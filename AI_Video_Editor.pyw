    def remove_avatar(self):
        p = self.avatar_path()
        if p and messagebox.askyesno("Remove", "Avatar remove korbe?"):
            archive(p, self.proj)
            self._avp_pause()
            for k in ("AV_TRIM_START", "AV_TRIM_END"):
                self.avv[k].set("0")
            self.refresh_avatar()

