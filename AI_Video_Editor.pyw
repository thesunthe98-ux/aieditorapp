def local_ffmpeg_bin():
    ex = load_recent().get("ffmpeg_dir")
    if ex and os.path.exists(os.path.join(ex, FF_EXE)):
        return ex
    if os.path.exists(os.path.join(FF_BIN, FF_EXE)):
