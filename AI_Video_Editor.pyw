    def _voice_tab_changed(self):
        cur = self._voice_tab.get()
        for k, fr in self._voice_pages.items():
            if k == cur:
                fr.pack(fill="both", expand=True)
            else:
                fr.pack_forget()

    def refresh_voice(self):
        _voice_ensure_dirs()
        if not self._voice_main_running and not self._voice_regens:
            try:
                _cfg_now = dict(self._voice_cfg)
                _cfg_now["output_dir"] = VOICE_OUTPUT
                voice_sweep_done(_cfg_now, self.voice_log_line)
                cur = self._voice_cur_script
                if cur and not os.path.exists(os.path.join(VOICE_SCRIPTS, cur)) \
                        and not os.path.exists(os.path.join(VOICE_LB, cur)):
                    self.voice_new_script()                  # editor e khola script ta done e chole geche
            except Exception:
                pass
        self.voice_refresh_scripts()
        self.voice_refresh_accounts()
        self.voice_refresh_results()

    def voice_log_line(self, msg):
        line = f"[{time.strftime('%H:%M:%S')}] {msg}"
        self._voice_q.put(line)
        try:
            with open(VOICE_LOG, "a", encoding="utf-8") as fh:
                fh.write(line + "\n")
        except Exception:
            pass

    def _voice_poll(self):
        try:
            while True:
                line = self._voice_q.get_nowait()
                low = line.lower()
                tag = "err" if ("fail" in low or "error" in low or "problem" in low) else (
                    "ok" if ("shesh" in low or "saved" in low) else (
                        "step" if "=====" in line else None))
                try:
                    _need = self._voice_track(line)
                except Exception:
                    _need = False
                if _need or "MP3 saved" in line or "SRT saved" in line or "SHESH" in line:
                    self.after(300, self.voice_refresh_results)     # show new files live
                self.voice_log.configure(state="normal")
                self.voice_log.insert("end", line + "\n", tag)
                self.voice_log.see("end")
                self.voice_log.configure(state="disabled")
                self.voice_status.configure(text=line[11:].strip()[:100],
                                            fg=BAD if tag == "err" else (OK if tag == "ok" else MUTED))
        except queue.Empty:
            pass
        try:
            self._voice_live_tick()
        except Exception:
            pass
        self.after(200, self._voice_poll)

    # ───────── live progress (Generated section e dekhabe ekhon ki kaj cholche) ─────────
    _VL_NAME = {"mp3": "MP3", "srt": "SRT", "gemini": "Gemini"}
    _VL_NUM = {"mp3": "\u2460", "srt": "\u2461", "gemini": "\u2462"}

    def _voice_cur_stage(self, d):
        gone = d["done"] | d["skipped"] | d["bad"]
        for s_ in d["stages"]:
            if s_ not in gone:
                return s_
        return None

    def _voice_track(self, line):
        """Log line pore bojhe: kon script e, kon dhape (MP3 / SRT / Gemini) kaj cholche.
        True dile Generated list notun kore ankte hobe."""
        msg = line[11:].strip()
        m = re.match(r"^\[(T\d+)\]\s*(.*)$", msg)
        tag, body = (m.group(1), m.group(2).strip()) if m else ("", msg)
        now = time.time()
        h = re.match(r"^=+\s*(.+?)\s*=+$", body)
        if h:
            inner = h.group(1)
            m2 = re.match(r"^(.*?)\s*\((mp3|srt|gemini)\)$", inner, re.I)
            name, what = (m2.group(1).strip(), m2.group(2).lower()) if m2 else (inner, "all")
            gem = bool(self._voice_cfg.get("gemini_enabled", True))
            if what == "gemini":
                stages = ["gemini"]
            elif what == "srt":
                stages = ["srt"] + (["gemini"] if gem else [])
            else:
                stages = ["mp3", "srt"] + (["gemini"] if gem else [])
            done = set()
            if what == "all":
                try:
                    mp = os.path.join(VOICE_OUTPUT, name, name + ".mp3")
                    if os.path.exists(mp) and os.path.getsize(mp) > 1000:
                        done.add("mp3")          # MP3 age thekei ache — Speechify skip hobe
                except OSError:
                    pass
            self._voice_live[name] = {"tag": tag, "stages": stages, "done": done, "skipped": set(),
                                      "bad": set(), "state": "run", "t0": now, "st0": now,
                                      "detail": "Shuru hochhe\u2026"}
            self._voice_tag_cur[tag] = name
            return True
        name = self._voice_tag_cur.get(tag)
        d = self._voice_live.get(name) if name else None
        if not d or d["state"] != "run" or not body or body.startswith("---"):
            return False
        low = body.lower()
        st = d["stages"]
        before = self._voice_cur_stage(d)
        if low.startswith(("mp3 saved", "mp3 notun kore")) and "mp3" in st:
            d["done"].add("mp3")
        elif low.startswith(("srt saved", "srt notun kore")) and "srt" in st:
            d["done"].add("srt")
        elif (low.startswith("corrected srt saved") or "corrected srt age thekei" in low) and "gemini" in st:
            d["done"].add("gemini")
        elif "gemini correction skip" in low and "gemini" in st:
            d["skipped"].add("gemini")
        elif low.startswith("gemini fail") and ("ager moto ache" in low or "hoyni" in low) and "gemini" in st:
            d["bad"].add("gemini")
        elif low.startswith("shesh:"):
            d["state"] = "done"
            d["tend"] = now
            for s_ in st:
                if s_ not in d["bad"] and s_ not in d["skipped"]:
                    d["done"].add(s_)
            d["detail"] = "Shesh"
            return True
        elif low.startswith("fail:") or low.startswith("error"):
            d["state"] = "fail"
            d["tend"] = now
            if before:
                d["bad"].add(before)
            d["detail"] = body[:140]
            return True
        d["detail"] = body[:110]
        if self._voice_cur_stage(d) != before:
            d["st0"] = now
        return False

    def _voice_live_finalize(self, only=None):
        """Kaj shesh/stop hole je gulo 'run' obosthay atke ache shegulor obostha thik kore."""
        changed = False
        for n, d in self._voice_live.items():
            if d["state"] != "run":
                continue
            if only is not None and n != only:
                continue
            if only is None and n in self._voice_regens:
                continue
            if d["bad"]:
                d["state"] = "fail"
                if not d.get("detail") or d["detail"] in ("Shuru hochhe\u2026", "Shesh"):
                    d["detail"] = "Kichu dhap fail hoyeche (upore \u2717 dekho)"
            else:
                d["state"] = "done" if self._voice_cur_stage(d) is None else "stopped"
            d["tend"] = time.time()
            changed = True
        if changed:
            try:
                self.voice_refresh_results()
            except tk.TclError:
                pass

    def _voice_live_row(self, card, name, d):
        fr = tk.Frame(card, bg=PANEL)
        fr.pack(fill="x", padx=10, pady=(4, 4))
        r1 = tk.Frame(fr, bg=PANEL)
        r1.pack(fill="x", padx=8, pady=(6, 0))
        chips = {}
        for s_ in d["stages"]:
            lb = mklabel(r1, "", 9, MUTED, True, bg=PANEL)
            lb.pack(side="left", padx=(0, 12))
            chips[s_] = lb
        tl = mklabel(r1, "", 9, MUTED, bg=PANEL)
        tl.pack(side="right")
        if d["state"] in ("fail", "stopped"):
            mkbtn(r1, "\u2715", lambda n=name: self._voice_live_dismiss(n), "flat",
                  pady=0, padx=6).pack(side="right", padx=(0, 8))
        dl = mklabel(fr, "", 9, FG, bg=PANEL, justify="left", anchor="w", wraplength=420)
        dl.pack(fill="x", padx=8, pady=(2, 7))
        fr.bind("<Configure>", lambda e, l=dl: l.configure(wraplength=max(140, e.width - 24)))
        self._voice_live_w[name] = {"frame": fr, "chips": chips, "time": tl, "detail": dl, "cache": {}}
        self._voice_live_update(self._voice_live_w[name], d)

    def _voice_live_dismiss(self, name):
        self._voice_live.pop(name, None)
        self.voice_refresh_results()

    def _voice_live_tick(self):
        if not self._voice_live_w:
            return
        self._voice_live_i += 1
        for name in list(self._voice_live_w):
            w = self._voice_live_w.get(name)
            d = self._voice_live.get(name)
            try:
                if not w or not d or not w["frame"].winfo_exists():
                    self._voice_live_w.pop(name, None)
                    continue
                self._voice_live_update(w, d)
            except tk.TclError:
                self._voice_live_w.pop(name, None)

    def _voice_live_update(self, w, d):
        i = self._voice_live_i
        now = time.time()
        dots = ("." * ((i // 2) % 4)).ljust(3)
        pulse = (math.sin(i * 0.9) + 1) / 2
        run = d["state"] == "run"
        cur = self._voice_cur_stage(d)
        cache = w["cache"]

        def put(key, widget, **kw):
            sig = tuple(sorted(kw.items()))
            if cache.get(key) != sig:
                cache[key] = sig
                widget.configure(**kw)

        for s_, lb in w["chips"].items():
            nm = f"{self._VL_NUM[s_]} {self._VL_NAME[s_]}"
            if s_ in d["done"]:
                put(s_, lb, text=nm + " \u2713", fg=OK)
            elif s_ in d["skipped"]:
                put(s_, lb, text=nm + " \u2013 skip", fg=MUTED)
            elif s_ in d["bad"]:
                put(s_, lb, text=nm + " \u2717", fg=BAD)
            elif s_ == cur and run:
                put(s_, lb, text=nm + " " + dots, fg=_mix(ACCENT, FG, pulse))
            elif s_ == cur:
                put(s_, lb, text=nm + " \u25a0", fg=WARN)
            else:
                put(s_, lb, text=nm, fg=MUTED)
        tot = (now if run else d.get("tend", now)) - d["t0"]
        ttxt = "\u23f1 " + fmt_dur(tot)
        if run and cur:
            ttxt += "   (dhap: " + fmt_dur(now - d["st0"]) + ")"
        put("time", w["time"], text=ttxt)
        det = d["detail"]
        if d["state"] == "fail":
            put("det", w["detail"], text="\u2717 " + det, fg=BAD)
        elif d["state"] == "stopped":
            put("det", w["detail"], text="\u25a0 Bondho hoye geche \u2014 " + det, fg=WARN)
        else:
            warn = re.search(r"fail|problem|retry|reload|abar", det.lower())
            put("det", w["detail"], text="\u25b8 " + det, fg=WARN if warn else FG)

    def voice_refresh_scripts(self):
        for w in self.voice_slist.inner.winfo_children():
            w.destroy()
        names = set()
        for base in (VOICE_SCRIPTS, VOICE_LB):
            try:
                names.update(f for f in os.listdir(base)
                             if f.lower().endswith(".txt") and os.path.isfile(os.path.join(base, f)))
            except Exception:
                pass
        files = sorted(names)
        for fn in files:
            sel = (self._voice_cur_script == fn)
            b = mkbtn(self.voice_slist.inner, os.path.splitext(fn)[0],
                      lambda n=fn: self.voice_load_script(n),
                      "primary" if sel else "flat", pady=3, padx=10)
            b.pack(fill="x", pady=1, padx=4)

    def _voice_alive(self):
        if self._voice_main_running or self._voice_regens:
            return True
        return self._voice_kind == "setup" and bool(self._voice_thread and self._voice_thread.is_alive())

    def _voice_running(self):
        return bool(self._voice_main_running or self._voice_regens)

    def _voice_ui_update(self):
        """Button state + animation sob ekhane theke thik hoy."""
        run = self._voice_running()
        busy = self._voice_alive()
        if not run:
            self._voice_stopping = False
        try:
            self.voice_start_btn.configure(state="disabled" if (self._voice_main_running or (busy and not run)) else "normal")
            self.voice_stop_btn.configure(state="normal" if run else "disabled")
            self.voice_clear_btn.configure(state="disabled" if busy else "normal")
            self.voice_atext.configure(state="disabled" if busy else "normal")
            if not busy:
                self.voice_status.configure(text="Ready", fg=MUTED)
        except tk.TclError:
            return
        self.voice_act.set_active(run)
        if (run or self._voice_stopping) and self._voice_anim_job is None:
            self._voice_anim_tick()
        elif not run and not self._voice_stopping:
            self._voice_anim_reset()

    def _voice_anim_reset(self):
        if self._voice_anim_job:
            try:
                self.after_cancel(self._voice_anim_job)
            except Exception:
                pass
            self._voice_anim_job = None
        try:
            self.voice_start_btn.configure(text="▶  START")
            self.voice_stop_btn.configure(text="■  STOP", bg=DANGER, activebackground=DANGER)
            self.voice_active_lbl.configure(text="")
        except tk.TclError:
            pass

    def _voice_anim_tick(self):
        self._voice_anim_job = None
        run = self._voice_running()
        if not run and not self._voice_stopping:
            self._voice_anim_reset()
            return
        self._voice_anim_i += 1
        i = self._voice_anim_i
        k = (i // 6) % 4
        dots = "." * k + " " * (3 - k)
        try:
            if self._voice_main_running:
                self.voice_start_btn.configure(text="▶  Running" + dots)
            if self._voice_stopping:
                self.voice_stop_btn.configure(text="■  Stopping" + dots)
                col = _mix(WARN, DANGER, (math.sin(i * 0.3) + 1) / 2)
            else:
                self.voice_stop_btn.configure(text="■  STOP")
                col = _mix(DANGER, DANGER_HOV, (math.sin(i * 0.2) + 1) / 2)
            self.voice_stop_btn.configure(bg=col, activebackground=col)
            n = len(self._voice_slots.busy)
            self.voice_active_lbl.configure(text=f"● {n} Chrome kaj korche" if run else "")
        except tk.TclError:
            return
        self._voice_anim_job = self.after(50, self._voice_anim_tick)

    def _voice_sched(self, key, fn, ms):
        j = self._voice_jobs.get(key)
        if j:
            try:
                self.after_cancel(j)
            except Exception:
                pass
        self._voice_jobs[key] = self.after(ms, fn)

    def _voice_text_modified(self, e=None):
        changed = False
        for w in (self.voice_stext, self.voice_ltext):
            if w.edit_modified():
                w.edit_modified(False)
                changed = True
        if changed:
            self._voice_sched("script", self._voice_autosave_script, 600)

    def _voice_prompt_modified(self, e=None):
        if not self.voice_ptext.edit_modified():
            return
        self.voice_ptext.edit_modified(False)
        self._voice_sched("prompt", self._voice_save_prompt, 600)

    def _voice_save_prompt(self):
        _voice_ensure_dirs()
        atomic_write(VOICE_PROMPT, self.voice_ptext.get("1.0", "end-1c"))

    def voice_reset_prompt(self):
        if not messagebox.askyesno("Prompt", "Prompt ta default e ferot nibo? (ekhon ja lekha ache muchhe jabe)"):
            return
        self.voice_ptext.delete("1.0", "end")
        self.voice_ptext.insert("1.0", VOICE_DEFAULT_PROMPT)
        self.voice_ptext.edit_modified(False)
        self._voice_save_prompt()
        self.note("Prompt default e ferot geche")

    def _voice_acct_modified(self, e=None):
        if not self.voice_atext.edit_modified():
            return
        self.voice_atext.edit_modified(False)
        if self._voice_alive():
            return
        self._voice_sched("acct", lambda: self.voice_save_accounts(silent=True), 600)

    def _voice_autosave_script(self):
        raw = self.voice_sname.get().strip()
        name = re.sub(r'[\\/:*?"<>|]', "_", raw)
        text = self.voice_stext.get("1.0", "end").strip()
        ltext = self.voice_ltext.get("1.0", "end").strip()
        cur = self._voice_cur_script
        if not name:
            if not text and not ltext:
                return
            n = 1
            while any(os.path.exists(os.path.join(b, f"script_{n}.txt")) for b in (VOICE_SCRIPTS, VOICE_DONE, VOICE_LB)):
                n += 1
            name = f"script_{n}"
            self._voice_loading = True
            self.voice_sname.set(name)
            self._voice_loading = False
        fn = f"{name}.txt"
        _voice_ensure_dirs()
        dst = os.path.join(VOICE_SCRIPTS, fn)
        ldst = os.path.join(VOICE_LB, fn)
        if cur and cur != fn:
            for base in (VOICE_SCRIPTS, VOICE_LB):
                src_ = os.path.join(base, cur)
                dst_ = os.path.join(base, fn)
                if os.path.exists(src_) and not os.path.exists(dst_):
                    try:
                        os.replace(src_, dst_)
                    except OSError:
                        pass
        if not text and not ltext:
            return
        if text:
            atomic_write(dst, text)
        if ltext:
            atomic_write(ldst, ltext)
        elif os.path.exists(ldst):
            try:
                os.remove(ldst)
            except OSError:
                pass
        changed = (cur != fn)
        self._voice_store_voice(name, old=(os.path.splitext(cur)[0] if cur and cur != fn else None))
        self._voice_cur_script = fn
        if changed:
            self.voice_refresh_scripts()

    def _voice_store_voice(self, name, remember=False, old=None):
        """Ei script er voice name file e rakhe. remember=True hole voice name ta dropdown list e-o joma hoy."""
        v = self.voice_svoice.get().strip()
        d = _voice_voices_load()
        changed = False
        if old and old != name and old in d["map"]:
            del d["map"][old]
            changed = True
        if v:
            if d["map"].get(name) != v:
                d["map"][name] = v
                changed = True
            if remember and v not in d["names"]:
                d["names"].append(v)
                changed = True
        elif name in d["map"]:
            del d["map"][name]
            changed = True
        if changed:
            try:
                _voice_voices_save(d)
            except Exception:
                pass
        try:
            self.voice_vcombo.configure(values=d["names"])
        except Exception:
            pass

    def _voice_voice_commit(self):
        cur = self._voice_cur_script
        if cur:
            self._voice_store_voice(os.path.splitext(cur)[0], remember=True)
        else:
            v = self.voice_svoice.get().strip()
            if v:                                   # script ekhono save hoyni — shudhu nam ta mone rakho
                d = _voice_voices_load()
                if v not in d["names"]:
                    d["names"].append(v)
                    try:
                        _voice_voices_save(d)
                    except Exception:
                        pass
                    self.voice_vcombo.configure(values=d["names"])

    def _voice_voice_forget(self, e=None):
        v = self.voice_svoice.get().strip()
        d = _voice_voices_load()
        if not v:
            messagebox.showinfo("Voice name", "Age dropdown theke (ba type kore) je voice name muchte chao seta select koro.")
            return
        if v not in d["names"]:
            messagebox.showinfo("Voice name", f"'{v}' mone rakha list e nei.")
            return
        if messagebox.askyesno("Voice name", f"'{v}' dropdown list theke muchben?"):
            d["names"].remove(v)
            try:
                _voice_voices_save(d)
            except Exception:
                pass
            self.voice_vcombo.configure(values=d["names"])
            self.voice_svoice.set("")

    def voice_new_script(self):
        self._voice_cur_script = None
        self._voice_loading = True
        self.voice_sname.set("")
        self.voice_svoice.set("")
        self._voice_loading = False
        for w in (self.voice_stext, self.voice_ltext):
            w.delete("1.0", "end")
            w.edit_modified(False)
        self.voice_refresh_scripts()

    def voice_save_script(self):
        name = re.sub(r'[\\/:*?"<>|]', "_", self.voice_sname.get().strip())
        text = self.voice_stext.get("1.0", "end").strip()
        ltext = self.voice_ltext.get("1.0", "end").strip()
        if not name or not text:
            messagebox.showwarning("Script", "Name ar Raw script duto-i dorkar.")
            return
        _voice_ensure_dirs()
        atomic_write(os.path.join(VOICE_SCRIPTS, f"{name}.txt"), text)
        if ltext:
            atomic_write(os.path.join(VOICE_LB, f"{name}.txt"), ltext)
        self._voice_store_voice(name, remember=True)
        self._voice_cur_script = f"{name}.txt"
        self.voice_refresh_scripts()
        self.voice_log_line(f"Script saved: {name}")

    def voice_load_script(self, fname):
        self._voice_cur_script = fname
        self._voice_loading = True
        self.voice_sname.set(os.path.splitext(fname)[0])
        self.voice_svoice.set(str(_voice_voices_load()["map"].get(os.path.splitext(fname)[0], "") or ""))
        self._voice_loading = False
        for w, base in ((self.voice_stext, VOICE_SCRIPTS), (self.voice_ltext, VOICE_LB)):
            p = os.path.join(base, fname)
            w.delete("1.0", "end")
            if os.path.exists(p):
                w.insert("1.0", read_text(p))
            w.edit_modified(False)
        self.voice_refresh_scripts()

    def voice_del_script(self):
        if self._voice_cur_script and messagebox.askyesno("Delete", "Ei script queue theke muchben?"):
            for base in (VOICE_SCRIPTS, VOICE_LB):
                try:
                    os.remove(os.path.join(base, self._voice_cur_script))
                except Exception:
                    pass
            try:
                _d = _voice_voices_load()
                if _d["map"].pop(os.path.splitext(self._voice_cur_script)[0], None) is not None:
                    _voice_voices_save(_d)
            except Exception:
                pass
            self.voice_new_script()

    def voice_refresh_accounts(self):
        self.voice_atext.configure(state="normal")
        self.voice_atext.delete("1.0", "end")
        if os.path.exists(VOICE_ACCOUNTS):
            self.voice_atext.insert("1.0", open(VOICE_ACCOUNTS, encoding="utf-8").read())
        self.voice_atext.edit_modified(False)
        if self._voice_alive():          # cholar somoy runner accounts.txt update kore — editor lock
            self.voice_atext.configure(state="disabled")

    def voice_save_accounts(self, silent=False):
        if self._voice_alive():
            return
        _voice_ensure_dirs()
        atomic_write(VOICE_ACCOUNTS, self.voice_atext.get("1.0", "end").strip() + "\n")
        if not silent:
            self.voice_log_line("Accounts saved")

    def voice_save_settings(self, silent=False):
        for k, v in self.voice_vars.items():
            val = v.get().strip()
            if k in ("vpn_disconnect_after", "gemini_enabled"):
                self._voice_cfg[k] = (val == "1")
                continue
            if k == "thread_mode":
                self._voice_cfg[k] = "multiple" if val.lower().startswith("multiple") else "single"
                continue
            if k == "after_action":
                self._voice_cfg[k] = next((a for a, l in VOICE_AFTER_LABELS.items() if l == val), "none")
                continue
            if k == "after_delay_min":
                try:
                    val = max(0.0, float(val))
                    if val == int(val):
                        val = int(val)
                except ValueError:
                    val = VOICE_DEFAULTS[k]
                self._voice_cfg[k] = val
                continue
            if k == "gemini_timeout_min":
                try:
                    val = max(0.5, float(val))
                    if val == int(val):
                        val = int(val)
                except ValueError:
                    val = VOICE_DEFAULTS[k]
            elif k in ("max_account_tries", "max_vpn_tries", "vpn_load_wait_sec", "gen_timeout_min",
                     "export_timeout_min", "convert_timeout_min", "threads",
                     "gemini_tries"):
                try:
                    val = int(val)
                except ValueError:
                    val = VOICE_DEFAULTS[k]
            if k == "zamzar_check_sec":
                try:
                    val = max(5, int(float(val)))
                except ValueError:
                    val = VOICE_DEFAULTS[k]
            self._voice_cfg[k] = val
        if str(self._voice_cfg.get("vpn_provider", "")) not in VOICE_VPN_PROVIDERS:
            self._voice_cfg["vpn_provider"] = "VeePN"
        if self._voice_cfg.get("thread_mode") == "multiple":
            self._voice_cfg["threads"] = max(2, min(5, int(self._voice_cfg.get("threads") or 2)))
        else:
            self._voice_cfg["threads"] = 1
        self._voice_cfg["output_dir"] = VOICE_OUTPUT
        _voice_save_cfg(self._voice_cfg)
        if not silent:
            self.voice_log_line("Settings saved")

    def voice_refresh_results(self):
        self._voice_live_w = {}
        for w in self.voice_results.inner.winfo_children():
            w.destroy()
        out = VOICE_OUTPUT
        folders = []
        sort_mode = self._voice_sort.get()
        stamps = {}                                    # folder -> (created, modified)
        if os.path.isdir(out):
            for d in os.listdir(out):
                fp_ = os.path.join(out, d)
                if os.path.isdir(fp_):
                    try:
                        stamps[d] = (os.path.getctime(fp_), os.path.getmtime(fp_))
                    except OSError:
                        stamps[d] = (0, 0)
            if sort_mode == "name":
                folders = sorted(stamps, key=lambda d: natural_key(d))
            elif sort_mode == "modified":
                folders = sorted(stamps, key=lambda d: stamps[d][1], reverse=True)
            else:
                folders = sorted(stamps, key=lambda d: stamps[d][0], reverse=True)
        # queue te ache kintu ekhono shuru hoyni
        pending = set()
        if self._voice_main_running:
            try:
                pending = {os.path.splitext(x)[0] for x in os.listdir(VOICE_SCRIPTS)
                           if x.lower().endswith(".txt") and os.path.isfile(os.path.join(VOICE_SCRIPTS, x))}
            except Exception:
                pending = set()
            pending -= {n for n, d_ in self._voice_live.items() if d_["state"] in ("run", "fail")}
        if not folders and not pending:
            mklabel(self.voice_results.inner, "Ekhono kono output nei \u2014 START chapun.", 10, MUTED,
                    bg=PANEL).pack(anchor="w", padx=8, pady=8)
            return
        pend_shown = [False]
        last_day = [None]
        today_d = datetime.date.today()

        def _day_title(ts):
            d_ = datetime.date.fromtimestamp(ts)
            if d_ == today_d:
                pre = "Today"
            elif d_ == today_d - datetime.timedelta(days=1):
                pre = "Yesterday"
            else:
                pre = d_.strftime("%A")
            return f"{pre}  \u00b7  {d_.day} {d_.strftime('%b %Y')}"

        def _day_header(name):
            if sort_mode == "name":
                return
            ts = stamps.get(name, (0, 0))[0 if sort_mode == "date" else 1]
            day = datetime.date.fromtimestamp(ts)
            if day == last_day[0]:
                return
            last_day[0] = day
            hr = tk.Frame(self.voice_results.inner, bg=PANEL)
            hr.pack(fill="x", padx=8, pady=(10, 2))
            mklabel(hr, "\U0001f4c5  " + _day_title(ts), 10, ACCENT, True, bg=PANEL).pack(side="left")
            tk.Frame(hr, bg=PANEL2, height=1).pack(side="left", fill="x", expand=True, padx=(10, 0), pady=(2, 0))

        def _pend_cards():
            if pend_shown[0]:
                return
            pend_shown[0] = True
            for pn in sorted(pending - set(folders)):
                pc = tk.Frame(self.voice_results.inner, bg=PANEL2)
                pc.pack(fill="x", padx=6, pady=4)
                pr_ = tk.Frame(pc, bg=PANEL2)
                pr_.pack(fill="x", padx=10, pady=8)
                mklabel(pr_, f"\U0001f4c4  {pn}", 11, FG, True, bg=PANEL2).pack(side="left")
                mklabel(pr_, "  \u23f3 queue e opekkha korche\u2026", 9, MUTED, bg=PANEL2).pack(side="left", padx=(8, 0))

        _pend_cards()
        for name in folders:
            _day_header(name)
            folder = os.path.join(out, name)
            card = tk.Frame(self.voice_results.inner, bg=PANEL2)
            card.pack(fill="x", padx=6, pady=4)
            top = tk.Frame(card, bg=PANEL2)
            top.pack(fill="x", padx=10, pady=(8, 2))
            files_here = [x for x in os.listdir(folder) if os.path.isfile(os.path.join(folder, x))]
            # Regenerate / Gemini fix cholle: je file gulo notun hobe, shegulor tick shuru te uthe jabe;
            # notun file toiri hole (regenerate shuru howar por banano) tabei tick boshbe.
            _rg = self._voice_regens.get(name)
            _t0 = getattr(self, "_voice_regen_t0", {}).get(name)
            _stale = ({"mp3": {"mp3", "srt", "corr"}, "srt": {"srt", "corr"}}.get(_rg, {"corr"})
                      if (_rg and _t0) else set())

            def _ok(kind, x):
                if x.startswith(".regen_tmp"):
                    return False
                if kind not in _stale:
                    return True
                try:
                    return os.path.getmtime(os.path.join(folder, x)) >= _t0 - 1
                except OSError:
                    return False
            has_mp3 = any(os.path.splitext(x)[1].lower() in AUDIO_EXTS and _ok("mp3", x) for x in files_here)
            has_srt = any(x.lower().endswith(".srt") and not x.startswith(VOICE_CORR_PREFIX) and _ok("srt", x)
                          for x in files_here)
            has_corr = any(x.startswith(VOICE_CORR_PREFIX) and x.lower().endswith(".srt") and _ok("corr", x)
                           for x in files_here)
            mklabel(top, f"\U0001f4c1  {name}", 11, FG, True, bg=PANEL2).pack(side="left")
            if name in self._voice_regens:
                mklabel(top, "  ⏳ " + {"mp3": "MP3", "srt": "SRT"}.get(self._voice_regens[name], "Gemini")
                        + " regenerate cholche…", 9, WARN, True, bg=PANEL2).pack(side="left", padx=(8, 0))
            mklabel(top, ("  MP3 \u2713" if has_mp3 else "  MP3 \u2717"), 9, OK if has_mp3 else BAD,
                    bg=PANEL2).pack(side="left", padx=(10, 0))
            mklabel(top, ("SRT \u2713" if has_srt else "SRT \u2717"), 9, OK if has_srt else BAD,
                    bg=PANEL2).pack(side="left", padx=(6, 0))
            mklabel(top, ("Corrected \u2713" if has_corr else "Corrected \u2717"), 9, OK if has_corr else MUTED,
                    bg=PANEL2).pack(side="left", padx=(6, 0))
            mkbtn(top, "\U0001f5d1 Delete", lambda n=name: self.voice_delete_folder(n), "danger",
                  pady=2, padx=10).pack(side="right")
            mkbtn(top, "Use in project", lambda n=name: self._voice_use_folder(n), "primary",
                  pady=2, padx=10).pack(side="right", padx=4)
            mkbtn(top, "Open folder", lambda p=folder: open_path(p), "flat", pady=2, padx=8).pack(side="right", padx=4)
            src = next((os.path.join(b, f"{name}.txt") for b in (VOICE_DONE, VOICE_SCRIPTS)
                        if os.path.exists(os.path.join(b, f"{name}.txt"))), None)
            _can_fix = bool(_voice_find_lb(name) and has_srt)
            d_ = self._voice_live.get(name)
            if d_ and d_["state"] in ("run", "fail", "stopped"):
                self._voice_live_row(card, name, d_)
            elif name in pending:
                mklabel(card, "  \u23f3 queue e ache \u2014 ager script shesh hole shuru hobe", 9, MUTED,
                        bg=PANEL2).pack(anchor="w", padx=12, pady=(0, 4))
            body = tk.Frame(card, bg=PANEL2)
            body.pack(fill="x")
            left = tk.Frame(body, bg=PANEL2)
            left.pack(side="left", fill="x", expand=True)   # age pack: sankuchito hole button gulo bhitore dhuke jabe
            if _can_fix or has_mp3 or src:
                # buttons: Delete / Use in project / Open folder er niche, file list er pashe (ডান দিকে)
                right = tk.Frame(body, bg=PANEL2)
                right.pack(side="right", anchor="n", padx=(0, 10), pady=(2, 4))
                if _can_fix:
                    mkbtn(right, "Gemini fix", lambda n=name: self.voice_fix_srt(n), "ghost",
