        slide = False
        if prev != key:
            self._tab_finish()
            if prev:
                self.frames[prev].place_forget()
                self.nav[prev].set_active(False)
            self.cur = key
            slide = False          # sliding a whole heavy tab at 60fps made every tab switch janky
            self.nav[key].set_active(True, animate=prev is not None)
            self.frames[key].place(x=34 if slide else 0, y=0, relwidth=1, relheight=1)
            self._move_ind(prev is not None)
        if key == "clips":
            self.refresh_clips()
        elif key == "export":
            self.refresh_export()
            self.refresh_usage(max_age=30)
        elif key == "audio":
            self.refresh_audio()
        elif key == "srt":
            self.refresh_srt()
        elif key == "avatar":
