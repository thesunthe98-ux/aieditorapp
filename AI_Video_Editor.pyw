    def _tr_dur(self, mul=1.0):
        try:
            sp = max(0.0, min(20.0, float(self.tspd.get())))
        except (tk.TclError, ValueError):
            sp = 10.0
        return max(0.15, (1.2 - 0.05 * sp) * mul)

    def _tr_update_lbl(self):
        try:
            cur = self._tr_cur()
            self.tr_lbl.configure(text=("Ekhon: " + self.trans_key) if cur else "Ekhon: None (transition nei)")
            mul = cur[1] if cur else 1.0
            self.tr_dur_lbl.configure(text=f"Duration ≈ {self._tr_dur(mul):.2f}s  (speed baralei chhoto hoy)")
        except (AttributeError, tk.TclError):
            pass

    def _tr_mark(self):
        for key, t in self._tr_tiles.items():
            try:
                t["cv"].configure(highlightbackground=ACCENT if key == self.trans_key else PANEL2)
            except tk.TclError:
                pass

    def _tr_select(self, key):
        if key == self.trans_key:
            return
        self._edit_begin()
        self.trans_key = key
        self._tr_mark()
        self._tr_update_lbl()
        self.app.note(f"Transition: {key} — sob clip er majhe boshbe ✓" if key else "Transition bondho kora hoyeche")
        self._cfg_dirty = True
        self._changed()

    def _seek_refresh(self):
        if not self._playing:
            self._seek_still(self.cur_t)

    def _play_join(self):
        if not self.trans_key:
            self.app.note("Age ekta transition template select koro.", WARN)
            return
        cand = [i for i in range(1, len(self.slots)) if self.slots[i]["path"] and self.slots[i - 1]["path"]]
        if not cand:
            self.app.note("Transition er jonno kompokkhe 2 ta pashapashi clip lagbe.", WARN)
            return
        i = self.sel if self.sel in cand else cand[0]
        self._layout()
        self._pause()
        self._set_time(max(0.0, self._geo[i][2] - 1.2))
        self._play()

    # hover mini-preview (frames made once by ffmpeg xfade on two synthetic pictures)
    @staticmethod
    def _tile_sources(w, h):
        a, b = bytearray(), bytearray()
        cx, cy, r = w / 2.0, h / 2.0, h * 0.28
        for y in range(h):
            for x in range(w):
                t = x / float(w) * 0.6 + y / float(h) * 0.4
                px = (int(25 + 30 * t), int(70 + 120 * t), int(220 - 40 * t))
                if (x - cx) ** 2 + (y - cy) ** 2 < r * r:
                    px = (255, 255, 255)
                a += bytes(px)
                t2 = x / float(w) * 0.4 + y / float(h) * 0.6
                qx = (int(250 - 20 * t2), int(140 - 90 * t2), int(30 + 170 * t2))
                if abs(x - cx) < r and abs(y - cy) < r:
                    qx = (255, 255, 255) if (abs(x - cx) > r - 4 or abs(y - cy) > r - 4) else (25, 25, 45)
                b += bytes(qx)
        return bytes(a), bytes(b)

    def _tile_start(self):
        if self._tile_started:
            return
        self._tile_started = True
        threading.Thread(target=self._tile_worker, daemon=True).start()

    def _tile_worker(self):
        TW, TH = self.TILE_W, self.TILE_H
        hdr = b"P6 %d %d 255\n" % (TW, TH)
        try:
            add_ffmpeg_path()
            d = os.path.join(TOOLS, "_t2thumbs")
            os.makedirs(d, exist_ok=True)
            pa, pb = os.path.join(d, "tile_a.ppm"), os.path.join(d, "tile_b.ppm")
            a, b = self._tile_sources(TW, TH)
            for p, data in ((pa, a), (pb, b)):
                with open(p, "wb") as fh:
                    fh.write(hdr + data)
            self._q.put(("tile", "", [hdr + a]))
        except Exception:
            return
        for name, x, _m in T2_TRANSITIONS:
            self._q.put(("tile", name, self._tile_render(pa, pb, x, TW, TH, hdr)))

    @staticmethod
    def _tile_render(pa, pb, x, TW, TH, hdr, fps=12, dur=1.0, pre=0.3, post=0.3):
        la, lb = dur + pre, dur + post
        fc = (f"[0:v]format=yuv420p[a];[1:v]format=yuv420p[b];"
              f"[a][b]xfade=transition={x}:duration={dur}:offset={pre},format=rgb24[o]")
        cmd = ["ffmpeg", "-v", "error", "-loop", "1", "-framerate", str(fps), "-t", f"{la:.3f}", "-i", pa,
               "-loop", "1", "-framerate", str(fps), "-t", f"{lb:.3f}", "-i", pb,
               "-filter_complex", fc, "-map", "[o]", "-f", "rawvideo", "-pix_fmt", "rgb24", "-"]
        try:
            r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, creationflags=NOWIN, timeout=40)
        except FileNotFoundError:
            return "noff"
        except Exception:
            return None
        size = TW * TH * 3
        n = len(r.stdout) // size
        if n < 3:
            return None
        return [hdr + r.stdout[i * size:(i + 1) * size] for i in range(n)]

    def _tile_ready(self, key, frames):
        t = self._tr_tiles.get(key)
        if t is None:
            return
        if frames == "noff":
            self._q.put(("noff",))
            frames = None
        if not frames:
            if key != "":
                try:
                    t["cv"].itemconfigure("ph", text="n/a")
                except tk.TclError:
                    pass
            return
        self._tile_raw[key] = frames
        try:
            t["static"] = tk.PhotoImage(data=frames[0 if key == "" else len(frames) // 2], format="PPM")
            t["cv"].delete("ph")
            t["cv"].itemconfigure(t["item"], image=t["static"])
            if t["hover"]:
                self._tile_anim(key, 0)
        except tk.TclError:
            pass

    def _tile_hover(self, key, on):
        t = self._tr_tiles.get(key)
        if t is None or key == "":
            return
        t["hover"] = on
        if t["job"]:
            try:
                self.after_cancel(t["job"])
            except (ValueError, tk.TclError):
                pass
            t["job"] = None
        if on:
            if key in self._tile_raw:
                self._tile_anim(key, 0)
        elif t["static"] is not None:
            t["cv"].itemconfigure(t["item"], image=t["static"])

    def _tile_anim(self, key, i):
        t = self._tr_tiles.get(key)
        raw = self._tile_raw.get(key)
        if t is None or not raw or not t["hover"]:
            return
        try:
            if t["imgs"] is None:
                t["imgs"] = [tk.PhotoImage(data=f, format="PPM") for f in raw]
            t["cv"].itemconfigure(t["item"], image=t["imgs"][i])
        except tk.TclError:
            return
        nxt = (i + 1) % len(raw)
        t["job"] = self.after(450 if nxt == 0 else 80, lambda: self._tile_anim(key, nxt))

