def _voice_find_lb(name):
    for base in (VOICE_LB, VOICE_LB_DONE):
        p = os.path.join(base, f"{name}.txt")
        if os.path.exists(p) and os.path.getsize(p) > 0:
            return p
    return None


def voice_state(name, cfg=None):
    """Output folder dekhe bole dey: (mp3 ache?, srt ache?, corrected srt ache?, corrected srt dorkar?)."""
    cfg = cfg or {}
    out = os.path.join(cfg.get("output_dir") or VOICE_OUTPUT, name)
    mp3_ok = srt_ok = corr_ok = False
    try:
        names = os.listdir(out)
    except OSError:
        names = []
    for f in names:
        fp = os.path.join(out, f)
        if f.startswith(".regen") or not os.path.isfile(fp):
            continue
        try:
            size = os.path.getsize(fp)
        except OSError:
            continue
        ext = os.path.splitext(f)[1].lower()
        if ext in AUDIO_EXTS:
            if size > 1000:
                mp3_ok = True
        elif ext == ".srt" and size > 0:
            if f.startswith(VOICE_CORR_PREFIX):
                corr_ok = True
            else:
                srt_ok = True
    need = bool(cfg.get("gemini_enabled", True)) and _voice_find_lb(name) is not None
    return mp3_ok, srt_ok, corr_ok, need


def voice_script_complete(name, cfg=None):
    """MP3 + SRT (+ Corrected SRT, jodi Gemini on ar line-break script ache) sob ready kina."""
    m, s_, c, need = voice_state(name, cfg)
    return bool(m and s_ and (c or not need))


def _voice_move_pair(name, to_done):
    pairs = ((VOICE_SCRIPTS, VOICE_DONE), (VOICE_LB, VOICE_LB_DONE))
    moved = False
    for a, b in pairs:
        src_dir, dst_dir = (a, b) if to_done else (b, a)
        src = os.path.join(src_dir, f"{name}.txt")
        if not os.path.isfile(src):
            continue
        dst = os.path.join(dst_dir, f"{name}.txt")
        if not to_done and os.path.exists(dst):         # queue e already ache — done er copy ta rekhe dao
            continue
        try:
            os.makedirs(dst_dir, exist_ok=True)
            if os.path.exists(dst):
                os.remove(dst)
            shutil.move(src, dst)
            moved = True
        except OSError:
            pass
    return moved


def voice_move_to_done(name):
    """Script (+ line-break script) queue theke done e soray. Age-i soranor thakle kichu kore na."""
    return _voice_move_pair(name, True)


def voice_restore_to_queue(name):
    """Done e thaka script abar queue e ferot ane (shudhu jodi kichu baki thake)."""
    return _voice_move_pair(name, False)


def voice_sweep_done(cfg, log=None):
    """Queue er je script er sob (MP3+SRT+Corrected) ready, shegulo done e soray. Soranor naam list return kore."""
    names = set()
    for base in (VOICE_SCRIPTS, VOICE_LB):
        try:
            names.update(os.path.splitext(f)[0] for f in os.listdir(base)
                         if f.lower().endswith(".txt") and os.path.isfile(os.path.join(base, f)))
        except OSError:
            pass
    moved = []
    for n in sorted(names):
        if voice_script_complete(n, cfg) and voice_move_to_done(n):
            moved.append(n)
            if log:
                log(f"'{n}' er sob ready (MP3 + SRT + Corrected) \u2014 queue theke soriye done e rakha holo")
    return moved


_SRT_TIME_RX = re.compile(r"^\s*(\d{1,2}):(\d{2}):(\d{2})[,.](\d{1,3})\s*-->\s*(\d{1,2}):(\d{2}):(\d{2})[,.](\d{1,3})\s*$")


def _voice_norm_line(t):
    """Shudhu invisible/space difference ignore kore (NFC, extra space, zero-width). Baki hubohu."""
    import unicodedata
    t = unicodedata.normalize("NFC", t or "")
    t = re.sub("[\u200b\u200c\u200d\ufeff]", "", t)
    return re.sub(r"\s+", " ", t).strip()


def voice_srt_match_problems(srt_text, script_lines):
    """Shudhu sonkha milay: SRT er block sonkha == script er line sonkha. Somossha er list return kore (faka = 100% match)."""
    texts = []
    for blk in re.split(r"\n\s*\n", srt_text.strip()):
        ls = [l for l in blk.strip().splitlines()]
        if len(ls) >= 3:
            texts.append(" ".join(x.strip() for x in ls[2:]))
    problems = []
    if len(texts) != len(script_lines):
        problems.append(f"block sonkha mile nai: SRT {len(texts)}, script {len(script_lines)}")
    return problems


def voice_md_to_srt(md):
    """Gemini .md output -> clean SRT text. (text, block_count) return kore."""
    t = md.replace("\r\n", "\n").replace("\r", "\n").lstrip("\ufeff")
    blocks, cur, open_ = [], None, False
    for line in t.split("\n"):
        s = line.strip()
        if s.startswith("```"):
            continue
        m = _SRT_TIME_RX.match(line)
        if m:
            g = m.groups()
            a = f"{int(g[0]):02d}:{g[1]}:{g[2]},{g[3].ljust(3, '0')}"
            b = f"{int(g[4]):02d}:{g[5]}:{g[6]},{g[7].ljust(3, '0')}"
            cur = {"t": f"{a} --> {b}", "text": []}
            blocks.append(cur)
            open_ = True
        elif cur is not None and open_:
            if not s:
                open_ = False
            else:
                cur["text"].append(s)
    blocks = [b for b in blocks if b["text"]]
    out = []
    for i, b in enumerate(blocks, 1):
        out.append(f"{i}\n{b['t']}\n" + "\n".join(b["text"]))
    return "\n\n".join(out) + ("\n" if out else ""), len(blocks)


def _voice_load_cfg():
    cfg = dict(VOICE_DEFAULTS)
    cfg["output_dir"] = VOICE_OUTPUT
    if os.path.exists(VOICE_CONFIG):
        try:
            cfg.update(json.load(open(VOICE_CONFIG, encoding="utf-8")))
        except Exception:
            pass
        if int(cfg.get("defaults_ver", 0) or 0) < 1:
            cfg.update(VOICE_DEFAULTS_V1)
            cfg["defaults_ver"] = 1
        if int(cfg.get("defaults_ver", 0) or 0) < 2:
            cfg.update(VOICE_DEFAULTS_V2)
            cfg["defaults_ver"] = 2
    cfg["output_dir"] = VOICE_OUTPUT  # always keep inside app workspace
    return cfg


def _voice_voices_load():
    d = {}
    try:
        d = json.load(open(VOICE_VOICES, encoding="utf-8"))
    except Exception:
        d = {}
    if not isinstance(d, dict):
        d = {}
    m, n = d.get("map"), d.get("names")
    return {"map": m if isinstance(m, dict) else {},
            "names": [x for x in n if isinstance(x, str) and x.strip()] if isinstance(n, list) else []}


