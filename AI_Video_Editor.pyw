    def _wheel(self, e):
        if getattr(e, "num", 0) == 4:            # Linux
            n = -1
        elif getattr(e, "num", 0) == 5:
            n = 1
        elif sys.platform == "darwin":           # Mac: delta chhoto (±1, ±2…)
            n = -int(e.delta) if abs(e.delta) < 40 else -int(e.delta / 40)
            n = max(-6, min(6, n)) or (-1 if e.delta > 0 else 1)
        else:                                    # Windows: 120 per notch
            n = int(-e.delta / 120)
        self.cv.yview_scroll(n, "units")

    def _fit_changed(self, *a):
        """Fit clips toggle -> config.txt e sathe sathe save (default OFF)."""
        if getattr(self, "_fit_loading", False):
            return
        try:
            cfg_write(self.proj, {"FIT_CLIPS": self.fit_var.get()})
        except Exception:
            pass

    def _fit_load(self):
        try:
            v = "1" if cfg_read(self.proj).get("FIT_CLIPS", "0").strip() == "1" else "0"
        except Exception:
            v = "0"
        self._fit_loading = True
        try:
            self.fit_var.set(v)
        finally:
            self._fit_loading = False

    def clips_dir(self):
        d = os.path.join(self.proj, "clips")
        os.makedirs(d, exist_ok=True)
        return d

    def refresh_clips(self, force=False):
        self._fit_load()
        self.flush_script()
        sents = sentences_of(os.path.join(self.proj, "script.txt"))
        clips = scan_clips(self.clips_dir())
        total = sum(len(v) for v in clips.values())
        multi = sum(1 for v in clips.values() if len(v) > 1)
        cfg = cfg_read(self.proj)
        cov = set()
        if self.mode.get() == 2:
            try:
                cov = covered_by_avatar(len(sents), int(cfg.get("AVATAR_SHOW_FOR", "2") or 2),
                                        int(cfg.get("AVATAR_SHOW_EVERY", "6") or 6))
            except ValueError:
                pass
        if total:
            self.clips_banner.configure(
                text=f"MANUAL mode  •  {total} clips  •  {multi} sentence e ekadhik clip (1a, 1b…)  •  "
                     "jei sentence e clip nei, ager clip reuse hobe.\n"
                     "💡 File ke 1a, 1b, 2a… naam diye drop korle naam onujayi sentence e boshbe.  "
                     "Kono row te drop = oi sentence e add;  kono clip er upor drop = oi clip replace.",
                fg=OK)
        else:
            self.clips_banner.configure(
                text="AUTO mode (kono clip nai) — Pexels/Pixabay theke auto khuje.\n"
                     "💡 Clips drag & drop koro: 1a, 1b, 2a, 2b, 3 … naam dile naam onujayi sentence e boshbe.",
                fg=WARN)

        # Nothing changed since the last build -> keep the rows that are already there.
        # (Rebuilding every row on every tab visit was the main reason this tab felt heavy.)
        try:
            stamp = tuple((i, tuple((v, p, os.path.getmtime(p)) for v, p in lst))
                          for i, lst in sorted(clips.items()))
        except OSError:
            stamp = None
        sig = (self.proj, tuple(sents), stamp, tuple(sorted(cov)))
        if (not force and stamp is not None and sig == getattr(self, "_clips_sig", None)
                and self.clip_inner.winfo_children()):
            return
        self._clips_sig = sig
        self._clips_gen = gen = getattr(self, "_clips_gen", 0) + 1
        try:
            y0 = self.cv.yview()[0]
        except tk.TclError:
            y0 = 0.0

        for w in self.clip_inner.winfo_children():
            w.destroy()
        self.thumb_labels.clear()
        try:
            while True:
                self.thumb_q.get_nowait()
        except queue.Empty:
            pass
        if not sents:
            mklabel(self.clip_inner, "Age Script tab e script likho.", 11, MUTED).pack(pady=40)
            return
        self._dnd_register_tree(self.clip_inner)
        self._clip_rows(gen, sents, clips, cov, 0, y0)

    def _clip_rows(self, gen, sents, clips, cov, start, y0):
        """Builds the sentence rows a few at a time so the window never freezes."""
        if gen != getattr(self, "_clips_gen", 0):
            return
        end = min(len(sents), start + (24 if start == 0 else 14))
        try:
            for i in range(start + 1, end + 1):
                s = sents[i - 1]
                row = tk.Frame(self.clip_inner, bg=PANEL)
                row.pack(fill="x", padx=8, pady=3)
