    # template gallery (own copy)
    def _tpl_lbl_upd(self):
        try:
            nm = self.subv2["SUB_TEMPLATE"].get().strip()
            self._tpl_lbl.configure(text=(f"Ekhon: {nm}" if nm else "Kono template select kora nei — button e click kore dekho."))
        except Exception:
            pass

    def _toggle_tpl(self):
        if self._tpl_open:
            self._tpl_panel.grid_remove()
            self._tpl_open = False
            self._tpl_btn.configure(text="🎨   Subtitle Templates  ▾")
            return
        if not self._tpl_built:
            self._tpl_build()
        self._tpl_panel.grid(row=2, column=0, columnspan=2, sticky="we", pady=(2, 10))
        self._tpl_open = True
        self._tpl_btn.configure(text="🎨   Subtitle Templates  ▴")
        self._tpl_redraw()
        self._tpl_mark()

    def _tpl_build(self):
        self._tpl_built = True
        pn = tk.Frame(self._tpl_body, bg=PANEL)
        self._tpl_panel = pn
        self._tpl_status = mklabel(pn, "Card e click korlei apply hobe. Tomar current font thakbe.", 9, MUTED,
                                   bg=PANEL, wraplength=320, justify="left")
        self._tpl_status.pack(anchor="w", pady=(6, 6))
        grid = tk.Frame(pn, bg=PANEL)
        grid.pack(anchor="w")
        for i, tpl in enumerate(self.app.SUB_TEMPLATES):
            cell = tk.Frame(grid, bg=PANEL)
            cell.grid(row=i // 2, column=i % 2, padx=(0, 8), pady=4)
            cvx = tk.Canvas(cell, width=self.app.TPL_CW, height=self.app.TPL_CH, bg="#262626", highlightthickness=2,
                            highlightbackground=PANEL2, highlightcolor=ACCENT, cursor="hand2", bd=0)
            cvx._no_theme = True
            cvx.pack()
            cvx.bind("<Button-1>", lambda e, t=tpl: self._tpl_pick(t))
            mklabel(cell, tpl[0], 9, MUTED, bg=PANEL).pack(pady=(2, 0))
            self._tpl_cards.append((cvx, tpl))

    def _tpl_redraw(self):
        for cvx, tpl in self._tpl_cards:
            self._tpl_draw(cvx, tpl)

    def _tpl_draw(self, cv, tpl):
        CW, CH = self.app.TPL_CW, self.app.TPL_CH
        cv.delete("all")
        cv.create_rectangle(0, 0, CW, CH, fill="#262626", outline="")
        cfg = {k: v.get().strip() for k, v in self.subv2.items()}
        cfg.update(self.app._tpl_values(tpl, False))
        words = self.app.SUB_TPL_SAMPLE.split()
        try:
            n = int(float(cfg.get("SUB_WORDS", "0") or 0))
        except ValueError:
            n = 0
        if n > 0:
            words = words[:n]
        text = " ".join(words)
        if cfg.get("SUB_UPPER") == "1":
            text = text.upper()
        try:
            size, wid = float(cfg.get("SUB_SIZE", "5.5")), float(cfg.get("SUB_WIDTH", "80"))
        except ValueError:
            size, wid = 5.5, 80.0
        maxw = min(CW * 0.94, CW * wid / 100.0)

        def blend(hexcol, op, *_a):
            try:
                r1, g1, b1 = (int(hexcol[i:i + 2], 16) for i in (1, 3, 5))
            except Exception:
                return "#000000"
            a = op / 100.0
            return "#%02x%02x%02x" % (int(r1 * a + 0x26 * (1 - a)), int(g1 * a + 0x26 * (1 - a)),
                                      int(b1 * a + 0x26 * (1 - a)))
        try:
            self.app._sub_render(cv, text, cfg, 18.0 * size / 5.0 * CW / 172.0, CW / 2.0, CH / 2.0, maxw, blend,
                                 family=cfg.get("SUB_FONT") or None)
        except tk.TclError:
            pass

    def _tpl_mark(self):
        if not getattr(self, "_tpl_built", False):
            return
        cur = self.subv2["SUB_TEMPLATE"].get().strip()
        for cvx, tpl in self._tpl_cards:
            try:
                cvx.configure(highlightbackground=ACCENT if tpl[0] == cur else PANEL2)
            except tk.TclError:
                pass

    def _tpl_pick(self, tpl):
        for k, v in self.app._tpl_values(tpl, False).items():
            self.subv2[k].set(v)
        self.subv2["SUB_TEMPLATE"].set(tpl[0])
        self._tpl_mark()
        self._tpl_status.configure(text=f"✓ {tpl[0]} apply hoyeche", fg=OK)

