def parse_volume_pct(s):
    s = str(s or "").strip().lower()
    try:
        if s.endswith("db"):
            v = 100 * 10 ** (float(s[:-2]) / 20)
        elif s.endswith("%"):
            v = float(s[:-1])
        else:
            v = float(s) * 100
    except ValueError:
        v = 100
    return int(max(10, min(400, round(v / 5) * 5)))


