class VoiceStopped(Exception):
    pass


class VoiceRunner:
    """Speechify -> VeePN -> Zamzar pipeline (runs in a worker thread)."""

    def __init__(self, cfg, log, ask, stop_event, chrome_hidden=False, profile=None, shared=None, tag=""):
        self.cfg = cfg
        self.tag = (tag + " ") if tag else ""
        self.log = (lambda m: log(f"[{tag}] {m}")) if tag else log
        self.shared = shared or {"lock": threading.RLock(), "reserved": set(), "ask": threading.Lock()}
        _ask_lock = self.shared["ask"]

        def _ask(msg):
            with _ask_lock:
                return ask(f"[{tag}] {msg}" if tag else msg)
        self.ask = _ask
        self.profile = profile or VOICE_PROFILE
        self.stop = stop_event
        self.chrome_hidden = chrome_hidden
        self.own = set()
        self.ctx = None
        self.keepalive = None
        self.last_vpn = None

    def check_stop(self):
        if self.stop.is_set():
            raise VoiceStopped()

    def sweep(self):
        try:
            for p in list(self.ctx.pages):
                if p in self.own:
                    continue
                url = p.url or ""
                if url in ("", "about:blank"):
                    continue
                host = _urlparse(url).netloc
                if url.startswith(("chrome://", "chrome-extension://")):
                    continue
                if any(host.endswith(h) for h in VOICE_ALLOWED):
                    continue
                self.log(f"  (ad tab bondho: {host})")
                p.close()
        except Exception:
            pass

    def sleep(self, ms, page=None):
        self.check_stop()
        (page or self.keepalive).wait_for_timeout(ms)
        self.sweep()

    def new_page(self):
        p = self.ctx.new_page()
        self.own.add(p)
        p.on("dialog", lambda d: d.accept())
        if self.chrome_hidden:
            self.move_window(p, False)
        return p

    def close_page(self, p):
        try:
            self.own.discard(p)
            p.close()
        except Exception:
            pass

    def move_window(self, page, visible):
        try:
            cdp = self.ctx.new_cdp_session(page)
            wid = cdp.send("Browser.getWindowForTarget")["windowId"]
            bounds = ({"left": 60, "top": 60, "width": 1200, "height": 800, "windowState": "normal"}
                      if visible else
                      {"left": -32000, "top": -32000, "width": 1366, "height": 900, "windowState": "normal"})
            cdp.send("Browser.setWindowBounds", {"windowId": wid, "bounds": bounds})
        except Exception:
            pass

    def set_chrome_hidden(self, hidden):
        self.chrome_hidden = bool(hidden)
        if not self.ctx:
            return
        for p in list(self.own) + list(self.ctx.pages):
            try:
                self.move_window(p, not self.chrome_hidden)
            except Exception:
                pass

    def _used_emails(self):
        used = set()
        try:
            for l in open(VOICE_USED, encoding="utf-8").read().splitlines():
                l = l.strip()
                if l:
                    used.add(l.split(":", 1)[0].strip().lower())
        except Exception:
            pass
        return used

    def peek_account(self, skip):
        """Ekta mail neya + reserve kore rakha. Ager e login hoye jaoa (used) mail kokhono dewa hobe na."""
        with self.shared["lock"]:
            if not os.path.exists(VOICE_ACCOUNTS):
                return None
            used = self._used_emails()
            for line in open(VOICE_ACCOUNTS, encoding="utf-8").read().splitlines():
                line = line.strip()
                if not line or line in skip or line in self.shared["reserved"]:
                    continue
                if ":" in line:
                    email, pw = line.split(":", 1)
                else:
                    email, pw = line, line
                if email.strip().lower() in used:
                    continue
                self.shared["reserved"].add(line)
                return email.strip(), pw.strip(), line
        return None

    def release_account(self, line):
        with self.shared["lock"]:
            self.shared["reserved"].discard(line)

    def mark_used(self, line):
        """Mail ke accounts.txt theke soriye accounts_used.txt e rakhe (ekbar-i, duplicate hoy na)."""
        with self.shared["lock"]:
            email = line.split(":", 1)[0].strip().lower()
            lines = [l.strip() for l in open(VOICE_ACCOUNTS, encoding="utf-8").read().splitlines() if l.strip()]
            keep = [l for l in lines if l.split(":", 1)[0].strip().lower() != email]
            if keep != lines:
                atomic_write(VOICE_ACCOUNTS, "\n".join(keep) + ("\n" if keep else ""))
            if email not in self._used_emails():
                with open(VOICE_USED, "a", encoding="utf-8") as f:
                    f.write(line + "\n")
            self.shared["reserved"].discard(line)

    def debug(self, page, tag):
        try:
            os.makedirs(VOICE_DEBUG, exist_ok=True)
            shot = os.path.join(VOICE_DEBUG, f"{time.strftime('%H%M%S')}_{self.tag}{tag}.png")
            page.screenshot(path=shot)
            txt = " ".join(page.inner_text("body").split())[:300]
            self.log(f"  [debug] {os.path.basename(shot)} | {page.url} | {txt}")
        except Exception:
            pass

    def dismiss_onboarding(self, page):
        try:
            btn = page.get_by_role("button", name=re.compile(
                r"^(Skip|Skip for now|Got it|Maybe later|No thanks|Not now|Done|Close|Continue to Studio)$", re.I))
            for i in range(min(btn.count(), 3)):
                if btn.nth(i).is_visible():
                    btn.nth(i).click(timeout=1500)
                    page.wait_for_timeout(500)
        except Exception:
            pass

    def find_editor(self, page):
        cands = [
            lambda: page.get_by_placeholder("Type or paste your text to generate speech..."),
            lambda: page.locator("[data-placeholder*='Type or paste']"),
            lambda: page.locator("[placeholder*='Type or paste']"),
            lambda: page.get_by_text(re.compile(r"Type or paste your text")).first,
            lambda: page.locator("[contenteditable='true']").last,
            lambda: page.locator("textarea").last,
        ]
        for _ in range(45):
            self.dismiss_onboarding(page)
            for mk in cands:
                try:
                    loc = mk().first
                    if loc.is_visible():
                        return loc
                except Exception:
                    continue
            self.sleep(1500, page)
        raise RuntimeError("Script likhar box paoa jayni")

    def launch(self, pw):
        self.pw = pw
        os.makedirs(self.profile, exist_ok=True)
        args = ["--disable-blink-features=AutomationControlled", "--start-maximized"]
        self.ctx = pw.chromium.launch_persistent_context(
            self.profile, channel="chrome", headless=False, accept_downloads=True,
            no_viewport=True, ignore_default_args=["--disable-extensions", "--enable-automation"],
            args=args)
        try:
            self.ctx.grant_permissions(["clipboard-read", "clipboard-write"], origin=VOICE_ORIGIN)
        except Exception:
            pass
        self.keepalive = self.ctx.pages[0] if self.ctx.pages else self.ctx.new_page()
        self.own.add(self.keepalive)
        if self.chrome_hidden:
            self.move_window(self.keepalive, False)

    def is_urban(self):
        return str(self.cfg.get("vpn_provider", "VeePN")).strip().lower().startswith("urban")

    def _ext_from_disk(self, key="veepn"):
        """Profile folder e install kora extension scan kore VeePN/UrbanVPN er ID ber kore (service worker ghumaleo kaj kore)."""
        found = set()
        keys = ("urban vpn", "urbanvpn") if key == "urban" else ("veepn",)
        root = os.path.join(self.profile, "Default", "Extensions")
        try:
            for eid in os.listdir(root):
                if not re.fullmatch(r"[a-p]{32}", eid):
                    continue
                if key == "urban" and eid == URBAN_EXT_ID:
                    found.add(eid)
                    continue
                edir = os.path.join(root, eid)
                for ver in os.listdir(edir):
                    blob = ""
                    for rel in ("manifest.json", os.path.join("_locales", "en", "messages.json"),
                                os.path.join("_locales", "en_US", "messages.json")):
                        fp = os.path.join(edir, ver, rel)
                        if os.path.exists(fp):
                            try:
                                blob += open(fp, encoding="utf-8", errors="ignore").read().lower()
                            except Exception:
                                pass
                    if any(k in blob for k in keys):
                        found.add(eid)
        except Exception:
            pass
        return found

    def ext_id_urban(self):
        v = str(self.cfg.get("urban_ext_id", "") or "").strip()
        if v:
            return v
        if getattr(self, "_urban_cached", None):
            return self._urban_cached
        disk = self._ext_from_disk("urban")
        if disk:
            self._urban_cached = sorted(disk)[0]
            self.log(f"  UrbanVPN extension ID: {self._urban_cached}")
            return self._urban_cached
        raise RuntimeError(
            "UrbanVPN extension ID paoa jayni. Ei app er Chrome profile e UrbanVPN install nai — "
            "'Chrome Profile Setup' chalie UrbanVPN install korun (ekbar-i). "
            "Ba Settings e UrbanVPN Extension ID boshan.")

    def ext_id(self):
        if self.is_urban():
            return self.ext_id_urban()
        if self.cfg.get("ext_id", "").strip():
            return self.cfg["ext_id"].strip()
        if getattr(self, "_ext_cached", None):
            return self._ext_cached
        t0 = time.time()
        while True:
            ids = set()
            try:
                for w in list(self.ctx.service_workers) + list(self.ctx.background_pages):
                    m = re.match(r"chrome-extension://([a-p]{32})/", w.url)
                    if m:
                        ids.add(m.group(1))
            except Exception:
                pass
            disk = self._ext_from_disk()
            if len(disk) == 1:                       # disk scan sobcheye nirbhorjoggo
                ids = disk
            elif len(disk) > 1 and ids & disk:
                ids = ids & disk
            if len(ids) == 1:
                self._ext_cached = next(iter(ids))
                self.log(f"  VeePN extension ID: {self._ext_cached}")
                return self._ext_cached
            if time.time() - t0 > 12 or self.stop.is_set():
                break
            self.sleep(1000, self.ctx.pages[0] if self.ctx.pages else None)   # Chrome shuru hoyei extension jage na
        raise RuntimeError(
            "VeePN extension ID paoa jayni. Ei app er Chrome profile e VeePN install nai — "
            "ekbar 'Chrome Profile Setup' chalie VeePN install korun (ekbar-i, porer bar auto). "
            "Ba Settings e Extension ID boshan.")

    def ext_ids_for(self, which):
        """'urban' ba 'veepn' er sob known extension ID (disk scan + Settings e deya ID)."""
        ids = set(self._ext_from_disk(which))
        if which == "urban":
            v = str(self.cfg.get("urban_ext_id", "") or "").strip()
            ids.add(v) if v else None
            if getattr(self, "_urban_cached", None):
                ids.add(self._urban_cached)
        else:
            v = str(self.cfg.get("ext_id", "") or "").strip()
            ids.add(v) if v else None
            if getattr(self, "_ext_cached", None):
                ids.add(self._ext_cached)
        return {i for i in ids if re.fullmatch(r"[a-p]{32}", i or "")}

    def ext_prepare_provider(self):
        """Selected provider er extension ENABLE, onnota DISABLE (UrbanVPN on thakle VeePN kaj kore na).
        Age onnota disable kore, tarpor selected ta enable kori — jate 'Service interruption' na ashe."""
        want = "urban" if self.is_urban() else "veepn"
        if getattr(self, "_prov_ready", None) == want:
            return
        other = "veepn" if want == "urban" else "urban"
        ok = True
        off_ids = self.ext_ids_for(other) - self.ext_ids_for(want)
        for i in sorted(off_ids):
            self.log(f"  {'VeePN' if other == 'veepn' else 'UrbanVPN'} disable korchi (selected: {'UrbanVPN' if want == 'urban' else 'VeePN'})")
            ok = self.ext_set_enabled(i, False) and ok
        for i in sorted(self.ext_ids_for(want)):
            ok = self.ext_set_enabled(i, True) and ok
        if ok:
            self._prov_ready = want

    def open_vpn_popup(self):
        try:
            self.ext_prepare_provider()
        except Exception as e:
            self.log(f"  provider extension switch kora gelo na: {str(e).splitlines()[0][:120]}")
        eid = self.ext_id()
        p = self.new_page()
        popup = "popup.html"
        mf = f"chrome-extension://{eid}/manifest.json"
        try:
            p.goto(mf, timeout=20000)
        except Exception:
            # extension disable kora thakle (jemon UrbanVPN 'Disable other extension' dile) -> chrome://extensions theke on kore abar
            self.log("  VPN extension disabled mone hocche — chrome://extensions theke enable korchi")
            try:
                self.ext_set_enabled(eid, True)
                p.goto(mf, timeout=20000)
            except Exception:
                pass
        try:
            data = json.loads(p.inner_text("body"))
            popup = ((data.get("action") or data.get("browser_action") or {}).get("default_popup") or popup)
        except Exception:
            pass
        p.goto(f"chrome-extension://{eid}/{popup}", timeout=30000)
        p.wait_for_timeout(2500)
        if self.is_urban():
            try:
                p.set_viewport_size({"width": 380, "height": 730})   # popup er moto size (layout milanor jonno)
                p.wait_for_timeout(500)
            except Exception:
                pass
            try:
                self.urban_dismiss(p)
            except Exception:
                pass
            return p
        try:
            self.vpn_wait_loaded(p, eid, popup)
        except Exception:
            self.close_page(p)
            raise
        self.dismiss_popups(p)
        return p

    def vpn_wait_loaded(self, p, eid, popup):
        """VeePN 'Loading — We're setting up your extension' screen e atke thakle:
        X second wait -> na hole page reload -> abar wait (max 3 bar), tarpor error (VPN tries e abar hobe)."""
        try:
            wait = max(10, int(self.cfg.get("vpn_load_wait_sec", 60)))
        except (TypeError, ValueError):
            wait = 60
        rx = re.compile(r"setting up your extension|take up to 2 minutes|^\s*Loading\b", re.I)

        def loading():
            try:
                return p.get_by_text(rx).first.is_visible()
            except Exception:
                return False

        for rnd in range(3):
            if not loading():
                return
            if rnd == 0:
                self.log("  VeePN 'Loading' dekhacche — load howar jonno wait korchi...")
            t0 = time.time()
            while time.time() - t0 < wait:
                self.sleep(2000, p)
                if not loading():
                    self.log("  VeePN load hoyeche")
                    return
            if rnd < 2:
                self.log(f"  VeePN {wait}s e load hoyni — page reload kore abar chesta (try {rnd + 2}/3)")
                try:
                    p.goto(f"chrome-extension://{eid}/{popup}", timeout=30000)
                except Exception:
                    try:
                        p.reload(timeout=30000)
                    except Exception:
                        pass
                p.wait_for_timeout(2500)
        raise RuntimeError("VeePN extension 'Loading' e atke ache (reload kore-o load hoyni)")

    def dismiss_popups(self, p):
        try:
            for rx in (r"^\s*No,?\s*thanks\b", r"^\s*Maybe later\b", r"^\s*Not now\b"):
                t = p.get_by_text(re.compile(rx, re.I))
                for i in range(min(t.count(), 2)):
                    if t.nth(i).is_visible():
                        t.nth(i).click(timeout=2000)
                        p.wait_for_timeout(800)
        except Exception:
            pass
        for s in ("[aria-label*='close' i]", "button:has-text('Close')", "button:has-text('No thanks')",
                  "button:has-text('Maybe later')", "button:has-text('Skip')"):
            try:
                loc = p.locator(s)
                for i in range(min(loc.count(), 3)):
                    if loc.nth(i).is_visible():
                        loc.nth(i).click(timeout=1500)
                        p.wait_for_timeout(400)
            except Exception:
                pass

    def click_power(self, p, label_regex):
        self.dismiss_popups(p)
        t = p.get_by_text(label_regex).first
        for _ in range(8):
            try:
                t.wait_for(timeout=2000)
                break
            except Exception:
                self.dismiss_popups(p)
        t.wait_for(timeout=5000)
        try:
            btn = t.locator("xpath=preceding::*[self::button or @role='button'][1]")
            box = btn.bounding_box()
            if box and box["width"] >= 80:
                btn.click(timeout=3000)
                return
        except Exception:
            pass
        box = t.bounding_box()
        p.mouse.click(box["x"] + box["width"] / 2, box["y"] - 145)

    def is_connected(self, p):
        self.dismiss_popups(p)
        try:
            return p.get_by_text(re.compile(r"^\s*Connected")).first.is_visible()
        except Exception:
            return False

    # ───────── chrome://extensions on/off ─────────
    def ext_set_enabled(self, eid, want=True):
        """chrome://extensions e gie ei extension er toggle on/off kore."""
        p = self.new_page()
        try:
            p.goto("chrome://extensions/", timeout=20000)
            p.wait_for_timeout(1500)
            tog = p.locator(f"extensions-item[id='{eid}'] #enableToggle")
            tog.wait_for(timeout=8000)
            try:
                on = bool(tog.evaluate("e => e.checked"))
            except Exception:
                on = (tog.get_attribute("aria-pressed") == "true")
            if on != bool(want):
                tog.click(timeout=4000)
                p.wait_for_timeout(1500)
                self.log(f"  extension {eid[:8]}… {'enable' if want else 'disable'} kora hoyeche")
            return True
        except Exception as e:
            self.log(f"  chrome://extensions e toggle kora gelo na: {str(e).splitlines()[0][:120]}")
            return False
        finally:
            self.close_page(p)

    # ───────── UrbanVPN ─────────
    def urban_interruption(self, p):
        """'Service interruption' -> 'Disable other extension' click; na hole nijei VeePN disable kore reload."""
        rx = re.compile(r"Service interruption|being interrupted", re.I)
        self.log("  UrbanVPN: 'Service interruption' — 'Disable other extension' chapchi")
        try:
            b = p.get_by_role("button", name=re.compile(r"Disable other extension", re.I)).first
            if not b.is_visible():
                b = p.get_by_text(re.compile(r"Disable other extension", re.I)).first
            b.click(timeout=3000)
        except Exception:
            pass
        for _ in range(8):
            p.wait_for_timeout(700)
            try:
                if not p.get_by_text(rx).first.is_visible():
                    self.log("  UrbanVPN: onno extension disable hoyeche")
                    return
            except Exception:
                return
        # Chrome nijer confirm dialog dekhale click kora jay na -> chrome://extensions diye disable
        ids = set(self._ext_from_disk("veepn"))
        vid = str(self.cfg.get("ext_id", "") or "").strip()
        if vid:
            ids.add(vid)
        for i in ids:
            self.ext_set_enabled(i, False)
        try:
            p.reload(timeout=20000)
        except Exception:
            pass
        p.wait_for_timeout(2500)

    def urban_close_x(self, p):
        """'Enjoy using UrbanVPN?' rating popup er upore-dane X."""
        try:
            for s in ("[aria-label*='close' i]", "button[class*='close' i]", "[class*='close' i]"):
                loc = p.locator(s)
                for i in range(min(loc.count(), 3)):
                    if loc.nth(i).is_visible():
                        loc.nth(i).click(timeout=1500)
                        return
        except Exception:
            pass
        try:
            pt = p.evaluate("""() => {
                let best = null;
                for (const el of document.querySelectorAll('button,[role=button],svg,img,a,div,span')) {
                    const r = el.getBoundingClientRect();
                    if (r.width < 10 || r.height < 10 || r.width > 60 || r.height > 60) continue;
                    if (r.top > 80 || r.bottom < 0) continue;
                    const cs = getComputedStyle(el);
                    if (cs.visibility === 'hidden' || cs.display === 'none') continue;
                    if (!best || r.right > best.r) best = {x: r.left + r.width / 2, y: r.top + r.height / 2, r: r.right};
                }
                return best;
            }""")
            if pt:
                p.mouse.click(pt["x"], pt["y"])
        except Exception:
            pass

    def urban_dismiss(self, p):
        """'Want to use Urban VPN?' -> Accept, 'Enjoy using UrbanVPN?' (rate us) -> X."""
        for _ in range(4):
            acted = False
            try:
                if p.get_by_text(re.compile(r"Service interruption", re.I)).first.is_visible():
                    self.urban_interruption(p)
                    acted = True
            except Exception:
                pass
            try:
                if p.get_by_text(re.compile(r"Want to use Urban\s?VPN", re.I)).first.is_visible():
                    b = p.get_by_role("button", name=re.compile(r"^\s*Accept\s*$", re.I)).first
                    if not b.is_visible():
                        b = p.get_by_text(re.compile(r"^\s*Accept\s*$")).first
                    b.click(timeout=3000)
                    p.wait_for_timeout(1500)
                    acted = True
            except Exception:
                pass
            try:
                if p.get_by_text(re.compile(r"Enjoy using Urban\s?VPN|rating us on", re.I)).first.is_visible():
                    self.urban_close_x(p)
                    p.wait_for_timeout(800)
                    acted = True
            except Exception:
                pass
            if not acted:
                break

    def urban_status(self, p):
        self.urban_dismiss(p)
        for name, rx in (("connected", r"^\s*Connected\s*$"), ("not", r"^\s*Not connected\s*$"),
                         ("connecting", r"^\s*Connecting")):
            try:
                if p.get_by_text(re.compile(rx)).first.is_visible():
                    return name
            except Exception:
                pass
        return None

    def urban_connected(self, p):
        return self.urban_status(p) == "connected"

    def urban_wait_status(self, p, names, timeout):
        t0 = time.time()
        while time.time() - t0 < timeout:
            st = self.urban_status(p)
            if st in names:
                return st
            if self.stop.is_set():
                break
            p.wait_for_timeout(600)
        return None

    def urban_power(self, p, dy=182):
        """Bhetorer boro gol (play/pause) button — status lekhar thik upore."""
        self.urban_dismiss(p)
        t = p.get_by_text(re.compile(r"^\s*(Not connected|Connected|Connecting.*)\s*$")).first
        t.wait_for(timeout=8000)
        box = t.bounding_box()
        p.mouse.click(box["x"] + box["width"] / 2 - 12, box["y"] + box["height"] / 2 - dy)

    def urban_pick(self, p, name):
        inp = p.locator("input[placeholder*='Search' i], input[type='search'], input[type='text']").first

        heads = p.get_by_text(re.compile(r"^\s*(Top locations|All locations)\s*$", re.I))

        def has_input():
            try:
                return inp.is_visible()
            except Exception:
                return False

        def opened():
            # UrbanVPN er notun UI te search input na-o thakte pare — list er heading dekhlei khola dhore nibo
            if has_input():
                return True
            try:
                return heads.first.is_visible()
            except Exception:
                return False
        if not opened():
            pts = []
            try:
                bx = p.get_by_text(re.compile(r"Get Premium", re.I)).first.bounding_box()
            except Exception:
                bx = None
            if bx:
                cy = bx["y"] + bx["height"] / 2 + 62
                pts += [(bx["x"] - 60, cy), (bx["x"] - 160, cy), (bx["x"] + 40, cy)]
            pts += [(150, 92), (120, 92)]
            for x, y in pts:
                try:
                    p.mouse.click(x, y)
                except Exception:
                    continue
                p.wait_for_timeout(800)
                self.urban_dismiss(p)
                if opened():
                    break
            if not opened():
                raise RuntimeError("UrbanVPN location list khola jayni")
        q = re.sub(r"\s*\(.*?\)\s*", " ", name).strip() or name
        if has_input():
            try:
                inp.click(timeout=2000)
                inp.fill("")
                inp.type(q, delay=40)
            except Exception:
                pass
        p.wait_for_timeout(1000)
        # list er item gulo ei Y er niche — upore current selected location (header) ache, seta click korle list bondho hoye jay
        min_y = 0
        try:
            if has_input():
                ib = inp.bounding_box()
                if ib:
                    min_y = ib["y"] + ib["height"]
            else:
                hb = heads.first.bounding_box()
                if hb:
                    min_y = hb["y"] + hb["height"]
        except Exception:
            pass
        item = None
        for rx in (rf"^\s*{re.escape(name)}\s*$", rf"^\s*{re.escape(name)}", rf"^\s*{re.escape(q)}\b",
                   re.escape(q)):
            loc = p.get_by_text(re.compile(rx, re.I))
            cands = []
            try:
                for i in range(min(loc.count(), 8)):
                    cand = loc.nth(i)
                    if not cand.is_visible():
                        continue
                    cb = cand.bounding_box()
                    if cb and cb["y"] > min_y - 2:
                        cands.append((cb["y"], cand))
            except Exception:
                pass
            if cands:
                cands.sort(key=lambda t: t[0])
                # heading/input paoa na gele prothom match = header e selected location, tai porerta nao
                item = cands[1][1] if (min_y == 0 and len(cands) > 1) else cands[0][1]
                break
        if item is None:
            raise RuntimeError(f"UrbanVPN e '{name}' paoa jayni")
        for how in ("normal", "force", "mouse"):
            try:
                if how == "normal":
                    item.click(timeout=3000)
                elif how == "force":
                    item.click(timeout=3000, force=True)
                else:
                    b = item.bounding_box()
                    p.mouse.click(b["x"] + b["width"] / 2, b["y"] + b["height"] / 2)
                return
            except Exception:
                continue
        raise RuntimeError(f"UrbanVPN '{name}' select kora jayni")

    def vpn_connect_urban(self):
        locs = [s.strip() for s in str(self.cfg.get("urban_locations", "") or "").split(",") if s.strip()]
        if not locs:
            locs = [s.strip() for s in VOICE_DEFAULTS["urban_locations"].split(",")]
        pool = [x for x in locs if x != self.last_vpn] or locs
        choice = random.choice(pool)
        self.last_vpn = choice
        self.log(f"VPN (UrbanVPN): location -> {choice}")
        p = self.open_vpn_popup()
        try:
            if self.urban_connected(p):
                self.urban_power(p)
                if not self.urban_wait_status(p, ("not",), 20):
                    raise RuntimeError("UrbanVPN disconnect hoyni")
            self.urban_pick(p, choice)
            p.wait_for_timeout(1500)
            st = self.urban_wait_status(p, ("connected", "connecting"), 6)   # location select korle auto connect hote pare
            if st is None:
                for dy in (182, 170, 195):
                    self.urban_power(p, dy)
                    st = self.urban_wait_status(p, ("connected", "connecting"), 6)
                    if st:
                        break
            if st != "connected":
                st = self.urban_wait_status(p, ("connected",), 40)
            if st != "connected":
                self.urban_dismiss(p)
                self.ask("VPN connect hoyni. Extension popup thakle nijer haate bondho kore OK chapen.")
                if not self.urban_connected(p):
                    raise RuntimeError("VPN connect hoyni")
            self.log("  VPN connected")
        except Exception:
            self.debug(p, "vpn")
            raise
        finally:
            self.close_page(p)

    def vpn_disconnect_urban(self):
        p = None
        try:
            p = self.open_vpn_popup()
            if self.urban_connected(p):
                self.urban_power(p)
                self.urban_wait_status(p, ("not",), 20)
                self.log("  VPN disconnect hoyeche")
        except Exception as e:
            self.log(f"  VPN disconnect kora gelo na: {e}")
        finally:
            if p:
                self.close_page(p)

    def vpn_disconnect(self):
        if self.is_urban():
            return self.vpn_disconnect_urban()
        p = None
        try:
            p = self.open_vpn_popup()
            if self.is_connected(p):
                self.click_power(p, re.compile(r"^\s*Connected"))
                p.get_by_text(re.compile(r"Connection is OFF", re.I)).first.wait_for(timeout=20000)
                self.log("  VPN disconnect hoyeche")
        except Exception as e:
            self.log(f"  VPN disconnect kora gelo na: {e}")
        finally:
            if p:
                self.close_page(p)

    def vpn_pick(self, p, item):
        status = re.compile(r"Connection is OFF|Disconnected", re.I)
        for how in ("normal", "force", "mouse"):
            self.dismiss_popups(p)
            try:
                if how == "normal":
                    item.click(timeout=4000)
                elif how == "force":
                    item.click(timeout=3000, force=True)
                else:
                    b = item.bounding_box()
                    p.mouse.click(b["x"] + b["width"] / 2, b["y"] + b["height"] / 2)
            except Exception:
                continue
            try:
                p.get_by_text(status).first.wait_for(timeout=4000)
                return
            except Exception:
                continue
        raise RuntimeError("VPN location select kora jayni")

    def vpn_list_open(self, p):
        try:
            return p.get_by_text(re.compile(r"^\s*Free locations\s*$", re.I)).first.is_visible()
        except Exception:
            return False

    def vpn_expand_us(self, p, state):
        """United States row er dropdown khule Oregon / Virginia dekhay."""
        rx = re.compile(rf"^\s*{state}\b")

        def shown():
            try:
                return p.get_by_text(rx).first.is_visible()
            except Exception:
                return False
        if shown():
            return
        us = p.get_by_text(re.compile(r"^\s*United States\b")).first
        us.scroll_into_view_if_needed(timeout=8000)
        for how in ("text", "edge"):
            try:
                if how == "text":
                    us.click(timeout=3000)
                else:
                    b = us.bounding_box()
                    w = p.evaluate("window.innerWidth")
                    p.mouse.click(w - 70, b["y"] + b["height"] / 2)
            except Exception:
                continue
            for _ in range(6):
                p.wait_for_timeout(500)
                if shown():
                    return
        raise RuntimeError("USA dropdown khola jayni")

    def vpn_connect(self):
        if self.is_urban():
            return self.vpn_connect_urban()
        locs = voice_vpn_choices(self.cfg.get("vpn_locations", "")) or voice_vpn_choices(VOICE_DEFAULTS["vpn_locations"])
        pool = [x for x in locs if x != self.last_vpn] or locs
        choice = random.choice(pool)
        self.last_vpn = choice
        self.log(f"VPN: location -> {choice}")
        p = self.open_vpn_popup()
        try:
            if self.is_connected(p):
                self.click_power(p, re.compile(r"^\s*Connected"))
                p.get_by_text(re.compile(r"Connection is OFF", re.I)).first.wait_for(timeout=20000)
            opened = self.vpn_list_open(p)          # list age-i khola thakle kono location e click korbo na
            for name in ([] if opened else VOICE_FREE_LOCS):
                loc = p.get_by_text(re.compile(rf"^\s*{re.escape(name)}\b")).first
                try:
                    if loc.is_visible():
                        loc.click(timeout=3000)
                        opened = True
                        break
                except Exception:
                    continue
            if not opened:
                box = p.get_by_text("Your IP").first.bounding_box()
                p.mouse.click(box["x"] + 100, box["y"] - 60)
            p.wait_for_timeout(1200)
            if choice in VOICE_US_STATES:
                self.vpn_expand_us(p, choice)
            item = p.get_by_text(re.compile(rf"^\s*{re.escape(choice)}\b")).first
            item.scroll_into_view_if_needed(timeout=8000)
            self.vpn_pick(p, item)
            p.wait_for_timeout(1200)
            self.click_power(p, re.compile(r"Connection is OFF|Disconnected", re.I))
            try:
                for _ in range(15):
                    self.dismiss_popups(p)
                    try:
                        p.get_by_text(re.compile(r"^\s*Connected")).first.wait_for(timeout=2000)
                        break
                    except Exception:
                        continue
                else:
                    raise RuntimeError("connect timeout")
            except Exception:
                self.dismiss_popups(p)
                self.ask("VPN connect hoyni. Extension popup thakle nijer haate bondho kore OK chapen.")
                if not self.is_connected(p):
                    raise RuntimeError("VPN connect hoyni")
            self.log("  VPN connected")
        except Exception:
            self.debug(p, "vpn")
            raise
        finally:
            self.close_page(p)

    def clear_speechify_cookies(self):
        """Shudhu Speechify cookie muchhbe — Google (Gemini) login jeno na mushe."""
        try:
            self.ctx.clear_cookies(domain=re.compile(r"speechify", re.I))
            return
        except Exception:
            pass
        try:                                            # purano Playwright: Google cookie save kore baki muchhe, abar boshay
            keep = [c for c in self.ctx.cookies()
                    if re.search(r"google|youtube|gstatic|googleusercontent", c.get("domain", ""), re.I)]
            self.ctx.clear_cookies()
            if keep:
                self.ctx.add_cookies(keep)
        except Exception:
            pass

    def speechify(self, page, email, password, text, out_mp3, voice=None):
        cfg = self.cfg
        self.log(f"Speechify: login -> {email}")
        self.clear_speechify_cookies()
        page.goto(VOICE_SIGN_IN, timeout=90000)
        try:
            cdp = self.ctx.new_cdp_session(page)
            cdp.send("Storage.clearDataForOrigin", {"origin": VOICE_ORIGIN, "storageTypes": "all"})
        except Exception:
            pass
        page.goto(VOICE_SIGN_IN, timeout=90000)
        page.get_by_placeholder("Email address").fill(email, timeout=30000)
        page.get_by_placeholder("Password").fill(password)
        page.get_by_role("button", name="Continue", exact=True).click()
        page.get_by_text("Build Something").wait_for(timeout=60000)
        self.log("  login hoyeche")
        acct_line = getattr(self, "_cur_acct", None)
        if acct_line:                                   # login hoyei mail 'used' — voice generate hok ba na hok, ar use hobe na
            self.mark_used(acct_line)
            self._cur_acct = None
            self.log("  mail used list e geche (ar use hobe na)")
        page.get_by_text("Voiceover", exact=True).first.click()
        page.wait_for_url("**/voiceover/**", timeout=60000)
        ta = self.find_editor(page)
        self.select_voice(page, voice)
        self.sleep(500, page)
        self.log("  script paste")
        # button kokhono "Split & Generate (206 credits)", kokhono shudhu "Split" -- duto-i dhorbe
        # ("Split by Paragraphs" etc. option card gulo match korbe na)
        split_btn = page.get_by_role("button", name=re.compile(r"^\s*Split\s*(&\s*Generate.*)?$", re.I)).first
        ta.click()
        try:
            page.evaluate("t => navigator.clipboard.writeText(t)", text)
            page.keyboard.press("Control+V")
            split_btn.wait_for(timeout=12000)
        except Exception:
            ta.click()
            ta.fill(text)
            split_btn.wait_for(timeout=15000)
        mode = cfg.get("split_mode")
        if mode:
            try:
                page.get_by_text(mode, exact=True).first.click(timeout=3000)
            except Exception:
                pass
        # "Generate speech immediately after splitting" checkbox tick kora thakle button "Split & Generate" hoy
        try:
            cb = page.get_by_role("checkbox", name=re.compile(r"Generate speech immediately", re.I)).first
            if cb.count() and not cb.is_checked():
                cb.check(timeout=3000)
                page.wait_for_timeout(400)
        except Exception:
            try:
                page.get_by_text("Generate speech immediately after splitting", exact=False).first.click(timeout=2000)
                page.wait_for_timeout(400)
            except Exception:
                pass
        try:
            lbl = (split_btn.inner_text(timeout=3000) or "").strip()
        except Exception:
            lbl = ""
        split_btn.click()
        self.log(f"  {lbl.splitlines()[0] if lbl else 'Split & Generate'}")
        self.wait_generation(page)
        self.export_and_download(page, out_mp3)

    def select_voice(self, page, voice=None):
        name = (voice or self.cfg.get("voice_name") or "Albert (M)").strip() or "Albert (M)"
        self.log(f"  voice name: {name}")
