    def _thumb_cache(self, path):
        st = os.stat(path)
        k = hashlib.md5(f"{path}{st.st_mtime}{st.st_size}".encode()).hexdigest()[:16]
        d = os.path.join(self.proj, "_thumbs")
        os.makedirs(d, exist_ok=True)
        return os.path.join(d, k + ".png")

    def _thumb_worker(self):
        while True:
            path = self.thumb_q.get()
            try:
                out = self._thumb_cache(path)
                ok = os.path.exists(out) or self._make_thumb(path, out)
                if ok:
                    self.q.put(("thumb", (path, out)))
                elif ok is None:
                    self.q.put(("thumb_fail", None))
            except Exception:
                pass

    def _thumb_pump(self):
        pass

    def _set_thumb(self, path, png):
        lb = self.thumb_labels.get(path)
        if not lb:
            return
        try:
            img = tk.PhotoImage(file=png)
            if not hasattr(self, "_thumb_imgs"):
                self._thumb_imgs = {}
            self._thumb_imgs[png] = img
            lb.configure(image=img, text="")
            lb.image = img
        except Exception:
            pass

    # ───────── AVATAR (overlay + live preview) ─────────

    AV_DEFAULTS = {"AV_SKIP_FIRST": "0", "AV_KEY_ON": "1", "AV_KEY_COLOR": "#FFFFFF",
                   "AV_KEY_SIM": "15", "AV_KEY_BLEND": "5", "AV_SIZE": "35", "AV_X": "100", "AV_Y": "100", "AV_FREE": "0",
                   "AV_MIRROR": "0", "AV_TRIM_START": "0", "AV_TRIM_END": "0"}
    AVP_W, AVP_H, AVP_FPS = 300, 180, 24

    @staticmethod
    def av_geometry(size_pct, px, py, W, H, vw, vh, even=True, free=False):
        """Same maths as the engine: avatar w/h and top-left corner inside a WxH frame.
        px/py = position inside the free space (100,100 = bottom-right corner).
        free=True lets the avatar go outside the frame (-100..200)."""
        size_pct = min(100.0, max(5.0, size_pct))
        aw = W * size_pct / 100.0
        ah = aw * vh / float(vw)
        if even:
            aw = max(2, int(round(aw / 2.0)) * 2)
            ah = max(2, int(round(aw * vh / float(vw) / 2.0)) * 2)
            if ah > H and not free:
                ah = max(2, (int(H) // 2) * 2)
                aw = max(2, int(round(ah * vw / float(vh) / 2.0)) * 2)
        elif ah > H and not free:
            ah = float(H)
            aw = ah * vw / float(vh)
        if free:
            px, py = min(200.0, max(-100.0, px)), min(200.0, max(-100.0, py))
            ux, uy = max(W - aw, 0.25 * W), max(H - ah, 0.25 * H)
        else:
            px, py = min(100.0, max(0.0, px)), min(100.0, max(0.0, py))
            ux, uy = W - aw, H - ah
        return aw, ah, int(round(ux * px / 100.0)), int(round(uy * py / 100.0))

    def _build_avatar(self, f):
        self.header(f, "Avatar & Subtitles", "Duto-i ek preview e dekhe size, position, style thik koro")
        self.avv = {k: tk.StringVar(value=v) for k, v in self.AV_DEFAULTS.items()}
        self.av_for, self.av_every = tk.StringVar(), tk.StringVar()
        self._av_ready, self._av_job, self._av_busy, self._av_dirty = False, None, False, False
        self._av_bg, self._av_bg_key, self._av_bg_busy = None, None, False
        self._av_img = self._av_raw = None
        self._av_key_sig = None
        self._av_dims = None
        self._av_path = False
        self._av_pick, self._av_drag, self._av_snap = False, None, (False, False)
        self._av_q, self._av_bgq = queue.Queue(), queue.Queue()
        self._av_size, self._av_out = (self.PV_MAX_W, 281), (1920, 1080)
        self._av_swatch = None
        self._av_scale = tk.IntVar(value=int(self.rec.get("av_preview", 100) or 100))
        self._av_rs, self._av_grip_job, self._av_ctl_hidden = False, None, False
        self._av_scale_job = None
        self._av_resize_job = None
        # in-app avatar player + trim
        self._avp_sig, self._avp_path = None, None
        self._avp_dur, self._avp_vw, self._avp_vh = 0.0, 0, 0
