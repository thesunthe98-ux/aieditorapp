    def voice_delete_folder(self, name):
        """Voice+SRT: ekta generated folder (MP3 + SRT) computer theke delete kore."""
        folder = os.path.join(VOICE_OUTPUT, name)
        if not os.path.isdir(folder):
            self.voice_refresh_results()
            return
        if self._voice_alive():
            messagebox.showinfo("Busy", "Voice+SRT cholche — age STOP koro, tarpor Delete koro.")
            return
        if not messagebox.askyesno(
                "Delete folder",
                f"'{name}' folder delete korbe?\n\n"
                "• Ei folder er MP3 + SRT (computer theke muchhe jabe)\n\n"
                "Script queue / raw script / project e boshano audio-SRT muchbe na.",
                icon="warning"):
            return
        self._voice_play_stop()
        self._voice_drag_path = None
        try:
            rm_tree(folder)
        except Exception as e:
            messagebox.showerror("Delete", f"Delete hoyni: {e}")
        if os.path.isdir(folder):
            self.note(f"Delete puro hoyni — file open thakte pare: {name}", WARN)
        else:
            self.note(f"✓ Deleted: {name}", OK)
        self.voice_refresh_results()
        self.refresh_usage()

    def _voice_play(self, path):
        self._voice_play_stop()
        ff = shutil.which("ffmpeg")
        if not ff:
            open_path(path)
            return

        def work():
            try:
                wav = os.path.join(tempfile.gettempdir(), "voice_preview.wav")
                subprocess.run([ff, "-y", "-i", path, "-ac", "1", "-ar", "22050", wav],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               creationflags=NOWIN, timeout=180)
                if os.name == "nt":
                    import winsound
                    winsound.PlaySound(wav, winsound.SND_FILENAME | winsound.SND_ASYNC)
                else:
                    exe = shutil.which("afplay") or shutil.which("paplay") or shutil.which("aplay")
                    if exe:
                        self._voice_aproc = subprocess.Popen([exe, wav], stdout=subprocess.DEVNULL,
                                                             stderr=subprocess.DEVNULL)
                    else:
                        self.after(0, lambda: open_path(path))
            except Exception:
                self.after(0, lambda: open_path(path))
        threading.Thread(target=work, daemon=True).start()

    def _voice_play_stop(self):
        try:
            if os.name == "nt":
                import winsound
                winsound.PlaySound(None, winsound.SND_PURGE)
            else:
                p = getattr(self, "_voice_aproc", None)
                if p is not None and p.poll() is None:
                    p.terminate()
        except Exception:
            pass

    def _voice_make_draggable(self, widget, path):
        """Generated item (txt/mp3/srt) ke drag source banay."""
        if not DND_OK:
            return
        try:
            widget.drag_source_register(1, DND_FILES)
            widget.dnd_bind("<<DragInitCmd>>", lambda e, p=path: self._voice_drag_init(e, p))
            widget.dnd_bind("<<DragEndCmd>>", self._voice_drag_end)
        except Exception:
            pass

    def _voice_drag_init(self, event, path):
        if not path or not os.path.exists(path):
            return "refuse_drop"
        self._drag_out = True
        self._voice_drag_path = path
        self._voice_drag_watch()
        return ("copy", DND_FILES, (os.path.abspath(path).replace("\\", "/"),))

    def _voice_drag_end(self, event):
        self._voice_drag_path = None
        self.after(300, lambda: setattr(self, "_drag_out", False))
        return event.action

    def _voice_drag_watch(self):
        if not self._voice_drag_path:
            return
        try:
            x, y = self.winfo_pointerxy()
            w = self.winfo_containing(x, y)
        except Exception:
            w = None
        target = None
        while w is not None:
            for key, nav in self.nav.items():
                if w is nav or w in (getattr(nav, "ic", None), getattr(nav, "tx", None)):
                    if key in ("audio", "srt", "script"):
                        target = key
                    break
            if target:
                break
            w = getattr(w, "master", None)
        if target and self.cur != target:
            self.show(target)
        if self._voice_drag_path:
            self.after(120, self._voice_drag_watch)

    def _voice_use_in_project(self, path):
        ext = os.path.splitext(path)[1].lower()
        if ext in AUDIO_EXTS:
            self.set_audio(path)
            self.show("audio")
            self.note(f"Audio set: {os.path.basename(path)}")
        elif ext == ".srt":
            self.set_srt(path)
            self.show("srt")
            self.note(f"SRT set: {os.path.basename(path)}")

    def _voice_use_folder(self, name):
        folder = os.path.join(VOICE_OUTPUT, name)
        mp3 = srt = corr = None
        for fn in sorted(os.listdir(folder)):
            fp = os.path.join(folder, fn)
            e = os.path.splitext(fn)[1].lower()
            if e in AUDIO_EXTS and not mp3:
                mp3 = fp
            elif e == ".srt":
                if fn.startswith(VOICE_CORR_PREFIX):
                    corr = corr or fp
                else:
                    srt = srt or fp
        use_srt = corr or srt
        if mp3:
            self.set_audio(mp3)
        if use_srt:
            self.set_srt(use_srt)
        sp = _voice_find_lb(name)                       # line break script -> Script section
        if not sp:
            for base in (VOICE_DONE, VOICE_SCRIPTS):
                p = os.path.join(base, f"{name}.txt")
                if os.path.exists(p):
                    sp = p
                    break
        if sp:
            self.set_script_file(sp)
        self.show("audio" if mp3 else "srt")
        extra = "corrected SRT" if corr else "SRT"
        self.note(f"\u2713 {name} project e bosheche (audio / {extra} / script)")

    def voice_ask(self, msg):
        ev = threading.Event()

        def show():
            messagebox.showinfo("Apnar kaj dorkar", msg)
            ev.set()
        self.after(0, show)
        ev.wait()

    def voice_toggle_chrome(self):
        self._voice_chrome_hidden = not self._voice_chrome_hidden
        self.voice_hide_btn.configure(
            text="\U0001f441 Unhide Chrome" if self._voice_chrome_hidden else "\U0001f441 Hide Chrome")
        for r_ in list(self._voice_runners):
            try:
                r_.set_chrome_hidden(self._voice_chrome_hidden)
            except Exception:
                pass
        self.note("Chrome hidden — onno kaj korte paren" if self._voice_chrome_hidden
                  else "Chrome visible — automation dekhte parben")

    def voice_setup_profile(self):
        if self._voice_kind == "setup" and self._voice_thread and self._voice_thread.is_alive():
            messagebox.showinfo("Setup cholche",
                                "Chrome Profile Setup ekhono cholche. Khola Chrome window gulo bondho korun "
                                "(Task Manager e 'Google Chrome' ar 'python' o dekhte paren), tahole porer profile khulbe.")
            return
        if self._voice_main_running or self._voice_regens:
            messagebox.showwarning("Busy", "Voice+SRT ba Regenerate cholche — age STOP korun.")
            return
        ok, err = _ensure_playwright()
        if not ok:
            messagebox.showerror("Playwright", f"Install fail:\n{err}")
            return
        self.voice_log_line("Chrome Profile Setup shuru (5 ta profile, ek ek kore)...")
        self._voice_kind = "setup"
        eid = str(self._voice_cfg.get("ext_id", "") or "").strip()
        self._voice_thread = threading.Thread(
            target=lambda: voice_chrome_setup_all(
                5, eid, self.voice_log_line,
                str(self._voice_cfg.get("urban_ext_id", "") or "").strip()), daemon=True)
        self._voice_thread.start()

    def voice_regen(self, name, what):
        label = "MP3" if what == "mp3" else "SRT"
        if self.proc or self.busy:
            messagebox.showinfo("Busy", "Export cholche — shesh hole abar chalan.")
            return
        if not messagebox.askyesno("Regenerate " + label,
                                   (f"'{name}' er MP3 notun kore toiri hobe, tarpor SRT ar Corrected SRT-o notun hobe. Purano file gulo replace hobe. Cholbe?"
                                    if what == "mp3" else
                                    f"'{name}' er SRT notun kore toiri hobe, tarpor Corrected SRT-o notun hobe. Purano SRT/Corrected replace hobe. Cholbe?")):
            return
        self.voice_fix_srt(name, what)

    def voice_fix_srt(self, name, what="gemini"):
        """Regenerate / Gemini fix. Multiple threads cholle: je Chrome (thread) ekhon free sheta te shuru hoy,
        baki gulo cholte thake. Shob thread busy thakle hobe na."""
        if self.proc or self.busy:
            messagebox.showinfo("Busy", "Export cholche — shesh hole chalan.")
            return
        if self._voice_kind == "setup" and self._voice_alive() and not self._voice_running():
            messagebox.showinfo("Busy", "Setup cholche — shesh hok.")
            return
        if name in self._voice_regens:
            messagebox.showinfo("Busy", f"'{name}' er kaj ekhon-i cholche.")
            return
        if self._voice_stopping:
            messagebox.showinfo("Stopping", "Stop hochhe — shesh hole abar chalan.")
            return
        ok, err = _ensure_playwright()
        if not ok:
            messagebox.showerror("Playwright", f"Install lagbe:\n{err}")
            return
        self.voice_save_settings(silent=True)
        cfg = dict(self._voice_cfg)
        cfg["output_dir"] = VOICE_OUTPUT
        cands = voice_slot_candidates(cfg)
        got = None
        for idx, prof in cands:
            if self._voice_slots.try_acquire(idx):
                got = (idx, prof)
                break
        if not got:
            messagebox.showinfo(
                "Shob Chrome busy",
                f"Ekhon {len(cands)} ta Chrome (thread) shob-i kaj korche.\n"
                "Ekta Chrome free hole (kaj shesh hole) abar Regenerate chapun.")
            return
        idx, prof = got
        if not self._voice_alive():
            self._voice_stop.clear()
        self._voice_regens[name] = what
        if not hasattr(self, "_voice_regen_t0"):
            self._voice_regen_t0 = {}
        self._voice_regen_t0[name] = time.time()
        tag = f"T{idx}" if len(cands) > 1 else ""
        self.voice_log_line(f"Regenerate ({what}): {name}" + (f"  -> Chrome T{idx} e shuru" if tag else ""))
        hidden = self._voice_chrome_hidden

        def work():
            r = None
            fail_msg = None
            try:
                r = VoiceRunner(cfg, self.voice_log_line, self.voice_ask, self._voice_stop,
                                chrome_hidden=hidden, profile=prof, shared=self._voice_shared, tag=tag)
                self._voice_runners.append(r)
                r.run_single(name, what)
                self.voice_log_line(f"--- {name}: shesh ---")
            except VoiceStopped:
                self.voice_log_line("--- STOP kora hoyeche ---")
            except Exception as e:
                fail_msg = (str(e).splitlines() or [type(e).__name__])[0][:220] or type(e).__name__
                self.voice_log_line(f"ERROR: Regenerate ({what}) fail \u2014 {name}: {fail_msg}")
            finally:
                if r in self._voice_runners:
                    self._voice_runners.remove(r)
                self._voice_slots.release(idx)
                self.after(0, lambda: self._voice_regen_done(name, what, fail_msg))

        threading.Thread(target=work, daemon=True).start()
        self._voice_ui_update()
        self.voice_refresh_results()

    def _voice_regen_done(self, name, what=None, fail_msg=None):
        self._voice_regens.pop(name, None)
        getattr(self, "_voice_regen_t0", {}).pop(name, None)
        if fail_msg:
            d = self._voice_live.get(name)
            if not d:
                st = {"mp3": ["mp3", "srt"], "srt": ["srt"]}.get(what, ["gemini"])
                now = time.time()
                d = self._voice_live[name] = {"tag": "", "stages": st, "done": set(), "skipped": set(),
                                              "bad": set(), "state": "run", "t0": now, "st0": now,
                                              "detail": ""}
            cur = self._voice_cur_stage(d)
            if cur:
                d["bad"].add(cur)
            d["state"] = "fail"
            d["tend"] = time.time()
            d["detail"] = "Regenerate fail: " + fail_msg
            try:
                self.note("\u2717 Regenerate fail \u2014 " + name + ": " + fail_msg[:90], BAD, 10)
            except Exception:
                pass
        self.after(600, lambda n=name: self._voice_live_finalize(n))
        self._voice_ui_update()
        self.refresh_voice()

    def voice_start(self):
        if self._voice_main_running:
            return
        if self._voice_kind == "setup" and self._voice_alive():
            messagebox.showinfo("Busy", "Setup cholche — shesh hole START chapun.")
            return
        if self.proc or self.busy:
            messagebox.showinfo("Busy", "Export cholche — shesh hole Voice+SRT chalan.")
            return
        if self._voice_stopping:
            messagebox.showinfo("Stopping", "Stop hochhe — shesh hole abar chalan.")
            return
        self.voice_start_btn.configure(text="⏳  Preparing…")
        self.voice_status.configure(text="Preparing…", fg=ACCENT)
        self.update_idletasks()
        self._voice_voice_commit()
        self.voice_save_settings()
        self.voice_save_accounts()
        ok, err = _ensure_playwright()
        if not ok:
            messagebox.showerror("Playwright", f"Install lagbe:\n{err}")
            self._voice_ui_update()
            self._voice_anim_reset()
            return
        _cfg_now = dict(self._voice_cfg)
        _cfg_now["output_dir"] = VOICE_OUTPUT
        voice_sweep_done(_cfg_now, self.voice_log_line)      # jegulor sob ready (manual kora-o) shegulo soriye dao
        self.voice_refresh_scripts()
        files = sorted(
            [os.path.join(VOICE_SCRIPTS, f) for f in os.listdir(VOICE_SCRIPTS)
             if f.lower().endswith(".txt") and os.path.isfile(os.path.join(VOICE_SCRIPTS, f))])
        if not files:
            messagebox.showwarning("Scripts", "Queue e kono script nei (sob ready ba kono script save kora nei).")
            self._voice_ui_update()
            self._voice_anim_reset()
            return
        if not self._voice_alive():
            self._voice_stop.clear()
        cfg = dict(self._voice_cfg)
        cfg["output_dir"] = VOICE_OUTPUT
        self._voice_main_running = True
        self._voice_kind = "run"

        def work():
            done_ok = False
            try:
                voice_run_all(cfg, files, self.voice_log_line, self.voice_ask, self._voice_stop,
                              lambda: self._voice_chrome_hidden, self._voice_runners,
                              self._voice_shared, self._voice_slots)
                self.voice_log_line("--- shesh ---")
                done_ok = True
            except VoiceStopped:
                self.voice_log_line("--- STOP kora hoyeche ---")
            except Exception as e:
                self.voice_log_line(f"ERROR: {e}")
            finally:
                self.after(0, self._voice_finish)
                if done_ok:
                    self.after(0, self._voice_after_finish)

        self._voice_thread = threading.Thread(target=work, daemon=True)
        self._voice_thread.start()
        self.voice_status.configure(text="Running…", fg=ACCENT)
        self._voice_ui_update()

    def _voice_finish(self):
        self._voice_main_running = False
        self._voice_ui_update()
        self.after(600, self._voice_live_finalize)
        cur = self._voice_cur_script
        if cur and not os.path.exists(os.path.join(VOICE_SCRIPTS, cur)):
            self.voice_new_script()          # script ta done e chole geche
        self.refresh_voice()

    def _voice_after_finish(self):
        """Sob kaj normal bhabe shesh hole (STOP na) PC shutdown/sleep — age countdown + Cancel."""
        act = str(self._voice_cfg.get("after_action", "none"))
        if act not in ("shutdown", "sleep"):
            return
        if self._voice_alive():                     # regenerate ityadi cholle shesh howar jonno opekkha
            self.after(3000, self._voice_after_finish)
            return
        try:
            secs = max(15, int(float(self._voice_cfg.get("after_delay_min", 1) or 0) * 60))
        except (TypeError, ValueError):
            secs = 60
        name = VOICE_AFTER_LABELS[act]
        self.voice_log_line(f"Sob kaj shesh — {secs}s por {name} hobe (Cancel korte countdown window e chapun)")
        win = tk.Toplevel(self)
        win.title(name)
        win.configure(bg=PANEL)
        win.attributes("-topmost", True)
        win.resizable(False, False)
        lbl = mklabel(win, "", 12, FG, True, bg=PANEL)
        lbl.pack(padx=30, pady=(22, 8))
        mklabel(win, "Cancel chaple PC bondho hobe na.", 9, MUTED, bg=PANEL).pack(padx=30)
        brow = tk.Frame(win, bg=PANEL)
        brow.pack(pady=18)
        state = {"left": secs, "job": None, "dead": False}

        def close():
            state["dead"] = True
            if state["job"]:
                try:
                    win.after_cancel(state["job"])
                except Exception:
                    pass
            try:
                win.destroy()
            except tk.TclError:
                pass

        def cancel():
            close()
            self.voice_log_line(f"{name} cancel kora hoyeche")

        def go():
            close()
            self.voice_log_line(f"{name} hochhe…")
            self.after(500, lambda: self._voice_power(act))

        def tick():
            if state["dead"]:
                return
            m, sec = divmod(state["left"], 60)
            lbl.configure(text=f"{name} hobe  {m:02d}:{sec:02d}  por")
            if state["left"] <= 0:
                go()
                return
            state["left"] -= 1
            state["job"] = win.after(1000, tick)

        mkbtn(brow, "Cancel", cancel, "danger", padx=18).pack(side="left", padx=6)
        mkbtn(brow, "Ekhoni koro", go, "ghost", padx=14).pack(side="left", padx=6)
        win.protocol("WM_DELETE_WINDOW", cancel)
        tick()

    def _voice_power(self, act):
        try:
            if sys.platform.startswith("win"):
                flags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
                if act == "shutdown":
                    subprocess.Popen(["shutdown", "/s", "/t", "5", "/c", "AI Video Editor: kaj shesh"],
                                     creationflags=flags)
                else:
                    subprocess.Popen(["rundll32.exe", "powrprof.dll,SetSuspendState", "0,1,0"],
                                     creationflags=flags)
            elif sys.platform == "darwin":
                cmd = "tell application \"System Events\" to " + ("shut down" if act == "shutdown" else "sleep")
                subprocess.Popen(["osascript", "-e", cmd])
            else:
                subprocess.Popen(["systemctl", "poweroff" if act == "shutdown" else "suspend"])
        except Exception as e:
            self.voice_log_line(f"PC {act} kora gelo na: {e}")

    def _voice_wipe_dir(self, path):
        n = 0
        if not os.path.isdir(path):
            return 0
        for fn in os.listdir(path):
            fp = os.path.join(path, fn)
            try:
                if os.path.isdir(fp) and not os.path.islink(fp):
                    rm_tree(fp)
                else:
                    try:
                        os.chmod(fp, stat.S_IWRITE)
                    except Exception:
                        pass
                    os.remove(fp)
                n += 1
            except Exception:
                pass
        return n

    def voice_clear_all(self):
        """Voice+SRT: script queue, generated MP3/SRT (disk theke), log — sob muchhe dey. Accounts thake."""
        if self._voice_alive():
            messagebox.showinfo("Busy", "Voice+SRT cholche — age STOP koro, tarpor Clear All.")
            return
        if not messagebox.askyesno(
                "Clear All — Voice+SRT",
                "Voice+SRT er sob muchhe dibo?\n\n"
                "• Script queue (done shoho)\n"
                "• Generated MP3 + SRT (computer theke delete hobe)\n"
                "• Log / debug file\n\n"
                "Accounts mail, Settings, Chrome profile thakbe.\n"
                "(Project e already boshano audio/SRT muchbe na.)", icon="warning"):
            return
        self._voice_play_stop()
        self._voice_drag_path = None
        self._voice_live.clear()
        self._voice_tag_cur.clear()
        for k in ("script", "acct", "cfg"):
            j = self._voice_jobs.pop(k, None)
            if j:
                try:
                    self.after_cancel(j)
                except Exception:
                    pass
        for d in (VOICE_OUTPUT, VOICE_DEBUG):
            self._voice_wipe_dir(d)
        if os.path.isdir(VOICE_SCRIPTS):
            for fn in os.listdir(VOICE_SCRIPTS):
                fp = os.path.join(VOICE_SCRIPTS, fn)
                if os.path.isfile(fp):
                    try:
                        os.remove(fp)
                    except Exception:
                        pass
        self._voice_wipe_dir(VOICE_DONE)
        self._voice_wipe_dir(VOICE_LB)
        for fp in (VOICE_LOG, os.path.join(tempfile.gettempdir(), "voice_preview.wav")):
            try:
                os.remove(fp)
            except Exception:
                pass
        _voice_ensure_dirs()
        self.voice_new_script()
        self.voice_log.configure(state="normal")
        self.voice_log.delete("1.0", "end")
        self.voice_log.configure(state="disabled")
        self.voice_status.configure(text="Ready", fg=MUTED)
        self.voice_refresh_scripts()
        self.voice_refresh_results()
        self.refresh_usage()
        self.note("✓ Voice+SRT sob faka (accounts thakche)", OK)

    def voice_stop(self):
        if not self._voice_running():
            return
        self._voice_stop.set()
        self._voice_stopping = True
        self.voice_stop_btn.configure(text="\u25a0  Stopping")
        self.voice_status.configure(text="Stopping\u2026", fg=WARN)
        self.voice_log_line("Stop kora hochhe\u2026")
        self._voice_ui_update()


