class CreditLimit(Exception):
    """Speechify: 'You ran out of credits, buy more to continue generation!' popup."""


class Tab2SpeechifyRunner(VoiceRunner):
    """Tab 2 'Fix voice': Speechify Studio Voice Swap (/voice-changer) chunk by chunk.
    VoiceRunner er Chrome launch / new_page / sweep / peek_account / mark_used / clear_speechify_cookies reuse kore
    (Tab 1 er code ekdom bodlay na). Credit shesh hole account Tab 1 Accounts theke REMOVE hoy ar porer account e login hoy."""
    SWAP_URL = VOICE_ORIGIN + "/voice-changer"
    LIMIT_RE = VOICE_LIMIT_RE

    def __init__(self, cfg, log, stop_event, shared, profile, hidden=False, account_hint="",
                 on_account=None, on_accounts_changed=None):
        super().__init__(cfg, log, lambda m: None, stop_event, chrome_hidden=hidden, profile=profile,
                         shared=shared, tag="")
        self._want_hidden = bool(hidden)
        self.account = None                         # active "email:password" line
        self.hint = (account_hint or "").strip()    # age-r Tab 2 account (tab2.json)
        self.on_account = on_account or (lambda line: None)
        self.on_accounts_changed = on_accounts_changed or (lambda: None)

    def request_hidden(self, h):
        """Tk thread theke call hoy — asol window move runner er nijer thread e hoy (Playwright thread-safe na)."""
        self._want_hidden = bool(h)

    def sleep(self, ms, page=None):
        if self._want_hidden != self.chrome_hidden:
            self.set_chrome_hidden(self._want_hidden)
        super().sleep(ms, page)

    # ───────── small helpers ─────────
    @staticmethod
    def _split(line):
        if ":" in line:
            e, p = line.split(":", 1)
            return e.strip(), p.strip()
        return line.strip(), line.strip()

    @staticmethod
    def _btn(page, rx):
        return page.get_by_role("button", name=rx).or_(page.get_by_text(rx))

    def _limit_shown(self, page):
        try:
            return page.get_by_text(self.LIMIT_RE).first.is_visible()
        except Exception:
            return False

    def _wait_for(self, page, find, secs, what):
        """find() locator visible hoyar jonno wait. Credit-limit popup ashle CreditLimit."""
        t0 = time.time()
        while time.time() - t0 < secs:
            self.check_stop()
            if self._limit_shown(page):
                raise CreditLimit()
            try:
                loc = find().first
                if loc.is_visible():
                    return loc
            except Exception:
                pass
            self.dismiss_onboarding(page)
            self.sleep(1000, page)
        raise RuntimeError(f"{what} paoa jayni (timeout)")

    # ───────── accounts ─────────
    def _hint_account(self, skip):
        """Age-r Tab 2 account (tab2.json) — credit shesh na hole (blocked list e na thakle) sheta-i abar nao.
        Login er somoy-i Accounts list theke soriye deya hoy, tai list e thaka lagbe na."""
        h, self.hint = self.hint, ""
        if not h:
            return None
        em = h.split(":", 1)[0].strip().lower()
        with self.shared["lock"]:
            if em in self._blocked_emails():
                return None
        e, p = self._split(h)
        return e, p, h

    def _claim_account(self, line):
        """Tab 1 er moto: login hoye gele account ke Accounts section (accounts.txt) theke SORIYE used e rakho.
        Tab 2 ei account-i credit shesh na howa porjonto reuse korbe (self.account / tab2.json)."""
        try:
            self.mark_used(line)
        except Exception as e:
            self.log(f"  account remove e problem: {(str(e).splitlines() or [''])[0][:120]}")
        _t2_sess_set(self.profile, line)       # ei Chrome profile e ekhon ei account login ache
        try:
            self.on_accounts_changed()
        except Exception:
            pass

    def _take_account(self, skip):
        a = self._hint_account(skip) or self.peek_account(skip)
        if not a:
            raise RuntimeError("Accounts section e aro account add koro (Tab 1 > Accounts) \u2014 ekhon kono unused mail nei.")
        return a

    def _wipe_session(self, page):
        self.clear_speechify_cookies()
        try:
            cdp = self.ctx.new_cdp_session(page)
            cdp.send("Storage.clearDataForOrigin", {"origin": VOICE_ORIGIN, "storageTypes": "all"})
        except Exception:
            pass

    def _login(self, page, email, pw):
        self._wipe_session(page)
        page.goto(VOICE_SIGN_IN, timeout=90000)
        self._wipe_session(page)
        page.goto(VOICE_SIGN_IN, timeout=90000)
        page.get_by_placeholder("Email address").fill(email, timeout=30000)
        page.get_by_placeholder("Password").fill(pw)
        page.get_by_role("button", name="Continue", exact=True).click()
        page.get_by_text("Build Something").wait_for(timeout=60000)
        self.dismiss_onboarding(page)

    def _login_next(self, page):
        """Notun (unused) account diye login. Account na thakle clear error."""
        skipped, last = set(), ""
        tries = max(3, int(self.cfg.get("max_account_tries", 3) or 3))
        for _ in range(tries):
            self.check_stop()
            email, pw, line = self._take_account(skipped)
            self.log(f"Speechify login -> {email}")
            try:
                self._login(page, email, pw)
            except VoiceStopped:
                self.release_account(line)
                raise
            except Exception as e:
                last = (str(e).splitlines() or [type(e).__name__])[0][:160]
                self.log(f"  login fail ({email}): {last}")
                self.debug(page, "t2login")
                skipped.add(line)
                self.release_account(line)
                continue
            self.account = line
            self._claim_account(line)           # Accounts section theke remove (Tab 1 er moto)
            self.on_account(line)
            self.log("  login hoyeche — account Accounts theke soriye nilam, credit shesh na howa porjonto Tab 2 e reuse hobe")
            return
        raise RuntimeError("Speechify login hochhe na: " + last)

    def _drop_account(self):
        """Credit shesh account ke Tab 1 Accounts section theke REMOVE (accounts.txt -> used list)."""
        line, self.account = self.account, None
        if not line:
            return
        self.hint = ""
        _t2_sess_set(self.profile, None)
        try:
            self.mark_blocked(line)                 # permanent block (abar login hobe na); list e ar nai tai notun account lagbe
        except Exception as e:
            self.log(f"  account remove e problem: {str(e).splitlines()[0][:120]}")
        self.release_account(line)
        self.on_account("")
        self.on_accounts_changed()
        self.log(f"  {self._split(line)[0]} er credit shesh \u2014 BLOCK korlam (ar kokhono use hobe na), notun account e jachhi")

    def _switch_account(self, page):
        self._drop_account()
        self._wipe_session(page)            # cookies clear / logout
        self._login_next(page)

    def _swap_state(self, page, secs=30):
        """'in' = login kora (Voice Swap page), 'out' = sign-in page."""
        t0 = time.time()
        while time.time() - t0 < secs:
            self.check_stop()
            u = (page.url or "").lower()
            if "sign-in" in u or "sign-up" in u or "/login" in u:
                return "out"
            try:
                if page.get_by_placeholder("Email address").first.is_visible():
                    return "out"
            except Exception:
                pass
            try:
                if page.get_by_text(re.compile(r"Upload File|Now Select a Voice|Generate New Voice|Voice Swapping",
                                               re.I)).first.is_visible():
                    return "in"
            except Exception:
                pass
            self.dismiss_onboarding(page)
            self.sleep(1000, page)
        return "out"

    def _open_swap(self, page):
        page.goto(self.SWAP_URL, wait_until="domcontentloaded", timeout=90000)

    def _ensure_login(self, page):
        if self._swap_state(page, 30) == "in":
            if self.account:
                return
            h = (self.hint or "").strip()
            if h and _t2_sess_get(self.profile) == h and \
                    h.split(":", 1)[0].strip().lower() not in self._blocked_emails():
                self.hint = ""                         # ei profile e age Tab 2 ei account diyei login korechilo -> abar login lagbe na
                self.account = h
                self.on_account(h)
                self.log("Age-r account e-i login ache — abar login na kore sorasori upload")
                return
            a = self._hint_account(set())             # kon account e login ache ta jani na -> hint account e fresh login
            if not a:
                # account chena jachhe na -> credit shesh hole remove korte parbo na; tai list theke notun account e login
                self.log("Kon account e login ache chena jachhe na — list er account diye abar login korchhi")
                self._login_next(page)
                self._open_swap(page)
                return
            try:
                self.log(f"Speechify login (account chena jabe) -> {a[0]}")
                self._login(page, a[0], a[1])
                self._open_swap(page)
                if self._swap_state(page, 30) == "in":
                    self.account = a[2]
                    self._claim_account(a[2])
                    self.on_account(a[2])
                    return
            except VoiceStopped:
                self.release_account(a[2])
                raise
            except Exception as ex:
                self.log(f"  login fail: {(str(ex).splitlines() or [''])[0][:120]}")
            self.release_account(a[2])
        if self.account:                                    # session expire -> same account e abar login
            e, p = self._split(self.account)
            try:
                self.log(f"Speechify re-login -> {e}")
                self._login(page, e, p)
                self._open_swap(page)
                if self._swap_state(page, 30) == "in":
                    return
            except VoiceStopped:
                raise
            except Exception as ex:
                self.log(f"  re-login fail: {(str(ex).splitlines() or [''])[0][:120]}")
            self.release_account(self.account)
            self.account = None
        self._login_next(page)
        self._open_swap(page)
        if self._swap_state(page, 30) != "in":
            raise RuntimeError("Login-er por Voice Swap page khulchhe na")

    # ───────── one chunk ─────────
    def _pick_voice(self, page, name):
        short = re.sub(r"\s*\(.*?\)\s*", " ", name).strip() or name
        box = self._wait_for(page, lambda: page.get_by_placeholder("Search Voices"), 30,
                             "Voice Library 'Search Voices' box")
        use_rx = re.compile(r"^\s*Use Voice\s*$", re.I)
        queries = [name] + ([short] if short.lower() != name.lower() else [])
        for q in queries:
            self.check_stop()
            box.fill(q)
            self.sleep(2500, page)
            use = page.get_by_role("button", name=use_rx)
            try:
                use.first.wait_for(timeout=8000)
            except Exception:
                continue
            btn = None
            for c in dict.fromkeys([name, short]):                  # exact match (naam / naam (M))
                rx = re.compile(rf"^\s*{re.escape(c)}(\s*\([A-Za-z]\))?\s*$", re.I)
                try:
                    t = page.get_by_text(rx).first
                    if t.is_visible():
                        row = t.locator("xpath=ancestor::div[.//button[normalize-space(.)='Use Voice']][1]")
                        b = row.locator("button", has_text="Use Voice").first
                        if b.is_visible():
                            btn = b
                            break
                except Exception:
                    continue
            if btn is None:
                btn = use.first                                     # exact na pele prothom result
                self.log(f"  voice '{name}' exact match nei \u2014 prothom result nilam")
            btn.click(timeout=10000)
            try:
                box.wait_for(state="hidden", timeout=15000)
            except Exception:
                pass
            return
        raise RuntimeError(f"Voice '{name}' Voice Library te paoa jayni")

    def _wait_generated(self, page, secs=600):
        """'Adjusting Voice...' poll -> 'Generated Sample' + Download button. Timeout ~10 min."""
        t0 = time.time()
        gone = None
        bad = re.compile(r"something went wrong|generation failed|failed to generate|error occurred", re.I)
        dl_rx = re.compile(r"^\s*Download\s*$", re.I)
        while time.time() - t0 < secs:
            self.check_stop()
            if self._limit_shown(page):
                raise CreditLimit()
            try:
                if page.get_by_text(re.compile(r"Generated Sample", re.I)).first.is_visible():
                    dl = self._btn(page, dl_rx).first
                    if dl.is_visible():
                        return dl
                adj = page.get_by_text(re.compile(r"Adjusting Voice", re.I)).first.is_visible()
                if adj:
                    gone = None
                else:
                    gone = gone or time.time()
                    if page.get_by_text(bad).first.is_visible():
                        raise RuntimeError("Speechify error dekhalo")
                    if time.time() - gone > 90:
                        raise RuntimeError("Adjusting shesh kintu generated sample dekhachhe na")
            except RuntimeError:
                raise
            except Exception:
                pass
            self.sleep(2000, page)
        raise RuntimeError("Voice swap timeout (10 min)")

    # ───────── 'Accent' toggle: download-er age OFF kore dewa ─────────
    @staticmethod
    def _switch_on(el):
        """True = ON, False = OFF, None = bujhte parlam na."""
        try:
            v = (el.get_attribute("aria-checked") or "").lower()
            if v in ("true", "false"):
                return v == "true"
            v = (el.get_attribute("data-state") or "").lower()
            if v in ("checked", "unchecked", "on", "off"):
                return v in ("checked", "on")
            v = el.evaluate("e => (e.type === 'checkbox') ? e.checked : null")
            if v is not None:
                return bool(v)
            rgb = el.evaluate("e => getComputedStyle(e).backgroundColor") or ""     # fallback: dark track = ON
            m = re.findall(r"[\d.]+", rgb)
            if len(m) >= 3 and (len(m) < 4 or float(m[3]) > 0.05):
                r, g, b = (float(x) for x in m[:3])
                return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255.0 < 0.5
        except Exception:
            pass
        return None

    def _accent_switch(self, page):
        """'Accent' label er pashe thaka toggle element (na thakle None)."""
        lbl = page.get_by_text(re.compile(r"^\s*Accent\s*$", re.I)).first
        if not lbl.is_visible():
            return None
        cands = [
            lbl.locator("xpath=ancestor::*[.//*[@role='switch' or @role='checkbox' or @type='checkbox']][1]")
               .locator("[role='switch'], [role='checkbox'], input[type='checkbox']").first,
            lbl.locator("xpath=preceding-sibling::*[1]"),
            lbl.locator("xpath=../*[1]"),
            lbl.locator("xpath=following-sibling::*[1]"),
        ]
        for c in cands:
            try:
                if c.count() and self._switch_on(c) is not None:
                    return c
            except Exception:
                continue
        return None

    def _accent_off(self, page, dl):
        """Generated Sample ready hole 'Accent' toggle ON thakle OFF kore; sample abar generate hole wait kore.
        Fresh Download button return kore. Kono problem hole (toggle na pele ba fail) ager moto cholbe."""
        dl_rx = re.compile(r"^\s*Download\s*$", re.I)
        try:
            sw = self._accent_switch(page)
            if sw is None:
                self.log("  Accent toggle pailam na — jemon ache temon-i download")
                return dl
            if self._switch_on(sw) is False:
                self.log("  Accent already OFF")
                return dl
            self.log("  Accent ON chhilo — OFF korchhi")
            try:
                sw.click(timeout=4000)
            except Exception:
                sw.evaluate("e => e.click()")
            page.wait_for_timeout(1200)
            if self._switch_on(sw) is True:                         # click kaj kore ni? abar ekbar
                try:
                    sw.click(timeout=4000, force=True)
                except Exception:
                    sw.evaluate("e => e.click()")
                page.wait_for_timeout(1200)
            self.log("  Accent OFF ✓" if self._switch_on(sw) is False else "  Accent OFF confirm hoyni (state bujhlam na)")
            self.sleep(1500, page)
            try:
                regen = page.get_by_text(re.compile(r"Adjusting Voice", re.I)).first.is_visible()
            except Exception:
                regen = False
            if regen:                                               # toggle bodlale sample notun kore generate hoy
                self.log("  Accent bodlalo — sample abar generate hochhe, wait…")
                return self._wait_generated(page)
            return self._btn(page, dl_rx).first
        except (VoiceStopped, CreditLimit):
            raise
        except Exception as ex:
            self.log(f"  Accent off fail ({(str(ex).splitlines() or [''])[0][:100]}) — jemon ache temon-i download")
            return self._btn(page, dl_rx).first

    def swap_chunk(self, page, chunk, name, out_base):
        self._open_swap(page)
        self._ensure_login(page)
        if self._limit_shown(page):
            raise CreditLimit()
        up_rx = re.compile(r"Upload File", re.I)
        try:                                                        # age-r state thakle Restart
            if not self._btn(page, up_rx).first.is_visible():
                rs = page.get_by_text("Restart", exact=True).first
                if rs.is_visible():
                    rs.click(timeout=3000)
                    page.wait_for_timeout(800)
        except Exception:
            pass
        up = self._wait_for(page, lambda: self._btn(page, up_rx), 45, "'Upload File' button")
        with page.expect_file_chooser(timeout=30000) as fc:
            up.click()
        fc.value.set_files(chunk)
        self.log("  chunk upload hochhe\u2026")
        sel = self._wait_for(page, lambda: self._btn(page, re.compile(r"Now Select a Voice", re.I)), 180,
                             "'Now Select a Voice' button")
        sel.click()
        self._pick_voice(page, name)
        gen = self._wait_for(page, lambda: self._btn(page, re.compile(r"Generate New Voice", re.I)), 60,
                             "'Generate New Voice' button")
        gen.click()
        self.log("  'Adjusting Voice\u2026' \u2014 generate cholche")
        dl = self._wait_generated(page)
        dl = self._accent_off(page, dl)
        with page.expect_download(timeout=120000) as di:
            dl.click()
        d = di.value
        ext = os.path.splitext(d.suggested_filename or "")[1].lower()
        if ext not in AUDIO_EXTS:
            ext = ".mp3"
        out = out_base + ext
        d.save_as(out)
        if not os.path.isfile(out) or os.path.getsize(out) < 1000:
            raise RuntimeError("Download kora file thik na")
        return out

    # ───────── main loop ─────────
    def run(self, chunks, name, work):
        """Shob chunk swap kore swapped file path list (chunk order e) return kore. Shesh e Chrome bondho."""
        from playwright.sync_api import sync_playwright
        outs = []
        with sync_playwright() as pw:
            self.launch(pw)
            try:
                page = self.new_page()
                self._open_swap(page)
                self._ensure_login(page)
                for i, ch in enumerate(chunks, 1):
                    self.check_stop()
                    base = os.path.join(work, f"swapped_part{i:02d}")
                    for e in AUDIO_EXTS:
                        try:
                            os.remove(base + e)
                        except OSError:
                            pass
                    self.log(f"Chunk {i}/{len(chunks)} swap hochhe: {os.path.basename(ch)}")
                    fails = switches = 0
                    while True:
                        self.check_stop()
                        try:
                            outs.append(self.swap_chunk(page, ch, name, base))
                            self.log(f"  chunk {i}/{len(chunks)} \u2713")
                            break
                        except CreditLimit:
                            switches += 1
                            if switches > 25:
                                raise RuntimeError("Onek account e credit limit \u2014 bondho korlam")
                            self.log("  Credit limit popup \u2014 account badlachhi, ei chunk abar upload hobe")
                            self._switch_account(page)
                        except VoiceStopped:
                            raise
                        except Exception as e:
                            if "Accounts section e aro account" in str(e):
                                raise
                            try:
                                _lim = (not page.is_closed()) and self._limit_shown(page)
                            except Exception:
                                _lim = False
                            if _lim:
                                switches += 1
                                if switches > 25:
                                    raise RuntimeError("Onek account e credit limit \u2014 bondho korlam")
                                self.log("  Credit limit popup (error er por) \u2014 account badlachhi")
                                self._switch_account(page)
                                continue
                            fails += 1
                            msg = (str(e).splitlines() or [type(e).__name__])[0][:200]
                            self.log(f"  chunk {i} fail ({fails}/3): {msg}")
                            self.debug(page, f"t2chunk{i}")
                            if fails >= 3:
                                raise RuntimeError(f"Chunk {i} swap fail: {msg}")
                            try:
                                if page.is_closed():
                                    page = self.new_page()
                            except Exception:
                                page = self.new_page()
            finally:
                try:
                    self.ctx.close()
                except Exception:
                    pass
                voice_trim_profile(self.profile)
                if self.account:
                    self.release_account(self.account)
        return outs


if __name__ == "__main__":
    _sess = gate()
    if _sess is not None:
        App(_sess).mainloop()
