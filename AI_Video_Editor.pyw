        self._sub_key = None
        self._tpl_mark()
        self._lk_apply_all()
        self._tr_mark()
        self._tr_update_lbl()
        self._lk_mark_labels()
        self._lk_refresh()
        self._changed()

    def activate(self):
        if self.app.proj != self._proj:
            self.load()
        self._cues_ok = False
        self.after(60, lambda: (self._draw(), self._pv_configure(), self._seek_still(self.cur_t), self._sub_redraw()))

    def deactivate(self):
        self._pause()
        self.save()

    def shutdown(self):
        self._pause()
        self.save()
        try:
            d = tempfile.gettempdir()
            for fn in os.listdir(d):
                if fn.startswith(f"ave_t2_{os.getpid()}_"):
                    self._rm(os.path.join(d, fn))
        except Exception:
            pass



