    # ───────── light leak trim (per template) ─────────
    @staticmethod
    def _lk_path(name):
        for n, x, _m in T2_TRANSITIONS:
            if n == name and isinstance(x, str) and x.startswith("LK:"):
                return x[3:]
        return None

    def _lk_edit(self, key):
        """✂ button on a leak tile: select that template, then the Light Leak Trim card edits it."""
        if key != self.trans_key:
            self._tr_select(key)
        else:
            self._lk_refresh()

    def _lk_apply_all(self):
        """lk_trim (by name) -> _LK_TRIM (by path) used by the ffmpeg filter."""
        for n, x, _m in T2_TRANSITIONS:
            if isinstance(x, str) and x.startswith("LK:"):
                t = self.lk_trim.get(n)
                if t:
                    _LK_TRIM[x[3:]] = (float(t[0]), float(t[1]))
                else:
                    _LK_TRIM.pop(x[3:], None)

    def _lk_refresh(self):
        try:
            self._lk_stop()
            p = self._lk_path(self.trans_key) if self.trans_key else None
            if not p:
                self.lk_name_lbl.configure(text="Ekta light leak template select koro (tile e click ba \u2702 Trim)")
                self.lk_bar.set_state(dur=0.0, t0=0.0, t1=0.0, cur=0.0)
                self.lk_time_lbl.configure(text="")
                self.lk_pv.delete("all")
                self._lk_img = None
                return
            od = _lk_len(p)
            t = self.lk_trim.get(self.trans_key)
            t0, t1 = (float(t[0]), float(t[1])) if t else (0.0, od)
            t0, t1 = max(0.0, min(t0, od - 0.2)), max(0.2, min(t1, od))
            self.lk_name_lbl.configure(text="Trim: " + self.trans_key)
            self.lk_bar.set_state(dur=od, t0=t0, t1=t1, cur=(t0 + t1) / 2.0)
            self._lk_label(t0, t1, od)
            self._lk_on_seek((t0 + t1) / 2.0)
        except (AttributeError, tk.TclError):
            pass

    def _lk_label(self, t0, t1, od):
        try:
            self.lk_time_lbl.configure(text=f"Start {t0:.2f}s   End {t1:.2f}s   \u2192  length {t1 - t0:.2f}s  (original {od:.2f}s)")
        except (AttributeError, tk.TclError):
            pass

    def _lk_on_seek(self, t):
        """Shows the leak frame at time t (debounced; ffmpeg runs in a thread)."""
        p = self._lk_path(self.trans_key) if self.trans_key else None
        if not p:
            return
        self._lk_stop()
        self._lk_seq += 1
        seq = self._lk_seq
        if self._lk_job:
            try:
                self.after_cancel(self._lk_job)
            except (ValueError, tk.TclError):
                pass
        self._lk_job = self.after(90, lambda: threading.Thread(target=self._lk_frame_worker, args=(seq, p, t),
                                                              daemon=True).start())

    def _lk_frame_worker(self, seq, p, t):
        W, H = 240, 135
        try:
            add_ffmpeg_path()
            vf = f"scale={W}:{H}:force_original_aspect_ratio=decrease,pad={W}:{H}:(ow-iw)/2:(oh-ih)/2:black"
            cmd = ["ffmpeg", "-v", "error", "-ss", f"{max(0.0, t):.3f}", "-i", p, "-frames:v", "1", "-vf", vf,
                   "-f", "rawvideo", "-pix_fmt", "rgb24", "-"]
            r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, creationflags=NOWIN, timeout=20)
            if len(r.stdout) == W * H * 3:
                self._q.put(("lkframe", seq, b"P6 %d %d 255\n" % (W, H) + r.stdout))
        except Exception:
            pass

    def _lk_frame_ready(self, seq, data):
        if seq != self._lk_seq:
            return
        try:
            self._lk_img = tk.PhotoImage(data=data, format="PPM")
            self.lk_pv.delete("all")
            self.lk_pv.create_image(121, 68, image=self._lk_img)
        except tk.TclError:
            pass

    def _lk_stop(self):
        self._lk_playing = False
        if self._lk_play_job:
            try:
                self.after_cancel(self._lk_play_job)
            except (ValueError, tk.TclError):
                pass
            self._lk_play_job = None
        try:
            self.lk_play_btn.configure(text="\u25b6  Play")
        except (AttributeError, tk.TclError):
            pass

    def _lk_play(self):
        """Plays the trimmed leak in the small preview, stretched over the real transition length."""
        if self._lk_playing:
            self._lk_stop()
            return
        p = self._lk_path(self.trans_key) if self.trans_key else None
        if not p:
            self.app.note("Age ekta light leak template select koro.", WARN)
            return
        t0, t1, _tr = _lk_trim_of(p)
        cur = self._tr_cur()
        D = max(0.3, self._tr_dur(cur[1])) if cur else max(0.3, t1 - t0)
        self._lk_seq += 1
        seq = self._lk_seq
        self._lk_playing = True
        try:
            self.lk_play_btn.configure(text="\u25a0  Stop")
        except (AttributeError, tk.TclError):
            pass
        threading.Thread(target=self._lk_play_worker, args=(seq, p, t0, t1, D), daemon=True).start()

    def _lk_play_worker(self, seq, p, t0, t1, D):
        W, H, F = 240, 135, 20
        try:
            add_ffmpeg_path()
            vf = (f"trim=start={t0:.3f}:end={t1:.3f},setpts=PTS-STARTPTS,setpts=PTS*{D / max(0.1, t1 - t0):.5f},fps={F},"
                  f"scale={W}:{H}:force_original_aspect_ratio=decrease,pad={W}:{H}:(ow-iw)/2:(oh-ih)/2:black")
            cmd = ["ffmpeg", "-v", "error", "-i", p, "-an", "-vf", vf, "-f", "rawvideo", "-pix_fmt", "rgb24", "-"]
            r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, creationflags=NOWIN, timeout=60)
            size = W * H * 3
            n = len(r.stdout) // size
            hdr = b"P6 %d %d 255\n" % (W, H)
            frames = [hdr + r.stdout[i * size:(i + 1) * size] for i in range(n)]
            self._q.put(("lkplay", seq, frames, F, t0, t1))
        except Exception:
            self._q.put(("lkplay", seq, [], F, t0, t1))

    def _lk_play_ready(self, seq, frames, fps, t0, t1):
        if seq != self._lk_seq or not self._lk_playing:
            return
        if not frames:
            self._lk_stop()
            return
        try:
            imgs = [tk.PhotoImage(data=f, format="PPM") for f in frames]
        except tk.TclError:
            self._lk_stop()
            return
        self._lk_play_step(seq, imgs, 0, fps, t0, t1)

    def _lk_play_step(self, seq, imgs, i, fps, t0, t1):
        if seq != self._lk_seq or not self._lk_playing:
            return
        if i >= len(imgs):
            self._lk_stop()
            return
        try:
            self._lk_img = imgs[i]
            self.lk_pv.delete("all")
            self.lk_pv.create_image(121, 68, image=imgs[i])
            self.lk_bar.set_state(cur=t0 + (t1 - t0) * i / float(max(1, len(imgs) - 1)))
        except tk.TclError:
            self._lk_stop()
            return
        self._lk_play_job = self.after(int(1000 / fps), lambda: self._lk_play_step(seq, imgs, i + 1, fps, t0, t1))

    def _lk_on_trim(self, t0, t1, final):
        p = self._lk_path(self.trans_key) if self.trans_key else None
        if not p:
            return
        od = _lk_len(p)
        self._lk_label(t0, t1, od)
        if not final:
            return
        if t0 <= 0.01 and t1 >= od - 0.01:
            self.lk_trim.pop(self.trans_key, None)
        else:
            self.lk_trim[self.trans_key] = (round(t0, 3), round(t1, 3))
        self._lk_changed()

    def _lk_reset(self):
        if not self.trans_key or not self._lk_path(self.trans_key):
            return
        self.lk_trim.pop(self.trans_key, None)
        self._lk_changed()
        self._lk_refresh()

    def _lk_changed(self):
        """A trim changed: update filter store, labels, mini-preview tile, saved config and the player."""
        self._lk_apply_all()
        _lk_trims_save(self.lk_trim)
        self._tr_update_lbl()
        self._lk_mark_labels()
        self._cfg_dirty = True
        try:
            self._cfg_touch()
        except Exception:
            pass
        self._tile_rerender(self.trans_key)
        self._draw_soon()
        self._seek_refresh()

    def _lk_mark_labels(self):
        for key, t in self._tr_tiles.items():
            try:
                if t.get("lbl") is not None and self._lk_path(key):
                    t["lbl"].configure(text=t["label"] + ("  \u2702" if key in self.lk_trim else ""))
            except tk.TclError:
                pass

    def _tile_rerender(self, name):
        """Re-make the hover mini-preview of one template (after its trim changed)."""
        x = None
        for n, xx, _m in T2_TRANSITIONS:
            if n == name:
                x = xx
        if x is None:
            return

        def work():
            try:
                d = os.path.join(TOOLS, "_t2thumbs")
                pa, pb = os.path.join(d, "tile_a.ppm"), os.path.join(d, "tile_b.ppm")
                if not (os.path.isfile(pa) and os.path.isfile(pb)):
                    return
                TW, TH = self.TILE_W, self.TILE_H
                hdr = b"P6 %d %d 255\n" % (TW, TH)
                self._q.put(("tile", name, self._tile_render(pa, pb, x, TW, TH, hdr)))
            except Exception:
                pass
        threading.Thread(target=work, daemon=True).start()

    # ───────── transition position (age / pore) ─────────
    def _tr_off(self):
        try:
            v = float(self.toff.get())
        except (tk.TclError, ValueError):
            v = 0.0
        return max(-2.0, min(2.0, round(v, 3)))

    def _toff_set(self, sec):
        self.toff.set(max(-2.0, min(2.0, round(float(sec), 3))))

    def _toff_from_entry(self):
        t = (self.toff_ms.get() or "").strip().lower().replace(",", ".").replace("\u2212", "-")
        try:
            if t.endswith("ms"):
                ms = float(t[:-2])
            elif t.endswith("s"):
                ms = float(t[:-1]) * 1000.0
            else:
                ms = float(t or 0)
        except ValueError:
            self._toff_upd()
            return
        self._toff_set(ms / 1000.0)
        self._toff_upd()

    def _toff_upd(self):
        try:
            ms = int(round(self._tr_off() * 1000))
            if self.focus_get() is not self.toff_entry:
                self.toff_ms.set(str(ms))
            if ms == 0:
                txt = "0 ms \u2014 normally jemon 2 ta clip er majhe boshe, temon."
            elif ms < 0:
                txt = f"{-ms} ms AGE (aage) boshbe."
            else:
                txt = f"{ms} ms PORE boshbe."
            self.toff_lbl.configure(text=txt)
        except (AttributeError, tk.TclError):
            pass

    def _tr_cur(self):
        for n, x, m in T2_TRANSITIONS:
            if n == self.trans_key:
                if isinstance(x, str) and x.startswith("LK:"):
                    return None                      # light leak = overlay line (timeline), never a transition
                return x, m
        return None

    def _tr_dur(self, mul=1.0):
        try:
            sp = max(0.0, min(20.0, float(self.tspd.get())))
        except (tk.TclError, ValueError):
            sp = 10.0
        return max(0.15, (1.2 - 0.05 * sp) * mul)

    def _tr_update_lbl(self):
        try:
            cur = self._tr_cur()
            self.tr_lbl.configure(text=("Ekhon: " + self.trans_key) if cur else (
                ("Ekhon: " + self.trans_key + " \u2014 overlay (transition nei)") if self.trans_key else "Ekhon: None (transition nei)"))
            mul = cur[1] if cur else 1.0
            self.tr_dur_lbl.configure(text=f"Duration ≈ {self._tr_dur(mul):.2f}s  (speed baralei chhoto hoy)")
        except (AttributeError, tk.TclError):
            pass

    def _tr_mark(self):
        for key, t in self._tr_tiles.items():
            try:
                t["cv"].configure(highlightbackground=ACCENT if key == self.trans_key else PANEL2)
            except tk.TclError:
                pass

    def _tr_select(self, key):
        if key == self.trans_key:
            return
        self._edit_begin()
        self.trans_key = key
        self._tr_mark()
        self._tr_update_lbl()
        self._lk_refresh()
        self.app.note((f"{key} \u2014 light leak: prottek 2 clip er majhe overlay line e boshbe ✓" if self._lk_path(key)
                       else f"Transition: {key} — sob clip er majhe boshbe ✓") if key else "Transition bondho kora hoyeche")
        self._cfg_dirty = True
        self._changed()

    def _seek_refresh(self):
        if not self._playing:
            self._seek_still(self.cur_t)

    def _play_join(self):
        if not self._tr_cur():
            self.app.note("Age ekta transition template select koro.", WARN)
            return
        cand = [i for i in range(1, len(self.slots)) if self.slots[i]["path"] and self.slots[i - 1]["path"]]
        if not cand:
            self.app.note("Transition er jonno kompokkhe 2 ta pashapashi clip lagbe.", WARN)
            return
        i = self.sel if self.sel in cand else cand[0]
        self._layout()
        self._pause()
        self._set_time(max(0.0, self._geo[i][2] - 1.2 - max(0.0, -self._tr_off())))
        self._play()

    # hover mini-preview (frames made once by ffmpeg xfade on two synthetic pictures)
    @staticmethod
    def _tile_sources(w, h):
        a, b = bytearray(), bytearray()
        cx, cy, r = w / 2.0, h / 2.0, h * 0.28
        for y in range(h):
            for x in range(w):
                t = x / float(w) * 0.6 + y / float(h) * 0.4
                px = (int(25 + 30 * t), int(70 + 120 * t), int(220 - 40 * t))
                if (x - cx) ** 2 + (y - cy) ** 2 < r * r:
                    px = (255, 255, 255)
                a += bytes(px)
                t2 = x / float(w) * 0.4 + y / float(h) * 0.6
                qx = (int(250 - 20 * t2), int(140 - 90 * t2), int(30 + 170 * t2))
                if abs(x - cx) < r and abs(y - cy) < r:
                    qx = (255, 255, 255) if (abs(x - cx) > r - 4 or abs(y - cy) > r - 4) else (25, 25, 45)
                b += bytes(qx)
        return bytes(a), bytes(b)

    def _tile_start(self):
        if self._tile_started:
            return
        self._tile_started = True
        threading.Thread(target=self._tile_worker, daemon=True).start()

    def _tile_worker(self):
        TW, TH = self.TILE_W, self.TILE_H
        hdr = b"P6 %d %d 255\n" % (TW, TH)
        try:
            add_ffmpeg_path()
            d = os.path.join(TOOLS, "_t2thumbs")
            os.makedirs(d, exist_ok=True)
            pa, pb = os.path.join(d, "tile_a.ppm"), os.path.join(d, "tile_b.ppm")
            a, b = self._tile_sources(TW, TH)
            for p, data in ((pa, a), (pb, b)):
                with open(p, "wb") as fh:
                    fh.write(hdr + data)
            self._q.put(("tile", "", [hdr + a]))
        except Exception:
            return
        for name, x, _m in T2_TRANSITIONS:
            self._q.put(("tile", name, self._tile_render(pa, pb, x, TW, TH, hdr)))

    @staticmethod
    def _tile_render(pa, pb, x, TW, TH, hdr, fps=12, dur=1.0, pre=0.3, post=0.3):
        la, lb = dur + pre, dur + post
        fc = (f"[0:v]format=yuv420p[a];[1:v]format=yuv420p[b];"
              f"[a][b]{t2_xf(x, dur, pre, TW, TH, fps)},format=rgb24[o]")
        cmd = ["ffmpeg", "-v", "error", "-loop", "1", "-framerate", str(fps), "-t", f"{la:.3f}", "-i", pa,
               "-loop", "1", "-framerate", str(fps), "-t", f"{lb:.3f}", "-i", pb,
               "-filter_complex", fc, "-map", "[o]", "-f", "rawvideo", "-pix_fmt", "rgb24", "-"]
        try:
            r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, creationflags=NOWIN, timeout=40)
        except FileNotFoundError:
            return "noff"
        except Exception:
            return None
        size = TW * TH * 3
        n = len(r.stdout) // size
        if n < 3:
            return None
        return [hdr + r.stdout[i * size:(i + 1) * size] for i in range(n)]

    def _tile_ready(self, key, frames):
        t = self._tr_tiles.get(key)
        if t is None:
            return
        if frames == "noff":
            self._q.put(("noff",))
            frames = None
        if not frames:
            if key != "":
                try:
                    t["cv"].itemconfigure("ph", text="n/a")
                except tk.TclError:
                    pass
            return
        self._tile_raw[key] = frames
        t["imgs"] = None
        try:
            t["static"] = tk.PhotoImage(data=frames[0 if key == "" else len(frames) // 2], format="PPM")
            t["cv"].delete("ph")
            t["cv"].itemconfigure(t["item"], image=t["static"])
            if t["hover"]:
                self._tile_anim(key, 0)
        except tk.TclError:
            pass

    def _tile_hover(self, key, on):
        t = self._tr_tiles.get(key)
        if t is None or key == "":
            return
        t["hover"] = on
        if t["job"]:
            try:
                self.after_cancel(t["job"])
            except (ValueError, tk.TclError):
                pass
            t["job"] = None
        if on:
            if key in self._tile_raw:
                self._tile_anim(key, 0)
        elif t["static"] is not None:
            t["cv"].itemconfigure(t["item"], image=t["static"])

    def _tile_anim(self, key, i):
        t = self._tr_tiles.get(key)
        raw = self._tile_raw.get(key)
        if t is None or not raw or not t["hover"]:
            return
        try:
            if t["imgs"] is None:
                t["imgs"] = [tk.PhotoImage(data=f, format="PPM") for f in raw]
            t["cv"].itemconfigure(t["item"], image=t["imgs"][i])
        except tk.TclError:
            return
        nxt = (i + 1) % len(raw)
        t["job"] = self.after(450 if nxt == 0 else 80, lambda: self._tile_anim(key, nxt))

