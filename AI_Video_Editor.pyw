    def _tpl_lbl_update(self):
        try:
            nm = self.subv["SUB_TEMPLATE"].get().strip()
            self._tpl_lbl.configure(text=(f"Ekhon: {nm}" if nm else "Kono template select kora nei \u2014 button e click kore dekho."))
        except Exception:
            pass

    def _tpl_values(self, tpl, use_font):
        _name, fonts, vals = tpl
        v = dict(self.SUB_TPL_BASE)
        v.update(vals)
        if use_font:
            import tkinter.font as tkfont
            have = {n.lower(): n for n in tkfont.families(self)}
            for fam, b in fonts:
                if fam.lower() in have:
                    v["SUB_FONT"], v["SUB_BOLD"] = have[fam.lower()], b
                    break
        return v

    def _apply_sub_template(self, tpl, use_font):
        for k, v in self._tpl_values(tpl, use_font).items():
            self.subv[k].set(v)
        self.subv["SUB_TEMPLATE"].set(tpl[0])

    def _tpl_draw_card(self, cv, tpl, use_font, my_text):
        CW, CH = self.TPL_CW, self.TPL_CH
        cv.delete("all")
        cv.create_rectangle(0, 0, CW, CH, fill="#262626", outline="")
        vals = self._tpl_values(tpl, use_font)
        cfg = {k: v.get().strip() for k, v in self.subv.items()}
        cfg.update(vals)
        text = self.SUB_TPL_SAMPLE
        if my_text and self._pv_samples:
            text = self._pv_samples[self._pv_idx % len(self._pv_samples)]
        words = text.split()
        try:
            n = int(float(cfg.get("SUB_WORDS", "0") or 0))
        except ValueError:
            n = 0
        if n > 0:
            words = words[:n]
        text = " ".join(words)
        if cfg.get("SUB_UPPER") == "1":
            text = text.upper()
        try:
            size = float(cfg.get("SUB_SIZE", "5.5"))
            wid = float(cfg.get("SUB_WIDTH", "80"))
        except ValueError:
            size, wid = 5.5, 80.0
        maxw = min(CW * 0.94, CW * wid / 100.0)

        def blend(hexcol, op, *_a):
            try:
                r1, g1, b1 = (int(hexcol[i:i + 2], 16) for i in (1, 3, 5))
            except Exception:
                return "#000000"
            a = op / 100.0
            return "#%02x%02x%02x" % (int(r1 * a + 0x26 * (1 - a)), int(g1 * a + 0x26 * (1 - a)),
                                      int(b1 * a + 0x26 * (1 - a)))
        try:
            self._sub_render(cv, text, cfg, 18.0 * size / 5.0 * CW / 172.0, CW / 2.0, CH / 2.0, maxw, blend,
                             family=cfg.get("SUB_FONT") or None)
        except tk.TclError:
            pass

    TPL_CW, TPL_CH = 148, 94

    def _toggle_sub_templates(self):
        """Dropdown: show / hide the template grid right under the button."""
        if self._tpl_open:
            self._tpl_panel.grid_remove()
            self._tpl_open = False
            self._tpl_btn.configure(text="\U0001f3a8   Subtitle Templates  \u25be")
            return
        if not self._tpl_built:
            self._tpl_build_panel()
        self._tpl_panel.grid(row=2, column=0, columnspan=2, sticky="we", pady=(2, 10))
        self._tpl_open = True
        self._tpl_btn.configure(text="\U0001f3a8   Subtitle Templates  \u25b4")
        self._tpl_redraw()
        self._tpl_mark()

    def _tpl_build_panel(self):
        self._tpl_built = True
        pn = tk.Frame(self._tpl_body, bg=PANEL)
        self._tpl_panel = pn
        self._tpl_use_font = tk.StringVar(value="0")
        self._tpl_my_text = tk.StringVar(value="0")
        self._tpl_status = mklabel(pn, "Card e click korlei apply hobe. Tomar current font thakbe.",
                                   9, MUTED, bg=PANEL, wraplength=330, justify="left")
        self._tpl_status.pack(anchor="w", pady=(6, 6))
        grid = tk.Frame(pn, bg=PANEL)
        grid.pack(anchor="w")
        for i, tpl in enumerate(self.SUB_TEMPLATES):
            cell = tk.Frame(grid, bg=PANEL)
            cell.grid(row=i // 2, column=i % 2, padx=(0, 8), pady=4)
            cvx = tk.Canvas(cell, width=self.TPL_CW, height=self.TPL_CH, bg="#262626", highlightthickness=2,
                            highlightbackground=PANEL2, highlightcolor=ACCENT, cursor="hand2", bd=0)
            cvx._no_theme = True
            cvx.pack()
            cvx.bind("<Button-1>", lambda e, t=tpl: self._tpl_pick(t))
            mklabel(cell, tpl[0], 9, MUTED, bg=PANEL).pack(pady=(2, 0))
            self._tpl_cards.append((cvx, tpl))
        self._tpl_use_font.trace_add("write", lambda *a: self._tpl_redraw())
        self._tpl_my_text.trace_add("write", lambda *a: self._tpl_redraw())
        self.subv["SUB_TEMPLATE"].trace_add("write", lambda *a: self._tpl_mark())

    def _tpl_redraw(self):
        for cvx, tpl in self._tpl_cards:
            self._tpl_draw_card(cvx, tpl, self._tpl_use_font.get() == "1", self._tpl_my_text.get() == "1")

    def _tpl_mark(self):
        if not self._tpl_built:
            return
        cur = self.subv["SUB_TEMPLATE"].get().strip()
        for cvx, tpl in self._tpl_cards:
            try:
                cvx.configure(highlightbackground=ACCENT if tpl[0] == cur else PANEL2)
            except tk.TclError:
                pass

    def _tpl_pick(self, tpl):
        self._apply_sub_template(tpl, self._tpl_use_font.get() == "1")
        self._tpl_mark()
        self._tpl_status.configure(text=f"\u2713 {tpl[0]} apply hoyeche", fg=OK)

    def _pv_press(self, e):
        self._pv_drag = True
        self._pv_move(e)

    def _pv_move(self, e):
        cw, ch = self._pv_size
        xp = max(0.0, min(100.0, e.x / float(cw) * 100))
        yp = max(0.0, min(100.0, e.y / float(ch) * 100))
        sx, sy = abs(xp - 50) < 1.8, abs(yp - 50) < 1.8
        if sx:
            xp = 50.0
        if sy:
            yp = 50.0
        self._pv_snap = (sx, sy)
        self.subv["SUB_X"].set(self._fmt_num(xp))
        self.subv["SUB_Y"].set(self._fmt_num(yp))

    def _pv_release(self, e):
        self._pv_drag = False
        self._pv_draw()

    def _pv_reset_pos(self, e=None):
        self._set_sub_pos(self.SUB_DEFAULTS["SUB_X"], self.SUB_DEFAULTS["SUB_Y"])

    def _pv_wheel(self, e):
        up = (getattr(e, "delta", 0) > 0) or getattr(e, "num", 0) == 4
        cur = self._fnum("SUB_SIZE", 5, 1, 30)
        self.subv["SUB_SIZE"].set(self._fmt_num(max(2.0, min(14.0, cur + (0.25 if up else -0.25)))))


