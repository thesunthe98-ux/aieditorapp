def anim_unwrap(text):
    """Claude er '{"language":"html","code":"..."}' wrapper ba ```html fence thakle bhitorer asol HTML ber kore.
    -> (text, bodle_gelo?)"""
    t = (text or "").lstrip("\ufeff \t\r\n")
    if t.startswith("{"):
        try:
            d = json.loads(t)
        except Exception:
            d = None
        if isinstance(d, dict):
            for k in ("code", "html", "content", "text"):
                v = d.get(k)
                if isinstance(v, str) and "<" in v and len(v.strip()) > 50:
                    return v, True
    m = re.match(r"^```[A-Za-z0-9_-]*[ \t]*\r?\n(.*?)\r?\n?```[ \t\r\n]*$", t, re.S)
    if m and "<" in m.group(1):
        return m.group(1), True
    return text, False


def anim_static_check(path):
    """Browser chhara shohoj check. Wrapper thakle file ta nijei thik kore dey. -> (ok, reason, note)"""
    try:
        raw = read_text(path)
    except Exception as e:
        return False, f"file pora jayni ({e})", ""
    note = ""
    fixed, changed = anim_unwrap(raw)
    if changed:
        try:
            atomic_write(path, fixed)
            note = "JSON/``` wrapper chhariye file thik kora holo"
        except Exception as e:
            return False, f"wrapper chharano gelo na ({e})", ""
        raw = fixed
    low = raw.lower()
    if len(raw.strip()) < 300:
        return False, "file khub chhoto / khali", note
    if not re.search(r"<!doctype html|<html|<body|<svg|<canvas|<script", low):
        return False, "ei file HTML-i na", note
    if low.count("<script") > low.count("</script"):
        return False, "code majhpothe kete geche (</script> nei)", note
    if "<html" in low and "</html>" not in low:
        return False, "code majhpothe kete geche (</html> nei)", note
    return True, "", note


def _anim_err_text(e):
    """Browser er pageerror theke 'TypeError: msg (line N)' toiri kore."""
    try:
        msg = (str(getattr(e, "message", "") or e).strip().splitlines() or ["error"])[0]
        name = getattr(e, "name", "") or ""
        if name and not msg.startswith(name):
            msg = f"{name}: {msg}"
        st = str(getattr(e, "stack", "") or "")
        for ln in st.splitlines()[1:4]:
            m = re.search(r":(\d+):\d+\)?\s*$", ln)
            if m:
                msg += f" (line {m.group(1)})"
                break
        return msg[:180]
    except Exception:
        return (str(e).strip().splitlines() or ["error"])[0][:150]


def anim_claude_reason(why):
    """Check er fail-er karon (ja app dhorte parse) Claude ke bojhanor jonno English e. Karon na jana thakle "" dey
    — tokhon shudhu Prompt section er Fix prompt-i jabe."""
    w = (why or "").strip()
    if w.startswith("JS error: "):
        msg, _, tail = w[len("JS error: "):].partition(" \u2014 ")
        t = f"Detected problem: the page throws a JavaScript error: {msg}. "
        if "majhpothe" in tail:
            t += "Because of this error the animation freezes partway through. "
        else:
            t += "Because of this error the animation never runs (the screen stays blank or frozen). "
        return t + "Find the cause of this error, fix it, and reply with the complete updated file."
    if w.startswith("page load hoyni"):
        return ("Detected problem: the page did not load properly in a browser. Make sure it is ONE complete, valid, "
                "self-contained HTML file, then reply with the complete updated file.")
    if "majhpothe kete geche" in w:
        return ("Detected problem: the HTML file is cut off / incomplete (a closing tag is missing). "
                "Reply with the complete file from <!DOCTYPE html> to </html>.")
    if "HTML-i na" in w or "khub chhoto" in w:
        return ("Detected problem: the output is not a complete HTML file. "
                "Reply with the complete, self-contained HTML file.")
    return ""


def _anim_differ(a, b):
    """Duto screenshot (PNG bytes) er majhe sotti poriborton ache kina."""
    if a == b:
        return False
    try:
        import io
        from PIL import Image, ImageChops
        ia = Image.open(io.BytesIO(a)).convert("L")
        ib = Image.open(io.BytesIO(b)).convert("L")
        hist = ImageChops.difference(ia, ib).histogram()
        changed = sum(hist[16:])
        return changed >= max(40, ia.size[0] * ia.size[1] * 0.0003)
    except Exception:
        return True


class AnimChecker:
    """Headless Chrome e HTML file khule dekhe: JS error ache kina + animation sotti nore kina.
    Screenshot gulo shudhu RAM e thake — disk e kichui save hoy na, tulona hoye gelei fele dey."""

    def __init__(self, pw):
        self.pw = pw
        self.br = None

    def _browser(self):
        if self.br is not None:
            try:
                if self.br.is_connected():
                    return self.br
            except Exception:
                pass
            self.br = None
        args = ["--autoplay-policy=no-user-gesture-required", "--mute-audio",
                "--disable-background-timer-throttling", "--disable-renderer-backgrounding",
                "--disable-backgrounding-occluded-windows", "--hide-scrollbars", "--no-first-run",
                "--window-position=-32000,-32000", "--window-size=1280,720"]   # check Chrome kokhono screen e ashbe na
        last = None
        for kw in ({"channel": "chrome"}, {}):
            try:
                self.br = self.pw.chromium.launch(headless=True, args=args, **kw)
                return self.br
            except Exception as e:
                last = e
        raise RuntimeError("headless Chrome khola jayni: " + (str(last).splitlines() or [""])[0][:100])

    def close(self):
        try:
            if self.br is not None:
                self.br.close()
        except Exception:
            pass
        self.br = None

    def check(self, path, stop=None):
        """-> (ok, reason).  ok = True (thik) / False (thik na) / None (check-i kora gelo na)."""
        ok, why, note = anim_static_check(path)
        if not ok:
            return False, why
        try:
            br = self._browser()
        except Exception as e:
            return None, str(e)[:120]
        import pathlib
        errs = []
        ctx = None

        def chk_stop():
            if stop is not None and stop.is_set():
                raise AnimStop()
        try:
            ctx = br.new_context(viewport={"width": 1280, "height": 720})
            page = ctx.new_page()
            page.on("pageerror", lambda e: errs.append(_anim_err_text(e)))

            def snap():
                chk_stop()
                return page.screenshot(type="png")

            def wait(ms):
                chk_stop()
                page.wait_for_timeout(ms)
            t0 = time.time()
            try:
                page.goto(pathlib.Path(os.path.abspath(path)).as_uri(), wait_until="domcontentloaded", timeout=20000)
            except Exception as e:
                return False, "page load hoyni: " + (str(e).splitlines() or [""])[0][:100]
            wait(300)
            f1 = snap(); wait(600)
            f2 = snap(); wait(700)
            f3 = snap(); wait(900)
            f4 = snap()
            moving = (_anim_differ(f1, f2) or _anim_differ(f2, f3) or _anim_differ(f3, f4)
                      or _anim_differ(f1, f4))
            how = ""
            if not moving:                   # kono animation click / key diye shuru hoy kina
                try:
                    page.mouse.move(640, 360)
                    page.mouse.click(640, 360)
                    page.keyboard.press("Space")
                except Exception:
                    pass
                wait(900)
                f5 = snap(); wait(700)
                f6 = snap()
                moving = _anim_differ(f4, f5) or _anim_differ(f5, f6)
                if moving:
                    how = "click/key dile animate hoy (auto-play na)"
            if not moving:
                if errs:
                    return False, "JS error: " + errs[0] + " — tai animation chole na"
                return False, "animation nore na (shob frame ek-i, frozen/blank)"
            while time.time() - t0 < ANIM_CHECK_SECS:      # loop er sheshe/majhe crash hoy kina dekhi
                wait(400)
            warn = ""
            if errs:
                x = snap(); wait(800)
                y = snap()
                if not _anim_differ(x, y):
                    return False, "JS error: " + errs[0] + " — animation majhpothe thambe geche"
                warn = "JS warning: " + errs[0]
            return True, "; ".join(z for z in (note, how, warn) if z)
        finally:
            if ctx is not None:
                try:
                    ctx.close()
                except Exception:
                    pass


class AnimHub:
    """Shob thread er shared state. Ekta 'task' = ekta prompt box (tar baki prompt gulo) = ekta chat."""

    def __init__(self, tasks, template, hidden, logq):
        from collections import deque
        self.jobs = deque(tasks)
        self.template, self.hidden, self.logq = template, hidden, logq
        self.stop = threading.Event()
        self.draining = threading.Event()     # soft stop: notun prompt nibe na, kintu cholte thaka prompt shesh korbe
        self.chk_sem = threading.Semaphore(3)  # ekshathe koyta animation check (headless Chrome)
        self.lock = threading.Lock()
        self.total = sum(len(t["items"]) for t in tasks)
        self.done = self.failed = self.skipped = 0
        self.threads = []
        self.launched = False
        self.statq = None
        self.limited = {}
        self._inflight = 0
        self.profs = []            # shob Chrome profile (pool) — thread er cheye beshi thakte pare
        self.claimed = set()       # ekhon kon profile kono thread e use hocche
        self.bad = set()           # login nei / window bondho — ei run e baad
        self.fix_prompt = ""       # animation thik na hole Claude ke ja pathabe (Prompt section er Fix prompt box)

    def pick_profile(self):
        """-> (profile | None, hopeless). Limit nei + kono thread e use hocche na + onno Chrome e khola nei emon profile."""
        now = time.time()
        with self.lock:
            usable = [p for p in self.profs if p["dir"] not in self.bad]
            if not usable:
                return None, True
            for p in usable:
                d = p["dir"]
                if d in self.claimed or anim_lim_until(d) > now:
                    continue
                if _voice_profile_in_use(d):
                    continue
                if anim_lim_until(d):                       # limit er somoy shesh — reset
                    anim_lim_set(d, win=0, until=0)
                self.claimed.add(d)
                return p, False
        return None, False

    def unclaim(self, prof, bad=False):
        with self.lock:
            self.claimed.discard(prof["dir"])
            if bad:
                self.bad.add(prof["dir"])

    def no_profile_msg(self):
        now = time.time()
        ups = [anim_lim_until(p["dir"]) for p in self.profs if p["dir"] not in self.bad]
        ups = [u for u in ups if u > now]
        if ups:
            return ("Shob free profile limit e / byasto — shobcheye age reset: "
                    + time.strftime("%I:%M %p", time.localtime(min(ups))) + " (tokhon oi profile nijei kaj dhorbe)")
        return "Free Chrome profile nei (onno Chrome e khola / byasto) — opekkha korchhi"

    def fix_text(self):
        return (self.fix_prompt or "").strip() or ANIM_FIX_DEFAULT

    def first_prompt(self):
        """Prompt section er prompt — prottek notun chat e age eta jay (box prompt pore)."""
        return (self.template or "").replace("{script}", "").strip()

    def set_status(self, job, st):
        q = self.statq
        if q is not None and "bid" in job:
            q.put((job["bid"], job["num"], st))

    def log(self, msg, lv="info"):
        self.logq.put((time.strftime("%H:%M:%S"), msg, lv))

    def has_work(self):
        if self.draining.is_set():
            return False
        with self.lock:
            return any(t["items"] for t in self.jobs)

    def next_task(self):
        """Prothom box jar prompt ekhono baki ase. Ekta box e ekadhik Chrome (thread) ekshathe kaj korte pare."""
        if self.draining.is_set():
            return None
        with self.lock:
            for t in self.jobs:
                if t["items"]:
                    self._inflight += 1
                    return t
            return None

    def claim_item(self, task):
        """Box er pore'r prompt ta ei Chrome er jonno nao (onno Chrome ta pabe na)."""
        if self.draining.is_set():
            return None
        with self.lock:
            return task["items"].pop(0) if task["items"] else None

    def give_back(self, task, job):
        """Prompt ta hoyni — box er shurute ferot dao, jate onno (ba ei) Chrome abar nite pare."""
        with self.lock:
            task["items"].insert(0, job)

    def inflight(self):
        return self._inflight

    def release(self, task, requeue):
        with self.lock:
            self._inflight -= 1

    def add_done(self):
        with self.lock:
            self.done += 1

    def add_failed(self):
        with self.lock:
            self.failed += 1


class AnimWorker:
    """Ekta Chrome profile = ekta thread. Claude (claude.ai/new) e prompt pathay, code ber kore save kore."""

    def __init__(self, idx, hub):
        """Ekta worker = ekta 'slot' (thread). Slot protibar ekta free profile (Chrome) nei; limit hole onno profile nei."""
        self.idx, self.hub = idx, hub
        self.prof = None
        self.tag = f"T{idx + 1}"
        self.pw = self.ctx = self.page = None
        self._nmsg = 0
        self._chk = None           # animation checker (headless Chrome), lazily toiri hoy

    def log(self, m, lv="info"):
        self.hub.log(f"[{self.tag}] {m}", lv)

    # ───── helpers ─────
    def _wait(self, ms):
        end = time.time() + ms / 1000.0
        while True:
            if self.hub.stop.is_set():
                raise AnimStop()
            left = end - time.time()
            if left <= 0:
                return
            if self.page is None:                 # Chrome bondho (limit opekkha / idle) — shudhu ghumao
                time.sleep(min(0.5, left))
                continue
            try:
                self.page.wait_for_timeout(int(min(500, left * 1000)))
            except Exception:
                if self.page.is_closed():
                    raise AnimClosed()
                time.sleep(min(0.5, left))

    def run(self):
        try:
            from playwright.sync_api import sync_playwright
            with sync_playwright() as pw:
                self.pw = pw
                try:
                    self._session()
                finally:
                    self._retire()
                    self._chk_close()
        except AnimStop:
            self.log("Stop hoyeche", "warn")
        except Exception as e:
            self.log(f"Chrome/Playwright error: {e}", "err")

    def _retire(self, bad=False):
        """Chrome bondho + profile ta pool e ferot (bad=true hole ei run e r use hobe na)."""
        self._close()
        if self.prof is not None:
            self.hub.unclaim(self.prof, bad)
            self.prof = None
            self.tag = f"T{self.idx + 1}"

    def _close(self):
        self._closing = True
        try:
            if self.ctx is not None:
                self.ctx.close()
        except Exception:
            pass
        self.ctx = self.page = None
        self._closing = False

    def _live_page(self):
        try:
            for pg in self.ctx.pages:
                if not pg.is_closed():
                    return pg
            return self.ctx.new_page()
        except Exception:
            return None

    def _launch(self):
        """Chrome khole. Khulei shathe shathe bondho hoye gele (first-run tab / crash) 3 bar porjonto abar chesta kore."""
        last = ""
        for k in range(3):
            try:
                self._launch_once()
                pg = self._live_page()
                if pg is not None:
                    self.page = pg
                    self._wait(1500)                  # ektu opekkha kore dekhi Chrome tike thake kina
                    pg = self._live_page()
                    if pg is not None:
                        self.page = pg
                        return
                last = "Chrome khulei shathe shathe bondho hoye gelo"
            except AnimStop:
                raise
            except Exception as e:
                last = (str(e).splitlines() or [type(e).__name__])[0][:100]
            self.log(f"  [debug] Chrome launch #{k + 1}/3 fail: {last} — abar chesta", "warn")
            self._close()
            time.sleep(2)
        raise AnimClosed()

    def _launch_once(self):
        os.makedirs(self.prof["dir"], exist_ok=True)
        _force_nvidia_for_chrome()
        args = ["--disable-blink-features=AutomationControlled"] + ANIM_GPU_ARGS
        if self.hub.hidden:
            args += ["--window-position=-32000,-32000", "--window-size=1366,900"]
        else:
            off = 28 * (self.idx % 10)
            args += [f"--window-position={off},{off}", "--window-size=1280,860"]
        self.ctx = self.pw.chromium.launch_persistent_context(
            self.prof["dir"], channel="chrome", headless=False, no_viewport=True,
            ignore_default_args=["--disable-extensions", "--enable-automation"], args=args)
        self.page = self.ctx.pages[0] if self.ctx.pages else self.ctx.new_page()
        # download capture: JEKONO tab/popup e download hole dhore rakhbe (page.expect_download er moto ekta page er upor nirbhor na)
        self._dls = []
        self._closing = False
        def _hook(pg):
            try:
                pg.on("download", lambda d: self._dls.append(d))
                pg.on("crash", lambda *_: self.log("  [debug] Chrome tab crash hoyeche (memory kom?)", "warn"))
                pg.on("close", lambda *_: (None if self._closing else
                                           self.log("  [debug] Chrome tab bondho hoyeche (app na — onno kono karone)", "warn")))
            except Exception:
                pass
        for _pg in list(self.ctx.pages):
            _hook(_pg)
        self.ctx.on("page", _hook)
        try:
            self.ctx.on("close", lambda *_: (None if self._closing else
                                             self.log("  [debug] Chrome window/process bondho hoyeche (app na)", "warn")))
        except Exception:
            pass
        try:   # blob capture: download event na ashle blob er content nije pore nibo
            self.ctx.add_init_script(
                "(()=>{if(window.__bh)return;window.__bh=1;window.__blobs=[];"
                "const o=URL.createObjectURL;URL.createObjectURL=function(b){"
                "try{if(b&&b.size>20)window.__blobs.push(b);}catch(e){}return o.apply(this,arguments);};})();")
            for _pg in list(self.ctx.pages):
                try:
                    _pg.reload()
                except Exception:
                    pass
        except Exception:
            pass
        self.log("Chrome khulechhe")

    # ───── limit / 5-ghonta window ─────
    def _mark_window(self):
        """Prothom message pathanor somoy theke 5 ghonta = ei account er window."""
        d, now = self.prof["dir"], time.time()
        st = anim_lim_get(d)
        if not st.get("win") or now - float(st["win"]) >= 5 * 3600:
            anim_lim_set(d, win=now, until=0)

    def _limit_texts(self):
        """Popup ('resets at 7:20 AM') ar textbox er upor er banner ('out of free messages until 7:20 AM') er text gulo."""
        res = []
        for rx in (r"(?:resets|returns)\s+at\s+\d", r"until\s+\d{1,2}:\d{2}\s*[AaPp]"):
            try:
                loc = self.page.get_by_text(re.compile(rx, re.I))
                for i in range(min(loc.count(), 4)):
                    try:
                        res.append(loc.nth(i).inner_text(timeout=2000))
                    except Exception:
                        pass
            except Exception:
                pass
        return res

    def _close_limit_popup(self):
        """'Upgrade to keep chatting' popup thakle cross (X) button e click kore bondho kore."""
        page = self.page

        def shown():
            try:
                return page.get_by_text(re.compile(r"Upgrade to keep chatting", re.I)).first.is_visible()
            except Exception:
                return False
        if not shown():
            return False
        tries = (
            lambda: page.locator('[role="dialog"] button[aria-label*="Close" i]').first.click(timeout=2000),
            lambda: page.get_by_role("button", name=re.compile(r"close", re.I)).first.click(timeout=2000),
            lambda: page.locator('[role="dialog"] button:has(svg)').first.click(timeout=2000),
            lambda: page.keyboard.press("Escape"),
            lambda: page.get_by_role("button", name=re.compile(r"not now", re.I)).first.click(timeout=2000),
        )
        for t in tries:
            try:
                t()
            except Exception:
                pass
            self._wait(700)
            if not shown():
                self.log("Limit popup bondho kora holo", "ok")
                return True
        return False

    def _dismiss_popups(self):
        """Onno kono popup/dialog (welcome, new feature, survey, cookie ...) thakle cross (X) button khuje bondho kore.
        Limit popup hole bondho kore na — oti AnimLimit handle kore. Kono popup bondho hole True."""
        page = self.page
        dlg = '[role="dialog"]:visible, [role="alertdialog"]:visible, [aria-modal="true"]:visible'
        closed = False
        for _ in range(3):
            try:
                d = page.locator(dlg).first
                if not d.is_visible():
                    break
                try:
                    if ANIM_LIMIT_STRICT_RE.search(d.inner_text(timeout=1500) or ""):
                        break
                except Exception:
                    pass
            except Exception:
                break
            tries = (
                lambda: d.locator('button[aria-label*="close" i], button[aria-label*="dismiss" i]').first.click(timeout=1500),
                lambda: d.get_by_role("button", name=re.compile(r"^(close|dismiss|not now|skip|maybe later|no thanks|got it|done|ok)$", re.I)).first.click(timeout=1500),
                lambda: d.locator("button:has(svg)").first.click(timeout=1500),
                lambda: page.keyboard.press("Escape"),
            )
            gone = False
            for t in tries:
                try:
                    t()
                except Exception:
                    continue
                self._wait(700)
                try:
                    if not d.is_visible():
                        gone = True
                        break
                except Exception:
                    gone = True
                    break
            if not gone:
                break
            closed = True
            self.log("Popup cross button e click kore bondho kora holo", "ok")
        return closed

    def _has_limit_output(self):
        """Limit popup er shathe-o Claude ei prompt er jonno HTML/artifact dilo kina."""
        try:
            if self._card_count() > getattr(self, "_say_cards0", 0):
                return True
        except Exception:
            pass
        try:
            if self._resp_count() > getattr(self, "_say_prev", 0):
                for c in self._codes():
                    low = c.lower()
                    if len(c) > 300 and any(k in low for k in ("<html", "<!doctype", "<svg", "<canvas", "<script")):
                        return True
        except Exception:
            pass
        return False

    def _limit_gate(self):
        """Prompt submit korar por limit popup ('Upgrade to keep chatting') dekhle Chrome sathe sathe bondho kora hobe na.
        1) age popup er cross (X) e click kore popup kete dewa  2) tarpor dekha: Claude HTML/artifact toiri korche kina
        - korle True (kaj cholbe, file download hobe)   - na korle AnimLimit raise (Chrome bondho hobe)."""
        if getattr(self, "_lim_ok", False):
            return True
        self.log("Limit popup eseche — age cross (X) e click kore bondho korchi, tarpor dekhbo HTML toiri hoyeche kina", "warn")
        try:
            self._lim_texts = self._limit_texts()          # reset somoy popup bondho howar age save
        except Exception:
            self._lim_texts = []
        self._close_limit_popup()
        end = time.time() + ANIM_LIMIT_RECHECK_SECS
        while True:
            if self._is_streaming() or self._has_limit_output():
                self._lim_ok = True
                self.log("Limit popup chilo kintu Claude HTML dicche/diyeche — kaj cholchhe, Chrome bondho hocche na", "ok")
                return True
            if time.time() >= end:
                break
            self._wait(1500)
            self._close_limit_popup()                       # popup abar ashle abar X
        self.log("Popup bondho kore dekhlam — HTML toiri hoyni, tai Chrome bondho hochhe", "warn")
        raise AnimLimit()

    def _calc_until(self):
        """Limit popup ashle: kokhon porjonto ei Chrome e kaj hobe na. Popup er 'resets at' time, na pele kaj shuru + 5 ghonta."""
        now, d = time.time(), self.prof["dir"]
        parsed = None
        for txt in list(self._limit_texts()) + list(getattr(self, "_lim_texts", None) or []):
            parsed = anim_reset_ts(txt)
            if parsed:
                break
        self._close_limit_popup()
        win = float(anim_lim_get(d).get("win") or 0)
        if parsed:
            until = parsed
        elif win and win + 5 * 3600 > now:
            until = win + 5 * 3600
        else:
            until = now + 5 * 3600
        until += 90
        anim_lim_set(d, until=until)
        return until

    # ───── main loop ─────
    def _session(self):
        hub = self.hub
        note_t = 0.0
        while True:
            if hub.stop.is_set():
                raise AnimStop()
            if hub.draining.is_set() and self.prof is None:
                self.log("Stop — ei thread er kaj shesh (Chrome bondho)", "ok")
                return
            if self.prof is None:                 # free, limit-nei Chrome profile khuji
                if not hub.has_work():
                    if hub.inflight() == 0:
                        self.log("Aar kono prompt nei — ei thread shesh", "ok")
                        return
                    self._wait(3000)
                    continue
                pr, hopeless = hub.pick_profile()
                if hopeless:
                    self.log("Kono usable Chrome profile nei — ei thread bondho", "err")
                    return
                if pr is None:
                    if time.time() - note_t > 60:
                        note_t = time.time()
                        self.log(hub.no_profile_msg(), "warn")
                    self._wait(3000)
                    continue
                self.prof = pr
                self.tag = f"T{self.idx + 1} {pr['name']}"
            task = hub.next_task()
            if task is None:
                if hub.draining.is_set():         # Stop dewa — nijer kaj shesh, Chrome bondho kore ber hoye jao
                    self.log("Stop — submit kora prompt shesh, Chrome bondho hochhe", "ok")
                    return
                if hub.inflight() > 0:            # onno Chrome limit khele tar box ekhane ashte pare
                    self._wait(3000)
                    continue
                self.log("Aar kono prompt nei — ei thread shesh", "ok")
                return
            try:
                if self.ctx is None:
                    self._launch()
                self._run_task(task)
            except AnimStop:
                hub.release(task, True)
                raise
            except AnimLogin:
                hub.release(task, True)
                self.log("Claude e login nei — Chrome section theke ei profile khule claude.ai te login koro. "
                         "Ei run e ei profile use hobe na, onno profile nichhi.", "err")
                self._retire(bad=True)
                continue
            except AnimClosed:
                hub.release(task, True)
                hits = self.__dict__.setdefault("_closed_hits", {})
                d = self.prof["dir"] if self.prof else ""
                hits[d] = hits.get(d, 0) + 1
                bad = hits[d] >= 3
                self.log(f"Chrome window bondho hoye geche ({hits[d]}/3) — "
                         + ("ei run e ei profile baad, onno profile nichhi." if bad else "profile ta rekhe abar chalu korchhi."),
                         "err")
                self._retire(bad=bad)
                self._wait(3000)
                continue
            except AnimLimit:
                until = self._calc_until()
                hub.release(task, True)
                self.log("Account er limit shesh (reset " + time.strftime("%I:%M %p", time.localtime(until))
                         + ") — Chrome bondho, onno Chrome khulchhe", "warn")
                self._retire()
                continue
            except Exception as e:
                hub.release(task, True)
                self.log(f"Chrome error: {e} — onno profile nichhi", "err")
                self._retire(bad=True)
                continue
            hub.release(task, False)

    def _run_task(self, task):
        """Ekta box er prompt gulo — ei box e onno Chrome (thread) o ekshathe kaj korte pare, prottek Chrome nijer chat e.
        Prottek Chrome prothome box er prompt neye (serial onujayi), tarpor kaj shesh hole pore'r prompt nei.
        Limit hole AnimLimit uthe jay (claim kora prompt box e ferot jay)."""
        hub = self.hub
        first = hub.first_prompt()
        fresh = True
        while True:
            if hub.stop.is_set():
                raise AnimStop()
            job = hub.claim_item(task)
            if job is None:
                return
            label = f"{job['box']} #{job['num']}"
            self.log(f"{label} shuru")
            hub.set_status(job, "run")
            t0 = time.time()
            try:
                if job.get("repair") and os.path.isfile(job["repair"]):
                    dest = self._repair_job(job, label)       # bad file upload kore fix — notun kore generate na
                    fresh = True                              # porer prompt notun chat + Prompt section diye shuru
                else:
                    if fresh:
                        self._goto_new()
                        if first:
                            self.log("new chat — Prompt section er prompt pathano hocche")
                            self._say(first)
                            self._wait(random.randint(1500, 3000))
                            self.log("Response shesh — ebar box er prompt pathano hocche")
                        fresh = False
                    job["_cards0"] = self._card_count()          # ei prompt pathanor age chat e koyta artifact card chhilo
                    self._say(job["text"])
                    self.log("Claude file toiri shesh koreche — download hocche")
                    self._wait(1500)
                    dest = self._grab(job)
                self._check_fix(job, label, dest)
            except AnimLimit as ex:
                if ex.args and ex.args[0] == "pre":
                    hub.give_back(task, job)
                    hub.set_status(job, "queued")
                    raise
                job["limit_hits"] = job.get("limit_hits", 0) + 1
                if job["limit_hits"] >= 2:
                    self._drop_bad(job)
                    hub.add_failed()
                    hub.set_status(job, "imp")
                    self.log(f"{label} \U0001f6ab limit-e generate possible hoyni (new Chrome/account e-o limit shesh hoye gese) "
                             f"\u2014 skip kora holo, manually korte hobe", "err")
                else:
                    hub.give_back(task, job)
                    hub.set_status(job, "queued")
                raise
            except (AnimStop, AnimLogin, AnimClosed):
                self._drop_bad(job)
                hub.give_back(task, job)
                hub.set_status(job, "queued")
                raise
            except AnimBad as ex:
                self._drop_bad(job, str(ex))
                hub.add_failed()
                hub.set_status(job, "fail")
                self.log(f"{label} FAIL — {ANIM_MAX_FIX} bar fix prompt diye-o animation thik hoyni ({ex}). "
                         f"File bad dewa holo, porer prompt e jachhi", "err")
                fresh = True
                self._wait(3000)
                continue
            except Exception as e:
                job["attempts"] += 1
                fresh = True
                if job["attempts"] < 2:
                    self.log(f"{label} hoyni ({e}) — notun chat e abar chesta korbo", "warn")
                    hub.give_back(task, job)
                    hub.set_status(job, "queued")
                else:
                    hub.add_failed()
                    hub.set_status(job, "fail")
                    self.log(f"{label} FAIL ({e})", "err")
                self._wait(3000)
                continue
            hub.add_done()
            anim_bad_clear(job["out"], job["num"])           # fix hoye gese — alada rakha bad file dorkar nei
            try:
                self.__dict__.setdefault("_closed_hits", {}).pop(self.prof["dir"], None)
            except Exception:
                pass
            hub.set_status(job, "done")
            self.log(f"{label} \u2713 download hoyeche ({int(time.time() - t0)}s)", "ok")
            self._wait(random.randint(3000, 6000))

    # ───── animation check + fix prompt ─────
    def _chk_close(self):
        try:
            if self._chk is not None:
                self._chk.close()
        except Exception:
            pass
        self._chk = None

    def _verify(self, dest):
        """Download howa file headless Chrome e khule check kore. -> (True/False/None, reason)"""
        if os.path.splitext(dest or "")[1].lower() not in (".html", ".htm"):
            return True, ""
        sem = getattr(self.hub, "chk_sem", None)
        if sem is not None:
            while not sem.acquire(timeout=0.5):
                if self.hub.stop.is_set():
                    raise AnimStop()
        try:
            if self._chk is None:
                self._chk = AnimChecker(self.pw)
            return self._chk.check(dest, self.hub.stop)
        except AnimStop:
            raise
        except Exception as e:
            return None, (str(e).splitlines() or ["check error"])[0][:100]
        finally:
            if sem is not None:
                sem.release()

    def _drop_bad(self, job, why=None):
        """Check e fail kora file muchhe dey — jate porer Start e 'done' dhore skip na kore.
        why dile (file sotti-i bad) age alada kore rakhe — Fix fails e eta Claude e upload hobe."""
        p = job.pop("_bad_dest", None)
        if p:
            if why and os.path.isfile(p):
                anim_bad_stash(job["out"], job["num"], p, why)
            try:
                if os.path.exists(p):
                    os.remove(p)
            except Exception:
                pass

    def _attach(self, path):
        """Claude chat e file attach kore, upload shesh howa porjonto opekkha kore."""
        page = self.page
        name = os.path.basename(path)
        done = False
        try:
            page.locator("input[type=file]").first.set_input_files(path, timeout=8000)
            done = True
        except Exception:
            pass
        if not done:
            for mk in (lambda: page.locator('button[aria-label*="attach" i], button[aria-label*="upload" i], '
                                            'button[aria-label*="add files" i]').first,
                       lambda: page.locator('button[data-testid*="plus" i], button[aria-label*="Add" i]').first):
                try:
                    btn = mk()
                    if not btn.is_visible():
                        continue
                    with page.expect_file_chooser(timeout=6000) as fc:
                        btn.click(timeout=3000)
                        try:      # menu ashle 'Upload a file' item e click
                            page.get_by_text(re.compile(r"^\s*Upload (a )?files?", re.I)).first.click(timeout=2500)
                        except Exception:
                            pass
                    fc.value.set_files(path)
                    done = True
                    break
                except Exception:
                    try:
                        page.keyboard.press("Escape")
                    except Exception:
                        pass
        if not done:
            raise RuntimeError("file upload korar button paoa jayni")
        for _ in range(40):                      # file er naam chat box e dekha jawa porjonto
            self._wait(1000)
            try:
                if page.get_by_text(name).first.is_visible():
                    break
            except Exception:
                pass
        self._wait(2500)                         # upload shesh howar jonno ektu beshi somoy
        self.log(f"  file upload hoyeche: {name}", "ok")

    def _repair_job(self, job, label):
        """Notun chat e bad HTML file upload kore + Fix prompt + karon pathay. Claude thik kora file dey."""
        hub = self.hub
        path, why = job["repair"], job.get("why") or ""
        self.log(f"{label} bad file Claude e upload kore fix korchi (notun kore generate na — credit/somoy bachbe)", "info")
        self._goto_new()
        self._attach(path)
        msg = hub.fix_text() + f"\n\n(The HTML file with the problem is attached: {os.path.basename(path)})"
        extra = anim_claude_reason(why)
        msg += "\n\n" + (extra or
                          "Read the attached code carefully and find the exact cause of the problem (timing, easing, a state "
                          "that never updates, a missing draw call, an error, etc.). Fix only that problem and keep everything "
                          "else (story, characters, design) exactly the same.")
        msg += ("\n\nIMPORTANT: Do not explain and do not paste the code in the chat. Create the complete fixed animation "
                "as ONE self-contained HTML artifact (a real file I can download), from <!DOCTYPE html> to </html>.")
        self.log("  karon dhora porche — Fix prompt er sathe karon-o pathachhi" if extra
                 else "  karon dhora jayni — shudhu tomar Fix prompt + file pathachhi", "info")
        job["_cards0"] = c0 = self._card_count()
        self._say(msg)
        if self._card_count() <= c0:                      # Claude file na bonaye chat e code likhle
            full = False
            try:
                full = any("</html>" in c.lower() for c in self._codes())
            except Exception:
                pass
            if not full:
                self.log("  Claude file toiri kore ni (chat e likhche) — file banate bolchi", "warn")
                job["_cards0"] = self._card_count()
                self._say("Please do not write the code in the chat. Create the complete fixed HTML as an artifact "
                          "(a downloadable file), from <!DOCTYPE html> to </html>, with no explanation.")
        self.log("Claude file thik kore dilo — download hocche")
        self._wait(1500)
        return self._grab(job)

    def _check_fix(self, job, label, dest):
        """File check kore. Thik na hole Prompt section er Fix prompt Claude ke pathay (max ANIM_MAX_FIX bar),
        notun file nie abar check kore. Tarpor-o thik na hole AnimBad uthe (file bad)."""
        hub = self.hub
        if not dest:
            return dest
        ok, why = self._verify(dest)
        if ok is None:
            self.log(f"  animation check kora gelo na ({why}) — file ta rekhe dilam", "warn")
        elif ok:
            self.log("  animation check \u2713" + (f" ({why})" if why else ""), "ok")
        for fx in range(1, ANIM_MAX_FIX + 1):
            if ok is not False:
                break
            job["_bad_dest"] = dest
            self.log(f"  {label} animate thik na: {why} \u2014 fix prompt pathachhi ({fx}/{ANIM_MAX_FIX})", "warn")
            job["_cards0"] = self._card_count()
            job["_fix"] = True
            fix_msg = hub.fix_text()
            extra = anim_claude_reason(why)
            if extra:                                   # karon dhora gele prompt er niche jure dey
                fix_msg = fix_msg + "\n\n" + extra
                self.log("  karon dhora porche \u2014 Fix prompt er sathe karon-o pathachhi", "info")
            else:
                self.log("  karon dhora jayni \u2014 shudhu tomar Fix prompt pathachhi", "info")
            d2 = None
            try:
                self._say(fix_msg)
                self._wait(1500)
                d2 = self._grab(job)
            except (AnimStop, AnimLimit, AnimLogin, AnimClosed):
                raise
            except Exception as e:
                self.log(f"  fix er por file download hoyni ({e})", "warn")
            finally:
                job.pop("_fix", None)
            if d2:
                dest = d2
                job["_bad_dest"] = dest
                ok, why = self._verify(dest)
                if ok:
                    self.log("  fix er por animation check \u2713" + (f" ({why})" if why else ""), "ok")
            else:
                why = "fix er por notun file paoa jayni"
        if ok is False:
            raise AnimBad(why)
        job.pop("_bad_dest", None)
        return dest

    def _say(self, text):
        self._dismiss_popups()
        comp = self._composer()
        if comp is None:
            raise RuntimeError("Prompt likhar box paoa jayni")
        self._mark_window()
        prev = self._resp_count()
        self._lim_ok, self._lim_texts = False, []
        self._say_prev, self._say_cards0 = prev, self._card_count()
        self._fill(comp, text)
        self._send(comp, self._nmsg == 0)
        self._nmsg += 1
        self._wait_start(prev)
        return self._wait_done()

    # ───── page steps ─────
    def _logged_out(self):
        page = self.page
        u = (page.url or "").lower()
        if "/login" in u or "/logout" in u or "accounts.google" in u:
            return True
        for sel in ('button:has-text("Continue with Google")', 'input[type="email"]'):
            try:
                if page.locator(sel).first.is_visible():
                    return True
            except Exception:
                pass
        return False

    def _composer(self):
        for sel in ('div[contenteditable="true"]', "textarea"):
            try:
                loc = self.page.locator(sel).first
                if loc.is_visible():
                    return loc
            except Exception:
                pass
        return None

    def _goto_new(self):
        self._nmsg = 0
        page = self.page
        if page.is_closed():
            raise AnimClosed()
        try:
            page.goto(ANIM_URL, wait_until="domcontentloaded", timeout=60000)
        except Exception as e:
            if page.is_closed():
                raise AnimClosed()
            raise RuntimeError(f"claude.ai khola jayni: {e}")
        for _ in range(40):
            self._wait(1500)
            if self._logged_out():
                raise AnimLogin()
            if self._limit_strict():
                raise AnimLimit("pre")
            self._dismiss_popups()
            if self._composer() is not None:
                self._wait(1500)
                if self._limit_strict():
                    raise AnimLimit("pre")
                self._dismiss_popups()
                return
        raise RuntimeError("claude.ai load hoyni / prompt box paoa jayni")

    def _ctext(self, comp):
        try:
            t = (comp.inner_text() or "").strip()
            if t:
                return t
        except Exception:
            pass
        try:
            return (comp.input_value() or "").strip()
        except Exception:
            return ""

    def _fill(self, comp, prompt):
        page = self.page
        comp.click()
        want = max(10, min(len(prompt) // 2, 200))
        for how in (0, 1):
            try:
                if how == 0:
                    comp.evaluate("""(el, text) => {
                        el.focus();
                        const dt = new DataTransfer();
                        dt.setData('text/plain', text);
                        el.dispatchEvent(new ClipboardEvent('paste', {clipboardData: dt, bubbles: true, cancelable: true}));
                    }""", prompt)
                else:
                    comp.click()
                    page.keyboard.press("Control+A")
                    page.keyboard.insert_text(prompt)
            except Exception:
                pass
            self._wait(800)
            if len(self._ctext(comp)) >= want:
                return
        raise RuntimeError("Prompt paste hoyni")

    def _send(self, comp, first_msg=False):
        page = self.page
        for _ in range(3):
            btn = None
            for sel in ('button[aria-label*="Send" i]', 'button[aria-label*="send message" i]'):
                try:
                    b = page.locator(sel).first
                    if b.is_visible() and b.is_enabled():
                        btn = b
                        break
                except Exception:
                    pass
            try:
                if btn is not None:
                    btn.click()
                else:
                    comp.click()
                    page.keyboard.press("Enter")
            except Exception:
                pass
            self._wait(2500)
            if len(self._ctext(comp)) < 10 or (first_msg and "/chat/" in (page.url or "")):
                return

    def _resp_count(self):
        page = self.page
        for sel in ("div[data-is-streaming]", ".font-claude-response", ".font-claude-message"):
            try:
                n = page.locator(sel).count()
                if n:
                    return n
            except Exception:
                pass
        return 0

    def _limit_strict(self):
        try:
            return self.page.get_by_text(ANIM_LIMIT_STRICT_RE).first.is_visible()
        except Exception:
            return False

    def _resp_el(self):
        page = self.page
        for sel in ("div[data-is-streaming]", ".font-claude-response", ".font-claude-message"):
            try:
                loc = page.locator(sel)
                n = loc.count()
                if n > 0:
                    return loc.nth(n - 1)
            except Exception:
                pass
        return None

    def _is_streaming(self):
        page = self.page
        try:
            if page.locator('[data-is-streaming="true"]').count() > 0:
                return True
        except Exception:
            pass
        try:
            return page.locator('button[aria-label*="Stop" i]').first.is_visible()
        except Exception:
            return False

    def _limit(self):
        try:
            return self.page.get_by_text(ANIM_LIMIT_RE).first.is_visible()
        except Exception:
            return False

    def _wait_start(self, prev=0):
        """Notun response shuru hoyeche kina (ager message er response ke gona hoy na)."""
        for _ in range(400):
            self._wait(1500)
            if self._is_streaming() or self._resp_count() > prev:
                return
            if prev == 0 and "/chat/" in (self.page.url or ""):
                return
            if not getattr(self, "_lim_ok", False) and (self._limit_strict() or self._limit()):
                self._limit_gate()          # popup X diye bondho + HTML ashe kina dekhe; na ashle AnimLimit
                return
            self._dismiss_popups()
        raise RuntimeError("Claude er response shuru hoyni")

    def _last_text(self):
        el = self._resp_el()
        try:
            if el is not None:
                return (el.inner_text() or "").strip()
            return (self.page.locator("main").last.inner_text() or "").strip()
        except Exception:
            return ""

    def _wait_done(self):
        t0, last, stable = time.time(), None, 0
        while True:
            self._wait(2000)
            if not getattr(self, "_lim_ok", False) and self._limit_strict():
                self._limit_gate()
            self._dismiss_popups()
            txt = self._last_text()
            if self._is_streaming():
                stable = 0
            else:
                stable = stable + 1 if (txt and txt == last) else 0
                if stable >= 3:
                    return txt
                if not getattr(self, "_lim_ok", False) and (self._limit_strict() or (not txt and self._limit())):
                    self._limit_gate()
            last = txt
            if time.time() - t0 > 3 * 3600:
                raise RuntimeError("Response 3 ghontay-o shesh hoyni")

    def _codes(self):
        page = self.page
        el = self._resp_el()
        loc = (el if el is not None else page.locator("main").last).locator("pre")
        try:
            arr = loc.evaluate_all("els => els.map(e => (e.querySelector('code') || e).innerText)")
        except Exception:
            arr = []
        return [c for c in arr if c and c.strip()]

    # ───── output: artifact Export > HTML  /  file card Download ─────
    def _vis(self, loc):
        try:
            return loc.is_visible()
        except Exception:
            return False

    def _export_btn(self):
        page = self.page
        for loc in (page.get_by_role("button", name=re.compile(r"^\s*Export\s*$", re.I)),
                    page.locator('button:has-text("Export")')):
            try:
                if loc.count() and self._vis(loc.first):
                    return loc.first
            except Exception:
                pass
        return None

    def _art_card(self):
        """Artifact card er asol click-link (frame-card-open) — shesh ta. Na pele purono text-based tarika."""
        page = self.page
        for sel in ('[data-testid="frame-card-open"]', '[aria-label^="View" i][data-cds="CardLink"]'):
            try:
                loc = page.locator(sel)
                n = loc.count()
                if n:
                    return loc.nth(n - 1)
            except Exception:
                pass
        try:
            loc = page.get_by_text(re.compile(r"Artifact\s*[\u00b7\u2022]"))
            n = loc.count()
            if n:
                return loc.nth(n - 1)
        except Exception:
            pass
        return None

    def _open_art_card(self):
        """Card khule dey: normal click -> force click -> JS click -> keyboard Enter."""
        card = self._art_card()
        if card is None:
            return False
        try:
            card.scroll_into_view_if_needed(timeout=4000)
        except Exception:
            pass
        try:                                   # chat input box jeno card dhake na — ektu upore scroll
            self.page.evaluate("()=>{const e=document.querySelector('[data-testid=\"frame-card-open\"]');"
                               "if(e){const l=[...document.querySelectorAll('[data-testid=\"frame-card-open\"]')].pop();"
                               "l.scrollIntoView({block:'center'});}}")
        except Exception:
            pass
        for how in ("click", "force", "js", "enter"):
            try:
                if how == "click":
                    card.click(timeout=4000)
                elif how == "force":
                    card.click(timeout=4000, force=True)
                elif how == "js":
                    card.evaluate("el => el.click()")
                else:
                    card.focus()
                    self.page.keyboard.press("Enter")
            except (AnimStop, AnimClosed):
                raise
            except Exception:
                continue
            for _ in range(6):                 # panel khulte somoy lage
                self._wait(500)
                if self._export_btn() is not None:
                    return True
        return False

    def _dl_locs(self):
        """File card er Download button (72.png er moto — Export button nai, card er upor download icon).
        Age exact 'Download' aria-label, na pele broad. Shudhu VISIBLE gulo, DOM order e."""
        page = self.page
        for loc in (page.locator('button[aria-label="Download" i]'),
                    page.locator('button[aria-label*="Download" i]'),
                    page.get_by_role("button", name=re.compile(r"download", re.I))):
            out = []
            try:
                n = min(loc.count(), 40)
                for i in range(n):
                    e = loc.nth(i)
                    if self._vis(e):
                        out.append(e)
            except Exception:
                out = []
            if out:
                return out
        return []

    def _dl_count(self):
        try:
            return len(self._dl_locs())
        except Exception:
            return 0

    def _file_dl_btn(self):
        locs = self._dl_locs()
        return locs[-1] if locs else None

    def _newest_is_file(self):
        """Chat er shesh output ta ki 'file card + Download icon' (72.png)? na artifact card (65.png)?
        Duita-i thakle DOM e jeta niche (notun) seta."""
        try:
            return bool(self.page.evaluate("""() => {
                const vis = e => e.offsetParent !== null;
                const cards = [...document.querySelectorAll('[data-testid="frame-card-open"]')];
                let dls = [...document.querySelectorAll('button[aria-label="Download" i], button[aria-label="download" i]')].filter(vis);
                if (!dls.length) dls = [...document.querySelectorAll('button[aria-label*="ownload"]')].filter(vis);
                if (!dls.length) return false;
                if (!cards.length) return true;
                const c = cards[cards.length - 1], d = dls[dls.length - 1];
                return !!(c.compareDocumentPosition(d) & Node.DOCUMENT_POSITION_FOLLOWING);
            }"""))
        except Exception:
            return self._dl_count() > 0 and self._card_count_art() == 0

    def _click_file_dl(self, job):
        """File card er upor Download icon e click -> download dhore save. normal -> force -> JS click."""
        last = None
        for how in ("click", "force", "js"):
            def go(how=how):
                b = self._file_dl_btn()
                if b is None:
                    raise RuntimeError("file card er Download button paoa jayni")
                try:
                    b.scroll_into_view_if_needed(timeout=3000)
                except Exception:
                    pass
                try:
                    b.hover(timeout=2000)           # kichu UI te hover korle button active hoy
                except Exception:
                    pass
                if how == "click":
                    b.click(timeout=4000)
                elif how == "force":
                    b.click(timeout=4000, force=True)
                else:
                    b.evaluate("el => el.click()")
            try:
                return self._download(job, go, timeout=15000)
            except (AnimStop, AnimClosed):
                raise
            except Exception as e:
                last = e
                self.log(f"  file card Download click ({how}) kaj kore ni: {str(e).splitlines()[0][:80]}", "warn")
                if self.page.is_closed():
                    raise AnimClosed()
        raise RuntimeError(f"file card Download hoyni ({last})")

    def _blob_text(self):
        """Page / iframe gulo te create hoye thaka sobcheye boro HTML blob er text (fallback)."""
        best = None
        try:
            frames = list(self.page.frames)
        except Exception:
            frames = []
        for fr in frames:
            try:
                t = fr.evaluate("async()=>{const a=window.__blobs||[];let r=null;"
                                "for(const b of a){try{const x=await b.text();"
                                "if(!r||x.length>r.length)r=x;}catch(e){}}return r;}")
            except Exception:
                t = None
            if t and len(t) > 20 and (best is None or len(t) > len(best)):
                best = t
        return best

    def _download(self, job, click, timeout=45000):
        """click() er por download dhore '<serial>.html' nam e save kore.
        1) kono tab e download event ashle seta   2) na ashle page er blob content."""
        n0 = len(getattr(self, "_dls", []))
        for fr in list(self.page.frames):
            try:
                fr.evaluate("window.__blobs=[]")
            except Exception:
                pass
        click()
        end = time.time() + timeout / 1000.0
        dl = None
        while time.time() < end:
            if len(self._dls) > n0:
                dl = self._dls[-1]
                break
            self._wait(300)
            if time.time() - (end - timeout / 1000.0) > 3:       # 3 sec por blob check
                bt = self._blob_text()
                if bt:
                    dest = os.path.join(job["out"], f"{job['num']}.html")
                    atomic_write(dest, bt)
                    return dest
        if dl is None:
            raise RuntimeError("click holo kintu download event/blob ashenai")
        ext = os.path.splitext(dl.suggested_filename or "")[1].lower()
        if ext in ("", ".txt", ".htm"):
            ext = ".html"
        dest = os.path.join(job["out"], f"{job['num']}{ext}")
        tmp = dest + ".part"
        dl.save_as(tmp)
        if not os.path.exists(tmp) or os.path.getsize(tmp) < 20:
            raise RuntimeError("download howa file khali")
        if os.path.exists(dest):
            os.remove(dest)
        os.replace(tmp, dest)
        return dest

    def _export_html(self, job):
        """Export > HTML row. Prottekbar try er age dekhe menu khola ache kina — bondho hoye gele abar khole."""
        page = self.page

        ROW_RX = re.compile(r"Standalone\s+web\s+page", re.I)
        MENU_RXS = (ROW_RX, re.compile(r"Plain-text\s*\.md", re.I), re.compile(r"browser.s\s+print\s+dialog", re.I))

        def vis_text(rx):
            """Shob frame (main + iframe) e rx match kora prothom *visible* element."""
            try:
                frames = list(page.frames)
            except Exception:
                frames = [page.main_frame]
            for fr in frames:
                try:
                    loc = fr.get_by_text(rx)
                    n = min(loc.count(), 12)
                except Exception:
                    continue
                for i in range(n):
                    try:
                        e = loc.nth(i)
                        if e.is_visible():
                            return e
                    except Exception:
                        pass
            return None

        class _Row:                      # lazy locator-er moto: jokhon dorkar tokhon visible element khuje
            def _e(self):
                e = vis_text(ROW_RX)
                if e is None:
                    raise RuntimeError("HTML row dekha jacche na")
                return e
            def hover(self, **k): return self._e().hover(**k)
            def click(self, **k): return self._e().click(**k)
            def focus(self): return self._e().focus()
            def bounding_box(self): return self._e().bounding_box()

        _row = _Row()
        row_txt = lambda: _row

        def menu_open():
            return any(vis_text(rx) is not None for rx in MENU_RXS)

        def open_menu():
            """Menu already khola thakle kichu kore na (Export abar chaple bondho hoye jay)."""
            for _ in range(2):
                for _ in range(5):
                    if menu_open():
                        return True
                    self._wait(400)
                b = self._export_btn()
                if b is not None:
                    try:
                        b.click(timeout=3000)
                    except Exception:
                        pass
                self._wait(1200)
            return menu_open()

        def dump_debug():
            try:
                for k, fr in enumerate(page.frames):
                    self.log("  [debug] frame#%d url=%s  Standalone=%d Markdown=%d" % (
                        k, (fr.url or "")[:70], fr.get_by_text("Standalone").count(),
                        fr.get_by_text("Markdown").count()), "warn")
            except Exception:
                pass

        def row_btn():
            return _row._e().locator(
                "xpath=ancestor-or-self::*[self::button or @role='menuitem' or @role='button' or self::a][1]")

        def mouse_click():
            bb = row_txt().bounding_box()
            if not bb:
                raise RuntimeError("HTML row er position paoa jayni")
            page.mouse.move(bb["x"] + bb["width"] / 2, bb["y"] + bb["height"] / 2)
            page.mouse.down()
            self._wait(80)
            page.mouse.up()

        def mouse_dl_icon():          # row er dan dike download icon
            bb = row_txt().bounding_box()
            if not bb:
                raise RuntimeError("HTML row er position paoa jayni")
            row = row_btn().bounding_box(timeout=2000) or bb
            page.mouse.click(row["x"] + row["width"] - 24, bb["y"] + bb["height"] / 2)

        def key_enter():
            row_txt().focus()
            page.keyboard.press("Enter")

        cands = (
            mouse_click,
            lambda: row_btn().click(timeout=3000),
            lambda: row_txt().click(timeout=3000, force=True),
            mouse_dl_icon,
            lambda: row_btn().locator("svg").last.click(timeout=3000, force=True),
            lambda: page.get_by_role("button", name=re.compile(r"^\s*HTML\b", re.I)).first.click(timeout=3000),
            key_enter,
        )
        last = None
        if not open_menu():
            dump_debug()
            raise RuntimeError("Export menu detect hoyni")
        for i, fn in enumerate(cands):
            try:
                if not open_menu():
                    raise RuntimeError("Export menu khola jacche na")
                try:
                    row_txt().hover(timeout=1500)
                except Exception:
                    pass
                return self._download(job, fn, timeout=9000)
            except (AnimStop, AnimClosed):
                raise
            except Exception as e:
                last = e
                self.log(f"  HTML click tarika #{i + 1} kaj kore ni: {str(e).splitlines()[0][:90]}", "warn")
                if page.is_closed():
                    raise AnimClosed()
        raise RuntimeError(f"Export > HTML download hoyni ({last})")

    def _api_html(self):
        """Permanent fallback: UI na use kore, conversation er data (same logged-in Chrome theke) theke HTML tule ane."""
        m = re.search(r"/chat/([0-9a-fA-F-]{36})", self.page.url or "")
        if not m:
            return None
        js = """async (cid) => {
          const o = await (await fetch('/api/organizations', {credentials: 'include'})).json();
          const ids = (Array.isArray(o) ? o : []).map(x => x.uuid).filter(Boolean);
          for (const id of ids) {
            const r = await fetch(`/api/organizations/${id}/chat_conversations/${cid}?tree=True&rendering_mode=messages&render_all_tools=true`, {credentials: 'include'});
            if (r.ok) return await r.text();
          }
          return null; }"""
        raw = self.page.evaluate(js, m.group(1))
        if not raw:
            return None
        data = json.loads(raw)

        def walk(o, out):
            if isinstance(o, str):
                out.append(o)
            elif isinstance(o, dict):
                for v in o.values():
                    walk(v, out)
            elif isinstance(o, list):
                for v in o:
                    walk(v, out)

        msgs = [x for x in (data.get("chat_messages") or []) if x.get("sender") == "assistant"]
        for msg in msgs[-1:]:                           # shudhu SHESH assistant message (ei prompter response) — purono file na
            strs = []
            walk(msg.get("content"), strs)
            best = None
            for t in strs:
                low = t.lower()
                if len(t) > 300 and ("<html" in low or "<!doctype" in low) and (best is None or len(t) > len(best)):
                    best = t
            if best:
                return best
        return None

    def _card_count_art(self):
        try:
            return self.page.locator('[data-testid="frame-card-open"]').count()
        except Exception:
            return 0

    def _card_count(self):
        """Chat e output koyta: artifact card (Export) + file card (Download icon)."""
        return self._card_count_art() + self._dl_count()

    def _close_panel(self):
        """Artifact panel er X chepe bondho kore (porer prompt er jonno chat clean thake). True = bondho hoyeche."""
        page = self.page
        if self._export_btn() is None:
            return True
        js = """el => { let c = el;
            for (let i = 0; i < 6 && c; i++) {
              c = c.parentElement; if (!c) break;
              const bs = [...c.querySelectorAll('button')].filter(b => b.offsetParent !== null);
              if (bs.length >= 4) { bs[bs.length - 1].click(); return true; }
            } return false; }"""

        def gone():
            self._wait(700)
            return self._export_btn() is None

        try:
            page.keyboard.press("Escape")            # Export popover khola thakle
        except Exception:
            pass
        self._wait(300)
        for attempt in range(3):
            try:
                if attempt == 0:                      # header er shesh button = X
                    eb = self._export_btn()
                    if eb is not None:
                        eb.evaluate(js)
                elif attempt == 1:                    # aria-label "Close" (sidebar/menu bad)
                    loc = page.get_by_role("button", name=re.compile(r"^\s*close(?!.*(sidebar|menu|nav))", re.I))
                    for i in range(loc.count() - 1, -1, -1):
                        if loc.nth(i).is_visible():
                            loc.nth(i).click(timeout=2000)
                            break
                else:
                    page.keyboard.press("Escape")
            except (AnimStop, AnimClosed):
                raise
            except Exception:
                pass
            if gone():
                return True
        self.log("  artifact panel bondho kora gelo na", "warn")
        return False

    def _grab(self, job):
        dest = self._grab_inner(job)
        if dest:
            try:
                if self._close_panel():
                    self.log("  artifact panel bondho — porer prompt er jonno ready")
            except (AnimStop, AnimClosed):
                raise
            except Exception:
                pass
        return dest

    def _grab_inner(self, job):
        os.makedirs(job["out"], exist_ok=True)
        cards0 = job.get("_cards0")
        # 1) ei prompt er notun artifact card ashar opekkha (chat e purono file thakle seta jeno download na hoy)
        for _ in range(10 if job.get("_fix") else 20):
            if cards0 is not None and self._card_count() > cards0:
                break
            if cards0 is None and (self._export_btn() or self._art_card() or self._file_dl_btn()):
                break
            self._wait(1500)
        now = self._card_count()
        stale = cards0 is not None and now > 0 and now <= cards0 and not job.get("_fix")   # fix hole purono artifact-i update hoy
        dest = None
        try:
            if stale:
                self.log(f"  notun artifact card ashe ni (cards {cards0} -> {now}) — purono file download korbo na", "warn")
            else:
                if self._export_btn() is not None:      # purono / onno file er panel khola — bondho kore ei prompt er card khulbo
                    self.log("  ager panel khola chhilo — bondho kore notun file khulchi")
                    self._close_panel()
                if self._newest_is_file():
                    # 72.png: Export nai — file card er upor Download icon
                    self.log("File card paoa gelo (Export nai) — card er Download button e click hocche")
                    dest = self._click_file_dl(job)
                else:
                    card = self._art_card()
                    if card is not None:
                        try:
                            self.log("  file: " + ((card.get_attribute("aria-label", timeout=2000) or "").replace("View ", "") or "?")
                                     + f"  (card {now}/{now})")
                        except Exception:
                            pass
                        self.log("Artifact file khola hocche")
                        if not self._open_art_card():
                            self.log("  card click kaj korlo na — abar chesta", "warn")
                            self._wait(1500)
                            self._open_art_card()
                    if self._export_btn() is not None:
                        dest = self._export_html(job)
                    elif self._file_dl_btn() is not None:      # Export asheni — file card Download diye chesta
                        self.log("Export button nai — file card er Download button e click hocche")
                        dest = self._click_file_dl(job)
        except (AnimStop, AnimClosed):
            raise
        except Exception as e:
            self.log(f"Download hoyni ({e}) — conversation data theke chesta kora hocche", "warn")
        if dest:
            return dest
        try:                                   # fallback: shesh assistant message er HTML (conversation data)
            h = self._api_html()
        except (AnimStop, AnimClosed):
            raise
        except Exception as e:
            h = None
            self.log(f"  conversation data theke neya gelo na ({str(e).splitlines()[0][:80]})", "warn")
        if h:
            dest = os.path.join(job["out"], f"{job['num']}.html")
            atomic_write(dest, h)
            self.log("HTML conversation data theke neya hoyeche", "ok")
            return dest
        html, best = None, 0                   # fallback: reply te code block thakle seta
        for c in self._codes():
            low = c.lower()
            if any(k in low for k in ("<html", "<!doctype", "<svg", "<canvas", "<script")) and len(c) > best:
                html, best = c, len(c)
        if html:
            dest = os.path.join(job["out"], f"{job['num']}.html")
            atomic_write(dest, html)
            return dest
        raise RuntimeError("Artifact / download button / code kichui paoa jayni")

class Tab3Anim(tk.Frame):
    SECTIONS = [("start", "\u25b6", "Start"), ("anim", "\U0001f3ac", "2D Animation"),
                ("chrome", "\U0001f310", "Chrome"), ("prompt", "\u270d", "Prompt")]

    def __init__(self, app):
        super().__init__(app, bg=BG)
        self.app = app
        self.cur = None
        self.nav, self.pages = {}, {}
        self._jobs = {}
        self._hub = None
        self._logq = queue.Queue()
        self._statq = queue.Queue()
        self._chkq = queue.Queue()       # "Check animations" er result
        self._chk_busy = False
        self._chk_box = None
        self._chk_done = self._chk_total = 0
        self._spin = 0
        self._bidn = 0
        os.makedirs(ANIM_BASE, exist_ok=True)

        self.side = tk.Frame(self, bg=SIDE, width=96)
        self.side.pack(side="left", fill="y")
        self.side.pack_propagate(False)
        tk.Frame(self, bg=PANEL2, width=1).pack(side="left", fill="y")
        self.nav_ind = tk.Frame(self.side, bg=ACCENT, width=3)
        self.content = tk.Frame(self, bg=BG)
        self.content.pack(side="left", fill="both", expand=True)
        for key, icon, name in self.SECTIONS:
            b = NavItem(self.side, icon, name, lambda k=key: self.show(k))
            b.pack(fill="x", padx=8, pady=2)
            self.nav[key] = b
            self.pages[key] = tk.Frame(self.content, bg=BG)
        self._build_anim(self.pages["anim"])
        self._build_chrome(self.pages["chrome"])
        self._build_prompt(self.pages["prompt"])
        self._build_start(self.pages["start"])
        self.side.bind("<Configure>", lambda e: self._move_ind())
        self.show("start")
        self.after(300, self._pump)

    @staticmethod
    def _rd(path):
        """File na thakle crash na kore khali string."""
        try:
            return read_text(path) if os.path.exists(path) else ""
        except Exception:
            return ""

    # ───── nav ─────
    def show(self, key):
        if self.cur and self.cur != key:
            self.pages[self.cur].place_forget()
            self.nav[self.cur].set_active(False)
        self.cur = key
        if key == "start":
            self._refresh_info()
        self.nav[key].set_active(True, animate=False)
        self.pages[key].place(x=0, y=0, relwidth=1, relheight=1)
        self.after(30, self._move_ind)

    def _move_ind(self):
        b = self.nav.get(self.cur)
        if b is None or b.winfo_height() < 20:
            return
        self.nav_ind.place(x=0, y=b.winfo_y() + 12, width=3, height=b.winfo_height() - 24)
        self.nav_ind.lift()

    def activate(self):
        self.after(60, self._move_ind)
        self._chrome_sync()

    def deactivate(self):
        self._flush()

    # ───── debounce save ─────
    def _sched(self, key, fn, ms=600):
        old = self._jobs.get(key)
        if old:
            try:
                self.after_cancel(old)
            except Exception:
                pass
        self._jobs[key] = self.after(ms, fn)

    def _flush(self):
        for k in list(self._jobs):
            try:
                self.after_cancel(self._jobs.pop(k))
            except Exception:
                pass
        try:
            self._save_prompts()
            atomic_write(ANIM_PROMPT, self.prompt_txt.get("1.0", "end-1c"))
            atomic_write(ANIM_FIX_PROMPT, self.fix_txt.get("1.0", "end-1c"))
        except Exception:
            pass

    # ───── 2D Animation : prompt boxes ─────
    BOX_COLORS = ("#4f9dff", "#ff8a3d", "#b36bff", "#2fd1a5", "#ff5fa2",
                  "#e6c229", "#5fd0ff", "#9be15d", "#ff7a7a", "#8c8cff")

    def _build_anim(self, f):
        self.boxes = []
        self._drag = None
        self._outb = self._read_out_cfg()
        self.app.header(f, "2D Animation", "Prompt box add koro, nam dao — Start dile upor er box er kaj age hobe")
        bar = tk.Frame(f, bg=BG)
        bar.pack(fill="x", padx=22, pady=(0, 8))
        mkbtn(bar, "\uff0b  Add prompts", lambda: self._add_box(), "primary", pady=6, padx=16).pack(side="left")
        self.cnt_lbl = mklabel(bar, "", 9, MUTED, bg=BG)
        self.cnt_lbl.pack(side="left", padx=12)
        mkbtn(bar, "\U0001f4c2 Open folder", self._open_out, "ghost", pady=3, padx=12).pack(side="right")
        mkbtn(bar, "\U0001f4c1 Select folder", self._pick_out, "ghost", pady=3, padx=12).pack(side="right", padx=6)
        self.out_lbl = mklabel(f, "", 9, MUTED, anchor="w")
        self.out_lbl.pack(fill="x", padx=24, pady=(0, 4))
        self._out_sync()
        mklabel(f, "\u2630 handle dhore upor-niche tano (upor er box er kaj age) \u00b7 .txt box e drop korle oi box e boshbe, "
                   "baire drop korle notun box hobe", 9, MUTED, anchor="w").pack(fill="x", padx=24, pady=(0, 6))
        mklabel(f, "\u26aa baki  \u00b7  \U0001f552 queue  \u00b7  \u23f3 cholche  \u00b7  \u2705 done  \u00b7  "
                   "\u274c fail / animate thik na (Fix fails e abar hobe)  \u00b7  "
                   "\U0001f6ab limit-e generate hoy ni (manually koro, Fix fails skip korbe)",
                9, MUTED, anchor="w").pack(fill="x", padx=24, pady=(0, 6))
        self.sf = ScrollFrame(f)
        self.sf.pack(fill="both", expand=True, padx=(22, 10), pady=(0, 14))
        self.empty_lbl = mklabel(self.sf.inner, "Ekhono kono prompt nei.\n'\uff0b Add prompts' chepe prothom box banao.",
                                 11, MUTED, justify="center")
        self._load_prompts()
        self._refresh_empty()

    def _load_prompts(self):
        try:
            data = json.loads(self._rd(ANIM_PROMPTS) or "[]")
        except Exception:
            data = []
        for d in data if isinstance(data, list) else []:
            if isinstance(d, dict):
                c = d.get("color")
                self._add_box(str(d.get("name", "")), str(d.get("text", "")), save=False, focus=False,
                              color=c if isinstance(c, int) else None, marks=d)

    def _save_prompts(self):
        data = [{"name": b["name"].get(), "text": b["txt"].get("1.0", "end-1c"), "color": b["color"],
                 "fail": sorted(b["fail"]), "imp": sorted(b["imp"]), "bad": sorted(b["bad"]),
                 "sel": bool(b["sel"].get())}
                for b in self.boxes]
        os.makedirs(ANIM_BASE, exist_ok=True)
        atomic_write(ANIM_PROMPTS, json.dumps(data, ensure_ascii=False, indent=1))

    def _changed(self):
        self._sched("prompts", self._save_prompts)
        self._sched("status_all", self._status_all, 500)

    def _refresh_empty(self):
        n = len(self.boxes)
        self.cnt_lbl.configure(text=f"{n} prompt" + ("s" if n != 1 else ""))
        if n == 0:
            self.empty_lbl.pack(pady=60)
        else:
            self.empty_lbl.pack_forget()

    def _free_name(self):
        used = {b["name"].get().strip().lower() for b in self.boxes}
        k = 1
        while f"prompt {k}" in used:
            k += 1
        return f"Prompt {k}"

    def _free_color(self):
        used = {b["color"] for b in self.boxes}
        for k in range(len(self.BOX_COLORS)):
            if k not in used:
                return k
        return len(self.boxes) % len(self.BOX_COLORS)

    def _repack(self):
        """boxes list er order onujayi frame gulo sajay + number badge update."""
        for b in self.boxes:
            b["frame"].pack_forget()
        for i, b in enumerate(self.boxes):
            b["frame"].pack(fill="x", pady=(0, 10), padx=(0, 48))   # right e faka — okhane mouse rekhe page scroll hoy
            b["badge"].configure(text=str(i + 1))

