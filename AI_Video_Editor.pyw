    def _ratio2(self, *a):
        lst = self.RES_LIST.get(self.aspect_var.get())
        if not lst:
            return
        try:
            self.res_cb2["values"] = lst
        except (AttributeError, tk.TclError):
            pass
        if self._loading:
            return
        m = re.fullmatch(r"(\d+)x(\d+)", self.res_var.get().strip())
        if m:
            short = min(int(m.group(1)), int(m.group(2)))
            best = min(lst, key=lambda r: abs(min(map(int, r.split("x"))) - short))
        else:
            best = lst[1]
        if self.res_var.get().strip() != best:
            self.res_var.set(best)
        self._cfg_touch()

    # ───────── subtitle timeline (cues) + drawing on the preview ─────────
    def _sub_changed(self, key=None):
        if self._loading:
            return
        self._sub_ver += 1
        if key in ("SUB_SOURCE", "SUB_OFFSET", "SUB_WORDS"):
            self._cues_ok = False
        self._cfg_dirty = True
        self._save_soon()
        if self._sub_job is None:
            self._sub_job = self.after(25, self._sub_redraw)

    def _sub_redraw(self):
        self._sub_job = None
        self._sub_key = None
        self._sub_sync()

    def _ensure_cues(self):
        if self._cues_ok:
            return
        self._cues_ok = True
        proj = self.app.proj
        srt, script = [], []
        try:
            if proj and os.path.isdir(proj):
                sp = self.app.srt_path()
                if sp:
                    srt = t2_parse_srt(read_text(sp))
                script = sentences_of(os.path.join(proj, "script.txt"))
        except Exception:
            pass
        src = self.subv2["SUB_SOURCE"].get().strip().lower()
        if src == "script":
            use_srt = False
        elif src == "srt":
            use_srt = True
        else:
            use_srt = bool(srt)
        base = []
        if use_srt:
            base = list(srt)
        elif script and self._total > 0.1:
            step = self._total / float(len(script))
            base = [(i * step, (i + 1) * step, t) for i, t in enumerate(script)]
        try:
            off = float(self.subv2["SUB_OFFSET"].get().strip().replace(",", ".") or 0)
        except ValueError:
            off = 0.0
        try:
            n = int(float(self.subv2["SUB_WORDS"].get().strip() or 0))
        except ValueError:
            n = 0
        cues = []
        for s, e, text in base:
            words = text.split()
            if n > 0 and len(words) > n:
                chunks = [" ".join(words[i:i + n]) for i in range(0, len(words), n)]
                tot = float(sum(len(c) for c in chunks)) or 1.0
                t = s
                for c in chunks:
                    d = (e - s) * len(c) / tot
                    cues.append((t + off, t + d + off, c))
                    t += d
            else:
                cues.append((s + off, e + off, text))
        self._cues = cues
        self._cue_starts = [c[0] for c in cues]

    def _sub_at(self, t):
        i = bisect.bisect_right(self._cue_starts, t) - 1
        if i >= 0 and t < self._cues[i][1]:
            return i
        return None

    def _sub_text(self):
        sub_open = self.rp_tab.get() == "subs" and not self._playing
        on = self.subv2["SUB_ENABLED"].get() == "1"
        if not (on or sub_open):
            return ""
        self._ensure_cues()
        t = self.cur_t
        i = self._sub_at(t)
        if i is not None:
            return self._cues[i][2]
        if sub_open:                                   # sample, so the style can be edited while paused
            j = bisect.bisect_right(self._cue_starts, t)
            if j < len(self._cues):
                return self._cues[j][2]
            if self._cues:
                return self._cues[-1][2]
            return "Eta tomar subtitle er preview"
        return ""

    def _sub_sync(self):
        try:
            txt = self._sub_text()
            W, H = self._rsz()
            cw, ch = self.pv_cv.winfo_width(), self.pv_cv.winfo_height()
            key = (txt, W, H, cw, ch, self._sub_ver, self._sub_drag)
            if key == self._sub_key:
                return
            self._sub_key = key
            self._sub_paint(txt, W, H, cw, ch)
        except (tk.TclError, AttributeError):
            pass

    @staticmethod
    def _sub_blend(hexcol, op, *_a):
        try:
            r1, g1, b1 = (int(hexcol[i:i + 2], 16) for i in (1, 3, 5))
        except Exception:
            return "#000000"
        a = op / 100.0
        return "#%02x%02x%02x" % (int(r1 * a + 0x30 * (1 - a)), int(g1 * a + 0x30 * (1 - a)), int(b1 * a + 0x30 * (1 - a)))

    def _sub_paint(self, txt, W, H, cw, ch):
        cv = self.pv_cv
        cv.delete("t2sub")
        if not txt or cw < 20 or ch < 20:
            return
        x0, y0 = (cw - W) / 2.0, (ch - H) / 2.0
        cfg = {k: v.get().strip() for k, v in self.subv2.items()}
        if cfg.get("SUB_UPPER") == "1":
            txt = txt.upper()

        def fn(key, d, lo, hi):
            try:
                x = float(cfg.get(key, d))
            except ValueError:
                x = float(d)
            return max(lo, min(hi, x))
        S = H * fn("SUB_SIZE", 5, 1, 30) / 100.0
        px = x0 + W * fn("SUB_X", 50, 0, 100) / 100.0
        py = y0 + H * fn("SUB_Y", 82, 0, 100) / 100.0
        maxw = W * fn("SUB_WIDTH", 80, 10, 100) / 100.0
        maxw = min(maxw, 2 * min(px - x0, x0 + W - px))
        mark = cv.create_rectangle(0, 0, 0, 0)
        try:
            self.app._sub_render(cv, txt, cfg, S, px, py, maxw, self._sub_blend)
            if self._sub_drag:
                sx, sy = self._sub_snap
                cv.create_line(x0 + W / 2, y0, x0 + W / 2, y0 + H, fill=ACCENT if sx else "#ffffff", dash=(3, 4))
                cv.create_line(x0, y0 + H / 2, x0 + W, y0 + H / 2, fill=ACCENT if sy else "#ffffff", dash=(3, 4))
        except tk.TclError:
            pass
        for i in cv.find_all():
            if i > mark:
                cv.addtag_withtag("t2sub", i)
        cv.delete(mark)
        cv.tag_raise("t2sub")

    # preview mouse: drag = subtitle position (Subtitles panel, paused) / click = play-pause
    def _pvc_press(self, e):
        self.tl_cv.focus_set()
        self._pv_xy, self._pv_moved = (e.x, e.y), False
        self._sub_can = bool(self.rp_tab.get() == "subs" and not self._playing and self._sub_text())

    def _pvc_move(self, e):
        if not self._sub_can:
            return
        if not self._pv_moved and abs(e.x - self._pv_xy[0]) + abs(e.y - self._pv_xy[1]) < 5:
            return
        self._pv_moved = self._sub_drag = True
        W, H = self._rsz()
        cw, ch = self.pv_cv.winfo_width(), self.pv_cv.winfo_height()
        x0, y0 = (cw - W) / 2.0, (ch - H) / 2.0
        xp = max(0.0, min(100.0, (e.x - x0) / float(W) * 100))
        yp = max(0.0, min(100.0, (e.y - y0) / float(H) * 100))
        sx, sy = abs(xp - 50) < 1.8, abs(yp - 50) < 1.8
        if sx:
            xp = 50.0
        if sy:
            yp = 50.0
        self._sub_snap = (sx, sy)
        fmt = self.app._fmt_num
        self.subv2["SUB_X"].set(fmt(xp))
        self.subv2["SUB_Y"].set(fmt(yp))
        self._sub_redraw()

    def _pvc_release(self, e):
        moved = self._pv_moved
        self._sub_drag = self._sub_can = self._pv_moved = False
        if moved:
            self._sub_redraw()
        else:
            self.toggle()

    def _pvc_wheel(self, e):
        if self.rp_tab.get() != "subs":
            return
        up = (getattr(e, "delta", 0) > 0) or getattr(e, "num", 0) == 4
        try:
            cur = float(self.subv2["SUB_SIZE"].get())
        except ValueError:
            cur = 5.0
        self.subv2["SUB_SIZE"].set(self.app._fmt_num(max(2.0, min(14.0, cur + (0.25 if up else -0.25)))))
        return "break"

    # ───────── transitions inside playback / seek (ffmpeg xfade) ─────────
    def _tr_geoms(self):
        """Per slot i: geometry of the transition that sits between slot i-1 and slot i (None = no transition).
        window = [o, o+D] measured from the cut: o>0 later (old frame held), o<0 earlier (tail of slot i-1)."""
        n = len(self.slots)
        out = [None] * n
        cur = self._tr_cur()
        if not cur:
            return out
        o_raw = self._tr_off()
        for i in range(1, n):
            s, p = self.slots[i], self.slots[i - 1]
            if not s["path"] or not p["path"]:
                continue
            d_i, d_p = self._dur(s), self._dur(p)
            D = min(self._tr_dur(cur[1]), d_i * 0.9)
            if D < 0.1:
                continue
            o = o_raw
            if str(cur[0]).startswith("LK:"):       # light leak: centre it on the cut -> no frozen frame
                o = min(0.0, o_raw - D / 2.0)
            if o > 0:
                o = max(0.0, min(o, d_i * 0.95 - D))
            elif o < 0:
                hd_p = max(0.0, out[i - 1]["hd"]) if out[i - 1] else 0.0
                o = -min(-o, max(0.0, d_p - hd_p - 0.05))
            if o > -0.04:
                o = max(0.0, o)
            pre = max(0.0, -o)
            hd = o + D
            if hd < 0.04 and pre < 0.04:
                continue
            out[i] = {"x": cur[0], "D": D, "o": o, "pre": pre, "hd": hd}
        return out

    def _tr_for(self, i, off, gs=None):
        """Transition info for slot i at offset `off` (None = no transition there)."""
        if i is None or i <= 0 or i >= len(self.slots):
            return None
        g = (gs or self._tr_geoms())[i]
        if not g or g["hd"] < 0.04 or off >= g["hd"] - 0.001:
            return None
        s, p = self.slots[i], self.slots[i - 1]
        ptin, pdur = self._trim(p)
        return {"x": g["x"], "D": g["D"], "o": g["o"], "pre": g["pre"], "hd": g["hd"], "prev": p["path"],
                "prev_img": self._is_img(p["path"]), "prev_dur": ptin + pdur, "tin": self._trim(s)[0]}

    def _tail_for(self, i, gs=None):
        """If the transition after slot i starts BEFORE the cut: info about the last `pre` seconds of slot i."""
        if i is None or i < 0 or i + 1 >= len(self.slots):
            return None
        g = (gs or self._tr_geoms())[i + 1]
        if not g or g["pre"] < 0.04:
            return None
        s, nx = self.slots[i], self.slots[i + 1]
        ptin, pdur = self._trim(s)
        return {"x": g["x"], "D": g["D"], "pre": g["pre"], "A": s["path"], "A_img": self._is_img(s["path"]),
                "A_end": ptin + pdur, "B": nx["path"], "B_img": self._is_img(nx["path"]),
                "B_tin": self._trim(nx)[0], "dur": self._dur(s)}

    def _last_frame(self, path, is_img, dur):
        """Last frame of the outgoing clip as a picture file (images are used as they are)."""
        if is_img:
            return path
        try:
            st = os.stat(path)
        except OSError:
            return None
        key = (path, st.st_mtime, st.st_size, round(dur, 2))
        with self._lf_lock:
            p = self._lastf.get(key)
            if p and os.path.exists(p):
                return p
            out = os.path.join(tempfile.gettempdir(), "ave_t2_%d_lf_%s.png" % (
                os.getpid(), hashlib.md5(repr(key).encode()).hexdigest()[:12]))
            for pre in ([["-ss", f"{max(0.0, dur - 0.15):.3f}"], ["-sseof", "-0.3"], []]):
                cmd = ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", *pre, "-i", path, "-an",
                       "-frames:v", "1", "-update", "1", out]
                try:
                    subprocess.run(cmd, creationflags=NOWIN, timeout=40, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL)
                except Exception:
                    pass
                if os.path.exists(out) and os.path.getsize(out) > 0:
                    self._lastf[key] = out
                    return out
                self._rm(out)
        return None

    def _first_frame(self, path, is_img, tin):
        """First frame of the incoming clip (after its trim) as a picture file."""
        if is_img:
            return path
        try:
            st = os.stat(path)
        except OSError:
            return None
        key = ("first", path, st.st_mtime, st.st_size, round(tin, 2))
        with self._lf_lock:
            p = self._lastf.get(key)
            if p and os.path.exists(p):
                return p
            out = os.path.join(tempfile.gettempdir(), "ave_t2_%d_ff_%s.png" % (
                os.getpid(), hashlib.md5(repr(key).encode()).hexdigest()[:12]))
            cmd = ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", "-ss", f"{max(0.0, tin):.3f}", "-i", path,
                   "-an", "-frames:v", "1", "-update", "1", out]
            try:
                subprocess.run(cmd, creationflags=NOWIN, timeout=40, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL)
            except Exception:
                pass
            if os.path.exists(out) and os.path.getsize(out) > 0:
                self._lastf[key] = out
                return out
            self._rm(out)
        return None

    def _tr_cmd(self, lp, path, img, x, tr, W, H, post=""):
        """Head of the transition (slot i): old clip's last frame (held) -> new clip. Output window starts at
        the transition start: for o<0 the first round(pre*FPS) frames belong to the previous slot (skipped by caller)."""
        vf, F = self._vf(W, H), self.FPS
        D, lead, pre, tin = tr["D"], max(0.0, tr["o"]), tr["pre"], tr.get("tin", 0.0)
        a_in = ["-loop", "1", "-framerate", str(F), "-t", f"{lead + D:.3f}", "-i", lp]
        b_ss = tin + lead
        b_in = (["-loop", "1", "-framerate", str(F)] if img else (["-ss", f"{b_ss:.3f}"] if b_ss > 0 else [])) \
            + ["-t", f"{D:.3f}", "-i", path]
        bpre = f",tpad=start_duration={pre:.3f}:start_mode=clone" if pre > 0.0005 else ""
        fc = (f"[0:v]fps={F},{vf},format=yuv420p[a];[1:v]fps={F},{vf}{bpre},format=yuv420p[b];"
              f"[a][b]{t2_xf(x, D, lead, W, H, F, cut_at=pre)}{post},format=rgb24[o]")
        return ["ffmpeg", "-v", "error"] + a_in + b_in + ["-filter_complex", fc, "-map", "[o]"]

    def _trans_still(self, tr, path, img, off, W, H):
        lp = self._last_frame(tr["prev"], tr["prev_img"], tr["prev_dur"])
        if not lp:
            return None
        k = max(0, int(round((off + tr["pre"]) * self.FPS)))
        for x in ([tr["x"], "fade"] if tr["x"] != "fade" else ["fade"]):
            cmd = self._tr_cmd(lp, path, img, x, tr, W, H, post=f",select='eq(n,{k})'")
            cmd += ["-frames:v", "1", "-f", "rawvideo", "-pix_fmt", "rgb24", "-"]
            try:
                r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, creationflags=NOWIN,
                                   timeout=40)
            except Exception:
                return None
            if len(r.stdout) == W * H * 3:
                return b"P6 %d %d 255\n" % (W, H) + r.stdout
        return None

    def _emit_transition(self, gen, e, W, H):
        """Pushes the transition frames at the start of slot e. Returns the clip-time (sec) reached, None = aborted."""
        tr = e["tr"]
        lp = self._last_frame(tr["prev"], tr["prev_img"], tr["prev_dur"])
        if not lp:
            return 0.0
        F, D = self.FPS, tr["D"]
        npre = int(round(tr["pre"] * F))
        nf = int(round((max(0.0, tr["o"]) + D) * F))
        if nf - npre < 2:
            return 0.0
        hdr, size = b"P6 %d %d 255\n" % (W, H), W * H * 3
        skip = int(round((e["off"] + tr["pre"]) * F))
        for x in ([tr["x"], "fade"] if tr["x"] != "fade" else ["fade"]):
            cmd = self._tr_cmd(lp, e["path"], e["img"], x, tr, W, H) + ["-f", "rawvideo", "-pix_fmt", "rgb24", "-"]
            proc = None
            n = 0
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, creationflags=NOWIN)
                while gen == self._gen and n < nf:
                    buf = proc.stdout.read(size)
                    if len(buf) < size:
                        break
                    if n >= skip and not self._push(gen, ("frame", e["t0"] + (n - skip) / float(F), hdr + buf, None)):
                        return None
                    n += 1
            except Exception:
                pass
            finally:
                try:
                    if proc is not None:
                        if proc.poll() is None:
                            proc.kill()
                        proc.stdout.close()
                except Exception:
                    pass
            if gen != self._gen:
                return None
            if n > npre:
                return (n - npre) / float(F)
            if x == "fade" or tr["x"] == "fade":
                self._q.put(("noxf",))
        return 0.0

    # ----- tail: the part of an EARLIER transition that sits at the end of the previous slot -----
    def _tail_parts(self, tl, x, W, H):
        """(inputs, filter text up to the xfade chain) for the window frames [0, pre) - old clip still running,
        new clip's first frame held. None if the first frame can't be made."""
        F, D, pre = self.FPS, tl["D"], tl["pre"]
        bf = self._first_frame(tl["B"], tl["B_img"], tl["B_tin"])
        if not bf:
            return None
        vf = self._vf(W, H)
        a_ss = max(0.0, tl["A_end"] - pre)
        a_in = (["-loop", "1", "-framerate", str(F)] if tl["A_img"] else ["-ss", f"{a_ss:.3f}"]) \
            + ["-t", f"{pre:.3f}", "-i", tl["A"]]
        b_in = ["-loop", "1", "-framerate", str(F), "-t", f"{D + 0.5:.3f}", "-i", bf]
        extra = f",tpad=stop_mode=clone:stop_duration={pre - D + 0.5:.3f}" if pre > D else ""
        fc = (f"[0:v]fps={F},{vf},tpad=stop_mode=clone:stop_duration={D + 0.5:.3f},format=yuv420p[a];"
              f"[1:v]fps={F},{vf},format=yuv420p[b];[a][b]{t2_xf(x, D, 0, W, H, F, cut_at=pre)}{extra}")
        return a_in + b_in, fc

    def _tail_cmd(self, tl, x, W, H, post=""):
        parts = self._tail_parts(tl, x, W, H)
        if not parts:
            return None
        inputs, fc = parts
        return ["ffmpeg", "-v", "error"] + inputs + ["-filter_complex", fc + post + ",format=rgb24[o]", "-map", "[o]"]

    def _tail_still(self, tl, off, W, H):
        k = int(round((off - (tl["dur"] - tl["pre"])) * self.FPS))
        k = max(0, min(int(round(tl["pre"] * self.FPS)) - 1, k))
        for x in ([tl["x"], "fade"] if tl["x"] != "fade" else ["fade"]):
            cmd = self._tail_cmd(tl, x, W, H, post=f",select='eq(n,{k})'")
            if not cmd:
                return None
            cmd += ["-frames:v", "1", "-f", "rawvideo", "-pix_fmt", "rgb24", "-"]
            try:
                r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, creationflags=NOWIN,
                                   timeout=40)
            except Exception:
                return None
            if len(r.stdout) == W * H * 3:
                return b"P6 %d %d 255\n" % (W, H) + r.stdout
        return None

    def _emit_tail(self, gen, tl, k0, t_start, W, H):
        """Pushes the tail frames [k0, pre*FPS). Returns number pushed, None = aborted."""
        F = self.FPS
        nt = int(round(tl["pre"] * F))
        hdr, size = b"P6 %d %d 255\n" % (W, H), W * H * 3
        for x in ([tl["x"], "fade"] if tl["x"] != "fade" else ["fade"]):
            cmd = self._tail_cmd(tl, x, W, H)
            if not cmd:
                return 0
            cmd += ["-f", "rawvideo", "-pix_fmt", "rgb24", "-"]
            proc = None
            n = 0
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, creationflags=NOWIN)
                while gen == self._gen and n < nt:
                    buf = proc.stdout.read(size)
                    if len(buf) < size:
                        break
                    if n >= k0 and not self._push(gen, ("frame", t_start + (n - k0) / float(F), hdr + buf, None)):
                        return None
                    n += 1
            except Exception:
                pass
            finally:
                try:
                    if proc is not None:
                        if proc.poll() is None:
                            proc.kill()
                        proc.stdout.close()
                except Exception:
                    pass
            if gen != self._gen:
                return None
            if n > k0:
                return n - k0
        return 0

    def _retheme(self):
        self._draw()

    # ───────── model helpers ─────────
    def _raw_dur(self, s):
        d = s.get("dur")
        return float(d) if d else (self.IMG_SEC if s.get("path") else self.GAP_SEC)

    def _dur(self, s):
        """Length of the slot on the timeline (after 'Cut clips' trimming, if on)."""
        return self._trim(s)[1]

    # ───────── Cut clips: trim silence before the first / after the last sound ─────────
    SIL_TH = 0.02            # peak level (0..1) that counts as "sound"

    def _cut_margin(self):
        """Margin in seconds to keep around the sound, or None when Cut clips is off / the box is not a number."""
        try:
            if self.cut_on.get() != "1":
                return None
            v = float(self.cut_val.get().strip().replace(",", "."))
        except (tk.TclError, ValueError):
            return None
        if v < 0:
            return None
        return v / 1000.0 if self.cut_unit.get().startswith("milli") else v

    def _sound_range(self, path):
        """(first, last) second of audible sound in the clip, or None (no audio / all silent / not analysed yet)."""
        pk = self._wave.get(path)
        if pk is None:
            self._wave_want(path)
            return None
        if path in self._srange:
            return self._srange[path]
        n, res, th = len(pk), None, self.SIL_TH
        if n:
            first = next((i for i in range(n) if pk[i] >= th and (i + 1 >= n or pk[i + 1] >= th)), None)
            if first is not None:
                last = next((i for i in range(n - 1, -1, -1) if pk[i] >= th and (i == 0 or pk[i - 1] >= th)), first)
                res = (first / float(self.WAVE_PPS), (last + 1) / float(self.WAVE_PPS))
        self._srange[path] = res
        return res

    def _trim(self, s):
        """(start offset inside the source clip, length used on the timeline)."""
        raw = self._raw_dur(s)
        m = self._cut_margin()
        p = s.get("path")
        if m is None or not p or not s.get("dur") or self._is_img(p):
            return 0.0, raw
        r = self._sound_range(p)
        if r is None:
            return 0.0, raw
        tin = max(0.0, r[0] - m)
        tout = min(raw, r[1] + m)
        if tout - tin < 0.1:
            tout = min(raw, tin + 0.1)
            tin = max(0.0, min(tin, tout - 0.1))
        return tin, tout - tin

    def _cut_widgets(self):
        on = self.cut_on.get() == "1"
        try:
            self.cut_ent.configure(state="normal" if on else "disabled")
            self.cut_cb.configure(state="readonly" if on else "disabled")
        except (AttributeError, tk.TclError):
            pass

    def _cut_changed(self):
        self._cut_widgets()
        self._cfg_touch()
        if self._loading:
            return
        self._cut_refresh_soon(350)

    def _cut_refresh_soon(self, ms=200):
        if self._cut_job is not None:
            try:
                self.after_cancel(self._cut_job)
            except Exception:
                pass
        self._cut_job = self.after(ms, self._cut_apply)

    def _cut_apply(self):
        self._cut_job = None
        self._edit_begin()
        self._changed()

    @staticmethod
    def _is_img(p):
        return os.path.splitext(p or "")[1].lower() in IMG_EXTS_T2

    def _new_slot(self, path=None, label="", dur=None):
        self._uid += 1
        return {"id": self._uid, "path": path, "label": label, "dur": dur, "thumb": None}

    def _label_of(self, path):
        return os.path.splitext(os.path.basename(path))[0]

    def _queue_media(self, s):
        p = s.get("path")
        if not p:
            return
        if self._is_img(p):
            s["dur"] = self.IMG_SEC
        else:
            self._probe_q.put((s["id"], p))
        self._thumb_req.add(p)
        self._thumb_q.put((s["id"], p))
        self._wave_want(p)

    def _slot_by_id(self, uid):
        for s in self.slots:
            if s["id"] == uid:
                return s
        return None

    def _edit_begin(self):
        self._pause()
        self._undo_push()

    # ───────── undo / redo ─────────
    def _snap(self):
        return {"slots": [dict(x) for x in self.slots], "sel": self.sel,
                "voice": (self.voice_path, self.voice_dur), "ovs": [dict(o) for o in self.ovs]}

    def _undo_push(self):
        if self._undoing:
            return
        self._undo.append(self._snap())
        del self._undo[:-100]
        self._redo.clear()
        self._undo_refresh()

    def _undo_refresh(self):
        try:
            self._undo_btn.set_enabled(bool(self._undo))
            self._redo_btn.set_enabled(bool(self._redo))
        except (AttributeError, tk.TclError):
            pass

    def _restore(self, snap):
        live = {x["id"]: x for x in self.slots}
        new = []
        for x in snap["slots"]:
            x = dict(x)
            lv = live.get(x["id"])
            if lv is not None and lv.get("path") == x.get("path"):      # background probe/thumb results ke harano jabe na
                for k, v in lv.items():
                    if k not in x or (x.get(k) is None and v is not None):
                        x[k] = v
            new.append(x)
        self.slots = new
        for x in self.slots:
            pth = x.get("path")
            if not pth:
                continue
            if self._is_img(pth):
                if x.get("dur") is None:
                    x["dur"] = self.IMG_SEC
                if not x.get("thumbs"):
                    self._thumb_req.add(pth)
                    self._thumb_q.put((x["id"], pth))
            else:
                if x.get("dur") is None:
                    self._probe_q.put((x["id"], pth))
                if not x.get("thumbs"):
                    self._thumb_req.add(pth)
                    self._thumb_q.put((x["id"], pth))
                    self._wave_want(pth)
        self.sel = snap["sel"] if (snap["sel"] is not None and snap["sel"] < len(self.slots)) else \
            (len(self.slots) - 1 if self.slots else None)
        self.ovs, self.ov_sel = [dict(o) for o in snap.get("ovs", [])], None
        vp, vd = snap["voice"]
        if vp != self.voice_path:
            self.voice_path, self.voice_dur = vp, vd
            self._cfg_touch()
        self._changed()

    def undo(self):
        if not self._undo:
            self.app.note("Undo korar moto kichu nei.", WARN)
            return
        self._pause()
        self._redo.append(self._snap())
        self._undoing = True
        try:
            self._restore(self._undo.pop())
        finally:
            self._undoing = False
        self._undo_refresh()
        self.app.note("↶ Undo hoyeche")

    def redo(self):
        if not self._redo:
            self.app.note("Redo korar moto kichu nei.", WARN)
            return
        self._pause()
        self._undo.append(self._snap())
        self._undoing = True
        try:
            self._restore(self._redo.pop())
        finally:
            self._undoing = False
        self._undo_refresh()
        self.app.note("↷ Redo hoyeche")

    def _on_undo_key(self, _e):
        if self._kbd_ok():
            self.undo()
            return "break"

    def _on_redo_key(self, _e):
        if self._kbd_ok():
            self.redo()
            return "break"

    # ───────── Hide Chrome (Fix voice er Chrome window) ─────────
    def _hide_chrome_changed(self):
        self._hide_flag = (self.hide_chrome.get() == "1")
        r = getattr(self, "_t2_runner", None)
        if r is not None:
            try:
                r.request_hidden(self._hide_flag)          # runner nijer thread e apply korbe
            except Exception:
                pass
        try:
            rec = self._rec()
            if rec is None:
                rec = load_recent()
            rec["t2_hide_chrome"] = bool(self._hide_flag)
            save_recent(rec)
        except Exception:
            pass
        try:
            self.app.note("Chrome hide ON — Fix voice er somoy Chrome screen e dekhabe na" if self._hide_flag
                          else "Chrome hide OFF — Fix voice er Chrome dekha jabe")
        except Exception:
            pass

    def _changed(self, reseek=True):
        self._cues_ok = False
        self._draw()
        self._stats()
        if self.sel is not None and self.sel >= len(self.slots):
            self.sel = len(self.slots) - 1 if self.slots else None
        self._sel_text()
        self.pv_cv.itemconfigure(self._pv_msg, state="hidden" if self.slots else "normal")
        self._set_time(min(self.cur_t, self._total))
        if reseek:
            self._seek_still(self.cur_t)
        self._save_soon()

    def _stats(self):
        n = sum(1 for s in self.slots if s["path"])
        e = len(self.slots) - n
        self.stat_lbl.configure(text=f"{n} clip  •  {len(self.slots)} slot" + (f"  •  {e} faka" if e else "") +
                                f"\nTotal: {fmt_ts(self._total)}")

    def _sel_text(self):
        i = self.sel
        if i is None or i >= len(self.slots):
            self.sel_lbl.configure(text="Block e click kore select koro")
            return
        s = self.slots[i]
        if s["path"]:
            self.sel_lbl.configure(text=f"Selected: #{i + 1}  •  {s['label']}  •  {self._dur(s):.1f}s")
        else:
            self.sel_lbl.configure(text=f"Selected: #{i + 1}  •  faka slot" + (f" (chhilo: {s['label']})" if s["label"] else ""))

    # ───────── import / edit actions ─────────
    def _media_only(self, paths):
        out = []
        for p in paths:
            if os.path.isdir(p):
                out += [os.path.join(p, f) for f in os.listdir(p)]
            else:
                out.append(p)
        ok = VIDEO_EXTS | IMG_EXTS_T2
        return [p for p in out if os.path.isfile(p) and os.path.splitext(p)[1].lower() in ok]

    def import_paths(self, paths, at=None):
        """at=None -> shesh e; at=N -> N number position e (0-based) dhukbe, porer clip gulo dane soray jabe."""
        paths = self._media_only(paths)
        if not paths:
            self.app.note("Kono video/image file pawa jayni.", WARN)
            return
        self._edit_begin()
        paths.sort(key=lambda p: natural_key(os.path.basename(p)))
        pos = len(self.slots) if at is None else max(0, min(int(at), len(self.slots)))
        first = pos
        for p in paths:
            s = self._new_slot(p, self._label_of(p))
            self.slots.insert(pos, s)
            pos += 1
            self._queue_media(s)
        if at is not None:
            self.sel = first
        where = "shesh e" if at is None else f"#{first + 1} position e"
        self.app.note(f"{len(paths)} ta clip {where} import hoyeche ✓")
        self._changed()

    def import_dialog(self, at=None):
        ps = filedialog.askopenfilenames(parent=self.app, title="Clips import koro", filetypes=T2_MEDIA_TYPES)
        if ps:
            self.import_paths(list(ps), at)

    def import_before_sel(self):
        if self._need_sel():
            self.import_dialog(self.sel)

    def import_after_sel(self):
        if self._need_sel():
            self.import_dialog(self.sel + 1)

    def import_folder(self):
        d = filedialog.askdirectory(parent=self.app, title="Clips er folder")
        if d:
            self.import_paths([d])

    def _need_sel(self):
        if self.sel is None or self.sel >= len(self.slots):
            self.app.note("Age timeline theke ekta block select koro.", WARN)
            return False
        return True

    def replace_sel(self):
        if self._need_sel():
            p = filedialog.askopenfilename(parent=self.app, title="Replace clip", filetypes=T2_MEDIA_TYPES)
            if p:
                self.replace_slot(self.sel, p)

    def replace_slot(self, i, path):
        if i is None or not (0 <= i < len(self.slots)) or not self._media_only([path]):
            return
        self._edit_begin()
        s = self.slots[i]
        s.update(path=path, label=self._label_of(path), dur=None, thumb=None)
        self._queue_media(s)
        self.sel = i
        self.app.note(f"Slot #{i + 1} e clip replace hoyeche ✓")
        self._changed()

    def remove_sel(self):
        if self._need_sel():
            self.remove_clip(self.sel)

    def remove_clip(self, i):
        s = self.slots[i]
        if not s["path"]:
            self.app.note("Ei slot ta already faka. Slot muchte 'Delete slot' chapo.", WARN)
            return
        self._edit_begin()
        s.update(path=None, thumb=None)          # keeps label + duration -> a gap of the same length
        self.app.note(f"Slot #{i + 1} er clip remove hoyeche — slot faka royeche ✓")
        self._changed()

    def delete_sel(self):
        if self._need_sel():
            self.delete_slot(self.sel)

    def delete_slot(self, i):
        self._edit_begin()
        self.slots.pop(i)
        self.sel = min(i, len(self.slots) - 1) if self.slots else None
        self.app.note(f"Slot #{i + 1} delete hoyeche ✓")
        self._changed()

    def move_sel(self, d):
        if not self._need_sel():
            return
        i, j = self.sel, self.sel + d
        if 0 <= j < len(self.slots):
            self._edit_begin()
            self.slots[i], self.slots[j] = self.slots[j], self.slots[i]
            self.sel = j
            self._changed()

    def add_empty(self, at=None):
        self._edit_begin()
        pos = at if at is not None else (self.sel + 1 if self.sel is not None else len(self.slots))
        self.slots.insert(pos, self._new_slot(None, "", self.GAP_SEC))
        self.sel = pos
        self._changed()

    def set_duration(self):
        if not self._need_sel():
            return
        s = self.slots[self.sel]
        if s["path"] and not self._is_img(s["path"]):
            self.app.note("Video clip er duration auto — shudhu image / faka slot er duration bodlano jay.", WARN)
            return
        v = simpledialog.askfloat("Duration", "Koto second?", parent=self.app, initialvalue=round(self._dur(s), 2),
                                  minvalue=0.2, maxvalue=3600)
        if v:
            self._edit_begin()
            s["dur"] = float(v)
            self._changed()

    def sort_by_name(self):
        if not self.slots:
            return
        self._edit_begin()
        cur = self.slots[self.sel]["id"] if self.sel is not None else None
        self.slots.sort(key=lambda s: natural_key(s["label"] or "\uffff"))
        if cur is not None:
            self.sel = next((k for k, s in enumerate(self.slots) if s["id"] == cur), None)
        self.app.note("Naam onujayi serially sajano hoyeche ✓")
        self._changed()

    def clear_all(self):
        if not self.slots and not self.voice_path:
            return
        if messagebox.askyesno("Clear", "Timeline er sob slot ar voice track muche felbe?\n(Tomar original file gulo thikই thakbe.)",
                               parent=self.app):
            self._edit_begin()
            self.slots, self.sel, self.cur_t = [], None, 0.0
            if self.voice_path:
                self.set_voice(None, undo=False)
            self._changed()

    def go_start(self):
        was = self._playing
        self._pause()
        self._set_time(0.0)
        self._seek_still(0.0)
        if was:
            self._play()

    def _aspect_changed(self):
        self.tl_cv.focus_set()
        was = self._playing
        self._pause()
        self._pv_configure()
        self._save_soon()
        if was:
            self._play()

    # ───────── drag & drop (called from App._on_drop while Tab 2 is open) ─────────
    def on_drop(self, event):
        raw = list(self.app.tk.splitlist(event.data))
        paths = self._media_only([p.strip() for p in raw])
        if not paths:
            self.app.note("Video/image file pawa jayni.", WARN)
            return event.action
        i = self._slot_at_root(event.x_root, event.y_root)
        if i is not None and len(paths) == 1:
            self.replace_slot(i, paths[0])
        else:
            self.import_paths(paths)
        return event.action

    def _slot_at_root(self, xr, yr):
        c = self.tl_cv
        x, y = xr - c.winfo_rootx(), yr - c.winfo_rooty()
        if 0 <= x <= c.winfo_width() and 0 <= y <= c.winfo_height():
            return self._slot_at_x(c.canvasx(x))
        return None

    # ───────── timeline drawing / geometry ─────────
    def _layout(self):
        geo, x, t = [], self.PAD, 0.0
        for s in self.slots:
            d = self._dur(s)
            w = max(self._floor(), d * self.pps)
            geo.append((x, x + w, t, d))
            x += w + self.GAPW
            t += d
        self._geo, self._total, self._end_x = geo, t, x

    def _slot_at_x(self, x):
        for i, (x0, x1, _t0, _d) in enumerate(self._geo):
            if x0 <= x <= x1 + self.GAPW / 2.0:
                return i
        return None

    def _x2t(self, x):
        if not self._geo:
            return 0.0
        for x0, x1, t0, d in self._geo:
            if x < x0:
                return t0
            if x <= x1:
                return t0 + (x - x0) / max(1.0, (x1 - x0)) * d
        return self._total

    def _t2x(self, t):
        if not self._geo:
            return self.PAD
        for x0, x1, t0, d in self._geo:
            if t <= t0 + d:
                return x0 + (max(t, t0) - t0) / max(0.001, d) * (x1 - x0)
        return self._geo[-1][1]

    def _badge(self, c, x, y, n):
        """Thumbnail er upor chhoto serial number badge."""
        t = str(n)
        w = 8 * len(t) + 10
        c.create_rectangle(x, y, x + w, y + 16, fill=BG, outline=ACCENT)
        c.create_text(x + w / 2.0, y + 8, text=t, fill=FG, font=(FONT, 9, "bold"))

    def _fit_text(self, text, px):
        n = max(3, int(px / 7.4))
        return text if len(text) <= n else text[:n - 1] + "…"

    def _thumb_img(self, s, maxw=96, maxh=9999):
        ths = s.get("thumbs")
        if not ths:
            sp = s.get("path")
            if sp and sp not in self._thumb_req and os.path.isfile(sp):     # self-heal: thumbnail nai? queue it
                self._thumb_req.add(sp)
                self._thumb_q.put((s["id"], sp))
            return None
        fits = [w for w in ths if w <= maxw and int(round(w * 54 / 96.0)) <= maxh]
        if not fits:
            return None
        p = ths[max(fits)]
        img = self._timg.get(p)
        if img is None:
            try:
                img = tk.PhotoImage(file=p)
            except tk.TclError:
                s["thumbs"] = None
                s["thumb"] = None
                try:
                    os.remove(p)
                except OSError:
                    pass
                return None
            self._timg[p] = img
        return img

    def _draw_soon(self):
        if self._draw_job is None:
            self._draw_job = self.after(30, self._draw)

    def _draw(self):
        self._draw_job = None
        c = self.tl_cv
        c.configure(bg=BG)
        c.delete("all")
        self._layout()
        H = self.TL_H
        sw = max(self._end_x + 160, c.winfo_width())
        self._sw = sw
        c.configure(scrollregion=(0, 0, sw, H))
        c.create_rectangle(0, 0, sw, self.RULER_H, fill=SIDE, outline="")
        y0 = self.RULER_H + 10 + self.OVL_H
        y1 = y0 + self.BLOCK_H
        for i, (s, (x0, x1, t0, d)) in enumerate(zip(self.slots, self._geo)):
            # ruler ticks
            bw = x1 - x0
            pxs = bw / max(0.001, d)
            if x0 - getattr(self, "_last_lbl_x", -999) >= 46 or i == 0:
                c.create_text(x0 + 2, 3, text=fmt_dur(t0), fill=MUTED, font=(FONT, 8), anchor="nw")
                self._last_lbl_x = x0
            if pxs >= 8:
                for k in range(1, int(d) + 1):
                    c.create_line(x0 + k * pxs, self.RULER_H - 5, x0 + k * pxs, self.RULER_H, fill=MUTED)
            sel = i == self.sel
            wide = bw >= 112
            if s["path"]:
                c.create_rectangle(x0, y0, x1, y1, fill=PANEL2, outline=ACCENT if sel else GHOST_HOV,
                                   width=2 if sel else 1)
                vid = not self._is_img(s["path"])
                if wide:
                    bh = self.BLOCK_H
                    txt = bh >= 84
                    wf_h = 0 if not vid else (18 if txt else 14)
                    reg_h = (bh - 36) if txt else (bh - wf_h)
                    img = self._thumb_img(s, int(bw - 12), int(reg_h - 10))
                    if img:
                        c.create_image(x0 + 6, y0 + (reg_h - img.height()) / 2.0, image=img, anchor="nw")
                    else:
                        c.create_rectangle(x0 + 6, y0 + 6, x0 + 102, y0 + max(12, reg_h - 6), fill=BG, outline="")
                        c.create_text(x0 + 54, y0 + reg_h / 2.0, text="…", fill=MUTED, font=(FONT, 12))
                    _by = (y0 + (reg_h - img.height()) / 2.0 + 3) if img else (y0 + 9)
                    self._badge(c, x0 + 9, _by, i + 1)
                    if txt:
                        right = ("✂ " if (self._cut_margin() is not None and abs(d - self._raw_dur(s)) > 0.001) else "") \
                            + f"{d:.1f}s"
                        _g = self._norm_gain(s["path"]) if vid else 1.0
                        if abs(_g - 1.0) > 0.03:
                            right += f"  {20 * math.log10(_g):+.0f}dB"
                        if vid and self._av_enabled and self._av_done.get("files", {}).get(s["path"]):
                            right += "  🎙✓"
                        c.create_text(x1 - 6, y1 - 36, text=right, fill=MUTED, font=(FONT, 9), anchor="ne")
                        c.create_text(x0 + 8, y1 - 36, text=self._fit_text(os.path.basename(s["path"]), bw - 24 - len(right) * 7),
                                      fill=FG, font=(FONT, 10, "bold"), anchor="nw")
                        if vid:
                            self._draw_wave(c, s["path"], x0 + 4, y1 - 20, x1 - 4, y1 - 4, s)
                        else:
                            c.create_text(x0 + 8, y1 - 18, text="(image — audio nai)", fill=MUTED,
                                          font=(FONT, 8), anchor="nw")
                    elif vid:
                        self._draw_wave(c, s["path"], x0 + 4, y1 - wf_h - 2, x1 - 4, y1 - 3, s)
                elif bw >= 22:
                    wf_h = 12 if vid else 0
                    nimg = self._thumb_img(s, int(bw - 6), int(self.BLOCK_H - 8 - wf_h))
                    cy_ = (y0 + y1 - wf_h) / 2.0
                    if nimg:
                        c.create_image((x0 + x1) / 2.0, cy_, image=nimg, anchor="center")
                        c.create_rectangle(x0 + 3, y0 + 3, x0 + 3 + 6 * len(str(i + 1)) + 8, y0 + 17,
                                           fill=BG, outline="")
                        c.create_text(x0 + 7, y0 + 10, text=str(i + 1), fill=FG, font=(FONT, 8, "bold"), anchor="w")
                    else:
                        c.create_rectangle(x0 + 2, y0 + 2, x1 - 2, y1 - 2 - wf_h, fill=BG, outline="")
                        c.create_text((x0 + x1) / 2.0, cy_, text=str(i + 1), fill=FG,
                                      font=(FONT, 8, "bold"))
                    if vid:
                        self._draw_wave(c, s["path"], x0 + 2, y1 - wf_h - 1, x1 - 2, y1 - 2, s)
            else:
                c.create_rectangle(x0, y0, x1, y1, fill=BG, outline=ACCENT if sel else MUTED,
                                   dash=(5, 4) if wide else None, width=2 if sel else 1)
                if wide:
                    cx = (x0 + x1) / 2.0
                    c.create_text(cx, y0 + 34, text="Faka", fill=MUTED, font=(FONT, 11, "bold"))
                    if s["label"]:
                        c.create_text(cx, y0 + 54, text=self._fit_text("(" + s["label"] + ")", bw - 10),
                                      fill=MUTED, font=(FONT, 9))
                    c.create_text(cx, y0 + 74, text=f"{d:.1f}s", fill=MUTED, font=(FONT, 9))
            if wide and not (s["path"] and self.BLOCK_H >= 84):
                if s["path"]:
                    c.create_text(x0 + 8, y1 - 5, text=self._fit_text(os.path.basename(s["path"]), bw - 16),
                                  fill=MUTED, font=(FONT, 8), anchor="sw")
                else:
                    _nm = f"#{i + 1}  {s['label']}" if s["label"] else f"#{i + 1}"
                    c.create_text(x1 - 6, y1 - 5, text=self._fit_text(_nm, bw - 12), fill=MUTED, font=(FONT, 8), anchor="se")
            if bw >= 30 and i > 0 and self._tr_cur() and s["path"] and self.slots[i - 1]["path"]:      # transition marker
                jx, jy = x0 - self.GAPW / 2.0, y0 + self.BLOCK_H / 2.0
                c.create_polygon(jx, jy - 9, jx + 9, jy, jx, jy + 9, jx - 9, jy, fill=ACCENT, outline=BG, width=2)
        self._last_lbl_x = -999
        # ── voice track row (under the clips)
        vy0, vy1 = y1 + 8, y1 + 30
        if self.voice_path and self.voice_dur > 0:
            vx1 = max(self.PAD + 20, self._t2x(min(self.voice_dur, self._total)) if self._total else self.PAD + 200)
            c.create_rectangle(self.PAD, vy0, vx1, vy1, fill="#1f7a4d", outline="#2fbf7a")
            c.create_text(self.PAD + 8, (vy0 + vy1) / 2.0, anchor="w", fill="#ffffff", font=(FONT, 9, "bold"),
                          text=self._fit_text("🎙 " + os.path.basename(self.voice_path), vx1 - self.PAD - 12))
        else:
            c.create_text(self.PAD, (vy0 + vy1) / 2.0, anchor="w", fill=MUTED, font=(FONT, 8),
                          text="Voice track nai — 'Import voice' ba 'Fix voice' chap")
        self._draw_ovl(c)
        self._ph_line = c.create_line(0, 0, 0, H, fill=self.PLAYHEAD, width=2)
        self._ph_head = c.create_polygon(0, 0, 0, 0, 0, 0, fill=self.PLAYHEAD, outline="")
        self._update_playhead()

    # ───────── light leak OVERLAY line (sits above the clips; screen-blended, never a transition) ─────────
    def _ovl_y(self):
        return self.RULER_H + 3, self.RULER_H + self.OVL_H - 3

    def _ov_dur(self, ov):
        try:
            t0, t1, _tr = _lk_trim_of(ov["p"])
            return max(0.1, float(t1 - t0))
        except Exception:
            return 1.0

    def _ov_x(self, ov):
        d = self._ov_dur(ov)
        x0 = self._t2x(ov["t"])
        x1 = self._t2x(min(ov["t"] + d, max(self._total, ov["t"])))
        return x0, max(x1, x0 + 10)

    def _draw_ovl(self, c):
        y0, y1 = self._ovl_y()
        c.create_rectangle(0, y0, max(self._sw, 10), y1, fill=PANEL, outline="")
        auto = self._auto_ovs()
        if not self.ovs and not auto:
            c.create_text(self.PAD, (y0 + y1) / 2.0, anchor="w", fill=MUTED, font=(FONT, 8),
                          text="\u2728 Overlay line \u2014 light leak tile e click korle prottek cut e boshbe; ekhane right-click kore alada-o boshano jay")
        for ov in auto:
            x0, x1 = self._ov_x(ov)
            c.create_rectangle(x0, y0, x1, y1, fill="#7c2d12", outline="#f97316")
            c.create_text(x0 + 4, (y0 + y1) / 2.0, anchor="w", fill="#fed7aa", font=(FONT, 8),
                          text=self._fit_text("\u2728 " + ov["name"], x1 - x0 - 6))
        for k, ov in enumerate(self.ovs):
            x0, x1 = self._ov_x(ov)
            sel = k == self.ov_sel
            c.create_rectangle(x0, y0, x1, y1, fill="#b45309", outline="#ffffff" if sel else "#fbbf24",
                               width=2 if sel else 1)
            c.create_text(x0 + 5, (y0 + y1) / 2.0, anchor="w", fill="#ffffff", font=(FONT, 8, "bold"),
                          text=self._fit_text("\u2728 " + ov["name"], x1 - x0 - 8))

    def _ov_at(self, x, y):
        y0, y1 = self._ovl_y()
        if not (y0 <= y <= y1):
            return None
        for k in range(len(self.ovs) - 1, -1, -1):
            x0, x1 = self._ov_x(self.ovs[k])
            if x0 <= x <= x1:
                return k
        return None

    def _ov_press(self, k, x):
        self._pause()
        self.ov_sel = k
        self._ov_drag = {"k": k, "dx": self._x2t(x) - self.ovs[k]["t"], "undo": False}
        self._draw()

    def _ov_move(self, x):
        d = self._ov_drag
        if not d or d["k"] >= len(self.ovs):
            return
        ov = self.ovs[d["k"]]
        t = round(max(0.0, min(self._x2t(x) - d["dx"], max(0.0, self._total - 0.1))), 2)
        if abs(t - ov["t"]) < 0.005:
            return
        if not d["undo"]:
            self._undo_push()
            d["undo"] = True
        ov["t"] = t
        self._draw_soon()
        self._set_time(t)

    def _ov_add(self, name, t=None):
        p = self._lk_path(name) if name else None
        if not p:
            self.app.note("Age ekta light leak template select koro.", WARN)
            return
        if not self.slots or self._total <= 0.05:
            self.app.note("Age clips import koro, tarpor overlay boshao.", WARN)
            return
        t = self.cur_t if t is None else t
        t = max(0.0, min(float(t), max(0.0, self._total - 0.1)))
        self._edit_begin()
        self.ovs.append({"name": name, "p": p, "t": round(t, 2)})
        self.ov_sel = len(self.ovs) - 1
        self._cfg_dirty = True
        self._changed()
        self.app.note(f"✨ {name} overlay boshano hoyeche ({fmt_ts(t)}) — drag kore soraao, Delete e muchhe jabe ✓")

    def _ov_add_cur(self):
        self._ov_add(self.trans_key)

    def _ov_delete(self, k):
        if k is None or not (0 <= k < len(self.ovs)):
            return
        self._edit_begin()
        del self.ovs[k]
        self.ov_sel = None
        self._cfg_dirty = True
        self._changed()

    def _ov_to_playhead(self, k):
        if 0 <= k < len(self.ovs):
            self._edit_begin()
            self.ovs[k]["t"] = round(max(0.0, min(self.cur_t, max(0.0, self._total - 0.1))), 2)
            self._cfg_dirty = True
            self._changed()

    def _ov_menu(self, e, k):
        self._tl_tip_hide()
        t = self._x2t(self.tl_cv.canvasx(e.x))
        kw = dict(tearoff=0, bg=PANEL2, fg=FG, activebackground=ACCENT, activeforeground=ACCENT_FG)
        m = tk.Menu(self.app, **kw)
        if k is not None:
            self.ov_sel = k
            self._draw()
            m.add_command(label="⏮ Start = playhead", command=lambda: self._ov_to_playhead(k))
            m.add_command(label="\U0001F5D1 Overlay muchho", command=lambda: self._ov_delete(k))
            m.add_separator()
        sub = tk.Menu(m, **kw)
        for n, x, _m in T2_TRANSITIONS:
            if isinstance(x, str) and x.startswith("LK:"):
                sub.add_command(label=n, command=lambda n=n, t=t: self._ov_add(n, t))
        m.add_cascade(label="✨ Ekhane light leak boshao", menu=sub)
        try:
            m.tk_popup(e.x_root, e.y_root)
        finally:
            m.grab_release()

    # preview: the leak frames are made once (ffmpeg -> PNG with alpha) and laid over the preview picture
    OV_FPS = 12

    def _lk_op(self):
        try:
            return max(0, min(100, int(self.lk_op.get())))
        except (tk.TclError, ValueError):
            return 100

    def _lk_op_changed(self):
        self._cfg_touch()
        job = getattr(self, "_lk_op_job", None)
        if job:
            try:
                self.after_cancel(job)
            except Exception:
                pass
        self._lk_op_job = self.after(300, lambda: self._ov_show(self.cur_t))

    def _auto_ovs(self):
        """Selected light leak = an overlay on EVERY cut between two clips (centred on the cut, + Position slider)."""
        p = self._lk_path(self.trans_key) if self.trans_key else None
        if not p or len(self.slots) < 2:
            return []
        geo = getattr(self, "_geo", None) or []
        d = self._ov_dur({"p": p})
        off = self._tr_off()
        out = []
        for i in range(1, min(len(self.slots), len(geo))):
            if self.slots[i]["path"] and self.slots[i - 1]["path"]:
                out.append({"name": self.trans_key, "p": p, "auto": True,
                            "t": max(0.0, round(geo[i][2] - d / 2.0 + off, 3))})
        return out

    def _all_ovs(self):
        return self._auto_ovs() + self.ovs

    def _ov_show(self, t):
        try:
            cv = self.pv_cv
            hit = None
            for ov in self._all_ovs():
                d = self._ov_dur(ov)
                if ov["t"] - 0.001 <= t < ov["t"] + d:
                    hit = (ov, d)
                    break
            if hit is None or self._pv_item is None:
                if self._ov_item is not None:
                    cv.itemconfigure(self._ov_item, state="hidden")
                return
            ov, d = hit
            W, H = self._rsz()
            frames = self._ov_frames(ov, W, H)
            if not frames:
                if self._ov_item is not None:
                    cv.itemconfigure(self._ov_item, state="hidden")
                return
            k = max(0, min(len(frames) - 1, int((t - ov["t"]) / d * len(frames))))
            cx, cy = cv.winfo_width() // 2, cv.winfo_height() // 2
            if self._ov_item is None:
                self._ov_item = cv.create_image(cx, cy, image=frames[k])
            else:
                cv.itemconfigure(self._ov_item, image=frames[k], state="normal")
                cv.coords(self._ov_item, cx, cy)
            cv.tag_raise(self._ov_item, self._pv_item)
            cv.tag_raise(self._pv_border)
            cv.tag_raise("t2sub")
        except Exception:
            pass

    def _ov_frames(self, ov, W, H):
        t0, t1, _tr = _lk_trim_of(ov["p"])
        key = (ov["p"], round(t0, 3), round(t1, 3), W, H, int(round(self._lk_op() / 5.0)) * 5)
        got = self._ov_cache.get(key)
        if got is not None:
            return got
        if key not in self._ov_busy:
            self._ov_busy.add(key)
            threading.Thread(target=self._ov_frames_worker, args=(key,), daemon=True).start()
        return None

    def _ov_frames_worker(self, key):
        p, t0, t1, W, H, op = key
        parts = []
        try:
            add_ffmpeg_path()
            mx = "max(r(X,Y),max(g(X,Y),b(X,Y)))"
            vf = (f"fps={self.OV_FPS},scale={W}:{H}:force_original_aspect_ratio=increase,crop={W}:{H},format=rgba,"
                  f"geq=r='255*r(X,Y)/max(1,{mx})':g='255*g(X,Y)/max(1,{mx})':b='255*b(X,Y)/max(1,{mx})':a='{mx}*{op / 100.0:.2f}'")
            r = subprocess.run(["ffmpeg", "-v", "error", "-ss", f"{t0:.3f}", "-t", f"{max(0.1, t1 - t0):.3f}", "-i", p,
                                "-an", "-vf", vf, "-f", "image2pipe", "-c:v", "png", "-"],
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, creationflags=NOWIN, timeout=120)
            sig = b"\x89PNG\r\n\x1a\n"
            parts = [sig + b for b in r.stdout.split(sig) if b]
        except FileNotFoundError:
            self._q.put(("noff",))
        except Exception:
            parts = []
        self._q.put(("ovframes", key, parts))

    def _ov_frames_ready(self, key, parts):
        self._ov_busy.discard(key)
        imgs = []
        for b in parts or []:
            try:
                imgs.append(tk.PhotoImage(data=base64.b64encode(b)))
            except tk.TclError:
                pass
        if len(self._ov_cache) > 8:
            self._ov_cache.clear()
        self._ov_cache[key] = imgs
        self._ov_show(self.cur_t)

    def _ov_export_list(self):
        out = []
        for ov in self._all_ovs():
            p = ov.get("p")
            if p and os.path.isfile(p):
                t0, t1, _tr = _lk_trim_of(p)
                out.append({"p": p, "t": float(ov["t"]), "t0": t0, "t1": t1, "op": self._lk_op() / 100.0})
        return out

    def _t2_ovl_graph(self, ovs, W, H):
        """(extra ffmpeg inputs, filter parts, last label) - input 0 = the joined video, overlays = inputs 1..N.
        FAST: shudhu leak er window e RGB blend hoy; baki ongsho yuv420p te ei pass kore (tpad-black / full-length blend nai)."""
        F = self.FPS
        wins = []
        for n, o in sorted(enumerate(ovs, 1), key=lambda x: x[1]["t"]):
            d = max(0.1, o["t1"] - o["t0"])
            sf = max(0, int(round(o["t"] * F)))
            wins.append((n, o, sf, sf + max(1, int(round(d * F)))))
        if any(b[2] < a[3] for a, b in zip(wins, wins[1:])):      # overlap -> purono (dhire) chain
            return self._t2_ovl_graph_legacy(ovs, W, H)
        ins = []
        for o in ovs:
            d = max(0.1, o["t1"] - o["t0"])
            ins += ["-ss", f"{o['t0']:.3f}", "-t", f"{d:.3f}", "-i", o["p"]]
        segs, pos = [], 0
        for n, o, sf, ef in wins:
            if sf > pos:
                segs.append(("g", pos, sf, None))
            segs.append(("w", sf, ef, (n, o)))
            pos = ef
        segs.append(("g", pos, None, None))
        m = len(segs)
        parts = [f"[0:v]split={m}" + "".join(f"[s{k}]" for k in range(m))]
        outs = []
        for k, (kind, sf, ef, info) in enumerate(segs):
            rng = f"start_frame={sf}" + (f":end_frame={ef}" if ef is not None else "")
            if kind == "g":
                parts.append(f"[s{k}]trim={rng},setpts=PTS-STARTPTS[p{k}]")
            else:
                n, o = info
                parts.append(f"[s{k}]trim={rng},setpts=PTS-STARTPTS,format=gbrp[w{k}]")
                parts.append(f"[{n}:v]setpts=PTS-STARTPTS,fps={F},scale={W}:{H}:force_original_aspect_ratio=increase,"
                             f"crop={W}:{H},trim=end_frame={ef - sf},format=gbrp[l{k}]")
                parts.append(f"[w{k}][l{k}]blend=all_mode=screen:all_opacity={o.get('op', 1.0):.3f}:eof_action=pass,"
                             f"format=yuv420p,setpts=PTS-STARTPTS[p{k}]")
            outs.append(f"[p{k}]")
        parts.append("".join(outs) + f"concat=n={m}:v=1:a=0,fps={F}[vo]")
        return ins, parts, "vo"

    def _t2_ovl_graph_legacy(self, ovs, W, H):
        F = self.FPS
        ins, parts, last = [], ["[0:v]format=gbrp[v0]"], "v0"
        for n, o in enumerate(ovs, 1):
            d = max(0.1, o["t1"] - o["t0"])
            ins += ["-ss", f"{o['t0']:.3f}", "-t", f"{d:.3f}", "-i", o["p"]]
            parts.append(f"[{n}:v]setpts=PTS-STARTPTS,fps={F},scale={W}:{H}:force_original_aspect_ratio=increase,"
                         f"crop={W}:{H},tpad=start_duration={o['t']:.3f}:color=black,format=gbrp[l{n}]")
            parts.append(f"[{last}][l{n}]blend=all_mode=screen:all_opacity={o.get('op', 1.0):.3f}:eof_action=pass[v{n}]")
            last = f"v{n}"
        return ins, parts, last

    def _t2_apply_ovl(self, src, dst, ovs, W, H, total, venc):
        """Screen-blend every overlay (light leak) onto the joined video at its timeline position."""
        F = self.FPS
        ins_o, parts, last = self._t2_ovl_graph(ovs, W, H)
        ins = ["-i", src] + ins_o
        parts.append(f"[{last}]format=yuv420p[o]")
        cmd = ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error"] + ins + \
              ["-filter_complex", ";".join(parts), "-map", "[o]", "-an", "-r", str(F)] + list(venc) + \
              ["-pix_fmt", "yuv420p", "-t", f"{total:.3f}", dst]
        rc, err = self._run_ff(cmd)
        return (rc == 0 and os.path.isfile(dst) and os.path.getsize(dst) > 0), err

    # ───────── audio waveform under each clip ─────────
    WAVE_RATE, WAVE_PPS = 4000, 40           # decode rate (Hz), peak buckets per second

    def _wave_want(self, path):
        if path and path not in self._wave and path not in self._wave_req and os.path.isfile(path):
            self._wave_req.add(path)
            self._wave_q.put(path)

    def _wave_analyze(self, path):
        """-> (peaks, rms). peaks = 40/sec level envelope (0..1); rms = loudness of the *sound* parts (0 = no sound).
        Cached on disk (TOOLS/_t2wave). Raises when ffmpeg is missing."""
        import array
        add_ffmpeg_path()
        st = os.stat(path)
        d = os.path.join(TOOLS, "_t2wave")
        os.makedirs(d, exist_ok=True)
        key = hashlib.md5(f"{path}{st.st_mtime}{st.st_size}v3".encode()).hexdigest()[:16]
        cache = os.path.join(d, key + ".json")
        try:
            with open(cache, "r", encoding="utf-8") as fh:
                c = json.load(fh)
            if isinstance(c, dict) and isinstance(c.get("p"), list):
                return c["p"], float(c.get("rms") or 0.0)
        except Exception:
            pass
        r = subprocess.run(["ffmpeg", "-v", "error", "-i", path, "-vn", "-ac", "1",
                            "-ar", str(self.WAVE_RATE), "-f", "s16le", "-"],
                           creationflags=NOWIN, timeout=600, stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL)
        a = array.array("h")
        a.frombytes(r.stdout[:len(r.stdout) // 2 * 2])
        if sys.byteorder == "big":
            a.byteswap()
        n = max(1, self.WAVE_RATE // self.WAVE_PPS)
        peaks, raw_pk = [], []
        for k in range(0, len(a), n):
            seg = a[k:k + n]
            pk = max(max(seg), -min(seg)) / 32768.0
            raw_pk.append(pk)
            peaks.append(round(pk, 3))
        # loudness of the *speech* parts only: buckets clearly above this clip's own noise / pauses
        thr = max(0.002, 0.15 * (max(raw_pk) if raw_pk else 0.0))
        ssq, cnt = 0.0, 0
        for bi, pk in enumerate(raw_pk):
            if pk >= thr:
                seg = a[bi * n:(bi + 1) * n]
                ssq += sum(x * x for x in seg)
                cnt += len(seg)
        rms = math.sqrt(ssq / cnt) / 32768.0 if cnt else 0.0
        if peaks or r.returncode == 0:
            try:
                with open(cache, "w", encoding="utf-8") as fh:
                    json.dump({"p": peaks, "rms": round(rms, 5)}, fh)
            except OSError:
                pass
        return peaks, rms

    def _wave_worker(self):
        while True:
            path = self._wave_q.get()
            try:
                peaks, rms = self._wave_analyze(path)
                self._wrms[path] = rms
                self._wave[path] = peaks
                self._wave_cols = {}
                self._q.put(("wave", path))
            except FileNotFoundError:
                pass                                        # ffmpeg nai — pore abar chesta hobe
            except Exception:
                self._wave[path], self._wrms[path] = [], 0.0   # poRa jay na: "no audio" dhore nao
                self._q.put(("wave", path))
            finally:
                self._wave_req.discard(path)

    # ───────── Auto volume: every clip's voice at the same loudness ─────────
    NORM_TARGET = 0.12                  # RMS target (about -18 dBFS)

    def _norm_gain(self, path):
        """Gain (linear) that brings this clip's voice to the common level; 1.0 when Auto volume is off."""
        if self.norm_on.get() != "1" or not path or self._is_img(path):
            return 1.0
        if self._av_src(path) != path:                       # Auto voice e volume already balanced
            return 1.0
        r = self._wrms.get(path)
        if r is None:
            self._wave_want(path)
            return 1.0
        if r < 0.002:
            return 1.0
        return max(0.2, min(5.0, self.NORM_TARGET / r))

    def _norm_changed(self):
        self._av_enabled = (self.norm_on.get() == "1")
        self._cfg_touch()
        if self._loading:
            return
        if self._playing:
            self._pause()
        for sl in self.slots:                            # make sure every clip gets analysed
            if sl.get("path"):
                self._norm_gain(sl["path"])
        if self._av_enabled:
            self._av_kick()
            if self._av_clip_paths():
                self.app.note("Auto voice shuru hoyeche — clip gulor voice thik hochhe…")
        self._draw_soon()

    def _analysis_pending(self):
        """True (+ queues the work) when Cut clips / Auto voice need audio analysis that is not finished yet."""
        if self._av_pending():
            return True
        if self.norm_on.get() != "1" and self._cut_margin() is None:
            return False
        pend = False
        for sl in self.slots:
            p = sl.get("path")
            if p and not self._is_img(p) and os.path.isfile(p) and (p not in self._wave or p not in self._wrms):
                self._wave_want(p)
                pend = True
        return pend

    # ───────── Auto voice: clip gulor voice (noise / tone / volume) clip er moddhei thik kore ─────────
    _AV_VER = "v1"

    def _av_dir(self):
        d = os.path.join(tempfile.gettempdir(), "ave_autovoice")
        os.makedirs(d, exist_ok=True)
        return d

    @staticmethod
    def _av_key(path):
        try:
            st = os.stat(path)
            raw = f"{os.path.abspath(path)}|{st.st_mtime_ns}|{st.st_size}"
        except OSError:
            raw = os.path.abspath(str(path))
        return hashlib.md5(raw.encode("utf-8", "ignore")).hexdigest()[:16]

    def _av_clip_paths(self):
        out, seen = [], set()
        for sl in self.slots:
            p = sl.get("path")
            if p and p not in seen and os.path.isfile(p) and not self._is_img(p):
                seen.add(p)
                out.append(p)
        return out

    def _av_cur_setsig(self):
        keys = sorted(self._av_key(p) for p in self._av_clip_paths())
        return hashlib.md5(("|".join(keys) + self._AV_VER).encode()).hexdigest()

    def _av_src(self, path):
        """Auto voice on + clip process hoye gele: thik kora audio file. Na hole original clip."""
        if not self._av_enabled or not path:
            return path
        f = self._av_done.get("files", {}).get(path)
        if f and os.path.isfile(f):
            return f
        return path

    def _av_pending(self):
        """True = Auto voice ekhono process kortese (ba shuru korlam). Main thread theke dako."""
        if not self._av_enabled:
            return False
        if self._av_busy:
            return True
        if not self._av_clip_paths():
            return False
        if self._av_done.get("setsig") != self._av_cur_setsig():
            self._av_kick()
            return True
        return False

    def _av_kick(self):
        if self._av_busy or not self._av_enabled:
            return
        paths = self._av_clip_paths()
        if not paths:
            return
        self._av_busy = True
        sig = self._av_cur_setsig()
        threading.Thread(target=self._av_worker, args=(paths, sig), daemon=True).start()

    def _av_say(self, msg):
        try:
            self.after(0, lambda m=str(msg): self.app.note(m))
        except Exception:
            pass

    def _av_worker(self, paths, sig):
        add_ffmpeg_path()
        files, msg = {}, ""
        try:
            files, msg = self._av_process(paths)
        except Exception as e:
            msg = "error: " + (str(e) or type(e).__name__)
        self._av_done = {"setsig": sig, "files": files}
        n, tot = len(files), len(paths)
        try:
            self.after(0, lambda: self._av_finished(n, tot, msg))
        except Exception:
            self._av_busy = False

    def _av_finished(self, n, tot, msg):
        self._av_busy = False
        if self._av_enabled and self._av_clip_paths() and self._av_done.get("setsig") != self._av_cur_setsig():
            self._av_kick()                               # process er shomoy clips bodlayeche -> abar
            return
        if msg:
            self.app.note("Auto voice: " + msg, WARN)
        else:
            self.app.note(f"Auto voice ready — {n}/{tot} clip er voice thik hoyeche. Ekhon Play / Export korte paro.", OK)
        self._draw_soon()

    def _av_numpy(self):
        try:
            import numpy as np
            return np
        except ImportError:
            pass
        if self._av_np_tried:
            return None
        self._av_np_tried = True
        self._av_say("Auto voice: numpy install hochhe (shudhu prothombar, ektu somoy lagbe)…")
        try:
            subprocess.run([sys.executable, "-m", "pip", "install", "--quiet", "--disable-pip-version-check", "numpy"],
                           capture_output=True, creationflags=NOWIN, timeout=900)
            import importlib
            importlib.invalidate_caches()
            import numpy as np
            return np
        except Exception:
            return None

    def _av_process(self, paths):
        """Returns ({original_path: fixed_wav}, warning_text)."""
        DSP = _AutoVoiceDSP
        SR = DSP.SR
        ff = shutil.which("ffmpeg") or "ffmpeg"
        d = self._av_dir()
        warn = ""
        try:                                              # purono cache (3 din+) muche fela
            now = time.time()
            for fn in os.listdir(d):
                fp = os.path.join(d, fn)
                if now - os.path.getmtime(fp) > 3 * 86400:
                    os.remove(fp)
        except OSError:
            pass
        tot = len(paths)
        # 1) shob clip theke audio ber + noise remove
        raws = {}
        for i, p in enumerate(paths):
            self._av_say(f"Auto voice: audio ber + noise remove {i + 1}/{tot} …")
            key = self._av_key(p)
            raw = os.path.join(d, f"raw_{key}.f32")
            if not (os.path.isfile(raw) and os.path.getsize(raw) > 3200):
                tmp = raw + ".part"
                r = subprocess.run([ff, "-y", "-hide_banner", "-loglevel", "error", "-i", p, "-vn",
                                    "-af", DSP.AF_EXTRACT, "-ac", "1", "-ar", str(SR), "-f", "f32le", tmp],
                                   capture_output=True, creationflags=NOWIN)
                if r.returncode != 0 or not os.path.isfile(tmp) or os.path.getsize(tmp) < 3200:
                    try:
                        os.remove(tmp)
                    except OSError:
                        pass
                    continue                              # ei clip e audio nai
                os.replace(tmp, raw)
            raws[p] = (key, raw)
        if not raws:
            return {}, "kono clip e audio paoa jayni."
        # 2) tone analysis + reference
        np = self._av_numpy()
        curves, ref = {}, None
        if np is not None and len(raws) > 1:
            for i, (p, (key, raw)) in enumerate(raws.items()):
                self._av_say(f"Auto voice: golar tone mapa hochhe {i + 1}/{len(raws)} …")
                cv = self._av_ltas.get(key)
                if cv is None:
                    cv = DSP.ltas(np, np.fromfile(raw, dtype="<f4"))
                    self._av_ltas[key] = cv
                curves[p] = cv
            ref = DSP.pick_reference(np, curves)
        elif np is None:
            warn = "numpy paoa jayni — tone match hoyni (noise + volume thik hoyeche). CMD te 'pip install numpy' dao."
        refkey = self._av_key(ref) if ref else "solo"
        # 3) tone match + compressor + loudness
        files = {}
        for i, (p, (key, raw)) in enumerate(raws.items()):
            self._av_say(f"Auto voice: voice thik hochhe {i + 1}/{len(raws)} …")
            out = os.path.join(d, f"fixed_{key}_{refkey}_{self._AV_VER}.wav")
            if os.path.isfile(out) and os.path.getsize(out) > 1000:
                files[p] = out
                continue
            src, eq = raw, None
            if ref is not None and p != ref:
                x = np.fromfile(raw, dtype="<f4")
                y = DSP.apply_eq(np, x, DSP.eq_curve(np, curves[ref], curves[p]))
                pk = float(np.max(np.abs(y))) if len(y) else 0.0
                if pk > 0.98:
                    y = y * (0.98 / pk)
                eq = os.path.join(d, f"eq_{key}_{refkey}.f32")
                y.astype("<f4").tofile(eq)
                src = eq
            dur = os.path.getsize(src) // 4 / float(SR)
            tmp = out + ".part.wav"
            r = subprocess.run([ff, "-y", "-hide_banner", "-loglevel", "error", "-f", "f32le", "-ar", str(SR),
                                "-ac", "1", "-i", src, "-af", DSP.AF_FIX + ",apad", "-t", f"{dur:.3f}",
                                "-ar", str(SR), "-ac", "1", "-c:a", "pcm_s16le", tmp],
                               capture_output=True, creationflags=NOWIN)
            if eq:
                try:
                    os.remove(eq)
                except OSError:
                    pass
            if r.returncode == 0 and os.path.isfile(tmp) and os.path.getsize(tmp) > 1000:
                os.replace(tmp, out)
                files[p] = out
            else:
                try:
                    os.remove(tmp)
                except OSError:
                    pass
                warn = warn or "kichu clip process hoyni (original sound-i thakbe)."
        return files, warn

    def _wave_cols_for(self, path, n, i0=0, i1=None):
        key = (path, n, i0, i1)
        got = self._wave_cols.get(key)
        if got is None:
            pk = (self._wave.get(path) or [])[i0:i1]
            m = len(pk)
            got = []
            if m:
                for k in range(n):
                    a = int(k * m / n)
                    b = max(a + 1, int((k + 1) * m / n))
                    got.append(max(pk[a:b]))
                ref = max(max(got), 0.12)
                got = [min(1.0, (v / ref) ** 0.75) for v in got]
            if len(self._wave_cols) > 400:
                self._wave_cols = {}
            self._wave_cols[key] = got
        return got

    def _draw_wave(self, c, path, x0, y0, x1, y1, s=None):
        """Little waveform strip: shows where the clip has sound (and where it is silent)."""
        if x1 - x0 < 8 or y1 - y0 < 5:
            return
        c.create_rectangle(x0, y0, x1, y1, fill=BG, outline="")
        cy = (y0 + y1) / 2.0
        pk = self._wave.get(path)
        if pk is None:
            self._wave_want(path)
            c.create_line(x0, cy, x1, cy, fill=GHOST_HOV, dash=(2, 3))
            return
        if not pk:
            c.create_line(x0, cy, x1, cy, fill=GHOST_HOV)
            if x1 - x0 >= 80 and y1 - y0 >= 10:
                c.create_text(x0 + 4, cy, text="no audio", fill=MUTED, font=(FONT, 7), anchor="w")
            return
        n = max(4, min(int((x1 - x0) / 2), 500))
        i0, i1 = 0, None
        if s is not None:
            tin, dd = self._trim(s)
            i0, i1 = int(tin * self.WAVE_PPS), int((tin + dd) * self.WAVE_PPS) + 1
        cols = self._wave_cols_for(path, n, i0, i1)
        half = (y1 - y0) / 2.0 - 1
        step = (x1 - x0) / float(n)
        up, dn = [], []
        for k, v in enumerate(cols):
            x = x0 + (k + 0.5) * step
            a = max(0.6, v * half)
            up += [x, cy - a]
            dn = [x, cy + a] + dn
        c.create_polygon(up + dn, fill="#38bdf8", outline="")
        c.create_line(x0, cy, x1, cy, fill="#7dd3fc")

    def _update_playhead(self):
        c = self.tl_cv
        try:
            x = self._t2x(self.cur_t)
            H = self.TL_H
            c.coords(self._ph_line, x, 0, x, H)
            c.coords(self._ph_head, x - 6, 0, x + 6, 0, x, 9)
            c.tag_raise(self._ph_line)
            c.tag_raise(self._ph_head)
        except (AttributeError, tk.TclError):
            pass

    def _follow(self):
        c = self.tl_cv
        x = self._t2x(self.cur_t)
        lo, hi = c.xview()
        left, right = lo * self._sw, hi * self._sw
        if x > right - 50 or x < left:
            c.xview_moveto(max(0.0, (x - 80) / max(1.0, self._sw)))

    def _set_time(self, t):
        self.cur_t = min(max(0.0, t), self._total)
        self._update_playhead()
        self.time_lbl.configure(text=f"{fmt_ts(self.cur_t)} / {fmt_ts(self._total)}")
        self._sub_sync()
        self._ov_show(self.cur_t)

    def _zoom(self, f, anchor_t=None):
        """Zoom with no hard lower limit: clips can shrink until the whole timeline fits on screen."""
        t = self.cur_t if anchor_t is None else anchor_t
        self.pps = min(self.PPS_MAX, max(self.PPS_MIN, self.pps * f))
        self._draw()
        try:                                  # keep the playhead roughly where it was on screen
            self.tl_cv.xview_moveto(max(0.0, (self._t2x(t) - self.tl_cv.winfo_width() / 2.0) / max(1.0, self._sw)))
        except tk.TclError:
            pass
        self._save_soon()

    def _zoom_fit(self):
        """Zoom out/in so ALL clips are visible without side scrolling."""
        if not self.slots or self._total <= 0:
            return
        avail = max(200, self.tl_cv.winfo_width() - 2 * self.PAD - 20)
        n = len(self.slots)
        lo, hi = self.PPS_MIN, self.PPS_MAX
        for _ in range(30):                   # binary search: floors make width non-linear
            mid = (lo + hi) / 2.0
            w = sum(max(self._floor(mid), self._dur(s) * mid) for s in self.slots) + self.GAPW * n
            lo, hi = (mid, hi) if w <= avail else (lo, mid)
        self.pps = max(self.PPS_MIN, lo)
        self._draw()
        self.tl_cv.xview_moveto(0)
        self._save_soon()

    def _floor(self, pps=None):
        """Minimum block width: shrinks smoothly when zooming out (default zoom 60 -> 112px)."""
        p = self.pps if pps is None else pps
        return max(2.0, min(float(self.MINW), p * 1.9))

    def _select(self, i):
        self.sel = i
        self._draw()
        self._sel_text()

    # ───────── timeline mouse ─────────
    def _tl_press(self, e):
        self._tl_tip_hide()
        c = self.tl_cv
        c.focus_set()
        x = c.canvasx(e.x)
        k = self._ov_at(x, e.y)
        if k is not None:
            self._ov_press(k, x)
            return
        if self.ov_sel is not None:
            self.ov_sel = None
        if e.y >= self.RULER_H:
            self._select(self._slot_at_x(x))
        self._scrub_was = self._playing
        self._pause()
        self._scrub = True
        self._scrub_to(x)

    def _tl_drag(self, e):
        if self._ov_drag:
            c = self.tl_cv
            if e.x > c.winfo_width() - 20:
                c.xview_scroll(1, "units")
            elif e.x < 20:
                c.xview_scroll(-1, "units")
            self._ov_move(c.canvasx(e.x))
            return
        if self._scrub:
            c = self.tl_cv
            if e.x > c.winfo_width() - 20:
                c.xview_scroll(1, "units")
            elif e.x < 20:
                c.xview_scroll(-1, "units")
            self._scrub_to(c.canvasx(e.x))

    def _tl_release(self, _e):
        if self._ov_drag:
            self._ov_drag = None
            self._cfg_dirty = True
            self._save_soon()
            self._seek_refresh()
            return
        if self._scrub:
            self._scrub = False
            if self._scrub_was:
                self._play()

    def _scrub_to(self, x):
        t = self._x2t(x)
        self._set_time(t)
        self._seek_still(t)

    def _tl_wheel(self, e):
        self.tl_cv.xview_scroll(-3 if e.delta > 0 else 3, "units")

    def _tl_zoomwheel(self, e):
        self._zoom(1.15 if e.delta > 0 else 0.87, self._x2t(self.tl_cv.canvasx(e.x)))

    def _tl_tip_hide(self):
        t = getattr(self, "_tl_tip", None)
        if t is not None:
            try:
                t.destroy()
            except Exception:
                pass
        self._tl_tip = None
        self._tl_tip_i = None

    def _tl_hover(self, e):
        """Mouse kono block er upor gele tar #serial + clip er asol naam + duration tooltip e dekhay."""
        if getattr(self, "_scrub", False):
            return
        c = self.tl_cv
        i = self._slot_at_x(c.canvasx(e.x)) if e.y >= self.RULER_H else None
        if i is None or i >= len(self.slots):
            self._tl_tip_hide()
            return
        if i == getattr(self, "_tl_tip_i", None) and getattr(self, "_tl_tip", None) is not None:
            try:
                self._tl_tip.geometry(f"+{e.x_root + 14}+{e.y_root + 16}")
            except Exception:
                pass
            return
        self._tl_tip_hide()
        sl = self.slots[i]
        name = os.path.basename(sl["path"]) if sl.get("path") else ((sl.get("label") or "") + "  (faka slot)")
        txt = f"#{i + 1}   {name}   •   {self._dur(sl):.1f}s"
        try:
            t = tk.Toplevel(self.app)
            t.wm_overrideredirect(True)
            t.attributes("-topmost", True)
            tk.Label(t, text=txt, bg=PANEL2, fg=FG, font=(FONT, 9), padx=8, pady=4,
                     relief="solid", bd=1).pack()
            t.geometry(f"+{e.x_root + 14}+{e.y_root + 16}")
            self._tl_tip, self._tl_tip_i = t, i
        except Exception:
            self._tl_tip = None

    def _tl_menu(self, e):
        self._tl_tip_hide()
        c = self.tl_cv
        _oy0, _oy1 = self._ovl_y()
        _ok = self._ov_at(c.canvasx(e.x), e.y)
        if _ok is not None or _oy0 <= e.y <= _oy1:
            self._ov_menu(e, _ok)
            return
        i = self._slot_at_x(c.canvasx(e.x))
        m = tk.Menu(self.app, tearoff=0, bg=PANEL2, fg=FG, activebackground=ACCENT, activeforeground=ACCENT_FG)
        if i is None:
            m.add_command(label="＋ Empty slot (shesh e)", command=lambda: self.add_empty(len(self.slots)))
            m.add_command(label="Import clips…", command=self.import_dialog)
        else:
            self._select(i)
            m.add_command(label="⟲ Replace…", command=self.replace_sel)
            m.add_command(label="✕ Remove clip (slot faka thakbe)", command=self.remove_sel)
            m.add_command(label="🗑 Delete slot", command=self.delete_sel)
            m.add_separator()
            m.add_command(label="◀ Move left", command=lambda: self.move_sel(-1))
            m.add_command(label="▶ Move right", command=lambda: self.move_sel(1))
            m.add_command(label="⤵ Import clip(s) ekhaner AGE…", command=lambda: self.import_dialog(i))
            m.add_command(label="⤵ Import clip(s) ekhaner PORE…", command=lambda: self.import_dialog(i + 1))
            m.add_command(label="＋ Empty slot age", command=lambda: self.add_empty(i))
            m.add_command(label="＋ Empty slot pore", command=lambda: self.add_empty(i + 1))
            m.add_command(label="⏱ Duration…", command=self.set_duration)
        try:
            m.tk_popup(e.x_root, e.y_root)
        finally:
            m.grab_release()

    # ───────── keyboard ─────────
    def _kbd_ok(self):
        if getattr(self.app, "active_tab", 1) != 2 or self._exp_busy:
            return False
        try:
            f = self.app.focus_get()
        except Exception:
            f = None
        return not isinstance(f, (tk.Entry, tk.Text, ttk.Entry, ttk.Combobox))

    def _on_space(self, _e):
        if self._kbd_ok():
            self.toggle()
            return "break"

    def _on_delete(self, _e):
        if self._kbd_ok() and self.ov_sel is not None and self.ov_sel < len(self.ovs):
            self._ov_delete(self.ov_sel)
            return "break"
        if self._kbd_ok() and self.sel is not None and self.sel < len(self.slots):
            self.remove_clip(self.sel)
            return "break"

    def _on_shift_delete(self, _e):
        if self._kbd_ok() and self.ov_sel is None and self.sel is not None and self.sel < len(self.slots):
            self.delete_slot(self.sel)
            return "break"

    # ───────── preview canvas ─────────
    def _rsz(self):
        aw, ah = self.ASPECTS.get(self.aspect_var.get(), (16, 9))
        cw, ch = max(160, self.pv_cv.winfo_width()), max(90, self.pv_cv.winfo_height())
        s = min(cw / aw, ch / ah)
        w, h = aw * s, ah * s
        f = min(1.0, 640.0 / max(w, h))
        return max(2, int(w * f) // 2 * 2), max(2, int(h * f) // 2 * 2)

    def _fit_rect(self):
        aw, ah = self.ASPECTS.get(self.aspect_var.get(), (16, 9))
        cw, ch = self.pv_cv.winfo_width(), self.pv_cv.winfo_height()
        s = min(cw / aw, ch / ah)
        return (cw - aw * s) / 2, (ch - ah * s) / 2, (cw + aw * s) / 2, (ch + ah * s) / 2

    def _pv_configure(self, _e=None):
        cv = self.pv_cv
        cw, ch = cv.winfo_width(), cv.winfo_height()
        cv.coords(self._pv_msg, cw // 2, ch // 2)
        cv.coords(self._pv_border, *self._fit_rect())
        if self._pv_item is not None:
            cv.coords(self._pv_item, cw // 2, ch // 2)
        if self._rs_job:
            self.after_cancel(self._rs_job)
        if not self._playing:
            self._rs_job = self.after(220, lambda: self._seek_still(self.cur_t))
        self._sub_sync()

    def _draw_frame(self, ppm):
        try:
            img = tk.PhotoImage(data=ppm, format="PPM")
            self._pv_img = img
            cv = self.pv_cv
            cx, cy = cv.winfo_width() // 2, cv.winfo_height() // 2
            if self._pv_item is None:
                self._pv_item = cv.create_image(cx, cy, image=img)
            else:
                cv.itemconfigure(self._pv_item, image=img)
            cv.tag_raise(self._pv_border)
            cv.tag_raise("t2sub")
            if not self._playing:
                self._ov_show(self.cur_t)
        except tk.TclError:
            pass

    def _black(self, W, H):
        b = self._blacks.get((W, H))
        if b is None:
            b = b"P6 %d %d 255\n" % (W, H) + bytes(W * H * 3)
            self._blacks = {(W, H): b}
        return b

    def _vf(self, W, H):
        return (f"scale={W}:{H}:force_original_aspect_ratio=decrease,"
                f"pad={W}:{H}:(ow-iw)/2:(oh-ih)/2:color=black,setsar=1")

    # ───────── seek (single still frame) ─────────
    def _seg_at(self, t):
        for i, (_x0, _x1, t0, d) in enumerate(self._geo):
            if t < t0 + d:
                return i, max(0.0, t - t0)
        if self._geo:
            i = len(self._geo) - 1
            return i, max(0.0, self._geo[i][3] - 0.05)
        return None, 0.0

    def _seek_still(self, t):
        if self._playing:
            return
        W, H = self._rsz()
        i, off = self._seg_at(t)
        if i is None:
            if self._pv_item is not None:
                self.pv_cv.itemconfigure(self._pv_item, image="")
                self._pv_img = None
            return
        s = self.slots[i]
        self._seek_id += 1
        gs = self._tr_geoms()
        trq = self._tr_for(i, off, gs)
        if trq is None:
            tl = self._tail_for(i, gs)
            if tl and off >= tl["dur"] - tl["pre"] - 0.001:
                trq = dict(tl, tail=True)
        req = (self._seek_id, s["path"], self._is_img(s["path"]), off, W, H, trq, self._trim(s)[0])
        with self._slock:
            self._seek_req = req
            if self._seek_busy:
                return
            self._seek_busy = True
        add_ffmpeg_path()
        threading.Thread(target=self._seek_worker, daemon=True).start()

    def _seek_worker(self):
        while True:
            with self._slock:
                req, self._seek_req = self._seek_req, None
                if req is None:
                    self._seek_busy = False
                    return
            rid, path, img, off, W, H, tr, tin = req
            data = None
            if not path:
                data = self._black(W, H)
            else:
                if tr and tr.get("tail"):
                    data = self._tail_still(tr, off, W, H)
                elif tr:
                    data = self._trans_still(tr, path, img, off, W, H)
                if data is None:
                    pre = ["ffmpeg", "-v", "error"] + ([] if img else ["-ss", f"{off + tin:.3f}"]) + ["-i", path]
                    cmd = pre + ["-an", "-frames:v", "1", "-vf", self._vf(W, H), "-f", "rawvideo", "-pix_fmt", "rgb24", "-"]
                    try:
                        r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                           creationflags=NOWIN, timeout=30)
                        if len(r.stdout) == W * H * 3:
                            data = b"P6 %d %d 255\n" % (W, H) + r.stdout
                        else:
                            data = self._black(W, H)
                    except FileNotFoundError:
                        self._q.put(("noff",))
                    except Exception:
                        pass
            if data:
                self._q.put(("still", rid, data))

    # ───────── playback ─────────
    def toggle(self):
        if self._playing:
            self._pause()
        else:
            self._play()

    @staticmethod
    def _can_sound():
        if os.name == "nt":
            return True
        return bool(shutil.which("afplay") or shutil.which("paplay") or shutil.which("aplay"))

    def _plan(self, t):
        plan = []
        gs = self._tr_geoms()
        for i, (s, (_x0, _x1, t0, d)) in enumerate(zip(self.slots, self._geo)):
            if t0 + d <= t + 0.001:
                continue
            start = max(t, t0)
            ln = t0 + d - start
            if ln < 0.03:
                continue
            plan.append({"i": i, "path": s["path"], "img": self._is_img(s["path"]),
                         "t0": start, "off": start - t0, "len": ln, "tr": self._tr_for(i, start - t0, gs),
                         "tail": self._tail_for(i, gs),
                         "tin": self._trim(s)[0], "gain": self._norm_gain(s["path"])})
        return plan

    def _play(self):
        if self._playing:
            return
        if not self.slots or self._total <= 0.05:
            self.app.note("Age clips import koro.", WARN)
            return
        if self._av_pending():
            self.app.note("Auto voice process hochhe — ektu por abar Play chap.", WARN)
            return
        t = self.cur_t if self.cur_t < self._total - 0.05 else 0.0
        plan = self._plan(t)
        if not plan:
            return
        add_ffmpeg_path()
        try:
            self._vol = max(0.1, min(4.0, float(self.vol_pct.get()) / 100.0))
        except (tk.TclError, ValueError):
            self._vol = 1.0
        self._gen += 1
        gen = self._gen
        W, H = self._rsz()
        with self._lock:
            self._dq.clear()
        self._playing, self._worker_done = True, False
        self._tl, self._last = t, time.perf_counter()
        self.play_btn.configure(text="⏸ Pause")
        snd = self.snd_var.get() == "1" and self._can_sound() and not self._clips_muted()
        self._voice_start(t)
        threading.Thread(target=self._worker, args=(gen, plan, W, H, snd), daemon=True).start()

    def _pause(self):
        self._gen += 1
        was = self._playing
        self._playing = False
        with self._lock:
            self._dq.clear()
        self._audio_stop()
        try:
            self.play_btn.configure(text="▶ Play")
        except tk.TclError:
            pass
        return was

    def _finish(self):
        self._pause()
        self._set_time(self._total)

    def _push(self, gen, item):
        while gen == self._gen:
            with self._lock:
                if len(self._dq) < self.MAXQ:
                    self._dq.append((gen,) + item)
                    return True
            time.sleep(0.004)
        return False

    def _wav_path(self, gen, k):
        return os.path.join(tempfile.gettempdir(), f"ave_t2_{os.getpid()}_{gen}_{k}.wav")

    def _extract_wav(self, gen, k, e):
        if gen != self._gen:
            return None
        wav = self._wav_path(gen, k)
        try:
            r = subprocess.run(["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", "-ss", f"{e['off'] + e.get('tin', 0.0):.3f}",
                                "-t", f"{e['len']:.3f}", "-i", self._av_src(e["path"]), "-vn", "-ac", "1", "-ar", "32000",
                                "-af", (f"volume={e['gain']:.3f},alimiter=limit=0.97," if abs(e.get("gain", 1.0) - 1.0) > 0.005 else "")
                                + f"volume={self._vol:.2f}", "-c:a", "pcm_s16le", wav],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, creationflags=NOWIN, timeout=120)
            if r.returncode == 0 and os.path.exists(wav) and os.path.getsize(wav) > 200:
                return wav
        except Exception:
            pass
        self._rm(wav)
        return None

    @staticmethod
    def _rm(p):
        try:
            if p and os.path.exists(p):
                os.remove(p)
        except OSError:
            pass

    def _play_clip(self, gen, e, base, off, ln, W, H, hdr, size, black):
        """Plain playback of one clip part (frames pushed with their timeline time). False = aborted."""
        if ln < 0.03:
            return gen == self._gen
        vf = self._vf(W, H)
        if e["img"]:
            cmd = ["ffmpeg", "-v", "error", "-loop", "1", "-framerate", str(self.FPS), "-i", e["path"],
                   "-t", f"{ln:.3f}", "-an", "-vf", vf]
        else:
            cmd = ["ffmpeg", "-v", "error", "-ss", f"{off + e.get('tin', 0.0):.3f}", "-i", e["path"],
                   "-t", f"{ln:.3f}", "-an", "-vf", f"fps={self.FPS},{vf}"]
        cmd += ["-f", "rawvideo", "-pix_fmt", "rgb24", "-"]
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, creationflags=NOWIN)
        n = 0
        try:
            while gen == self._gen:
                buf = proc.stdout.read(size)
                if len(buf) < size:
                    break
                if not self._push(gen, ("frame", base + n / float(self.FPS), hdr + buf, None)):
                    break
                n += 1
            if n == 0:
                self._push(gen, ("frame", base, black, None))
        finally:
            try:
                if proc.poll() is None:
                    proc.kill()
                proc.stdout.close()
            except Exception:
                pass
        return gen == self._gen

    def _worker(self, gen, plan, W, H, snd):
        from concurrent.futures import ThreadPoolExecutor
        ex = ThreadPoolExecutor(max_workers=2)
        futs = {}

        def ensure(k):
            if snd and 0 <= k < len(plan) and k not in futs and plan[k]["path"] and not plan[k]["img"]:
                futs[k] = ex.submit(self._extract_wav, gen, k, plan[k])
        proc = None
        try:
            hdr, size = b"P6 %d %d 255\n" % (W, H), W * H * 3
            black = self._black(W, H)
            for k, e in enumerate(plan):
                if gen != self._gen:
                    return
                ensure(k)
                ensure(k + 1)
                wav = futs[k].result() if k in futs else None
                if gen != self._gen:
                    return
                if not self._push(gen, ("seg", e["t0"], e["i"], wav)):
                    return
                if not e["path"]:
                    if not self._push(gen, ("frame", e["t0"], black, None)):
                        return
                    continue
                base, off, ln = e["t0"], e["off"], e["len"]
                if e.get("tr"):
                    cb = self._emit_transition(gen, e, W, H)
                    if cb is None:
                        return
                    used = max(0.0, cb - e["off"])
                    if cb > 0:
                        base, off, ln = e["t0"] + used, cb, e["len"] - used
                    if ln < 0.03:
                        continue
                tl = e.get("tail")
                tu = min(tl["pre"], ln) if tl else 0.0
                if tu < 0.04:
                    tu = 0.0
                if not self._play_clip(gen, e, base, off, ln - tu, W, H, hdr, size, black):
                    return
                if tu > 0:                                   # earlier-placed transition: last `pre` sec of this slot
                    t_tail = base + (ln - tu)
                    k0 = int(round((tl["pre"] - tu) * self.FPS))
                    got = self._emit_tail(gen, tl, k0, t_tail, W, H)
                    if got is None:
                        return
                    if got == 0 and not self._play_clip(gen, e, t_tail, off + (ln - tu), tu, W, H, hdr, size, black):
                        return
        except Exception:
            pass
        finally:
            try:
                if proc is not None:
                    if proc.poll() is None:
                        proc.kill()
                    proc.stdout.close()
            except Exception:
                pass
            if gen != self._gen:
                for f in futs.values():
                    try:
                        if f.done():
                            self._rm(f.result())
                    except Exception:
                        pass
            ex.shutdown(wait=False)
            if gen == self._gen:
                self._worker_done = True

    # ───────── voice track / mute ─────────
    def _clips_muted(self):
        return self.mute_var.get() == "1" or self._voice_active()

    def _voice_active(self):
        return bool(self.voice_path and os.path.isfile(self.voice_path))

    def set_voice(self, path, undo=True):
        """Attach an audio file as the voice track (clips become muted automatically)."""
        self._pause()
        if undo:
            self._undo_push()
        self.voice_path = path
        self.voice_dur = (media_duration(path) or 0.0) if path else 0.0
        self._cfg_touch()
        self._draw()
        self._save_soon()

    def import_voice(self):
        p = filedialog.askopenfilename(title="Voice audio", filetypes=[
            ("Audio", " ".join("*" + e for e in sorted(AUDIO_EXTS))), ("All", "*.*")])
        if p:
            add_ffmpeg_path()
            self.set_voice(p)
            self.app.note("Voice track add hoyeche — clips er sound mute, voice volume ekhon shudhu voice e kaj korbe.", OK)

    def remove_voice(self):
        if self.voice_path:
            self.set_voice(None)

