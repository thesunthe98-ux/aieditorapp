class GeminiLoginNeeded(RuntimeError):
    """Gemini te Google login nei."""


class ZamzarRetry(Exception):
    """Zamzar e kaj hocche na -> VPN badle abar prothom theke upload."""


class VoiceStopped(Exception):
    pass


class VoiceRunner:
    """Speechify -> VeePN -> Zamzar pipeline (runs in a worker thread)."""

    def __init__(self, cfg, log, ask, stop_event, chrome_hidden=False, profile=None, shared=None, tag=""):
        self.cfg = cfg
        self.tag = (tag + " ") if tag else ""
        self.log = (lambda m: log(f"[{tag}] {m}")) if tag else log
        self.shared = shared or {"lock": threading.RLock(), "reserved": set(), "ask": threading.Lock()}
        _ask_lock = self.shared["ask"]

        def _ask(msg):
            with _ask_lock:
                return ask(f"[{tag}] {msg}" if tag else msg)
        self.ask = _ask
        self.profile = profile or VOICE_PROFILE
        self.stop = stop_event
        self.chrome_hidden = chrome_hidden
        self.own = set()
        self.ctx = None
        self.keepalive = None
        self.last_vpn = None

    def check_stop(self):
        if self.stop.is_set():
            raise VoiceStopped()

    def sweep(self):
        try:
            for p in list(self.ctx.pages):
                if p in self.own:
                    continue
                url = p.url or ""
                if url in ("", "about:blank"):
                    continue
                host = _urlparse(url).netloc
                if url.startswith(("chrome://", "chrome-extension://")):
                    continue
                if any(host.endswith(h) for h in VOICE_ALLOWED):
                    continue
                self.log(f"  (ad tab bondho: {host})")
                p.close()
        except Exception:
            pass

    def sleep(self, ms, page=None):
        self.check_stop()
        (page or self.keepalive).wait_for_timeout(ms)
        self.sweep()

    def new_page(self):
        p = self.ctx.new_page()
        self.own.add(p)
        p.on("dialog", lambda d: d.accept())
        if self.chrome_hidden:
            self.move_window(p, False)
        return p

    def close_page(self, p):
        try:
            self.own.discard(p)
            p.close()
        except Exception:
            pass

    def move_window(self, page, visible):
        try:
            cdp = self.ctx.new_cdp_session(page)
            wid = cdp.send("Browser.getWindowForTarget")["windowId"]
            bounds = ({"left": 60, "top": 60, "width": 1200, "height": 800, "windowState": "normal"}
                      if visible else
                      {"left": -32000, "top": -32000, "width": 1366, "height": 900, "windowState": "normal"})
            cdp.send("Browser.setWindowBounds", {"windowId": wid, "bounds": bounds})
        except Exception:
            pass

    def set_chrome_hidden(self, hidden):
        self.chrome_hidden = bool(hidden)
        if not self.ctx:
            return
        for p in list(self.own) + list(self.ctx.pages):
            try:
                self.move_window(p, not self.chrome_hidden)
            except Exception:
                pass

    def _used_emails(self):
        used = set()
        try:
            for l in open(VOICE_USED, encoding="utf-8").read().splitlines():
                l = l.strip()
                if l:
                    used.add(l.split(":", 1)[0].strip().lower())
        except Exception:
            pass
        return used | self._blocked_emails()

    def _blocked_emails(self):
        out = set()
        try:
            for l in open(VOICE_BLOCKED, encoding="utf-8").read().splitlines():
                l = l.strip()
                if l:
                    out.add(l.split(":", 1)[0].strip().lower())
        except Exception:
            pass
        return out

    def mark_blocked(self, line):
        """Credit shesh ('You ran out of credits') account: accounts.txt theke soriye accounts_no_credit.txt e rakhe —
        pore user abar accounts.txt e add korleo ei mail e kokhono login hobe na."""
        try:
            self.mark_used(line)
        except Exception:
            pass
        with self.shared["lock"]:
            email = line.split(":", 1)[0].strip().lower()
            if email and email not in self._blocked_emails():
                try:
                    with open(VOICE_BLOCKED, "a", encoding="utf-8") as f:
                        f.write(line + "\n")
                except Exception:
                    pass
            self.shared["reserved"].discard(line)

    def credit_popup(self, page):
        try:
            return page.get_by_text(VOICE_LIMIT_RE).first.is_visible()
        except Exception:
            return False

    def peek_account(self, skip):
        """Ekta mail neya + reserve kore rakha. Ager e login hoye jaoa (used) mail kokhono dewa hobe na."""
        with self.shared["lock"]:
            if not os.path.exists(VOICE_ACCOUNTS):
                return None
            used = self._used_emails()
            for line in open(VOICE_ACCOUNTS, encoding="utf-8").read().splitlines():
                line = line.strip()
                if not line or line in skip or line in self.shared["reserved"]:
                    continue
                if ":" in line:
                    email, pw = line.split(":", 1)
                else:
                    email, pw = line, line
                if email.strip().lower() in used:
                    continue
                self.shared["reserved"].add(line)
                return email.strip(), pw.strip(), line
        return None

    def release_account(self, line):
        with self.shared["lock"]:
            self.shared["reserved"].discard(line)

    def mark_used(self, line):
        """Mail ke accounts.txt theke soriye accounts_used.txt e rakhe (ekbar-i, duplicate hoy na)."""
        _t2_sess_set(self.profile, None)        # ei profile e notun account login hoyeche -> Tab 2 er age-r mapping bhul
        with self.shared["lock"]:
            email = line.split(":", 1)[0].strip().lower()
            lines = [l.strip() for l in open(VOICE_ACCOUNTS, encoding="utf-8").read().splitlines() if l.strip()]
            keep = [l for l in lines if l.split(":", 1)[0].strip().lower() != email]
            if keep != lines:
                atomic_write(VOICE_ACCOUNTS, "\n".join(keep) + ("\n" if keep else ""))
            if email not in self._used_emails():
                with open(VOICE_USED, "a", encoding="utf-8") as f:
                    f.write(line + "\n")
            self.shared["reserved"].discard(line)

    def debug(self, page, tag):
        try:
            os.makedirs(VOICE_DEBUG, exist_ok=True)
            shot = os.path.join(VOICE_DEBUG, f"{time.strftime('%H%M%S')}_{self.tag}{tag}.png")
            page.screenshot(path=shot)
            txt = " ".join(page.inner_text("body").split())[:300]
            self.log(f"  [debug] {os.path.basename(shot)} | {page.url} | {txt}")
        except Exception:
            pass

    def dismiss_onboarding(self, page):
        try:
            btn = page.get_by_role("button", name=re.compile(
                r"^(Skip|Skip for now|Got it|Maybe later|No thanks|Not now|Done|Close|Continue to Studio)$", re.I))
            for i in range(min(btn.count(), 3)):
                if btn.nth(i).is_visible():
                    btn.nth(i).click(timeout=1500)
                    page.wait_for_timeout(500)
        except Exception:
            pass

    def find_editor(self, page):
        cands = [
            lambda: page.get_by_placeholder("Type or paste your text to generate speech..."),
            lambda: page.locator("[data-placeholder*='Type or paste']"),
            lambda: page.locator("[placeholder*='Type or paste']"),
            lambda: page.get_by_text(re.compile(r"Type or paste your text")).first,
            lambda: page.locator("[contenteditable='true']").last,
            lambda: page.locator("textarea").last,
        ]
        for _ in range(45):
            self.dismiss_onboarding(page)
            for mk in cands:
                try:
                    loc = mk().first
                    if loc.is_visible():
                        return loc
                except Exception:
                    continue
            self.sleep(1500, page)
        raise RuntimeError("Script likhar box paoa jayni")

    def launch(self, pw):
        self.pw = pw
        os.makedirs(self.profile, exist_ok=True)
        args = ["--disable-blink-features=AutomationControlled"]
        args += (["--window-position=-32000,-32000", "--window-size=1366,900"] if self.chrome_hidden
                 else ["--start-maximized"])
        self.ctx = pw.chromium.launch_persistent_context(
            self.profile, channel="chrome", headless=False, accept_downloads=True,
            no_viewport=True, ignore_default_args=["--disable-extensions", "--enable-automation"],
            args=args)
        try:
            self.ctx.grant_permissions(["clipboard-read", "clipboard-write"], origin=VOICE_ORIGIN)
        except Exception:
            pass
        self.keepalive = self.ctx.pages[0] if self.ctx.pages else self.ctx.new_page()
        self.own.add(self.keepalive)
        if self.chrome_hidden:
            self.move_window(self.keepalive, False)

    def is_urban(self):
        return str(self.cfg.get("vpn_provider", "VeePN")).strip().lower().startswith("urban")

    def _ext_from_disk(self, key="veepn"):
        """Profile folder e install kora extension scan kore VeePN/UrbanVPN er ID ber kore (service worker ghumaleo kaj kore)."""
        found = set()
        keys = ("urban vpn", "urbanvpn") if key == "urban" else ("veepn",)
        root = os.path.join(self.profile, "Default", "Extensions")
        try:
            for eid in os.listdir(root):
                if not re.fullmatch(r"[a-p]{32}", eid):
                    continue
                if key == "urban" and eid == URBAN_EXT_ID:
                    found.add(eid)
                    continue
                edir = os.path.join(root, eid)
                for ver in os.listdir(edir):
                    blob = ""
                    for rel in ("manifest.json", os.path.join("_locales", "en", "messages.json"),
                                os.path.join("_locales", "en_US", "messages.json")):
                        fp = os.path.join(edir, ver, rel)
                        if os.path.exists(fp):
                            try:
                                blob += open(fp, encoding="utf-8", errors="ignore").read().lower()
                            except Exception:
                                pass
                    if any(k in blob for k in keys):
                        found.add(eid)
        except Exception:
            pass
        return found

    def ext_id_urban(self):
        v = str(self.cfg.get("urban_ext_id", "") or "").strip()
        if v:
            return v
        if getattr(self, "_urban_cached", None):
            return self._urban_cached
        disk = self._ext_from_disk("urban")
        if disk:
            self._urban_cached = sorted(disk)[0]
            self.log(f"  UrbanVPN extension ID: {self._urban_cached}")
            return self._urban_cached
        raise RuntimeError(
            "UrbanVPN extension ID paoa jayni. Ei app er Chrome profile e UrbanVPN install nai — "
            "'Chrome Profile Setup' chalie UrbanVPN install korun (ekbar-i). "
            "Ba Settings e UrbanVPN Extension ID boshan.")

    def ext_id(self):
        if self.is_urban():
            return self.ext_id_urban()
        if self.cfg.get("ext_id", "").strip():
            return self.cfg["ext_id"].strip()
        if getattr(self, "_ext_cached", None):
            return self._ext_cached
        t0 = time.time()
        while True:
            ids = set()
            try:
                for w in list(self.ctx.service_workers) + list(self.ctx.background_pages):
                    m = re.match(r"chrome-extension://([a-p]{32})/", w.url)
                    if m:
                        ids.add(m.group(1))
            except Exception:
                pass
            disk = self._ext_from_disk()
            if len(disk) == 1:                       # disk scan sobcheye nirbhorjoggo
                ids = disk
            elif len(disk) > 1 and ids & disk:
                ids = ids & disk
            if len(ids) == 1:
                self._ext_cached = next(iter(ids))
                self.log(f"  VeePN extension ID: {self._ext_cached}")
                return self._ext_cached
            if time.time() - t0 > 12 or self.stop.is_set():
                break
            self.sleep(1000, self.ctx.pages[0] if self.ctx.pages else None)   # Chrome shuru hoyei extension jage na
        raise RuntimeError(
            "VeePN extension ID paoa jayni. Ei app er Chrome profile e VeePN install nai — "
            "ekbar 'Chrome Profile Setup' chalie VeePN install korun (ekbar-i, porer bar auto). "
            "Ba Settings e Extension ID boshan.")

    def ext_ids_for(self, which):
        """'urban' ba 'veepn' er sob known extension ID (disk scan + Settings e deya ID)."""
        ids = set(self._ext_from_disk(which))
        if which == "urban":
            v = str(self.cfg.get("urban_ext_id", "") or "").strip()
            ids.add(v) if v else None
            if getattr(self, "_urban_cached", None):
                ids.add(self._urban_cached)
        else:
            v = str(self.cfg.get("ext_id", "") or "").strip()
            ids.add(v) if v else None
            if getattr(self, "_ext_cached", None):
                ids.add(self._ext_cached)
        return {i for i in ids if re.fullmatch(r"[a-p]{32}", i or "")}

    def ext_prepare_provider(self):
        """Selected provider er extension ENABLE, onnota DISABLE (UrbanVPN on thakle VeePN kaj kore na).
        Age onnota disable kore, tarpor selected ta enable kori — jate 'Service interruption' na ashe."""
        want = "urban" if self.is_urban() else "veepn"
        if getattr(self, "_prov_ready", None) == want:
            return
        other = "veepn" if want == "urban" else "urban"
        ok = True
        off_ids = self.ext_ids_for(other) - self.ext_ids_for(want)
        for i in sorted(off_ids):
            self.log(f"  {'VeePN' if other == 'veepn' else 'UrbanVPN'} disable korchi (selected: {'UrbanVPN' if want == 'urban' else 'VeePN'})")
            ok = self.ext_set_enabled(i, False) and ok
        for i in sorted(self.ext_ids_for(want)):
            ok = self.ext_set_enabled(i, True) and ok
        if ok:
            self._prov_ready = want

    def open_vpn_popup(self):
        try:
            self.ext_prepare_provider()
        except Exception as e:
            self.log(f"  provider extension switch kora gelo na: {str(e).splitlines()[0][:120]}")
        eid = self.ext_id()
        p = self.new_page()
        popup = "popup.html"
        mf = f"chrome-extension://{eid}/manifest.json"
        try:
            p.goto(mf, timeout=20000)
        except Exception:
            # extension disable kora thakle (jemon UrbanVPN 'Disable other extension' dile) -> chrome://extensions theke on kore abar
            self.log("  VPN extension disabled mone hocche — chrome://extensions theke enable korchi")
            try:
                self.ext_set_enabled(eid, True)
                p.goto(mf, timeout=20000)
            except Exception:
                pass
        try:
            data = json.loads(p.inner_text("body"))
            popup = ((data.get("action") or data.get("browser_action") or {}).get("default_popup") or popup)
        except Exception:
            pass
        p.goto(f"chrome-extension://{eid}/{popup}", timeout=30000)
        p.wait_for_timeout(2500)
        if self.is_urban():
            try:
                p.set_viewport_size({"width": 380, "height": 730})   # popup er moto size (layout milanor jonno)
                p.wait_for_timeout(500)
            except Exception:
                pass
            try:
                self.urban_dismiss(p)
            except Exception:
                pass
            return p
        try:
            self.vpn_wait_loaded(p, eid, popup)
        except Exception:
            self.close_page(p)
            raise
        self.dismiss_popups(p)
        return p

    def vpn_wait_loaded(self, p, eid, popup):
        """VeePN 'Loading — We're setting up your extension' screen e atke thakle:
        X second wait -> na hole page reload -> abar wait (max 3 bar), tarpor error (VPN tries e abar hobe)."""
        try:
            wait = max(10, int(self.cfg.get("vpn_load_wait_sec", 60)))
        except (TypeError, ValueError):
            wait = 60
        rx = re.compile(r"setting up your extension|take up to 2 minutes|^\s*Loading\b", re.I)

        def loading():
            try:
                return p.get_by_text(rx).first.is_visible()
            except Exception:
                return False

        for rnd in range(3):
            if not loading():
                return
            if rnd == 0:
                self.log("  VeePN 'Loading' dekhacche — load howar jonno wait korchi...")
            t0 = time.time()
            while time.time() - t0 < wait:
                self.sleep(2000, p)
                if not loading():
                    self.log("  VeePN load hoyeche")
                    return
            if rnd < 2:
                self.log(f"  VeePN {wait}s e load hoyni — page reload kore abar chesta (try {rnd + 2}/3)")
                try:
                    p.goto(f"chrome-extension://{eid}/{popup}", timeout=30000)
                except Exception:
                    try:
                        p.reload(timeout=30000)
                    except Exception:
                        pass
                p.wait_for_timeout(2500)
        raise RuntimeError("VeePN extension 'Loading' e atke ache (reload kore-o load hoyni)")

    def dismiss_popups(self, p):
        try:
            for rx in (r"^\s*No,?\s*thanks\b", r"^\s*Maybe later\b", r"^\s*Not now\b"):
                t = p.get_by_text(re.compile(rx, re.I))
                for i in range(min(t.count(), 2)):
                    if t.nth(i).is_visible():
                        t.nth(i).click(timeout=2000)
                        p.wait_for_timeout(800)
        except Exception:
            pass
        for s in ("[aria-label*='close' i]", "button:has-text('Close')", "button:has-text('No thanks')",
                  "button:has-text('Maybe later')", "button:has-text('Skip')"):
            try:
                loc = p.locator(s)
                for i in range(min(loc.count(), 3)):
                    if loc.nth(i).is_visible():
                        loc.nth(i).click(timeout=1500)
                        p.wait_for_timeout(400)
            except Exception:
                pass

    def click_power(self, p, label_regex):
        self.dismiss_popups(p)
        t = p.get_by_text(label_regex).first
        for _ in range(8):
            try:
                t.wait_for(timeout=2000)
                break
            except Exception:
                self.dismiss_popups(p)
        t.wait_for(timeout=5000)
        try:
            btn = t.locator("xpath=preceding::*[self::button or @role='button'][1]")
            box = btn.bounding_box()
            if box and box["width"] >= 80:
                btn.click(timeout=3000)
                return
        except Exception:
            pass
        box = t.bounding_box()
        p.mouse.click(box["x"] + box["width"] / 2, box["y"] - 145)

    def is_connected(self, p):
        self.dismiss_popups(p)
        try:
            return p.get_by_text(re.compile(r"^\s*Connected")).first.is_visible()
        except Exception:
            return False

    # ───────── chrome://extensions on/off ─────────
    def ext_set_enabled(self, eid, want=True):
        """chrome://extensions e gie ei extension er toggle on/off kore."""
        p = self.new_page()
        try:
            p.goto("chrome://extensions/", timeout=20000)
            p.wait_for_timeout(1500)
            tog = p.locator(f"extensions-item[id='{eid}'] #enableToggle")
            tog.wait_for(timeout=8000)
            try:
                on = bool(tog.evaluate("e => e.checked"))
            except Exception:
                on = (tog.get_attribute("aria-pressed") == "true")
            if on != bool(want):
                tog.click(timeout=4000)
                p.wait_for_timeout(1500)
                self.log(f"  extension {eid[:8]}… {'enable' if want else 'disable'} kora hoyeche")
            return True
        except Exception as e:
            self.log(f"  chrome://extensions e toggle kora gelo na: {str(e).splitlines()[0][:120]}")
            return False
        finally:
            self.close_page(p)

    # ───────── UrbanVPN ─────────
    def urban_interruption(self, p):
        """'Service interruption' -> 'Disable other extension' click; na hole nijei VeePN disable kore reload."""
        rx = re.compile(r"Service interruption|being interrupted", re.I)
        self.log("  UrbanVPN: 'Service interruption' — 'Disable other extension' chapchi")
        try:
            b = p.get_by_role("button", name=re.compile(r"Disable other extension", re.I)).first
            if not b.is_visible():
                b = p.get_by_text(re.compile(r"Disable other extension", re.I)).first
            b.click(timeout=3000)
        except Exception:
            pass
        for _ in range(8):
            p.wait_for_timeout(700)
            try:
                if not p.get_by_text(rx).first.is_visible():
                    self.log("  UrbanVPN: onno extension disable hoyeche")
                    return
            except Exception:
                return
        # Chrome nijer confirm dialog dekhale click kora jay na -> chrome://extensions diye disable
        ids = set(self._ext_from_disk("veepn"))
        vid = str(self.cfg.get("ext_id", "") or "").strip()
        if vid:
            ids.add(vid)
        for i in ids:
            self.ext_set_enabled(i, False)
        try:
            p.reload(timeout=20000)
        except Exception:
            pass
        p.wait_for_timeout(2500)

    def urban_close_x(self, p):
        """'Enjoy using UrbanVPN?' rating popup er upore-dane X."""
        try:
            for s in ("[aria-label*='close' i]", "button[class*='close' i]", "[class*='close' i]"):
                loc = p.locator(s)
                for i in range(min(loc.count(), 3)):
                    if loc.nth(i).is_visible():
                        loc.nth(i).click(timeout=1500)
                        return
        except Exception:
            pass
        try:
            pt = p.evaluate("""() => {
                let best = null;
                for (const el of document.querySelectorAll('button,[role=button],svg,img,a,div,span')) {
                    const r = el.getBoundingClientRect();
                    if (r.width < 10 || r.height < 10 || r.width > 60 || r.height > 60) continue;
                    if (r.top > 80 || r.bottom < 0) continue;
                    const cs = getComputedStyle(el);
                    if (cs.visibility === 'hidden' || cs.display === 'none') continue;
                    if (!best || r.right > best.r) best = {x: r.left + r.width / 2, y: r.top + r.height / 2, r: r.right};
                }
                return best;
            }""")
            if pt:
                p.mouse.click(pt["x"], pt["y"])
        except Exception:
            pass

    def urban_dismiss(self, p):
        """'Want to use Urban VPN?' -> Accept, 'Enjoy using UrbanVPN?' (rate us) -> X."""
        for _ in range(4):
            acted = False
            try:
                if p.get_by_text(re.compile(r"Service interruption", re.I)).first.is_visible():
                    self.urban_interruption(p)
                    acted = True
            except Exception:
                pass
            try:
                if p.get_by_text(re.compile(r"Want to use Urban\s?VPN", re.I)).first.is_visible():
                    b = p.get_by_role("button", name=re.compile(r"^\s*Accept\s*$", re.I)).first
                    if not b.is_visible():
                        b = p.get_by_text(re.compile(r"^\s*Accept\s*$")).first
                    b.click(timeout=3000)
                    p.wait_for_timeout(1500)
                    acted = True
            except Exception:
                pass
            try:
                if p.get_by_text(re.compile(r"Enjoy using Urban\s?VPN|rating us on", re.I)).first.is_visible():
                    self.urban_close_x(p)
                    p.wait_for_timeout(800)
                    acted = True
            except Exception:
                pass
            if not acted:
                break

    def urban_status(self, p):
        self.urban_dismiss(p)
        for name, rx in (("connected", r"^\s*Connected\s*$"), ("not", r"^\s*Not connected\s*$"),
                         ("connecting", r"^\s*Connecting")):
            try:
                if p.get_by_text(re.compile(rx)).first.is_visible():
                    return name
            except Exception:
                pass
        return None

    def urban_connected(self, p):
        return self.urban_status(p) == "connected"

    def urban_wait_status(self, p, names, timeout):
        t0 = time.time()
        while time.time() - t0 < timeout:
            st = self.urban_status(p)
            if st in names:
                return st
            if self.stop.is_set():
                break
            p.wait_for_timeout(600)
        return None

    def urban_power(self, p, dy=182):
        """Bhetorer boro gol (play/pause) button — status lekhar thik upore."""
        self.urban_dismiss(p)
        t = p.get_by_text(re.compile(r"^\s*(Not connected|Connected|Connecting.*)\s*$")).first
        t.wait_for(timeout=8000)
        box = t.bounding_box()
        p.mouse.click(box["x"] + box["width"] / 2 - 12, box["y"] + box["height"] / 2 - dy)

    def urban_pick(self, p, name):
        inp = p.locator("input[placeholder*='Search' i], input[type='search'], input[type='text']").first

        heads = p.get_by_text(re.compile(r"^\s*(Top locations|All locations)\s*$", re.I))

        def has_input():
            try:
                return inp.is_visible()
            except Exception:
                return False

        def opened():
            # UrbanVPN er notun UI te search input na-o thakte pare — list er heading dekhlei khola dhore nibo
            if has_input():
                return True
            try:
                return heads.first.is_visible()
            except Exception:
                return False
        if not opened():
            pts = []
            try:
                bx = p.get_by_text(re.compile(r"Get Premium", re.I)).first.bounding_box()
            except Exception:
                bx = None
            if bx:
                cy = bx["y"] + bx["height"] / 2 + 62
                pts += [(bx["x"] - 60, cy), (bx["x"] - 160, cy), (bx["x"] + 40, cy)]
            pts += [(150, 92), (120, 92)]
            for x, y in pts:
                try:
                    p.mouse.click(x, y)
                except Exception:
                    continue
                p.wait_for_timeout(800)
                self.urban_dismiss(p)
                if opened():
                    break
            if not opened():
                raise RuntimeError("UrbanVPN location list khola jayni")
        q = re.sub(r"\s*\(.*?\)\s*", " ", name).strip() or name
        if has_input():
            try:
                inp.click(timeout=2000)
                inp.fill("")
                inp.type(q, delay=40)
            except Exception:
                pass
        p.wait_for_timeout(1000)
        # list er item gulo ei Y er niche — upore current selected location (header) ache, seta click korle list bondho hoye jay
        min_y = 0
        try:
            if has_input():
                ib = inp.bounding_box()
                if ib:
                    min_y = ib["y"] + ib["height"]
            else:
                hb = heads.first.bounding_box()
                if hb:
                    min_y = hb["y"] + hb["height"]
        except Exception:
            pass
        item = None
        for rx in (rf"^\s*{re.escape(name)}\s*$", rf"^\s*{re.escape(name)}", rf"^\s*{re.escape(q)}\b",
                   re.escape(q)):
            loc = p.get_by_text(re.compile(rx, re.I))
            cands = []
            try:
                for i in range(min(loc.count(), 8)):
                    cand = loc.nth(i)
                    if not cand.is_visible():
                        continue
                    cb = cand.bounding_box()
                    if cb and cb["y"] > min_y - 2:
                        cands.append((cb["y"], cand))
            except Exception:
                pass
            if cands:
                cands.sort(key=lambda t: t[0])
                # heading/input paoa na gele prothom match = header e selected location, tai porerta nao
                item = cands[1][1] if (min_y == 0 and len(cands) > 1) else cands[0][1]
                break
        if item is None:
            raise RuntimeError(f"UrbanVPN e '{name}' paoa jayni")
        for how in ("normal", "force", "mouse"):
            try:
                if how == "normal":
                    item.click(timeout=3000)
                elif how == "force":
                    item.click(timeout=3000, force=True)
                else:
                    b = item.bounding_box()
                    p.mouse.click(b["x"] + b["width"] / 2, b["y"] + b["height"] / 2)
                return
            except Exception:
                continue
        raise RuntimeError(f"UrbanVPN '{name}' select kora jayni")

    def vpn_connect_urban(self):
        locs = [s.strip() for s in str(self.cfg.get("urban_locations", "") or "").split(",") if s.strip()]
        if not locs:
            locs = [s.strip() for s in VOICE_DEFAULTS["urban_locations"].split(",")]
        pool = [x for x in locs if x != self.last_vpn] or locs
        choice = random.choice(pool)
        self.last_vpn = choice
        self.log(f"VPN (UrbanVPN): location -> {choice}")
        p = self.open_vpn_popup()
        try:
            if self.urban_connected(p):
                self.urban_power(p)
                if not self.urban_wait_status(p, ("not",), 20):
                    raise RuntimeError("UrbanVPN disconnect hoyni")
            self.urban_pick(p, choice)
            p.wait_for_timeout(1500)
            st = self.urban_wait_status(p, ("connected", "connecting"), 6)   # location select korle auto connect hote pare
            if st is None:
                for dy in (182, 170, 195):
                    self.urban_power(p, dy)
                    st = self.urban_wait_status(p, ("connected", "connecting"), 6)
                    if st:
                        break
            if st != "connected":
                st = self.urban_wait_status(p, ("connected",), 40)
            if st != "connected":
                self.urban_dismiss(p)
                self.ask("VPN connect hoyni. Extension popup thakle nijer haate bondho kore OK chapen.")
                if not self.urban_connected(p):
                    raise RuntimeError("VPN connect hoyni")
            self.log("  VPN connected")
        except Exception:
            self.debug(p, "vpn")
            raise
        finally:
            self.close_page(p)

    def vpn_disconnect_urban(self):
        p = None
        try:
            p = self.open_vpn_popup()
            if self.urban_connected(p):
                self.urban_power(p)
                self.urban_wait_status(p, ("not",), 20)
                self.log("  VPN disconnect hoyeche")
        except Exception as e:
            self.log(f"  VPN disconnect kora gelo na: {e}")
        finally:
            if p:
                self.close_page(p)

    def vpn_disconnect(self):
        if self.is_urban():
            return self.vpn_disconnect_urban()
        p = None
        try:
            p = self.open_vpn_popup()
            if self.is_connected(p):
                self.click_power(p, re.compile(r"^\s*Connected"))
                p.get_by_text(re.compile(r"Connection is OFF", re.I)).first.wait_for(timeout=20000)
                self.log("  VPN disconnect hoyeche")
        except Exception as e:
            self.log(f"  VPN disconnect kora gelo na: {e}")
        finally:
            if p:
                self.close_page(p)

    def vpn_pick(self, p, item):
        status = re.compile(r"Connection is OFF|Disconnected", re.I)
        for how in ("normal", "force", "mouse"):
            self.dismiss_popups(p)
            try:
                if how == "normal":
                    item.click(timeout=4000)
                elif how == "force":
                    item.click(timeout=3000, force=True)
                else:
                    b = item.bounding_box()
                    p.mouse.click(b["x"] + b["width"] / 2, b["y"] + b["height"] / 2)
            except Exception:
                continue
            try:
                p.get_by_text(status).first.wait_for(timeout=4000)
                return
            except Exception:
                continue
        raise RuntimeError("VPN location select kora jayni")

    def vpn_list_open(self, p):
        try:
            return p.get_by_text(re.compile(r"^\s*Free locations\s*$", re.I)).first.is_visible()
        except Exception:
            return False

    def vpn_expand_us(self, p, state):
        """United States row er dropdown khule Oregon / Virginia dekhay."""
        rx = re.compile(rf"^\s*{state}\b")

        def shown():
            try:
                return p.get_by_text(rx).first.is_visible()
            except Exception:
                return False
        if shown():
            return
        us = p.get_by_text(re.compile(r"^\s*United States\b")).first
        us.scroll_into_view_if_needed(timeout=8000)
        for how in ("text", "edge"):
            try:
                if how == "text":
                    us.click(timeout=3000)
                else:
                    b = us.bounding_box()
                    w = p.evaluate("window.innerWidth")
                    p.mouse.click(w - 70, b["y"] + b["height"] / 2)
            except Exception:
                continue
            for _ in range(6):
                p.wait_for_timeout(500)
                if shown():
                    return
        raise RuntimeError("USA dropdown khola jayni")

    def vpn_connect(self):
        if self.is_urban():
            return self.vpn_connect_urban()
        locs = voice_vpn_choices(self.cfg.get("vpn_locations", "")) or voice_vpn_choices(VOICE_DEFAULTS["vpn_locations"])
        pool = [x for x in locs if x != self.last_vpn] or locs
        choice = random.choice(pool)
        self.last_vpn = choice
        self.log(f"VPN: location -> {choice}")
        p = self.open_vpn_popup()
        try:
            if self.is_connected(p):
                self.click_power(p, re.compile(r"^\s*Connected"))
                p.get_by_text(re.compile(r"Connection is OFF", re.I)).first.wait_for(timeout=20000)
            opened = self.vpn_list_open(p)          # list age-i khola thakle kono location e click korbo na
            for name in ([] if opened else VOICE_FREE_LOCS):
                loc = p.get_by_text(re.compile(rf"^\s*{re.escape(name)}\b")).first
                try:
                    if loc.is_visible():
                        loc.click(timeout=3000)
                        opened = True
                        break
                except Exception:
                    continue
            if not opened:
                box = p.get_by_text("Your IP").first.bounding_box()
                p.mouse.click(box["x"] + 100, box["y"] - 60)
            p.wait_for_timeout(1200)
            if choice in VOICE_US_STATES:
                self.vpn_expand_us(p, choice)
            item = p.get_by_text(re.compile(rf"^\s*{re.escape(choice)}\b")).first
            item.scroll_into_view_if_needed(timeout=8000)
            self.vpn_pick(p, item)
            p.wait_for_timeout(1200)
            self.click_power(p, re.compile(r"Connection is OFF|Disconnected", re.I))
            try:
                for _ in range(15):
                    self.dismiss_popups(p)
                    try:
                        p.get_by_text(re.compile(r"^\s*Connected")).first.wait_for(timeout=2000)
                        break
                    except Exception:
                        continue
                else:
                    raise RuntimeError("connect timeout")
            except Exception:
                self.dismiss_popups(p)
                self.ask("VPN connect hoyni. Extension popup thakle nijer haate bondho kore OK chapen.")
                if not self.is_connected(p):
                    raise RuntimeError("VPN connect hoyni")
            self.log("  VPN connected")
        except Exception:
            self.debug(p, "vpn")
            raise
        finally:
            self.close_page(p)

    def clear_speechify_cookies(self):
        """Shudhu Speechify cookie muchhbe — Google (Gemini) login jeno na mushe."""
        try:
            self.ctx.clear_cookies(domain=re.compile(r"speechify", re.I))
            return
        except Exception:
            pass
        try:                                            # purano Playwright: Google cookie save kore baki muchhe, abar boshay
            keep = [c for c in self.ctx.cookies()
                    if re.search(r"google|youtube|gstatic|googleusercontent", c.get("domain", ""), re.I)]
            self.ctx.clear_cookies()
            if keep:
                self.ctx.add_cookies(keep)
        except Exception:
            pass

    def _sp_open_email_form(self, page, timeout=45):
        """Sign-in page e direct email form na eshe 'Continue with Google/Apple/Email' page ashle
        'Continue with Email' e click kore email+password form ber kore."""
        t0 = time.time()
        clicked = False
        while time.time() - t0 < timeout:
            try:
                if page.get_by_placeholder("Email address").first.is_visible():
                    return
            except Exception:
                pass
            if not clicked or time.time() - t0 > 8:
                try:
                    b = page.get_by_role("button", name=re.compile(r"Continue with Email", re.I)).first
                    if b.is_visible():
                        self.log("  'Continue with Email' page eshechhe — button e click korchi")
                        b.click(timeout=5000)
                        clicked = True
                except Exception:
                    pass
            time.sleep(0.5)

    def speechify(self, page, email, password, text, out_mp3, voice=None):
        cfg = self.cfg
        self.log(f"Speechify: login -> {email}")
        self.clear_speechify_cookies()
        page.goto(VOICE_SIGN_IN, timeout=90000)
        try:
            cdp = self.ctx.new_cdp_session(page)
            cdp.send("Storage.clearDataForOrigin", {"origin": VOICE_ORIGIN, "storageTypes": "all"})
        except Exception:
            pass
        page.goto(VOICE_SIGN_IN, timeout=90000)
        self._sp_open_email_form(page)
        page.get_by_placeholder("Email address").fill(email, timeout=30000)
        page.get_by_placeholder("Password").fill(password)
        page.get_by_role("button", name="Continue", exact=True).click()
        page.get_by_text("Build Something").wait_for(timeout=60000)
        self.log("  login hoyeche")
        acct_line = getattr(self, "_cur_acct", None)
        if acct_line:                                   # login hoyei mail 'used' — voice generate hok ba na hok, ar use hobe na
            self.mark_used(acct_line)
            self._last_acct = acct_line
            self._cur_acct = None
            self.log("  mail used list e geche (ar use hobe na)")
        page.get_by_text("Voiceover", exact=True).first.click()
        page.wait_for_url("**/voiceover/**", timeout=60000)
        ta = self.find_editor(page)
        self.select_voice(page, voice)
        self.sleep(500, page)
        limit = int(cfg.get("split_credit_limit", 600) or 0)
        leftovers = []                                  # je part gulo porer account e generate hobe (order e)
        cur = text
        self.log("  script paste")
        self._paste_script(page, ta, cur)
        credits = self._prep_split(page)
        while limit and credits and credits > limit:
            halves = split_script_half(cur)
            if not halves:
                self.log(f"  {credits} credits (limit {limit}) kintu ekta-i line — vag kora gelo na, ei vabei cholbe")
                break
            first, rest = halves
            self.log(f"  {credits} credits > {limit} — script line hishebe adha korlam "
                     f"(ei account e prothom ongsho, baki porer account e)")
            leftovers.insert(0, rest)
            cur = first
            self._cancel_split_dialog(page)
            ta = self.find_editor(page)
            self._clear_editor(page, ta)
            self._paste_script(page, ta, cur)
            credits = self._prep_split(page)
        split_btn = self._split_btn(page)
        try:
            lbl = (split_btn.inner_text(timeout=3000) or "").strip()
        except Exception:
            lbl = ""
        split_btn.click()
        self.log(f"  {lbl.splitlines()[0] if lbl else 'Split & Generate'}")
        self.wait_generation(page)
        self.export_and_download(page, out_mp3)
        return leftovers

    def _split_btn(self, page):
        # button kokhono "Split & Generate (206 credits)", kokhono shudhu "Split"
        return page.get_by_role("button", name=re.compile(r"^\s*Split\s*(&\s*Generate.*)?$", re.I)).first

    def _paste_script(self, page, ta, text):
        split_btn = self._split_btn(page)
        ta.click()
        try:
            page.evaluate("t => navigator.clipboard.writeText(t)", text)
            page.keyboard.press("Control+V")
            split_btn.wait_for(timeout=12000)
        except Exception:
            ta.click()
            ta.fill(text)
            split_btn.wait_for(timeout=15000)

    def _clear_editor(self, page, ta):
        for _ in range(2):
            try:
                ta.click()
                page.keyboard.press("Control+A")
                page.keyboard.press("Backspace")
                page.wait_for_timeout(500)
                if len((ta.inner_text(timeout=2000) or "").strip()) < 20:
                    return
            except Exception:
                pass

    def _cancel_split_dialog(self, page):
        try:
            page.get_by_role("button", name="Cancel", exact=True).first.click(timeout=3000)
        except Exception:
            page.keyboard.press("Escape")
        page.wait_for_timeout(800)

    def _close_credit_popup(self, page):
        """'You ran out of credits...' popup ashle cross (X) e click kore bondho kore. Buy/Continue button chapbe na."""
        page.wait_for_timeout(1200)
        if not self.credit_popup(page):
            return False
        self.log("  'ran out of credits' popup — cross e click kore bondho korchi")
        head = page.get_by_text(re.compile(r"^\s*With .*Plan, you get", re.I)).first
        strategies = (
            lambda: head.locator("xpath=following::button[1]"),
            lambda: head.locator("xpath=ancestor::div[.//button][1]").locator("button").first,
            lambda: page.get_by_role("button", name=re.compile(r"close", re.I)).last,
        )
        for mk in strategies:
            try:
                btn = mk()
                txt = ((btn.inner_text(timeout=1500) or "").strip()
                       + " " + (btn.get_attribute("aria-label", timeout=1500) or "")).strip()
                if txt and not re.fullmatch(r"(?i)(x|\u00d7|\u2715|\u2716|close)", txt.replace("Close", "close").strip()) \
                        and not re.search(r"(?i)close", txt):
                    continue                            # X na — onno button (Continue/Buy) hote pare, chapbo na
                btn.click(timeout=3000)
                page.wait_for_timeout(800)
                if not self.credit_popup(page):
                    self.log("  popup bondho holo")
                    return True
            except Exception:
                continue
        page.keyboard.press("Escape")
        page.wait_for_timeout(800)
        if self.credit_popup(page):
            self.log("  popup bondho korte parlam na (continue korchi)")
            return False
        return True

    def _read_credits(self, page):
        try:
            m = re.search(r"\(\s*([\d,\.]+)\s*credits?\s*\)", self._split_btn(page).inner_text(timeout=2500) or "", re.I)
            if m:
                return int(re.sub(r"[^\d]", "", m.group(1).split(".")[0]))
        except Exception:
            pass
        try:
            body = page.inner_text("body", timeout=2500)
            m = re.search(r"Expected credit usage:\s*([\d,]+)", body, re.I)
            if m:
                return int(m.group(1).replace(",", ""))
        except Exception:
            pass
        return None

    def _prep_split(self, page):
        """Popup bondho -> split mode + 'Generate speech immediately' tick -> button er credit number pore return."""
        self._close_credit_popup(page)
        mode = self.cfg.get("split_mode")
        if mode:
            try:
                page.get_by_text(mode, exact=True).first.click(timeout=3000)
            except Exception:
                pass
        try:
            cb = page.get_by_role("checkbox", name=re.compile(r"Generate speech immediately", re.I)).first
            if cb.count() and not cb.is_checked():
                cb.check(timeout=3000)
                page.wait_for_timeout(400)
        except Exception:
            try:
                page.get_by_text("Generate speech immediately after splitting", exact=False).first.click(timeout=2000)
                page.wait_for_timeout(400)
            except Exception:
                pass
        credits = None
        for _ in range(6):
            credits = self._read_credits(page)
            if credits is not None:
                break
            page.wait_for_timeout(500)
        self.log(f"  credit dekhacche: {credits if credits is not None else 'pai nai'}")
        return credits

    def select_voice(self, page, voice=None):
        name = (voice or self.cfg.get("voice_name") or "Albert (M)").strip() or "Albert (M)"
        self.log(f"  voice name: {name}")
        short = name.split("(")[0].strip()
        page.get_by_text(VOICE_CHIP_RE).first.click()
        page.get_by_text("Voice Library", exact=True).wait_for(timeout=20000)

        def find_row():
            return (page.locator("div")
                    .filter(has=page.get_by_text(name, exact=True))
                    .filter(has=page.get_by_role("button", name="Use Voice"))
                    .last)

        self.log("  voice: Favorites e khujchhi")
        page.get_by_text("Favorites", exact=True).click()
        page.wait_for_timeout(1500)
        found = page.get_by_text(name, exact=True).count() > 0
        if not found:
            self.log(f"  Library te search: {short}")
            page.get_by_text("Library", exact=True).first.click()
            page.wait_for_timeout(1000)
            try:
                page.get_by_placeholder("Search Voices").fill(short, timeout=5000)
            except Exception:
                page.get_by_role("textbox").first.fill(short)
            page.wait_for_timeout(2500)
            if page.get_by_text(name, exact=True).count() == 0:
                self.close_voice_library(page)
                raise RuntimeError(f"Voice '{name}' paoa jayni")
        row = find_row()
        use = row.get_by_role("button", name="Use Voice").first
        use.wait_for(timeout=15000)
        if use.is_enabled():
            use.click()
        page.wait_for_timeout(1000)
        if page.get_by_text("Voice Library", exact=True).is_visible():
            self.close_voice_library(page)
        self.log(f"  voice: {name}")

    def close_voice_library(self, page):
        try:
            page.get_by_role("button", name=re.compile("close", re.I)).first.click(timeout=2000)
        except Exception:
            try:
                page.get_by_text("Voice Library", exact=True).locator("xpath=following::button[1]").click(timeout=2000)
            except Exception:
                page.keyboard.press("Escape")
        page.wait_for_timeout(800)

    def regen_missing(self, page):
        chips = page.get_by_text(VOICE_CHIP_RE)
        clicked = 0
        for i in range(chips.count()):
            self.check_stop()
            chip = chips.nth(i)
            try:
                chip.scroll_into_view_if_needed(timeout=3000)
                play = chip.locator("xpath=preceding::button[1]")
                play.hover(timeout=3000)
                page.wait_for_timeout(500)
                if page.get_by_text("Regenerate block").first.is_visible():
                    play.click()
                    clicked += 1
                    page.wait_for_timeout(500)
            except Exception:
                continue
        return clicked

    def _check_credit(self, page):
        if self.credit_popup(page):
            ln = getattr(self, "_last_acct", None)
            if ln:
                self.mark_blocked(ln)
                self._last_acct = None
            raise RuntimeError("Credit shesh (You ran out of credits) — account block korlam, porer account e jachhi")

    def wait_generation(self, page):
        export = page.get_by_role("button", name="Export", exact=True)
        timeout = self.cfg["gen_timeout_min"] * 60
        self.sleep(6000, page)
        for rnd in range(8):
            t0 = time.time()
            self._check_credit(page)
            while not export.is_visible():
                self._check_credit(page)
                if time.time() - t0 > timeout:
                    raise RuntimeError("Generate timeout")
                self.sleep(3000, page)
            n = self.regen_missing(page)
            if n == 0:
                self.log("  sob block generate hoyeche")
                return
            self.log(f"  {n} ta block regenerate (round {rnd + 1})")
            self.sleep(6000, page)
        raise RuntimeError("Kichu block generate hoyni")

    def export_and_download(self, page, out_mp3):
        timeout = self.cfg["export_timeout_min"] * 60
        export = page.get_by_role("button", name="Export", exact=True)
        export.click()
        try:
            page.get_by_text(".MP3", exact=True).click(timeout=3000)
        except Exception:
            pass
        page.get_by_role("button", name="Export Project").click()
        self.log("  exporting...")
        try:
            page.get_by_role("button", name="View Downloads").click(timeout=20000)
        except Exception:
            try:
                export.locator("xpath=following::button[1]").click(timeout=3000)
            except Exception:
                pass
        self.sleep(2000, page)
        if "/exports" not in page.url:
            page.goto(VOICE_ORIGIN + "/exports", wait_until="domcontentloaded", timeout=90000)
        name = re.compile(r"^\s*Download\s*$")
        dl = (page.get_by_role("button", name=name)
              .or_(page.get_by_role("link", name=name))
              .or_(page.get_by_text(name))).first
        t0 = time.time()
        tries = 0
        while True:
            self.check_stop()
            try:
                dl.wait_for(state="visible", timeout=8000)
                break
            except Exception:
                pass
            if time.time() - t0 > timeout:
                self.debug(page, "export_wait")
                raise RuntimeError("Export file ashenai (timeout)")
            tries += 1
            if tries == 3:
                self.debug(page, "export_wait")
            self.log("  export ekhono ashenai, reload...")
            self.sleep(5000, page)
            try:
                page.reload(wait_until="domcontentloaded", timeout=60000)
            except Exception:
                pass
        self.log("  Download chapchi")
        with page.expect_download(timeout=180000) as d:
            dl.click()
        os.makedirs(os.path.dirname(out_mp3), exist_ok=True)
        d.value.save_as(out_mp3)
        if not os.path.exists(out_mp3) or os.path.getsize(out_mp3) < 1000:
            raise RuntimeError("MP3 download thik hoyni")
        self.log(f"  MP3 saved: {out_mp3}")

    def zamzar_dismiss(self, page):
        try:
            btn = page.get_by_role("button", name=re.compile(
                r"^(Accept all|Accept All|Accept|I agree|Agree|Allow all|Got it|OK|Consent)$", re.I))
            for i in range(min(btn.count(), 2)):
                if btn.nth(i).is_visible():
                    btn.nth(i).click(timeout=2000)
                    page.wait_for_timeout(500)
        except Exception:
            pass

    def zamzar_uploaded(self, page, mp3_name, wait_s=30):
        name = re.compile(re.escape(mp3_name))
        convert = page.get_by_role("button", name=re.compile(r"^\s*Convert( Now)?\s*$", re.I)).first
        t0 = time.time()
        while time.time() - t0 < wait_s:
            self.check_stop()
            for loc in (page.get_by_text(name).first, convert):
                try:
                    if loc.is_visible():
                        return True
                except Exception:
                    pass
            self.sleep(1000, page)
        return False

    def zamzar_upload(self, page, mp3):
        last = None
        mp3_name = os.path.basename(mp3)
        for rnd in range(3):
            self.check_stop()
            try:
                btn = (page.get_by_role("button", name=re.compile(r"Choose Files?", re.I))
                       .or_(page.get_by_text(re.compile(r"^\s*Choose Files?\s*$", re.I)))).first
                btn.wait_for(state="visible", timeout=15000)
                with page.expect_file_chooser(timeout=10000) as fc:
                    btn.click(timeout=5000)
                fc.value.set_files(mp3)
                if self.zamzar_uploaded(page, mp3_name):
                    return
            except Exception as e:
                last = e
            try:
                page.locator("input[type=file]").first.set_input_files(mp3, timeout=10000)
                if self.zamzar_uploaded(page, mp3_name, 20):
                    return
            except Exception as e:
                last = e
            self.log("  upload hoyni, reload...")
            self.debug(page, "zamzar_upload")
            try:
                page.reload(wait_until="domcontentloaded", timeout=60000)
            except Exception:
                pass
            self.sleep(3000, page)
            self.zamzar_dismiss(page)
        raise RuntimeError("Zamzar e file upload hoyni" + (f": {last}" if last else ""))

    def zamzar_limit_popup(self, page):
        """'Your files are ready to download / Create Zamzar account' popup."""
        for rx in (r"Your files are ready to download", r"Create Zamzar account",
                   r"used up your free conversions"):
            try:
                if page.get_by_text(re.compile(rx, re.I)).first.is_visible():
                    return True
            except Exception:
                pass
        return False

    def zamzar_no_files(self, page):
        """'No files found - Sorry, we couldn't find details for any uploaded files' page."""
        for rx in (r"No files found", r"couldn.?t find details"):
            try:
                if page.get_by_text(re.compile(rx, re.I)).first.is_visible():
                    return True
            except Exception:
                pass
        return False

    def zamzar_converting(self, page):
        """'Converting' spinner / 'Hang tight' message dekha jachche kina."""
        for rx in (r"^\s*Converting", r"Hang tight"):
            try:
                if page.get_by_text(re.compile(rx, re.I)).first.is_visible():
                    return True
            except Exception:
                pass
        return False

    def zamzar_convert_and_wait(self, page):
        now_rx = re.compile(r"^\s*Convert Now\s*$", re.I)
        conv_rx = re.compile(r"^\s*Convert\s*$", re.I)
        dl_rx = re.compile(r"^\s*Download\s*$")
        now = (page.get_by_role("button", name=now_rx).or_(page.get_by_role("link", name=now_rx))
               .or_(page.get_by_text(now_rx))).first
        pop = (page.get_by_role("button", name=conv_rx).or_(page.get_by_role("link", name=conv_rx))
               .or_(page.get_by_text(conv_rx))).first
        dl = (page.get_by_role("button", name=dl_rx).or_(page.get_by_role("link", name=dl_rx))
              .or_(page.get_by_text(dl_rx))).first

        def visible(loc):
            try:
                return loc.is_visible()
            except Exception:
                return False

        def done():
            return visible(dl) and ("/files/" in (page.url or "")
                                    or visible(page.get_by_text(re.compile(r"All Done", re.I)).first))

        interval = max(5.0, float(self.cfg.get("zamzar_check_sec", 20)))
        start_deadline = time.time() + self.cfg["convert_timeout_min"] * 60   # shudhu Convert chapar age porjonto
        started = False
        next_check = 0.0
        last_now = 0.0
        reclicked = False
        misses = 0
        while True:
            self.check_stop()
            if self.zamzar_no_files(page):
                raise ZamzarRetry("'No files found' page")
            if self.zamzar_limit_popup(page):
                raise ZamzarRetry("account popup (free limit)")
            if done():
                return dl
            if not started:
                if time.time() > start_deadline:
                    raise ZamzarRetry("Convert button paoa jayni / convert shuru hoyni")
                if visible(pop):
                    try:
                        pop.click(timeout=4000)
                        self.log("  converting...")
                        started = True
                        next_check = time.time() + interval
                    except Exception:
                        pass
                elif visible(now) and time.time() - last_now > 6:
                    try:
                        now.click(timeout=4000)
                        self.log("  Convert Now")
                        started = True
                        next_check = time.time() + interval
                    except Exception:
                        pass
                    last_now = time.time()
            elif time.time() >= next_check:
                next_check = time.time() + interval
                if done():
                    return dl
                if self.zamzar_converting(page):
                    misses = 0
                    self.log("  check: Converting cholche, wait...")
                else:
                    misses += 1
                    btn = pop if visible(pop) else (now if visible(now) else None)
                    if btn is not None and not reclicked:
                        reclicked = True
                        try:
                            btn.click(timeout=4000)
                            self.log("  check: Converting nai, Convert abar chaplam")
                        except Exception:
                            pass
                    elif misses >= 2:
                        raise ZamzarRetry("Converting dekhay nai")
                    else:
                        self.log("  check: Converting dekha jachchhe na, abar dekhbo...")
            self.sleep(1500, page)

    def zamzar(self, page, mp3, out_srt):
        self.log("Zamzar: upload")
        page.goto(VOICE_ZAMZAR, wait_until="domcontentloaded", timeout=90000)
        self.sleep(3000, page)
        self.zamzar_dismiss(page)
        self.zamzar_upload(page, mp3)
        self.log("  upload ok")
        self.sleep(2000, page)
        dl = self.zamzar_convert_and_wait(page)
        self.log("  SRT ready")
        got = []
        page.once("download", lambda d: got.append(d))
        try:
            dl.click(timeout=10000)
        except Exception:
            if self.zamzar_limit_popup(page):
                raise ZamzarRetry("Download e account popup ashlo")
        t0 = time.time()
        while not got and time.time() - t0 < 90:
            self.check_stop()
            if self.zamzar_limit_popup(page):
                raise ZamzarRetry("Download e account popup ashlo")
            if self.zamzar_no_files(page):
                raise ZamzarRetry("'No files found' page")
            self.sleep(1000, page)
        if not got:
            raise ZamzarRetry("Download shuru hoyni")
        got[0].save_as(out_srt)
        if not os.path.exists(out_srt) or os.path.getsize(out_srt) == 0:
            raise RuntimeError("SRT download thik hoyni")
        self.log(f"  SRT saved: {out_srt}")

    def _speechify_chunk(self, text, out_mp3, voice=None):
        """Ekta chunk ke ekta account e generate kore out_mp3 te rakhe. Return: je ongsho gulo baki (porer account e)."""
        skipped = set()
        for attempt in range(int(self.cfg["max_account_tries"])):
            self.check_stop()
            acct = self.peek_account(skipped)
            if not acct:
                raise RuntimeError("accounts.txt e aar mail nei")
            page = self.new_page()
            try:
                self._cur_acct = acct[2]
                left = self.speechify(page, acct[0], acct[1], text, out_mp3, voice)
                self.mark_used(acct[2])
                return left or []
            except VoiceStopped:
                self.release_account(acct[2])
                raise
            except Exception as e:
                self.log(f"  Speechify fail ({acct[0]}): {str(e).splitlines()[0][:200]}")
                self.debug(page, "speechify")
                skipped.add(acct[2])
                self.release_account(acct[2])
            finally:
                self.close_page(page)
        raise RuntimeError("Speechify e sob chesta fail")

    def do_speechify(self, text, mp3, voice=None):
        if self.cfg.get("vpn_disconnect_after", True):
            self.vpn_disconnect()
        base = os.path.splitext(os.path.basename(mp3))[0].lstrip(".")
        parts_dir = os.path.join(os.path.dirname(mp3), ".parts_" + base)
        rm_tree(parts_dir)
        os.makedirs(parts_dir, exist_ok=True)
        pending, files, n = [text], [], 0
        while pending:
            chunk = pending.pop(0)
            n += 1
            part = os.path.join(parts_dir, f"part{n}.mp3")
            left = self._speechify_chunk(chunk, part, voice)
            files.append(part)
            if left:
                self.log(f"  part {n} download hoyeche — baki {len(left)} ongsho notun account e hobe")
                pending = left + pending                # ei part er por-i porer ongsho, order thik thakbe
        if len(files) == 1:
            os.replace(files[0], mp3)
        else:
            self.log(f"  {len(files)} ta part jora lagachhi (part 1 age)")
            ok, err = merge_audio_files(files, mp3)
            if not ok:
                raise RuntimeError("Part jora lagano fail: " + err)
            self.log("  complete MP3 toiri hoyeche")
        rm_tree(parts_dir)

    def do_srt(self, mp3, srt):
        for attempt in range(int(self.cfg["max_vpn_tries"])):
            self.check_stop()
            try:
                self.vpn_connect()
            except VoiceStopped:
                raise
            except Exception as e:
                self.log(f"  VPN problem: {str(e).splitlines()[0][:200]}")
                continue
            try:
                self.ctx.clear_cookies(domain="zamzar.com")
            except Exception:
                pass
            page = self.new_page()
            try:
                self.zamzar(page, mp3, srt)
                return
            except VoiceStopped:
                raise
            except ZamzarRetry as e:
                self.log(f"  Zamzar retry ({e}) -> VPN change kore abar prothom theke upload")
                self.debug(page, "zamzar")
            except Exception as e:
                self.log(f"  Zamzar fail: {str(e).splitlines()[0][:200]}")
                self.debug(page, "zamzar")
            finally:
                self.close_page(page)
        raise RuntimeError("Zamzar e sob chesta fail")

    # ───────────────────────── Gemini: SRT correction ─────────────────────────
    # ── login helpers ──
    _G_AUTH = ("SID", "__Secure-1PSID", "__Secure-3PSID", "SAPISID", "__Secure-1PAPISID", "__Secure-3PAPISID")
    _G_EDITOR = "rich-textarea, div.ql-editor, [contenteditable='true'], textarea"

    def _g_cookie_file(self):
        return os.path.join(self.profile, ".gemini_cookies.json")

    def _g_has_auth(self, cookies):
        return any(c.get("name") in self._G_AUTH and "google" in (c.get("domain") or "") for c in (cookies or []))

    def _g_save_cookies(self, cookies):
        """Google login cookie gulo profile folder e backup rakhe (Chrome profile e save na hole eta diye abar boshano jabe)."""
        keep = [c for c in (cookies or []) if re.search(r"google|youtube", c.get("domain") or "", re.I)]
        if not self._g_has_auth(keep):
            return False
        try:
            atomic_write(self._g_cookie_file(), json.dumps(keep))
            return True
        except Exception:
            return False

    def _g_restore_cookies(self):
        try:
            data = json.loads(read_text(self._g_cookie_file()))
        except Exception:
            return False
        fallback = int(time.time()) + 30 * 86400
        n = 0
        for c in data:
            c = dict(c)
            ex = c.get("expires")
            if not isinstance(ex, (int, float)) or ex <= 0:
                c["expires"] = fallback                 # session cookie hole-o jeno profile e theke jay
            try:
                self.ctx.add_cookies([c])
                n += 1
            except Exception:
                pass
        return n > 0

    def _g_backup_cookies(self):
        if time.time() - getattr(self, "_g_bk_t", 0) < 600:
            return
        self._g_bk_t = time.time()
        try:
            self._g_save_cookies(self.ctx.cookies())
        except Exception:
            pass

    @staticmethod
    def _g_any_visible(page, sel, limit=8):
        """Selector er je kono ekta element visible hole True (shudhu prothom ta na — oita hidden hote pare)."""
        try:
            loc = page.locator(sel)
            for i in range(min(loc.count(), limit)):
                try:
                    if loc.nth(i).is_visible():
                        return True
                except Exception:
                    pass
        except Exception:
            pass
        return False

    def gemini_signed_out(self, page):
        try:
            if "accounts.google.com" in (page.url or ""):
                return True
            rx = re.compile(r"^\s*Sign in\s*$", re.I)
            for role in ("link", "button"):
                if page.get_by_role(role, name=rx).first.is_visible():
                    return True
            return False
        except Exception:
            return False

    def gemini_open(self, page):
        page.goto(GEMINI_URL, wait_until="domcontentloaded", timeout=90000)
        self.sleep(3500, page)
        if self.gemini_signed_out(page):
            if self._g_restore_cookies():
                self.log("  Login nei dekhacche — save kora Google session diye abar chesta korchi")
                page.goto(GEMINI_URL, wait_until="domcontentloaded", timeout=90000)
                self.sleep(3500, page)
            if self.gemini_signed_out(page):
                raise GeminiLoginNeeded("Gemini te login nei")
        else:
            self._g_backup_cookies()

    def gemini_wait_login(self):
        """Login nai: automation Chrome bondho kore normal Chrome (Google block kore na) khole rakhe,
        login hoyeche detect hole Chrome bondho kore abar automation Chrome chalu kore."""
        import socket
        exe = _voice_chrome_exe()
        if not exe:
            raise RuntimeError("Google Chrome paoa jayni (install kora ache to?)")
        try:
            check_sec = max(5, int(self.cfg.get("gemini_login_check_sec", 20)))
        except (TypeError, ValueError):
            check_sec = 20
        self.log("Gemini te login nei. Chrome khulchhe — Google account diye LOGIN korun. "
                 f"Prottek {check_sec} second por check korbo; login hole sathe sathe kaj shuru hobe, "
                 "Chrome nijer haate bondho korben na.")
        try:
            self.ctx.close()
        except Exception:
            pass
        self.own.clear()
        self.keepalive = None
        t0 = time.time()
        while _voice_profile_in_use(self.profile) and time.time() - t0 < 20:
            time.sleep(1)
        sk = socket.socket()
        sk.bind(("127.0.0.1", 0))
        port = sk.getsockname()[1]
        sk.close()
        proc = subprocess.Popen([exe, f"--user-data-dir={self.profile}", f"--remote-debugging-port={port}",
                                 "--no-first-run", "--no-default-browser-check", "--start-maximized", GEMINI_URL])
        browser = None
        ok = False
        saved = []

        def all_cookies():
            out = []
            for c in browser.contexts:
                try:
                    out += c.cookies()
                except Exception:
                    pass
            return out

        def probe():
            """(logged_in, diagnostic text). Login = Gemini tab e 'Sign in' nei + (text box dekha jay ba Google login cookie ache)."""
            try:
                ck = all_cookies()
                auth = self._g_has_auth(ck)
                seen = []
                good = False
                for c in browser.contexts:
                    for pg in c.pages:
                        url = pg.url or ""
                        if "gemini.google.com" not in url:
                            seen.append("other-tab")
                            continue
                        so = self.gemini_signed_out(pg)
                        ed = self._g_any_visible(pg, self._G_EDITOR)
                        seen.append(f"gemini(SignIn={'ache' if so else 'nei'}, textbox={'ache' if ed else 'nei'})")
                        if not so and (ed or auth):
                            good = True
                return good, f"{', '.join(seen) or 'kono tab nei'}; login-cookie={'ache' if auth else 'nei'}"
            except Exception as e:
                return False, "check error: " + ((str(e).splitlines() or [type(e).__name__])[0][:100])

        try:
            for _ in range(40):
                self.check_stop()
                try:
                    browser = self.pw.chromium.connect_over_cdp(f"http://127.0.0.1:{port}")
                    break
                except Exception:
                    time.sleep(1)
            if browser is None:
                raise RuntimeError("Login Chrome er sathe connect hoyni")
            t0 = time.time()
            while time.time() - t0 < 30 * 60:
                self.check_stop()
                good, why = probe()
                if good:
                    time.sleep(2)                       # ekta chhoto double-check (false positive thekate)
                    good, why = probe()
                    if good:
                        ok = True
                        break
                self.log(f"  Login ekhono hoyni [{why}] — Chrome e Gemini te login korun. {check_sec} sec por abar check korbo...")
                for _ in range(check_sec):              # 1 sec kore ghumai — jeno STOP sathe sathe kaj kore
                    self.check_stop()
                    time.sleep(1)
            if not ok:
                raise RuntimeError("Gemini login timeout (30 minute)")
            self.log(f"  Login detect hoyeche [{why}] — ekhoni kaj shuru korchi")
            time.sleep(6)                               # Chrome ke cookie/session disk e likhte somoy dao
            try:
                saved = all_cookies()
            except Exception:
                saved = []
            try:
                browser.new_browser_cdp_session().send("Browser.close")
            except Exception:
                pass
        finally:
            try:
                if browser:
                    browser.close()
            except Exception:
                pass
            try:
                proc.wait(timeout=30)                   # nijer-i bondho hote dao (zor kore marle cookie hariye jay)
            except Exception:
                try:
                    proc.terminate()
                except Exception:
                    pass
            t1 = time.time()
            while _voice_profile_in_use(self.profile) and time.time() - t1 < 20:
                time.sleep(1)
        try:
            with open(os.path.join(self.profile, ".gemini_ok"), "w") as fh:
                fh.write("ok")
        except Exception:
            pass
        self._g_save_cookies(saved)
        self.launch(self.pw)
        try:                                            # profile e login session thikmoto save hoyeche kina
            if self._g_has_auth(self.ctx.cookies()):
                self.log("  Login session profile e save hoyeche \u2713")
            elif self._g_restore_cookies():
                self.log("  Profile e session save hoyni — backup diye Google login boshano holo")
        except Exception:
            pass

    def gemini_agree(self, page):
        """"Creating content from images and files" popup — Agree chapa (onek poddhoti try kore)."""
        title = page.get_by_text(re.compile(r"Creating content from images and files", re.I)).first

        def shown():
            try:
                return title.is_visible()
            except Exception:
                return False

        if not shown():
            return False
        rx = re.compile(r"^\s*(I\s+)?Agree\s*$", re.I)

        def js_click():
            page.evaluate("""() => {
                const els = [...document.querySelectorAll('button, [role=button], span, div')];
                const t = els.filter(e => /^\\s*(I\\s+)?agree\\s*$/i.test(e.textContent || '') && e.children.length < 3);
                if (t.length) { const e = t[t.length - 1]; (e.closest('button') || e).click(); }
            }""")

        def mouse_click():
            box = page.get_by_text(rx).last.bounding_box()
            page.mouse.click(box["x"] + box["width"] / 2, box["y"] + box["height"] / 2)

        steps = [
            lambda: page.get_by_role("button", name=rx).first.click(timeout=2500),
            lambda: page.locator("button:has-text('Agree')").last.click(timeout=2500, force=True),
            lambda: page.get_by_text(rx).last.click(timeout=2500, force=True),
            mouse_click,
            js_click,
            lambda: page.keyboard.press("Enter"),
        ]
        for st in steps:
            try:
                st()
            except Exception:
                pass
            page.wait_for_timeout(900)
            if not shown():
                self.log("  Gemini popup: Agree")
                return True
        self.log("  Gemini popup: Agree button click hoyni")
        self.debug(page, "gemini_agree")
        return False

    def gemini_editor(self, page):
        cands = [
            lambda: page.locator("div.ql-editor[contenteditable='true']"),
            lambda: page.locator("rich-textarea [contenteditable='true']"),
            lambda: page.get_by_role("textbox"),
            lambda: page.locator("[contenteditable='true']"),
        ]
        for _ in range(40):
            self.dismiss_onboarding(page)
            for mk in cands:
                try:
                    loc = mk().first
                    if loc.is_visible():
                        return loc
                except Exception:
                    continue
            self.sleep(1500, page)
        raise RuntimeError("Gemini text box paoa jayni")

    def gemini_fill_prompt(self, page, ta, prompt):
        want = len(re.sub(r"\s+", "", prompt))

        def got():
            try:
                return len(re.sub(r"\s+", "", ta.inner_text(timeout=3000)))
            except Exception:
                return 0

        def clear():
            try:
                ta.click()
                page.keyboard.press("Control+A")
                page.keyboard.press("Delete")
            except Exception:
                pass

        ta.click()
        try:
            page.keyboard.insert_text(prompt)
        except Exception:
            pass
        page.wait_for_timeout(1000)
        if got() >= want * 0.9:
            return
        clear()
        try:
            ta.fill(prompt, timeout=15000)
        except Exception:
            pass
        page.wait_for_timeout(1000)
        if got() >= want * 0.9:
            return
        clear()
        try:                                    # last resort: clipboard paste
            page.evaluate("t => navigator.clipboard.writeText(t)", prompt)
            ta.click()
            page.keyboard.press("Control+V")
        except Exception:
            pass
        page.wait_for_timeout(1500)
        if got() < want * 0.9:
            raise RuntimeError("Prompt paste hoyni")

    def gemini_upload(self, page, files):
        item_rx = re.compile(r"^\s*Upload files?\b", re.I)
        plus = [
            lambda: page.locator("button[aria-label*='upload' i]"),
            lambda: page.get_by_role("button", name=re.compile(r"upload|add files?|attach|add to prompt", re.I)),
            lambda: page.locator("button[aria-label*='Add' i]"),
            lambda: page.locator("button[aria-label*='menu' i]"),
        ]
        last = None
        for mk in plus:
            try:
                btn = mk().first
                if not btn.is_visible():
                    continue
                btn.click(timeout=4000)
                item = (page.get_by_role("menuitem", name=item_rx).or_(page.get_by_text(item_rx))).first
                item.wait_for(state="visible", timeout=5000)
                with page.expect_file_chooser(timeout=25000) as fc:
                    item.click(timeout=4000)
                    for _ in range(8):              # Agree popup ashle chooser tar por-i khole
                        page.wait_for_timeout(600)
                        if self.gemini_agree(page):
                            break
                fc.value.set_files(files)
                self.gemini_agree(page)
                return
            except Exception as e:
                last = e
                try:
                    page.keyboard.press("Escape")
                except Exception:
                    pass
        try:
            page.locator("input[type=file]").first.set_input_files(files, timeout=8000)
            return
        except Exception as e:
            last = e
        raise RuntimeError("Gemini e file upload hoyni: " + str(last).splitlines()[0][:120] if last else "upload")

    def gemini_send_btn(self, page):
        return page.locator("button[aria-label*='Submit' i], button[aria-label*='Send' i]").last

    def gemini_wait_ready(self, page, names, timeout=180):
        """Upload shesh hole (Submit button enable) sathe sathe-i jabe — 0.5s por por check."""
        send = self.gemini_send_btn(page)
        bad = page.get_by_text(re.compile(r"isn.t supported|not supported|unsupported|can.t upload|couldn.t upload", re.I)).first
        self.sleep(1200, page)                     # upload shuru howar jonno ektu somoy
        t0 = time.time()
        ok = 0
        while time.time() - t0 < timeout:
            self.check_stop()
            self.gemini_agree(page)
            try:
                if bad.is_visible():
                    raise RuntimeError("UNSUPPORTED file type")
            except RuntimeError:
                raise
            except Exception:
                pass
            try:
                enabled = send.is_visible() and send.is_enabled() and \
                    (send.get_attribute("aria-disabled") or "").lower() != "true"
            except Exception:
                enabled = False
            ok = ok + 1 if enabled else 0
            if ok >= 2:
                return
            self.sleep(500, page)
        raise RuntimeError("Gemini upload complete hoyni (timeout)")

    def _gem_timeout_sec(self):
        try:
            return max(30.0, float(self.cfg.get("gemini_timeout_min", 15)) * 60)
        except (TypeError, ValueError):
            return 15 * 60.0

    def gemini_wait_done(self, page):
        timeout = self._gem_timeout_sec()
        export = page.get_by_role("button", name=re.compile(r"^\s*Export\b", re.I))
        open_card = self.gemini_open_card_btn(page)
        stop = page.locator("button[aria-label*='Stop' i]")
        limit = page.get_by_text(re.compile(r"reached your limit|usage limit|too many requests", re.I)).first
        t0 = time.time()
        stable = 0
        idle_since = None
        while True:
            self.check_stop()
            if time.time() - t0 > timeout:
                raise RuntimeError("Gemini timeout (%s min e file toiri hoyni)" % self.cfg.get("gemini_timeout_min", 15))
            try:
                if limit.is_visible():
                    raise RuntimeError("Gemini limit/usage cap hoye geche")
            except RuntimeError:
                raise
            except Exception:
                pass
            try:
                running = stop.first.is_visible()
            except Exception:
                running = False
            try:
                ex = export.last
                ex_ok = ex.is_visible() and ex.is_enabled()
            except Exception:
                ex_ok = False
            if not ex_ok:                       # Export na thakle: file card er "Open" button
                try:
                    oc = open_card.last
                    ex_ok = oc.is_visible() and oc.is_enabled()
                except Exception:
                    ex_ok = False
            if not ex_ok:                       # file card nai: "Code snippet" er download button
                ex_ok = self.gemini_snippet_ready(page)
            if ex_ok and not running:
                stable += 1
                if stable >= 2:
                    self.sleep(800, page)
                    return
            else:
                stable = 0
            if not running and not ex_ok and time.time() - t0 > 40:
                idle_since = idle_since or time.time()
                if time.time() - idle_since > 60:
                    raise RuntimeError("Gemini file (Export) toiri kore ni")
            else:
                idle_since = None
            self.sleep(1000, page)

    def gemini_open_card_btn(self, page):
        """File card (output / MD) er 'Open' button — jokhon Export button thake na."""
        return page.locator("button, a, [role='button']").filter(
            has_text=re.compile(r"^\s*Open\s*$", re.I))

    def gemini_snippet_btn(self, page):
        """Gemini jodi file card na diye 'Code snippet' box e SRT dey: oi box er Download button
        (copy button er baam pashe)."""
        scope = page.locator("code-block, .code-block, [class*='code-block']")
        sel = ("button[aria-label*='Download' i], [role='button'][aria-label*='Download' i], "
               "button[title*='Download' i], [data-tooltip*='Download' i], [mattooltip*='Download' i]")
        return scope.locator(sel)

    def gemini_snippet_ready(self, page):
        try:
            b = self.gemini_snippet_btn(page).last
            return b.is_visible() and b.is_enabled()
        except Exception:
            return False

    def gemini_download_via_snippet(self, page, dest_md):
        """Code snippet er Download button -> .txt download hoy -> app oita SRT e convert kore."""
        self.log("  File card nai — Code snippet er Download button e click (.txt download hobe)")
        btn = self.gemini_snippet_btn(page).last
        btn.scroll_into_view_if_needed(timeout=5000)
        try:
            with page.expect_download(timeout=60000) as d:
                btn.click(timeout=6000)
            d.value.save_as(dest_md)
            self._gemini_save_ok(dest_md)
            return
        except Exception as e:
            self.log(f"  snippet download fail: {str(e).splitlines()[0][:100]} — code text copy kore nichhi")
        # fallback: code box er text sorasori pora
        blk = page.locator("code-block, .code-block, [class*='code-block']").last
        txt = blk.inner_text(timeout=8000)
        if not txt or not txt.strip():
            raise RuntimeError("Code snippet faka")
        atomic_write(dest_md, txt)
        self._gemini_save_ok(dest_md)

    def _gemini_save_ok(self, dest_md):
        if not os.path.exists(dest_md) or os.path.getsize(dest_md) == 0:
            raise RuntimeError(".md download thik hoyni")

    def gemini_download_via_export(self, page, dest_md):
        export = page.get_by_role("button", name=re.compile(r"^\s*Export\b", re.I)).last
        export.click(timeout=8000)
        md = (page.get_by_role("menuitem", name=re.compile(r"^\s*\.md\s*$", re.I))
              .or_(page.get_by_text(".md", exact=True))).first
        md.wait_for(state="visible", timeout=10000)
        with page.expect_download(timeout=60000) as d:
            md.click(timeout=5000)
        d.value.save_as(dest_md)
        self._gemini_save_ok(dest_md)

    def gemini_download_via_open(self, page, dest_md):
        """Card e 'Open' -> file viewer khole -> upor daan dike Download button."""
        self.log("  Export nai — file card er 'Open' button e click")
        card = self.gemini_open_card_btn(page).last
        card.scroll_into_view_if_needed(timeout=5000)
        card.click(timeout=8000)
        self.sleep(1500, page)
        dl_sel = ("button[aria-label*='Download' i], [role='button'][aria-label*='Download' i], "
                  "a[aria-label*='Download' i], button[title*='Download' i], "
                  "[data-tooltip*='Download' i], [mattooltip*='Download' i]")
        last = None
        for _ in range(3):
            targets = [page] + [f for f in page.frames if f != page.main_frame]
            for t in targets:
                try:
                    btn = t.locator(dl_sel).or_(
                        t.get_by_role("button", name=re.compile(r"download", re.I))).last
                    btn.wait_for(state="visible", timeout=6000)
                    with page.expect_download(timeout=60000) as d:
                        btn.click(timeout=5000)
                    d.value.save_as(dest_md)
                    self._gemini_save_ok(dest_md)
                    try:
                        page.keyboard.press("Escape")      # viewer bondho
                    except Exception:
                        pass
                    return
                except Exception as e:
                    last = e
            self.sleep(1500, page)
        raise RuntimeError("Viewer e Download button kaj korenni: " + (str(last).splitlines()[0][:100] if last else ""))

    def gemini_download_md(self, page, dest_md):
        export = page.get_by_role("button", name=re.compile(r"^\s*Export\b", re.I))
        try:
            has_export = export.last.is_visible()
        except Exception:
            has_export = False
        if has_export:
            order = [self.gemini_download_via_export, self.gemini_download_via_open,
                     self.gemini_download_via_snippet]
        elif self.gemini_snippet_ready(page):
            order = [self.gemini_download_via_snippet, self.gemini_download_via_open,
                     self.gemini_download_via_export]
        else:
            order = [self.gemini_download_via_open, self.gemini_download_via_snippet,
                     self.gemini_download_via_export]
        err = None
        for fn in order:
            dl = getattr(self, "_gem_deadline", None)
            if dl and time.time() > dl:
                raise RuntimeError("Gemini timeout (download %s min er moddhe hoyni)" % self.cfg.get("gemini_timeout_min", 15))
            try:
                fn(page, dest_md)
                return
            except Exception as e:
                err = e
                self.log(f"  download method fail ({fn.__name__}): {str(e).splitlines()[0][:100]}")
                try:
                    page.keyboard.press("Escape")
                except Exception:
                    pass
        raise err if err else RuntimeError(".md download thik hoyni")

    def gemini_once(self, page, prompt, files, lb_path, out_srt, strict):
        self.log("Gemini: open")
        self.gemini_open(page)
        ta = self.gemini_editor(page)
        self.log("  prompt paste")
        self.gemini_fill_prompt(page, ta, prompt)
        self.log("  script + SRT upload")
        self.gemini_upload(page, files)
        self.gemini_wait_ready(page, [os.path.basename(f) for f in files])
        self.log("  submit")
        sent = False
        for how in range(3):
            try:
                if how == 0:
                    self.gemini_send_btn(page).click(timeout=4000)
                elif how == 1:
                    self.gemini_send_btn(page).click(timeout=3000, force=True)
                else:
                    ta.click()
                    page.keyboard.press("Enter")
            except Exception:
                pass
            for _ in range(8):                      # submit holo kina — Stop button ashbe ba text box faka hobe
                self.sleep(500, page)
                try:
                    if page.locator("button[aria-label*='Stop' i]").first.is_visible():
                        sent = True
                        break
                    if len(re.sub(r"\s+", "", ta.inner_text(timeout=1500))) < 20:
                        sent = True
                        break
                except Exception:
                    sent = True
                    break
            if sent:
                break
        if not sent:
            raise RuntimeError("Submit button click hoyni")
        self._gem_deadline = time.time() + self._gem_timeout_sec()   # submit theke download porjonto
        self.log("  Gemini file toiri korche... (timeout %s min)" % self.cfg.get("gemini_timeout_min", 15))
        self.gemini_wait_done(page)
        tmp_md = out_srt + ".md.tmp"
        self.log("  Export / Download -> .md / .txt")
        self.gemini_download_md(page, tmp_md)
        try:
            text, n = voice_md_to_srt(read_text(tmp_md))
        finally:
            try:
                os.remove(tmp_md)
            except OSError:
                pass
        if n == 0:
            raise RuntimeError("Download kora .md te SRT block nei")
        # 100% match: SRT er block sonkha == script er line (sentence) sonkha. Na mille kichui save hobe na.
        script_lines = [l.strip() for l in read_text(lb_path).splitlines() if l.strip()]
        want = len(script_lines)
        if want:
            problems = voice_srt_match_problems(text, script_lines)
            if problems:
                for pr in problems[:5]:
                    self.log("    " + pr)
                if len(problems) > 5:
                    self.log(f"    ... aro {len(problems) - 5} ta somossha")
                raise RuntimeError(f"SRT match hoyni: {n}/{want} block, {len(problems)} ta somossha")
        atomic_write(out_srt, text)
        self.log(f"  Corrected SRT saved: {out_srt}")

    def gemini_correct(self, lb_path, srt_path, out_srt):
        prompt = voice_prompt_read().strip() or VOICE_DEFAULT_PROMPT
        tries = max(1, int(self.cfg.get("gemini_tries", 2)))
        return self._gemini_loop(prompt, tries, lb_path, srt_path, out_srt)

    def _gemini_loop(self, prompt, tries, lb_path, srt_path, out_srt):
        use_txt = False
        tmpd = None
        last = None
        attempt = 0
        logins = 0
        need_login = False
        while attempt < tries:
            self.check_stop()
            if need_login:
                need_login = False
                logins += 1
                self.gemini_wait_login()
            files = [lb_path, srt_path]
            if use_txt:
                if not tmpd:
                    tmpd = tempfile.mkdtemp(prefix="gem_")
                cp = os.path.join(tmpd, os.path.splitext(os.path.basename(srt_path))[0] + "_srt.txt")
                shutil.copyfile(srt_path, cp)
                files = [lb_path, cp]
            page = self.new_page()
            try:
                self.gemini_once(page, prompt, files, lb_path, out_srt, strict=(attempt < tries - 1))
                if tmpd:
                    rm_tree(tmpd)
                return
            except VoiceStopped:
                if tmpd:
                    rm_tree(tmpd)
                raise
            except GeminiLoginNeeded as e:
                last = e
                if logins >= 2:
                    attempt += 1
                    self.log("  Login-er pore-o Gemini te login nei dekhacche")
                else:
                    need_login = True
                continue
            except Exception as e:
                last = e
                msg = str(e).splitlines()[0][:200]
                self.log(f"  Gemini fail: {msg}")
                if "timeout" in msg.lower() and attempt + 1 < tries:
                    self.log(f"  Timeout — notun kore abar submit korchi (try {attempt + 2}/{tries})")
                self.debug(page, "gemini")
                if "UNSUPPORTED" in msg and not use_txt:
                    use_txt = True                      # .srt nile na — .txt naam diye abar
                    self.log("  .srt accept kore ni, .txt hishebe upload korchi")
                    continue
                attempt += 1
            finally:
                self.close_page(page)
        if tmpd:
            rm_tree(tmpd)
        raise RuntimeError("Gemini e sob chesta fail" + (f": {str(last).splitlines()[0][:120]}" if last else ""))

    def do_gemini(self, name, out, force=False):
        lb = _voice_find_lb(name)
        if not lb:
            self.log("Line break script nei — Gemini correction skip")
            return False
        srt = next((os.path.join(out, f) for f in sorted(os.listdir(out))
                    if f.lower().endswith(".srt") and not f.startswith(VOICE_CORR_PREFIX)), None)
        if not srt:
            self.log("Original SRT nei — Gemini correction skip")
            return False
        corr = os.path.join(out, f"{VOICE_CORR_PREFIX}{name}.srt")
        if not force and os.path.exists(corr) and os.path.getsize(corr) > 0:
            self.log("  Corrected SRT age thekei ache")
            return True
        self.vpn_disconnect()                           # Gemini VPN e kaj kore na
        self.gemini_correct(lb, srt, corr)
        return True

    def run_gemini_only(self, name):
        from playwright.sync_api import sync_playwright
        out = os.path.join(self.cfg["output_dir"], name)
        with sync_playwright() as pw:
            self.launch(pw)
            try:
                self.log(f"===== {name} (Gemini) =====")
                self.do_gemini(name, out, force=True)
            finally:
                if self.cfg.get("vpn_disconnect_after", True):
                    self.vpn_disconnect()
                try:
                    self.ctx.close()
                except Exception:
                    pass
                voice_trim_profile(self.profile)

    def _find_audio(self, out):
        for f in sorted(os.listdir(out)):
            if os.path.splitext(f)[1].lower() in AUDIO_EXTS and not f.startswith(".regen"):
                return os.path.join(out, f)
        return None

    def regen_mp3(self, name, out):
        src = next((os.path.join(b, f"{name}.txt") for b in (VOICE_DONE, VOICE_SCRIPTS)
                    if os.path.exists(os.path.join(b, f"{name}.txt"))), None)
        if not src:
            raise RuntimeError("Raw script (.txt) paoa jayni")
        text = open(src, encoding="utf-8").read().strip()
        tmp = os.path.join(out, ".regen_tmp.mp3")
        if os.path.exists(tmp):
            os.remove(tmp)
        self.do_speechify(text, tmp, voice_for_script(name, self.cfg))
        for f in os.listdir(out):
            if os.path.splitext(f)[1].lower() in AUDIO_EXTS and f != ".regen_tmp.mp3":
                os.remove(os.path.join(out, f))
        os.replace(tmp, os.path.join(out, f"{name}.mp3"))
        self.log(f"MP3 notun kore toiri: {name}.mp3  -> ebar SRT + Corrected SRT")
        self.regen_srt(name, out)

    def regen_srt(self, name, out):
        mp3 = self._find_audio(out)
        if not mp3:
            raise RuntimeError("Ei folder e MP3 nei")
        tmp = os.path.join(out, ".regen_tmp.srt")
        if os.path.exists(tmp):
            os.remove(tmp)
        self.do_srt(mp3, tmp)
        for f in os.listdir(out):
            if f.lower().endswith(".srt") and f != ".regen_tmp.srt":      # purano SRT + purano Corrected SRT
                os.remove(os.path.join(out, f))
        os.replace(tmp, os.path.join(out, f"{name}.srt"))
        self.log(f"SRT notun kore toiri: {name}.srt")
        if self.cfg.get("gemini_enabled", True):
            try:
                self.do_gemini(name, out, force=True)
            except VoiceStopped:
                raise
            except Exception as e:
                self.log(f"Gemini fail: {str(e).splitlines()[0][:200]} (Corrected SRT hoyni — 'Gemini fix' chapun)")

    def sync_queue(self, name):
        """Regenerate / Gemini fix er por: sob ready hole script queue theke soray, na hole (done e thakle) queue e ferot ane."""
        try:
            if voice_script_complete(name, self.cfg):
                if voice_move_to_done(name):
                    self.log(f"  '{name}' er sob ready (MP3 + SRT + Corrected) — script queue theke soriye done e rakha holo")
            elif voice_restore_to_queue(name):
                self.log(f"  '{name}' er kichu baki ache — script abar queue e rakha holo "
                         "(START dile shudhu baki ta toiri hobe)")
        except Exception:
            pass

    def run_single(self, name, what):
        from playwright.sync_api import sync_playwright
        out = os.path.join(self.cfg["output_dir"], name)
        with sync_playwright() as pw:
            self.launch(pw)
            try:
                self.log(f"===== {name} ({what}) =====")
                if what == "mp3":
                    self.regen_mp3(name, out)
                elif what == "srt":
                    self.regen_srt(name, out)
                else:
                    self.do_gemini(name, out, force=True)
            finally:
                if self.cfg.get("vpn_disconnect_after", True):
                    self.vpn_disconnect()
                try:
                    self.ctx.close()
                except Exception:
                    pass
                voice_trim_profile(self.profile)
                self.sync_queue(name)

    def process(self, fpath):
        name = os.path.splitext(os.path.basename(fpath))[0]
        text = open(fpath, encoding="utf-8").read().strip()
        out = os.path.join(self.cfg["output_dir"], name)
        os.makedirs(out, exist_ok=True)
        mp3, srt = os.path.join(out, f"{name}.mp3"), os.path.join(out, f"{name}.srt")
        self.log(f"===== {name} =====")
        try:
            if not (os.path.exists(mp3) and os.path.getsize(mp3) > 1000):
                self.do_speechify(text, mp3, voice_for_script(name, self.cfg))
                for _f in os.listdir(out):               # notun MP3 hole purano SRT / Corrected SRT ar kaj-er na
                    if _f.lower().endswith(".srt"):
                        try:
                            os.remove(os.path.join(out, _f))
                        except OSError:
                            pass
            if voice_state(name, self.cfg)[1]:
                self.log("  SRT age thekei ache — skip")
            else:
                self.do_srt(mp3, srt)
            if self.cfg.get("gemini_enabled", True):
                try:
                    self.do_gemini(name, out)
                except VoiceStopped:
                    raise
                except Exception as e:
                    self.log(f"Gemini fail: {str(e).splitlines()[0][:200]} (MP3 + SRT ager moto ache)")
            if voice_script_complete(name, self.cfg):
                voice_move_to_done(name)                # sob ready — script queue theke muche jabe
                self.log(f"SHESH: {name}  ->  {out}")
            else:
                self.log(f"SHESH: {name}  ->  {out}  (Corrected SRT baki — script queue e-i thaklo; "
                         "abar START dile shudhu baki ta toiri hobe)")
        finally:
            if self.cfg.get("vpn_disconnect_after", True):
                self.vpn_disconnect()

    def run(self, files=None):
        _voice_ensure_dirs()
        if files is None:
            files = sorted(
                [os.path.join(VOICE_SCRIPTS, f) for f in os.listdir(VOICE_SCRIPTS)
                 if f.lower().endswith(".txt") and os.path.isfile(os.path.join(VOICE_SCRIPTS, f))])
        if not files:
            self.log("Scripts folder e kono .txt script nei.")
            return
        q = queue.Queue()
        for f in files:
            q.put(f)
        self.run_queue(q)

    def run_queue(self, q, first=None):
        """Ei Chrome shared queue theke ekta ekta script ney — je Chrome age free hoy shei porer script ney.
        Onno Chrome er jonno wait kore na. 'first' = dispatcher je script ta age-i diye diyeche."""
        from playwright.sync_api import sync_playwright
        with sync_playwright() as pw:
            try:
                self.launch(pw)
            except BaseException:
                if first is not None:
                    q.put(first)                        # Chrome khulte na parle script ta queue te ferot
                raise
            try:
                while True:
                    self.check_stop()
                    if first is not None:
                        f, first = first, None
                    else:
                        try:
                            f = q.get_nowait()
                        except queue.Empty:
                            break
                    try:
                        self.process(f)
                    except VoiceStopped:
                        raise
                    except Exception as e:
                        self.log(f"FAIL: {os.path.basename(f)}: {str(e).splitlines()[0][:250]}")
            finally:
                try:
                    self.ctx.close()
                except Exception:
                    pass
                voice_trim_profile(self.profile)


def voice_clone_profile(i, log):
    """Thread i er alada Chrome profile. Main theke copy ar hoy na — prottek profile e VeePN
    alada kore ekbar setup korte hoy ('Thread Profiles Setup'). Setup hoye thakle path dey, na hole None."""
    dst = os.path.join(VOICE_CLONES, f"t{i}")
    if os.path.exists(os.path.join(dst, ".veepn_ok")):
        return dst
    log(f"Thread {i}: ei profile e VeePN setup kora nei — Settings > Chrome > 'Thread Profiles Setup' "
        f"chalie ekbar setup koro. (Thread {i} bad)")
    return None


class ActivityBar(tk.Canvas):
    """Chhoto 'kaj cholche' bar — active thakle ekta alo ghure."""

    def __init__(self, parent, height=5):
        super().__init__(parent, height=height, bg=parent["bg"], highlightthickness=0, bd=0)
        self.on, self._job, self._p = False, None, 0.0
        self.bind("<Configure>", lambda e: self._draw())

    def set_active(self, flag):
        flag = bool(flag)
        if flag == self.on:
            return
        self.on = flag
        if flag and self._job is None:
            self._tick()
        elif not flag:
            self._draw()

    def _tick(self):
        self._job = None
        if not self.on:
            self._draw()
            return
        self._p = (self._p + 0.018) % 1.0
        self._draw()
        try:
            self._job = self.after(30, self._tick)
        except tk.TclError:
            pass

    def _draw(self):
        try:
            self.delete("all")
            W, H = self.winfo_width(), self.winfo_height()
            if W < 10:
                return
            self.create_rectangle(0, 0, W, H, fill=PANEL2, outline="")
            if self.on:
                seg = W * 0.3
                x = -seg + (W + seg) * self._p
                self.create_rectangle(max(0, x), 0, min(W, x + seg), H, fill=ACCENT, outline="")
        except tk.TclError:
            pass

    def _retheme(self):
        self._draw()


class VoiceSlots:
    """Kon Chrome slot (thread) ekhon busy — run + regenerate ek-i slot share kore."""

    def __init__(self):
        self.lock = threading.Lock()
        self.busy = set()

    def try_acquire(self, idx):
        with self.lock:
            if idx in self.busy:
                return False
            self.busy.add(idx)
            return True

    def release(self, idx):
        with self.lock:
            self.busy.discard(idx)


def voice_slot_candidates(cfg, log=None):
    """[(slot, profile_dir)] — settings er thread sonkha onujayi, jegulo te VeePN setup kora ache."""
    multi = cfg.get("thread_mode") == "multiple"
    try:
        n = int(cfg.get("threads") or 1)
    except (TypeError, ValueError):
        n = 1
    n = max(2, min(5, n)) if multi else 1
    out = [(1, VOICE_PROFILE)]
    for i in range(2, n + 1):
        p = os.path.join(VOICE_CLONES, f"t{i}")
        if os.path.exists(os.path.join(p, ".veepn_ok")):
            out.append((i, p))
        elif log:
            log(f"Thread {i}: VeePN setup kora nei \u2014 Settings > Chrome > 'Thread Profiles Setup' chalan. (Thread {i} bad)")
    return out


def voice_vpn_choices(raw):
    """Settings er location list -> shudhu ei gulo-i connect hobe. 'United States' = Oregon + Virginia."""
    out = []
    for x in [s.strip() for s in str(raw).split(",") if s.strip()]:
        t = " ".join(re.sub(r"[^a-z ]+", " ", x.lower()).split())
        st = re.sub(r"^(united states|usa|us)\b\s*", "", t).strip()
        if st in ("oregon", "virginia"):
            c = [st.title()]
        elif t in ("united states", "usa", "us"):
            c = list(VOICE_US_STATES)
        else:
            c = [x]
        for y in c:
            if y not in out:
                out.append(y)
    return out


def voice_run_all(cfg, files, log, ask, stop_event, hidden_getter, runners, shared=None, slots=None):
    """Single thread = ekta Chrome. Multiple = N ta Chrome ekshathe, shared queue theke.
    Kono Chrome er kaj shesh hole shob gulo shesh howar jonne wait kora hoy na — je Chrome free hoy
    shei sathe sathe queue theke porer script niye kaj shuru kore. Regenerate e busy thaka slot
    free hoye gele sheta-o porer script pay."""
    shared = shared or {"lock": threading.RLock(), "reserved": set(), "ask": threading.Lock()}
    slots = slots or VoiceSlots()
    cands = voice_slot_candidates(cfg, log)
    multi = len(cands) > 1
    q = queue.Queue()
    for f in files:
        q.put(f)
    log(f"Threads: {len(cands)}  ({'multiple' if multi else 'single'})  \u2022  scripts: {len(files)}")

    def worker(idx, prof, first, res):
        r = VoiceRunner(cfg, log, ask, stop_event, chrome_hidden=hidden_getter(), profile=prof,
                        shared=shared, tag=(f"T{idx}" if multi else ""))
        runners.append(r)
        try:
            r.run_queue(q, first)
        except VoiceStopped:
            pass
        except Exception as e:
            res["crash"] = True
            log(f"ERROR (thread {idx}): {str(e).splitlines()[0][:220]}")
        finally:
            try:
                runners.remove(r)
            except ValueError:
                pass
            slots.release(idx)          # Chrome bondho \u2014 ei slot ebar free (porer script ba regenerate er jonno)

    active = {}                         # slot -> (thread, result)
    crashes = {}                        # slot -> porpor koybar Chrome chalu hoyni
    last_launch = 0.0
    warned_busy = False
    try:
        while not stop_event.is_set():
            for idx in [i for i, (t, _r) in active.items() if not t.is_alive()]:
                _t, res = active.pop(idx)
                crashes[idx] = crashes.get(idx, 0) + 1 if res.get("crash") else 0
            if q.empty():
                if not active:
                    break
                time.sleep(1)
                continue
            launched = False
            for idx, prof in cands:
                if idx in active or crashes.get(idx, 0) >= 2:
                    continue
                if time.time() - last_launch < 3:       # Chrome gulo ekshathe launch na kore ektu gap
                    break
                if not slots.try_acquire(idx):
                    continue
                try:
                    f = q.get_nowait()
                except queue.Empty:
                    slots.release(idx)
                    break
                res = {}
                t = threading.Thread(target=worker, args=(idx, prof, f, res), daemon=True)
                active[idx] = (t, res)
                t.start()
                last_launch = time.time()
                launched = True
                warned_busy = False
            if not launched and not active:
                if all(crashes.get(i, 0) >= 2 for i, _p in cands):
                    log("Kono Chrome chalu hoyni \u2014 kaj bondho korlam.")
                    break
                if not warned_busy:
                    log("Shob Chrome onno kaje busy \u2014 ekta free hole nijei kaj shuru hobe...")
                    warned_busy = True
            time.sleep(1)
    finally:
        for t, _r in list(active.values()):
            t.join()
    if stop_event.is_set():
        raise VoiceStopped()


def voice_trim_profile(prof):
    """Chrome profile er cache muchhe dey (login/extension thake) — profile jeno fule na othe."""
    if not prof or not os.path.isdir(prof):
        return
    for rel in ("Default/Cache", "Default/Code Cache", "Default/GPUCache", "Default/DawnGraphiteCache",
                "Default/DawnWebGPUCache", "Default/Media Cache",
                "GrShaderCache", "ShaderCache", "GraphiteDawnCache", "DawnCache"):
        p = os.path.join(prof, *rel.split("/"))
        if os.path.isdir(p):
            try:
                rm_tree(p)
            except Exception:
                pass


def _voice_chrome_exe():
    cands = []
    for env in ("PROGRAMFILES", "PROGRAMFILES(X86)", "LOCALAPPDATA"):
        base = os.environ.get(env)
        if base:
            cands.append(os.path.join(base, "Google", "Chrome", "Application", "chrome.exe"))
    cands += ["/usr/bin/google-chrome", "/usr/bin/google-chrome-stable",
              "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"]
    for c in cands:
        if os.path.exists(c):
            return c
    return shutil.which("chrome") or shutil.which("google-chrome")


def _voice_profile_in_use(prof):
    """Ei profile ekhon sotti kono Chrome e khola kina. Shudhu lockfile thakle hobe na —
    Chrome crash/force-close hole lockfile pore thake (stale), sheta 'in use' na."""
    lk = os.path.join(prof, "lockfile")
    if os.path.lexists(lk):
        try:
            with open(lk, "ab"):                    # Chrome cholle Windows e ei file lock kora thake
                pass
            try:
                os.remove(lk)                       # stale — porishkar
            except OSError:
                pass
        except OSError:
            return True
    sl = os.path.join(prof, "SingletonLock")        # Linux / Mac
    if os.path.lexists(sl):
        try:
            pid = int(os.readlink(sl).rsplit("-", 1)[-1])
            os.kill(pid, 0)
            return True
        except Exception:
            for f in ("SingletonLock", "SingletonCookie", "SingletonSocket"):
                try:
                    os.remove(os.path.join(prof, f))
                except OSError:
                    pass
    return False


def voice_gemini_login_setup(n, redo, log):
    """Prottek thread er Chrome profile e alada Gemini (Google) account login. Ekbar korlei hoy.
    Google automation Chrome e login block kore, tai ekhane normal Chrome (automation chhara) khola hoy."""
    _voice_ensure_dirs()
    if not os.path.isdir(VOICE_PROFILE):
        log("Chrome profile nei — age 'Chrome Profile Setup' koro.")
        return
    exe = _voice_chrome_exe()
    if not exe:
        log("Google Chrome paoa jayni (install kora ache to?)")
        return
    for i in range(1, n + 1):
        prof = VOICE_PROFILE if i == 1 else voice_clone_profile(i, log)
        if not prof:
            continue
        marker = os.path.join(prof, ".gemini_ok")
        if os.path.exists(marker) and not redo:
            log(f"Account {i}: ager login ache, skip")
            continue
        if _voice_profile_in_use(prof):
            log(f"Account {i}: ei profile er Chrome sotti-i ekhono khola. Task Manager e 'Google Chrome' "
                f"(background shoho) shesh kore abar chalan.")
            return
        log(f"Account {i}/{n}: Chrome khulbe — Gemini te {'ekta notun ' if i > 1 else ''}"
            f"Google account diye login korun, tarpor SOB Chrome window bondho korun.")
        try:
            proc = subprocess.Popen([exe, f"--user-data-dir={prof}", "--no-first-run",
                                     "--no-default-browser-check", "--start-maximized", GEMINI_URL])
            proc.wait()
            time.sleep(2)
            t0 = time.time()
            while _voice_profile_in_use(prof) and time.time() - t0 < 6 * 3600:
                time.sleep(1.5)                     # Chrome launcher process age exit hole-o wait
        except Exception as e:
            log(f"Account {i}: Chrome khola gelo na: {str(e).splitlines()[0][:150]}")
            return
        voice_trim_profile(prof)
        with open(marker, "w") as fh:
            fh.write("ok")
        log(f"Account {i}: shesh")
    log("Gemini login setup shesh.")


def voice_profile_setup(log, prof=None, label=""):
    """Ekta Chrome profile e VeePN install + pura load howa porjonto setup. Window bondho korle shesh."""
    prof = prof or VOICE_PROFILE
    os.makedirs(prof, exist_ok=True)
    tag = f"[{label}] " if label else ""
    from playwright.sync_api import sync_playwright
    with sync_playwright() as pw:
        ctx = pw.chromium.launch_persistent_context(
            prof, channel="chrome", headless=False, no_viewport=True,
            ignore_default_args=["--disable-extensions", "--enable-automation"],
            args=["--start-maximized"])
        page = ctx.pages[0] if ctx.pages else ctx.new_page()
        page.goto("https://chromewebstore.google.com/search/veepn")
        try:
            ctx.new_page().goto(URBAN_STORE_URL, timeout=30000)     # 2nd tab: UrbanVPN
        except Exception:
            pass
        log(tag + "Chrome khulechhe. VeePN install kore toolbar e pin korun, tarpor VeePN icon e click kore "
                  "'Loading' shesh howa porjonto (2 min porjonto) wait korun jeno VeePN pura khole. "
                  "Tarpor window bondho korun. (Gemini login ei window te hobe na — 'Gemini Login Setup' use korun.)")
        ids = set()
        try:
            while True:
                for w in list(ctx.service_workers) + list(ctx.background_pages):
                    m = re.match(r"chrome-extension://([a-p]{32})/", w.url)
                    if m:
                        ids.add(m.group(1))
                if not ctx.pages:
                    break
                page.wait_for_timeout(1500) if not page.is_closed() else time.sleep(1.5)
        except Exception:
            pass
        try:
            ctx.close()
        except Exception:
            pass
    try:
        with open(os.path.join(prof, ".veepn_ok"), "w") as fh:
            fh.write("ok")
    except Exception:
        pass
    log(tag + "Setup shesh. Extension ID: " + (", ".join(ids) if ids else "(auto-detect cholbe)"))


