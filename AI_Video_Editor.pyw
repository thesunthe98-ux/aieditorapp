    def _t2_pick_profile(self, slots, cfg):
        """Tab 1 er 5 Chrome profile er moddhe ekta FREE profile + tar slot (Tab 1 er sathe conflict hobe na).
        Boro index age (slot 1 = main profile Tab 1 er jonno shesh e). Kono free na pele 90s wait, tarpor
        alada Tab 2 profile."""
        cands, seen = [], set()
        for idx, prof in voice_slot_candidates(cfg):
            cands.append((idx, prof))
            seen.add(idx)
        for i in range(1, 6):
            if i in seen:
                continue
            prof = VOICE_PROFILE if i == 1 else os.path.join(VOICE_CLONES, f"t{i}")
            if i == 1 or os.path.isdir(prof):
                cands.append((i, prof))
        cands.sort(key=lambda c: -c[0])
        deadline = time.time() + 90
        warned = False
        while True:
            if self._fix_stop.is_set():
                raise VoiceStopped()
            for idx, prof in cands:
                if not slots.try_acquire(idx):
                    continue
                if _voice_profile_in_use(prof):
                    slots.release(idx)
                    continue
                return idx, prof
            if time.time() > deadline:
                idx, prof = 99, os.path.join(VOICE_BASE, "chrome_profile_tab2")
                if slots.try_acquire(idx):
                    self._t2_log("Tab 1 er shob Chrome profile busy — Tab 2 er nijosso profile e khulchhi")
                    return idx, prof
            if not warned:
                self._t2_log("Shob Chrome profile busy — ekta free hoyar jonno wait korchhi (max 90s)…")
                warned = True
            time.sleep(2)

    def _t2_speechify_swap(self, chunks, name, proj, work):
        """Prottek chunk Speechify Voice Swap e pathiye swapped audio nao, order e ffmpeg diye join kore
        project/fixed_voice/voice_fixed_<time>.mp3 return koro. Background thread e cholbe — Tk touch kore na.
        Cancel = self._fix_stop; active account = self._tab2_account (credit shesh hole Tab 1 Accounts theke remove)."""
        ok, err = _ensure_playwright()
        if not ok:
            raise RuntimeError("Playwright install lagbe: " + str(err))
        app = self.app
        cfg = dict(getattr(app, "_voice_cfg", None) or _voice_load_cfg())
        shared = getattr(app, "_voice_shared", None)
        slots = getattr(app, "_voice_slots", None) or VoiceSlots()
        hidden = bool(self._hide_flag)
        idx, prof = self._t2_pick_profile(slots, cfg)
        self._t2_log(f"Chrome profile slot {idx} niyechhi")
        runner = Tab2SpeechifyRunner(
            cfg, self._t2_log, self._fix_stop, shared, prof, hidden=hidden,
            account_hint=self._tab2_account, on_account=self._t2_set_account,
            on_accounts_changed=lambda: self.after(0, self._t2_refresh_accounts))
        self._t2_runner = runner
        self.after(0, self._t2_refresh_accounts)
        try:
            swapped = runner.run(chunks, name, work)
        finally:
            self._t2_runner = None
            slots.release(idx)
            self.after(0, self._t2_refresh_accounts)
            self.after(50, lambda: self.app._voice_ui_update())
        if self._fix_stop.is_set():
            raise VoiceStopped()
        if len(swapped) != len(chunks):
            raise RuntimeError("Shob chunk swap hoyni")
        self._t2_log("Swapped chunk gulo join hochhe…")
        return self._t2_join_swapped(swapped, chunks, work)

    def _t2_join_swapped(self, swapped, chunks, work):
        """Swapped chunk gulo serial e join; prottek chunk original chunk er length e pad/trim (timeline sync thik thakbe)."""
        ff = shutil.which("ffmpeg") or "ffmpeg"
        final = os.path.join(work, "voice_fixed_%s.mp3" % time.strftime("%Y%m%d_%H%M%S"))
        cmd = [ff, "-y", "-hide_banner", "-loglevel", "error"]
        filt, labels = [], []
        for k, (sw, orig) in enumerate(zip(swapped, chunks)):
            d = media_duration(orig) or 0.0
            cmd += ["-i", sw]
            tail = f",apad,atrim=0:{d:.3f}" if d > 0.05 else ""
            filt.append(f"[{k}:a:0]aresample=44100,aformat=sample_fmts=fltp:channel_layouts=stereo{tail},"
                        f"asetpts=PTS-STARTPTS[a{k}]")
            labels.append(f"[a{k}]")
        filt.append("".join(labels) + f"concat=n={len(labels)}:v=0:a=1[out]")
        fs = final + ".filter.txt"
        with open(fs, "w", encoding="utf-8") as fh:
            fh.write(";\n".join(filt))
        cmd += ["-filter_complex_script", fs, "-map", "[out]", "-c:a", "libmp3lame", "-b:a", "192k", final]
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, creationflags=NOWIN)
        finally:
            try:
                os.remove(fs)
            except OSError:
                pass
        if r.returncode != 0 or not os.path.isfile(final) or os.path.getsize(final) < 1000:
            raise RuntimeError("Join fail: " + (r.stderr or "")[-300:])
        return final

    @staticmethod
    def _gain_f(it):
        g = float(it.get("gain") or 1.0)
        return f"volume={g:.3f},alimiter=limit=0.97," if abs(g - 1.0) > 0.005 else ""

    def _t2_build_merged_audio(self, plan, out_path):
        """Serially join every slot's ORIGINAL audio (vol 1.0, ignores mute); image/empty = silence.
        Returns (ok, err)."""
        ff = shutil.which("ffmpeg") or "ffmpeg"
        cmd = [ff, "-y", "-hide_banner", "-loglevel", "error"]
        filt, labels = [], []
        n = 0
        for it in plan:
            d = max(0.04, float(it["dur"]))
            if it["path"] and not it["img"] and os.path.isfile(it["path"]):
                cmd += (["-ss", f"{it['tin']:.3f}"] if it.get("tin", 0) > 0 else []) + ["-i", it["path"]]
                filt.append(f"[{n}:a:0]aresample=44100,aformat=sample_fmts=fltp:channel_layouts=stereo,"
                            + self._gain_f(it) + f"apad,atrim=0:{d:.3f},asetpts=PTS-STARTPTS[a{len(labels)}]")
                n += 1
            else:
                filt.append(f"anullsrc=r=44100:cl=stereo,atrim=0:{d:.3f},asetpts=PTS-STARTPTS[a{len(labels)}]")
            labels.append(f"[a{len(labels)}]")
        # clips with no audio stream would fail on [n:a:0]; probe and replace with silence
        probed = []
        for i, it in enumerate(plan):
            if it["path"] and not it["img"] and os.path.isfile(it["path"]):
                probed.append(it)
        has_a = {}
        for it in probed:
            try:
                r = subprocess.run([(shutil.which("ffprobe") or "ffprobe"), "-v", "error", "-select_streams", "a",
                                    "-show_entries", "stream=index", "-of", "csv=p=0", it["path"]],
                                   capture_output=True, text=True, creationflags=NOWIN)
                has_a[it["path"]] = bool(r.stdout.strip())
            except Exception:
                has_a[it["path"]] = True
        if not all(has_a.values()):
            cmd = [ff, "-y", "-hide_banner", "-loglevel", "error"]
            filt, labels, n = [], [], 0
            for it in plan:
                d = max(0.04, float(it["dur"]))
                k = len(labels)
                if it["path"] and not it["img"] and os.path.isfile(it["path"]) and has_a.get(it["path"], True):
                    cmd += (["-ss", f"{it['tin']:.3f}"] if it.get("tin", 0) > 0 else []) + ["-i", it["path"]]
                    filt.append(f"[{n}:a:0]aresample=44100,aformat=sample_fmts=fltp:channel_layouts=stereo,"
                                + self._gain_f(it) + f"apad,atrim=0:{d:.3f},asetpts=PTS-STARTPTS[a{k}]")
                    n += 1
                else:
                    filt.append(f"anullsrc=r=44100:cl=stereo,atrim=0:{d:.3f},asetpts=PTS-STARTPTS[a{k}]")
                labels.append(f"[a{k}]")
        filt.append("".join(labels) + f"concat=n={len(labels)}:v=0:a=1[out]")
        fs = out_path + ".filter.txt"
        with open(fs, "w", encoding="utf-8") as fh:
            fh.write(";\n".join(filt))
        cmd += ["-filter_complex_script", fs, "-map", "[out]", "-c:a", "libmp3lame", "-b:a", "192k", out_path]
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, creationflags=NOWIN)
        except Exception as e:
            return False, str(e)
        try:
            os.remove(fs)
        except Exception:
            pass
        if r.returncode != 0 or not os.path.isfile(out_path):
            return False, "ffmpeg merge error: " + (r.stderr or "")[-300:]
        return True, ""

    def _t2_split_chunks(self, path, work, max_sec=300.0):
        """Split audio into <= max_sec chunks (voice_part01.mp3 …). Returns list of paths."""
        dur = media_duration(path) or 0.0
        if dur <= max_sec:
            return [path]
        ff = shutil.which("ffmpeg") or "ffmpeg"
        out, i, t = [], 1, 0.0
        while t < dur - 0.05:
            p = os.path.join(work, f"voice_part{i:02d}.mp3")
            subprocess.run([ff, "-y", "-hide_banner", "-loglevel", "error", "-ss", f"{t:.3f}", "-t", f"{max_sec:.3f}",
                            "-i", path, "-c:a", "libmp3lame", "-b:a", "192k", p],
                           capture_output=True, creationflags=NOWIN)
            out.append(p)
            t += max_sec
            i += 1
        return out

    # ───────── Tab 2 EXPORT: clips join -> transitions -> subtitle burn -> audio ─────────
    def _exp_ui(self, busy):
        self._exp_busy = busy
        for _b in getattr(self, "_exp_btns", []):
            try:
                _b.config(text="\u25a0 Stop export" if busy else "\U0001F3AC Export")
            except Exception:
                pass

    def _exp_say(self, msg):
        try:
            self.after(0, lambda m=str(msg): (self.app.note("Export: " + m),
                                              self._exp_dlg_update(None, m[:1].upper() + m[1:])))
        except Exception:
            pass

    def _exp_prog(self, pct):
        """Any thread: export % (0-100) -> progress dialog."""
        try:
            v = max(0.0, min(100.0, float(pct)))
            if int(v) == getattr(self, "_exp_last", -1):
                return
            self._exp_last = int(v)
            self.after(0, lambda x=v: self._exp_dlg_update(x, None))
        except Exception:
            pass

    def _exp_dlg_open(self, out):
        self._exp_pct, self._exp_last = -1.0, -1
        self._exp_dlg_close()
        if not self._right_shown:
            self._toggle_right()
        self.rp_tab.set("export")
        self.update_idletasks()
        box = self._exp_box
        bar, step = self._exp_pb
        bar["value"] = 0
        step.config(text="Shuru hochhe\u2026")
        self._exp_title.config(text="\U0001F3AC Export hochhe \u2014 " + os.path.basename(out))
        box.pack(fill="x", pady=(0, 10), before=self._exp_form)
        try:
            self._rp["export"].cv.yview_moveto(0)
        except Exception:
            pass
        self.update_idletasks()
        try:
            box.grab_set()                    # progress box chhara app er kono jaygay click/type kaj korbe na
        except tk.TclError:
            pass
        self._exp_dlg = {"win": box, "bar": bar, "step": step}

    def _exp_dlg_update(self, pct, msg):
        d = getattr(self, "_exp_dlg", None)
        if not d:
            return
        try:
            if pct is not None:
                self._exp_pct = max(getattr(self, "_exp_pct", 0.0), pct)
                d["bar"]["value"] = self._exp_pct
            if msg:
                d["step"].config(text=msg)
        except tk.TclError:
            pass

    def _exp_dlg_close(self):
        d = getattr(self, "_exp_dlg", None)
        self._exp_dlg = None
        if d:
            try:
                d["win"].grab_release()
            except tk.TclError:
                pass
            try:
                d["win"].pack_forget()
            except tk.TclError:
                pass

    def _exp_show_folder(self, out):
        try:
            if os.name == "nt":
                subprocess.Popen(["explorer", "/select,", os.path.normpath(out)])
            elif sys.platform == "darwin":
                subprocess.Popen(["open", "-R", out])
            else:
                open_path(os.path.dirname(out))
        except Exception:
            open_path(os.path.dirname(out))

