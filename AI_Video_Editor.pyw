        mkbtn(bt, "⟳", lambda p=path: self.replace_clip(p), "ghost", padx=7, pady=0).pack(side="left", padx=2)
        mkbtn(bt, "✕", lambda p=path: self.remove_clip(p), "danger", padx=7, pady=0).pack(side="left", padx=2)
