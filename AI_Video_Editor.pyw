LK_TRIM_FILE = os.path.join(WORKSPACE, "light_leak_trims.json")     # one file for ALL projects


def _lk_trims_load():
    """{template name: (start, end)} - the trim saved for each light leak (same in every project, kept after restart)."""
    out = {}
    try:
        with open(LK_TRIM_FILE, encoding="utf-8") as fh:
            data = json.load(fh)
    except Exception:
        return out
    by_base = {os.path.basename(x[3:]).lower(): n for n, x, _m in T2_TRANSITIONS
               if isinstance(x, str) and x.startswith("LK:")}
    for fn, t in (data or {}).items():
        n = by_base.get(str(fn).lower())
        try:
            if n and float(t[1]) > float(t[0]) >= 0:
                out[n] = (float(t[0]), float(t[1]))
        except (TypeError, ValueError, IndexError):
            pass
    return out


def _lk_trims_save(trims):
    data = {}
    for n, x, _m in T2_TRANSITIONS:
        if isinstance(x, str) and x.startswith("LK:") and n in trims:
            data[os.path.basename(x[3:])] = [round(float(trims[n][0]), 3), round(float(trims[n][1]), 3)]
    try:
        os.makedirs(os.path.dirname(LK_TRIM_FILE), exist_ok=True)
        atomic_write(LK_TRIM_FILE, json.dumps(data, ensure_ascii=False, indent=1))
    except Exception:
        pass


def _srt_ts(x):
    m = re.fullmatch(r"(\d+):(\d+):(\d+)[,.](\d+)", (x or "").strip())
    if not m:
        return None
    h, mi, s, f = m.groups()
    return int(h) * 3600 + int(mi) * 60 + int(s) + int(f) / float(10 ** len(f))


def t2_parse_srt(txt):
    """[(start, end, text)] from SRT text."""
    out = []
    for blk in re.split(r"\n\s*\n", (txt or "").replace("\r\n", "\n").replace("\r", "\n")):
        rows = [l.strip() for l in blk.strip().split("\n") if l.strip()]
        ti = next((i for i, l in enumerate(rows) if "-->" in l), None)
        if ti is None:
            continue
        a, _, b = rows[ti].partition("-->")
        s = _srt_ts(a)
        e = _srt_ts(b.strip().split()[0] if b.strip() else "")
        text = re.sub(r"\s+", " ", re.sub(r"<[^>]+>", "", " ".join(rows[ti + 1:]))).strip()
        if s is not None and e is not None and text:
            out.append((s, max(e, s + 0.05), text))
    out.sort(key=lambda c: c[0])
    return out


