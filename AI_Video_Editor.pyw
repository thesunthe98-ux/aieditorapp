    return t



# ───────────────────────── modern widgets (v3) ─────────────────────────
class NavItem(tk.Frame):
    """Sidebar item: big icon + small caption, smooth hover / active color fade."""

    def __init__(self, parent, icon, text, command):
        super().__init__(parent, bg=SIDE, cursor="hand2")
        self._cmd, self.active = command, False
        self.ic = tk.Label(self, text=icon, bg=SIDE, fg=MUTED, font=(ICON_FONT, 17), cursor="hand2")
        self.tx = tk.Label(self, text=text, bg=SIDE, fg=MUTED, font=(FONT, 8), cursor="hand2")
        self.ic.pack(pady=(10, 0))
        self.tx.pack(pady=(0, 10))
        self._shown = (SIDE, MUTED)
        for w in (self, self.ic, self.tx):
            w.bind("<Enter>", self._enter, add="+")
            w.bind("<Leave>", self._leave, add="+")
            w.bind("<Button-1>", self._click, add="+")

    def _rest(self):
        return (NAV_ACT, ACCENT) if self.active else (SIDE, MUTED)

    def _go(self, bg, fg, ms):
        b0, f0 = self._shown

        def step(t):
            b, f = _mix(b0, bg, t), _mix(f0, fg, t)
            self._shown = (b, f)
            for w in (self, self.ic, self.tx):
                w.configure(bg=b)
            self.ic.configure(fg=f)
            self.tx.configure(fg=f)
        tween(self, "c", ms, step)

    def _enter(self, _e=None):
        if not self.active:
            self._go(NAV_HOV, FG, 120)

    def _leave(self, _e=None):
        try:
            w = self.winfo_containing(*self.winfo_pointerxy())
        except Exception:
            w = None
        if w in (self, self.ic, self.tx):
            return
        self._go(*self._rest(), 180)

    def _click(self, _e=None):
        if self._cmd:
            self._cmd()

    def set_active(self, flag, animate=True):
        self.active = bool(flag)
        self._go(*self._rest(), 200 if animate else 0)

    def _retheme(self):
        self._shown = self._rest()
        b, f = self._shown
        for w in (self, self.ic, self.tx):
            w.configure(bg=b)
        self.ic.configure(fg=f)
        self.tx.configure(fg=f)


class SmoothBar(tk.Canvas):
    """Progress bar that glides to its value, shimmers while a job runs, and can flash on success.
    Drop-in for the old ttk.Progressbar: bar["value"] = 42 / bar["value"]."""

    def __init__(self, parent, maximum=100, active=None, **kw):
        super().__init__(parent, height=22, bg=BG, highlightthickness=0, bd=0)
        self._max = float(maximum) or 100.0
        self._target = self._shown = 0.0
        self._active = active or (lambda: False)
        self._job = None
        self._shine = None
        self._t_last = time.perf_counter()
        self.bind("<Configure>", lambda e: self._draw())

    def __getitem__(self, key):
        return self._target if key == "value" else super().__getitem__(key)

    def __setitem__(self, key, val):
        if key != "value":
            return super().__setitem__(key, val)
        self._target = max(0.0, min(self._max, float(val)))
        if self._target <= 0 or not ANIM_ON:
            self._shown = self._target
        self._kick()

    def _kick(self):
        if self._job is None:
            self._t_last = time.perf_counter()
            self._tick()

    def _tick(self):
        self._job = None
        try:
            now = time.perf_counter()
            dt, self._t_last = min(0.05, now - self._t_last), now
            diff = self._target - self._shown
            if abs(diff) < 0.06:
                self._shown = self._target
            else:
                self._shown += diff * (1 - math.exp(-dt / 0.10))
            self._draw()
            running = self._active() and 0 < self._shown < self._max
            if self._shown != self._target or running or self._shine is not None:
                self._job = self.after(16, self._tick)
        except tk.TclError:
            self._job = None

    def flash(self):
        if not ANIM_ON:
            return

        def step(t):
            self._shine = t
        tween(self, "shine", 750, step, done=lambda: (setattr(self, "_shine", None), self._draw()),
              ease=False)
        self._kick()

    def _draw(self):
        self.delete("all")
        W, H = self.winfo_width(), self.winfo_height()
        h, x0, x1, cy = 10, 5.0, W - 56.0, H / 2.0
        if W < 80:
            return
        self.create_line(x0, cy, x1, cy, width=h, capstyle="round", fill=PANEL2)
        frac = max(0.0, min(1.0, self._shown / self._max))
        if frac > 0.002:
            fx = x0 + (x1 - x0) * frac
            col = OK if frac >= 0.9995 else ACCENT
            self.create_line(x0, cy, max(fx, x0 + 0.1), cy, width=h, capstyle="round", fill=col)
            sh = self._shine
            if sh is None and self._active() and frac < 0.9995:
                sh = (time.perf_counter() % 1.6) / 1.6
            if sh is not None:
                pos = x0 - 30 + (fx - x0 + 60) * sh
                a, b = max(x0 + 2, pos - 34), min(fx - 2, pos)
                if b > a:
                    self.create_line(a, cy, b, cy, width=h - 4, capstyle="butt", fill=_mix(col, "#ffffff", 0.5))
        self.create_text(W - 4, cy, text=f"{int(round(frac * 100))}%", anchor="e",
                         fill=FG if frac > 0 else MUTED, font=(FONT, 9, "bold"))

    def _retheme(self):
        self._draw()


class Slider(tk.Canvas):
    """Thin accent slider (replaces tk.Scale). Works with IntVar / StringVar / DoubleVar."""
    PAD = 12

    def __init__(self, parent, variable, from_=0, to=100, resolution=1, length=220,
                 command=None, show_value=False, bg=None):
        extra = 46 if show_value else 0
        super().__init__(parent, width=length + 2 * self.PAD + extra, height=30,
                         bg=bg or parent["bg"], highlightthickness=0, bd=0, cursor="hand2")
        self.var, self.lo, self.hi, self.res = variable, from_, to, resolution
        self.len, self.cmd, self.show_value, self._r, self._drag = length, command, show_value, 6.0, False
        self.bind("<ButtonPress-1>", self._press)
        self.bind("<B1-Motion>", self._move)
        self.bind("<ButtonRelease-1>", self._release)
        self.bind("<Enter>", lambda e: self._grow(8.5))
        self.bind("<Leave>", lambda e: self._grow(6.0) if not self._drag else None)
        self._trace = variable.trace_add("write", lambda *a: self._safe_draw())
        self.bind("<Destroy>", self._destroyed, add="+")
        self._draw()

    def _destroyed(self, e):
        if e.widget is self:
            try:
                self.var.trace_remove("write", self._trace)
            except Exception:
                pass

    def _raw(self):
        try:
            return float(self.var.get())
        except Exception:
            return None

    def _safe_draw(self):
        try:
            self._draw()
        except tk.TclError:
            pass

    def _grow(self, r):
        r0 = self._r

        def step(t):
            self._r = r0 + (r - r0) * t
            self._draw()
        tween(self, "r", 120, step)

    def _draw(self):
        self.delete("all")
        raw = self._raw()
        v = self.lo if raw is None else max(self.lo, min(self.hi, raw))
        frac = (v - self.lo) / float(self.hi - self.lo)
        x0, x1, cy = self.PAD, self.PAD + self.len, 15
        hx = x0 + (x1 - x0) * frac
        self.create_line(x0, cy, x1, cy, width=4, capstyle="round", fill=PANEL2)
        if hx > x0:
            self.create_line(x0, cy, hx, cy, width=4, capstyle="round", fill=ACCENT)
        r = self._r
        self.create_oval(hx - r, cy - r, hx + r, cy + r, fill=PANEL, outline=ACCENT, width=3)
        if self.show_value:
            self.create_text(x1 + self.PAD + 6, cy, text=f"{v:g}", anchor="w", fill=FG, font=(FONT, 10, "bold"))

    def _set_from_x(self, x):
        frac = max(0.0, min(1.0, (x - self.PAD) / float(self.len)))
        v = self.lo + frac * (self.hi - self.lo)
        v = max(self.lo, min(self.hi, round(v / self.res) * self.res))
        if self._raw() == v:
            return
        iv = int(v) if float(v).is_integer() else v
        if isinstance(self.var, tk.IntVar):
            self.var.set(int(iv))
        elif isinstance(self.var, tk.DoubleVar):
            self.var.set(float(iv))
        else:
            self.var.set(str(iv))
        if self.cmd:
            self.cmd(str(iv))

    def _press(self, e):
        self._drag = True
        self._grow(9.5)
        self._set_from_x(e.x)

    def _move(self, e):
        if self._drag:
            self._set_from_x(e.x)

    def _release(self, e):
        self._drag = False
        self._grow(8.5)

    def _retheme(self):
        self._draw()


class TrimBar(tk.Canvas):
    """Timeline for the avatar player. Drag the two white handles to trim the start / end,
    click or drag anywhere else to move the playhead (yellow line)."""
    PAD, HIT, MIN_LEN = 12, 10, 0.2

    def __init__(self, parent, width=300, height=48, on_seek=None, on_trim=None):
        super().__init__(parent, width=width, height=height, bg=PANEL, highlightthickness=0, bd=0,
                         cursor="hand2")
        self.bw, self.bh = width, height
        self.dur, self.t0, self.t1, self.cur = 0.0, 0.0, 0.0, 0.0
        self.on_seek, self.on_trim = on_seek, on_trim
        self._grab = None
        self.bind("<ButtonPress-1>", self._press)
        self.bind("<B1-Motion>", self._move)
        self.bind("<ButtonRelease-1>", self._release)
        self.bind("<Motion>", self._hover)
        self.draw()

    def set_state(self, dur=None, t0=None, t1=None, cur=None):
        if dur is not None:
            self.dur = max(0.0, float(dur))
        if t0 is not None:
            self.t0 = float(t0)
        if t1 is not None:
            self.t1 = float(t1)
        if cur is not None:
            self.cur = float(cur)
        self.draw()

    def resize(self, w):
        self.bw = int(w)
        self.configure(width=self.bw)
        self.draw()

    def _x(self, t):
        if self.dur <= 0:
            return self.PAD
        return self.PAD + (self.bw - 2 * self.PAD) * min(max(t, 0.0), self.dur) / self.dur

    def _t(self, x):
        span = max(1.0, self.bw - 2 * self.PAD)
        return min(max((x - self.PAD) / span, 0.0), 1.0) * self.dur

    def draw(self):
        try:
            self.delete("all")
            self.configure(bg=PANEL)
            P, y0, y1 = self.PAD, 17, 33
            self.create_rectangle(P, y0, self.bw - P, y1, fill=PANEL2, outline="")
            if self.dur <= 0:
                self.create_text(self.bw // 2, 25, text="—", fill=MUTED)
                return
            xs, xe = self._x(self.t0), self._x(self.t1)
            self.create_rectangle(xs, y0, xe, y1, fill=ACCENT, outline="")
            for x in (xs, xe):
                self.create_rectangle(x - 4, y0 - 7, x + 4, y1 + 7, fill=FG, outline=ACCENT, width=2)
            xc = self._x(self.cur)
            self.create_line(xc, 3, xc, self.bh - 3, fill=WARN, width=2)
            self.create_polygon(xc - 5, 1, xc + 5, 1, xc, 8, fill=WARN, outline="")
        except tk.TclError:
            pass

    def _retheme(self):
        self.draw()

    def _pick(self, x):
        ds, de = abs(x - self._x(self.t0)), abs(x - self._x(self.t1))
        if min(ds, de) <= self.HIT:
            return "s" if ds <= de else "e"
        return "p"

    def _hover(self, e):
        if self._grab or self.dur <= 0:
            return
        near = self._pick(e.x) != "p"
        self.configure(cursor="sb_h_double_arrow" if near else "hand2")

    def _press(self, e):
        if self.dur <= 0:
            return
        self._grab = self._pick(e.x)
        self._apply(e.x, False)

    def _move(self, e):
        if self._grab:
            self._apply(e.x, False)

    def _release(self, e):
        g, self._grab = self._grab, None
        if g in ("s", "e") and self.on_trim:
            self.on_trim(self.t0, self.t1, True)

    def _apply(self, x, final):
        t = self._t(x)
        g = self._grab
        if g == "s":
            self.t0 = min(max(0.0, t), self.t1 - self.MIN_LEN)
            self.cur = self.t0
        elif g == "e":
            self.t1 = max(min(self.dur, t), self.t0 + self.MIN_LEN)
            self.cur = max(0.0, self.t1 - 0.05)       # show the last frame that will be kept
        else:
            self.cur = t
        self.draw()
        if g in ("s", "e") and self.on_trim:
            self.on_trim(self.t0, self.t1, False)
        if self.on_seek:
            self.on_seek(self.cur)


class ScrollFrame(tk.Frame):
    """Vertically scrollable container; put children in .inner. Scrollbar appears only if needed."""

    def __init__(self, parent, bg=None, hscroll=False):
        super().__init__(parent, bg=bg or BG)
        self._h, self._hb_shown = hscroll, False
        self.cv = tk.Canvas(self, bg=bg or BG, highlightthickness=0, bd=0, height=100)
        self.sb = ttk.Scrollbar(self, orient="vertical", command=self.cv.yview)
        self.cv.configure(yscrollcommand=self._on_scroll)
        self.inner = tk.Frame(self.cv, bg=bg or BG)
        self._win = self.cv.create_window((0, 0), window=self.inner, anchor="nw")
        if hscroll:
            self.hb = ttk.Scrollbar(self, orient="horizontal", command=self.cv.xview)
            self.cv.configure(xscrollcommand=self._on_hscroll)
            self.inner.bind("<Configure>", self._fit)
            self.cv.bind("<Configure>", self._fit)
        else:
            self.inner.bind("<Configure>", lambda e: self.cv.configure(scrollregion=self.cv.bbox("all")))
            self.cv.bind("<Configure>", lambda e: self.cv.itemconfigure(self._win, width=e.width))
        self.sb.pack(side="right", fill="y")
        self.cv.pack(side="left", fill="both", expand=True)
        for w in (self, self.cv, self.inner):
            w.bind("<Enter>", self._wheel_on, add="+")
            w.bind("<Leave>", self._wheel_off, add="+")

    def _on_scroll(self, lo, hi):
        self.sb.set(lo, hi)

    def _fit(self, _e=None):
        """hscroll mode: content is at least as wide as the view, wider when something big (preview) needs it."""
        try:
            w = max(self.cv.winfo_width(), self.inner.winfo_reqwidth())
            self.cv.itemconfigure(self._win, width=w)
            self.cv.configure(scrollregion=self.cv.bbox("all"))
        except tk.TclError:
            pass

    def _on_hscroll(self, lo, hi):
        self.hb.set(lo, hi)
        need = float(lo) > 0.0 or float(hi) < 1.0
        if need and not self._hb_shown:
            self.hb.pack(side="bottom", fill="x", before=self.cv)
            self._hb_shown = True
        elif not need and self._hb_shown:
            self.hb.pack_forget()
            self._hb_shown = False

    def _inside(self):
        try:
            w = self.winfo_containing(*self.winfo_pointerxy())
        except Exception:
            return False
        while w is not None:
            if w is self:
                return True
            w = getattr(w, "master", None)
        return False

    def _wheel(self, e):
        if getattr(e, "num", 0) == 4:
            n = -1
        elif getattr(e, "num", 0) == 5:
            n = 1
        elif sys.platform == "darwin":
            n = -int(e.delta) if abs(e.delta) < 40 else -int(e.delta / 40)
            n = max(-6, min(6, n)) or (-1 if e.delta > 0 else 1)
        else:
            n = int(-e.delta / 120)
        self.cv.yview_scroll(n, "units")

    def _wheel_on(self, _e=None):
        for ev in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            self.bind_all(ev, self._wheel)

    def _wheel_off(self, _e=None):
        if not self._inside():
            for ev in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
                self.unbind_all(ev)

    def _retheme(self):
        pass


# ───────── pretty option widgets (v4): toggle switch, pill choice, cards ─────────
class Toggle(tk.Canvas):
    """iOS-style switch bound to a StringVar/IntVar ("1"/"0")."""

    def __init__(self, parent, variable, on="1", off="0", bg=None):
        super().__init__(parent, width=42, height=24, bg=bg or parent["bg"], highlightthickness=0,
                         bd=0, cursor="hand2")
        self.var, self.on = variable, str(on)
        self._pos = 1.0 if self._is_on() else 0.0
        self.bind("<Button-1>", lambda e: self.flip())
        self._trace = variable.trace_add("write", lambda *a: self._sync())
        self.bind("<Destroy>", self._destroyed, add="+")
        self._draw()

    def _destroyed(self, e):
        if e.widget is self:
            try:
                self.var.trace_remove("write", self._trace)
            except Exception:
                pass

    def _is_on(self):
        try:
            return str(self.var.get()) == self.on
        except Exception:
            return False

    def flip(self):
        if isinstance(self.var, tk.IntVar):
            self.var.set(0 if self._is_on() else int(self.on))
        else:
            self.var.set("0" if self._is_on() else self.on)

    def _sync(self):
        target, p0 = (1.0 if self._is_on() else 0.0), self._pos

        def step(t):
            self._pos = p0 + (target - p0) * t
            self._draw()
        try:
            tween(self, "p", 140, step)
        except tk.TclError:
            pass

    def _draw(self):
        self.delete("all")
        p = self._pos
        self.create_line(12, 12, 30, 12, width=20, capstyle="round", fill=_mix(PANEL2, ACCENT, p))
        x = 12 + 18 * p
        self.create_oval(x - 8, 4, x + 8, 20, fill="#ffffff", outline="")

    def _retheme(self):
        self._pos = 1.0 if self._is_on() else 0.0
        self._draw()


def mktoggle(parent, text, variable, bg=None, on="1"):
    """Toggle switch + label on one row."""
    bg = bg or parent["bg"]
    fr = tk.Frame(parent, bg=bg)
    t = Toggle(fr, variable, on=on, bg=bg)
    t.pack(side="left")
    lb = mklabel(fr, text, 10, FG, bg=bg, cursor="hand2")
    lb.pack(side="left", padx=(10, 0))
    lb.bind("<Button-1>", lambda e: t.flip())
    return fr


class Segmented(tk.Frame):
    """Pill-style single choice bound to a variable."""

    def __init__(self, parent, variable, options, bg=None, idle=None, padx=14, pady=6, size=10):
        super().__init__(parent, bg=bg or parent["bg"])
        self.var, self._idle_tok, self._items = variable, idle, []
        for val, text in options:
            lb = tk.Label(self, text=text, font=(FONT, size, "bold"), padx=padx, pady=pady, cursor="hand2")
            lb.pack(side="left", padx=(0, 5))
            lb.bind("<Button-1>", lambda e, v=val: self._pick(v))
            lb.bind("<Enter>", lambda e, w=lb: self._hover(w, True), add="+")
            lb.bind("<Leave>", lambda e, w=lb: self._hover(w, False), add="+")
            self._items.append((val, lb))
        self._trace = variable.trace_add("write", lambda *a: self._paint())
        self.bind("<Destroy>", self._destroyed, add="+")
        self._paint()

    def _destroyed(self, e):
        if e.widget is self:
            try:
                self.var.trace_remove("write", self._trace)
            except Exception:
                pass

    def _pick(self, v):
        self.var.set(int(v) if isinstance(self.var, tk.IntVar) else str(v))

    def _sel(self, val):
        try:
            return str(self.var.get()) == str(val)
        except Exception:
            return False

    def _colors(self, val):
        if self._sel(val):
            return ACCENT, ACCENT_FG
        return (self._idle_tok or PANEL2), MUTED

    def _hover(self, w, inside):
        val = next((v for v, lb in self._items if lb is w), None)
        if val is None or self._sel(val):
            return
        bg, fg = self._colors(val)
        try:
            fade_to(w, {"bg": GHOST_HOV if inside else bg, "fg": FG if inside else fg}, 120)
        except tk.TclError:
            pass

    def _paint(self):
        for val, lb in self._items:
            bg, fg = self._colors(val)
            try:
                tween_cancel(lb, "fade")
                lb.configure(bg=bg, fg=fg)
            except tk.TclError:
                pass

    def _retheme(self):
        self._idle_tok = None if self._idle_tok is None else PANEL
        self._paint()


def mkcard(parent, title, sub="", body_padx=16):
    """Rounded-look section card: accent tick + title, hairline, then a body frame (grid)."""
    card = tk.Frame(parent, bg=PANEL)
    card.pack(fill="x", pady=(0, 10))
    hd = tk.Frame(card, bg=PANEL)
    hd.pack(fill="x", padx=16, pady=(13, 0))
    tk.Frame(hd, bg=ACCENT, width=3, height=15).pack(side="left", padx=(0, 9))
    mklabel(hd, title, 11, FG, True, bg=PANEL).pack(side="left")
    if sub:
        mklabel(hd, sub, 9, MUTED, bg=PANEL).pack(side="left", padx=10)
    tk.Frame(card, bg=PANEL2, height=1).pack(fill="x", padx=16, pady=(11, 6))
    body = tk.Frame(card, bg=PANEL)
    body.pack(fill="x", padx=body_padx, pady=(2, 12))
    body.columnconfigure(1, weight=1)
    return body


def frow(body, r, label, widget, pady=4):
