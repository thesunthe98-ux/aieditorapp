    # ---- helpers ----

    def _ok_hex(self, v):
        return bool(re.fullmatch(r"#[0-9a-fA-F]{6}", (v or "").strip()))

    def _paint_swatch(self, key):
        sw = self._sub_swatches.get(key)
        v = self.subv[key].get().strip()
        if sw is not None and self._ok_hex(v):
            try:
                sw.configure(bg=v)
            except tk.TclError:
                pass

    def _pick_sub_color(self, key):
        cur = self.subv[key].get().strip()
        res = colorchooser.askcolor(color=cur if self._ok_hex(cur) else "#ffffff", parent=self, title="Color")
        if res and res[1]:
            self.subv[key].set(res[1].upper())

    def _apply_sub_preset(self, vals):
        for k, v in vals.items():
            self.subv[k].set(v)
        self._pv_draw()

    def _set_sub_pos(self, x, y):
        self.subv["SUB_X"].set(x)
        self.subv["SUB_Y"].set(y)

    def _reset_subs(self):
        if messagebox.askyesno("Reset", "Subtitle settings default e ferot jabe. Thik ache?"):
            for k, v in self.SUB_DEFAULTS.items():
                self.subv[k].set(v)

    def load_sub_settings(self):
        c = cfg_read(self.proj)
        was = self._loading
        self._loading = True
        try:
            for k, v in self.subv.items():
                v.set(c.get(k, self.SUB_DEFAULTS[k]))
        finally:
            self._loading = was
        self._pv_samples = None
        self._pv_idx = 0
        if self.cur == "avatar":
            self.refresh_subs()

    def save_sub_settings(self, silent=True):
        cfg_write(self.proj, {k: v.get().strip() for k, v in self.subv.items()})
        return True

    def _fnum(self, key, default, lo=None, hi=None):
        try:
            x = float(self.subv[key].get())
        except Exception:
            x = float(default)
        if lo is not None:
            x = max(lo, x)
        if hi is not None:
            x = min(hi, x)
        return x

    def _fmt_num(self, x):
        return f"{x:.1f}".rstrip("0").rstrip(".")

    # ---- preview ----

    def _pv_out_dims(self):
        c = {k: v.get().strip() for k, v in self.sv.items()}
        m = re.fullmatch(r"(\d+)x(\d+)", c.get("OUTPUT_RESOLUTION", ""))
        if m and int(m.group(1)) > 0 and int(m.group(2)) > 0:
            return int(m.group(1)), int(m.group(2))
        return {"16:9": (1920, 1080), "9:16": (1080, 1920), "1:1": (1080, 1080),
                "4:3": (1440, 1080)}.get(c.get("OUTPUT_RATIO", "9:16"), (720, 1280))

    def _pv_collect_samples(self):
        srt_lines = []
        sp = self.srt_path()
        if sp:
            for blk in re.split(r"\n\s*\n", read_text(sp).replace("\r\n", "\n")):
                rows = [l for l in blk.strip().split("\n") if l.strip()]
                rows = [l for l in rows if "-->" not in l and not re.fullmatch(r"\d+", l.strip())]
                t = re.sub(r"\s+", " ", re.sub(r"<[^>]+>", "", " ".join(rows))).strip()
                if t:
                    srt_lines.append(t)
        script_lines = sentences_of(os.path.join(self.proj, "script.txt"))
        src = self.subv["SUB_SOURCE"].get().strip().lower()
        if src == "script":
            out = script_lines
        elif src == "srt":
            out = srt_lines
        else:
            out = srt_lines or script_lines
        out = out[:300]
        return out or ["Eta tomar subtitle er preview", "Drag kore position thik koro"]

    def refresh_subs(self):
        """Collect subtitle sample lines (preview itself is drawn by the shared avatar canvas)."""
        if not self.proj:
            return
        self._pv_samples = self._pv_collect_samples()
        self._pv_idx = min(self._pv_idx, len(self._pv_samples) - 1)
        self._pv_ready = True
        self._av_draw()

    def _pv_step(self, d):
        if not self._pv_samples:
            return
        self._pv_idx = (self._pv_idx + d) % len(self._pv_samples)
        self._pv_draw()

    def _pv_font(self, fam, weight, S_px):
        import tkinter.font as tkfont
        lk = (fam, weight)
        if lk not in self._pv_ls:
            self._pv_ls[lk] = max(1, tkfont.Font(family=fam, size=-100, weight=weight).metrics("linespace"))
        # libass: ASS font size == line height (ascent+descent). Pick the Tk pixel size with the same line height.
        E = max(5, int(round(S_px * 100.0 / self._pv_ls[lk])))
        fk = (fam, weight, E)
        if fk not in self._pv_fonts:
            if len(self._pv_fonts) > 60:
                self._pv_fonts.clear()
            self._pv_fonts[fk] = tkfont.Font(family=fam, size=-E, weight=weight)
        return self._pv_fonts[fk]

    def _pv_blend(self, hexcol, op, x0, y0, x1, y1):
        try:
            r1, g1, b1 = (int(hexcol[i:i + 2], 16) for i in (1, 3, 5))
        except Exception:
            return "#000000"
        br, bg_, bb = 0x2b, 0x30, 0x40
        if self._av_bg is not None:
            acc, n = [0, 0, 0], 0
            iw, ih = self._av_bg.width(), self._av_bg.height()
            for px, py in ((x0, y0), (x1, y0), (x0, y1), (x1, y1), ((x0 + x1) / 2, (y0 + y1) / 2)):
                try:
                    c = self._av_bg.get(int(max(0, min(iw - 1, px))), int(max(0, min(ih - 1, py))))
                    if isinstance(c, str):
                        c = c.split()
                    c = [int(v) for v in c[:3]]
                    acc = [a + b for a, b in zip(acc, c)]
                    n += 1
                except Exception:
                    pass
            if n:
                br, bg_, bb = (v // n for v in acc)
        a = op / 100.0
        return "#%02x%02x%02x" % (int(r1 * a + br * (1 - a)), int(g1 * a + bg_ * (1 - a)), int(bb * (1 - a) + b1 * a))

    def _pv_draw(self):
        self._av_draw()

    def _pv_overlay(self):
        """Draws the subtitle on the shared preview canvas (called from _av_draw_inner)."""
        if not self._pv_samples:
            return
        if self.subv["SUB_ENABLED"].get() != "1" and self._ctl_tab.get() != "subs":
            return
        cv = self.av_cv
        W, H = self._av_out
        cw, ch = self._av_size
        k = cw / float(W)
        text = self._pv_samples[self._pv_idx]
        n = int(self._fnum("SUB_WORDS", 0, 0, 50))
        words = text.split()
        if n > 0 and len(words) > n:
            text = " ".join(words[:n])
        if self.subv["SUB_UPPER"].get() == "1":
            text = text.upper()
        self.pv_info.configure(text=f"Sample {self._pv_idx + 1}/{len(self._pv_samples)}  •  {W}×{H}")

        S = H * self._fnum("SUB_SIZE", 5, 1, 30) / 100.0               # ASS font size in output px
        fam = self.subv["SUB_FONT"].get().strip() or "Arial"
        font = self._pv_font(fam, "bold" if self.subv["SUB_BOLD"].get() == "1" else "normal", S * k)
        pitch = font.metrics("linespace")
        px = cw * self._fnum("SUB_X", 50, 0, 100) / 100.0
        py = ch * self._fnum("SUB_Y", 82, 0, 100) / 100.0
        maxw = cw * self._fnum("SUB_WIDTH", 80, 10, 100) / 100.0
        maxw = min(maxw, 2 * min(px, cw - px))
        lines, cur = [], ""
        for w_ in text.split():                                        # greedy wrap (same as libass WrapStyle 1)
            trial = (cur + " " + w_) if cur else w_
            if cur and font.measure(trial) > maxw:
                lines.append(cur)
                cur = w_
            else:
                cur = trial
        if cur:
            lines.append(cur)
        top = py - len(lines) * pitch / 2.0
        col = self.subv["SUB_COLOR"].get().strip()
        col = col if self._ok_hex(col) else "#FFFFFF"
        box = self.subv["SUB_BOX"].get() == "1"
        if box:
            bcol = self.subv["SUB_BOX_COLOR"].get().strip()
            bcol = bcol if self._ok_hex(bcol) else "#000000"
            op = self._fnum("SUB_BOX_OPACITY", 60, 0, 100)
            pad = 0.22 * S * k
            for i, ln in enumerate(lines):
                cy = top + pitch * (i + 0.5)
                lw = font.measure(ln)
                x0, x1, y0, y1 = px - lw / 2 - pad, px + lw / 2 + pad, cy - pitch / 2 - pad, cy + pitch / 2 + pad
                cv.create_rectangle(x0, y0, x1, y1, outline="", fill=self._pv_blend(bcol, op, x0, y0, x1, y1))
        else:
            ocol = self.subv["SUB_OUTLINE_COLOR"].get().strip()
            ocol = ocol if self._ok_hex(ocol) else "#000000"
            r = S * k * self._fnum("SUB_OUTLINE", 8, 0, 30) / 100.0
            if r >= 0.6:
                for i, ln in enumerate(lines):
                    cy = top + pitch * (i + 0.5)
                    for a in range(0, 360, 30):
                        cv.create_text(px + r * math.cos(math.radians(a)), cy + r * math.sin(math.radians(a)),
                                       text=ln, font=font, fill=ocol, anchor="center")
        for i, ln in enumerate(lines):
            cv.create_text(px, top + pitch * (i + 0.5), text=ln, font=font, fill=col, anchor="center")
        if self._pv_drag:                                              # center guides while dragging
            sx, sy = self._pv_snap
            cv.create_line(cw / 2, 0, cw / 2, ch, fill=ACCENT if sx else "#ffffff", dash=(3, 4), width=1)
            cv.create_line(0, ch / 2, cw, ch / 2, fill=ACCENT if sy else "#ffffff", dash=(3, 4), width=1)

    def _pv_press(self, e):
        self._pv_drag = True
        self._pv_move(e)

    def _pv_move(self, e):
        cw, ch = self._pv_size
        xp = max(0.0, min(100.0, e.x / float(cw) * 100))
        yp = max(0.0, min(100.0, e.y / float(ch) * 100))
        sx, sy = abs(xp - 50) < 1.8, abs(yp - 50) < 1.8
        if sx:
            xp = 50.0
        if sy:
            yp = 50.0
        self._pv_snap = (sx, sy)
        self.subv["SUB_X"].set(self._fmt_num(xp))
        self.subv["SUB_Y"].set(self._fmt_num(yp))

    def _pv_release(self, e):
        self._pv_drag = False
        self._pv_draw()

    def _pv_reset_pos(self, e=None):
        self._set_sub_pos(self.SUB_DEFAULTS["SUB_X"], self.SUB_DEFAULTS["SUB_Y"])

    def _pv_wheel(self, e):
        up = (getattr(e, "delta", 0) > 0) or getattr(e, "num", 0) == 4
        cur = self._fnum("SUB_SIZE", 5, 1, 30)
        self.subv["SUB_SIZE"].set(self._fmt_num(max(2.0, min(14.0, cur + (0.25 if up else -0.25)))))


