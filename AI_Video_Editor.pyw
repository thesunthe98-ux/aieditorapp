    # ───────── timeline resize handle + compact (small-window) mode ─────────
    def _set_tl_h(self, h):
        try:
            room = self.winfo_height() - 330
        except tk.TclError:
            room = 266
        h = int(max(100, min(292, h, max(100, room))))
        if h == self.TL_H:
            return
        self.TL_H = h
        self.BLOCK_H = max(8, h - 76 - self.OVL_H)
        self.tl_cv.configure(height=h)
        try:                                   # timeline choto hole help-text lukiye aro jaga dao
            if h < 130:
                self._hl.pack_forget()
            elif not self._hl.winfo_ismapped():
                self._hl.pack(fill="x", padx=14, pady=(0, 8))
        except (AttributeError, tk.TclError):
            pass
        self._draw_soon()

    def _grip_press(self, e):
        self._gy, self._gh = e.y_root, self.TL_H

    def _grip_move(self, e):
        self._set_tl_h(self._gh + (self._gy - e.y_root))

    def _grip_release(self, _e=None):
        try:
            r = self._rec()
            if r is None:
                r = load_recent()
            r["tl_h"] = int(self.TL_H - self.OVL_H)
            save_recent(r)
        except Exception:
            pass

    def _compact_check(self, width):
        lvl = 0 if width >= 1480 else (1 if width >= 1150 else 2)
        if lvl != self._cmp_level:
            self._cmp_level = lvl
            self.after_idle(lambda: self._compact_apply(lvl))

    def _compact_apply(self, lvl):
        import tkinter.font as tkfont
        dsize = (0, -1, -2)[lvl]
        pk = (1.0, 0.65, 0.45)[lvl]
        for fl in getattr(self, "_tl_flows", []):
            for w, _px in fl._items:
                try:
                    o = self._cmp_orig.get(w)
                    if o is None:
                        if isinstance(w, ttk.Combobox):
                            o = ("cb", int(float(w.cget("width"))))
                        elif isinstance(w, (tk.Button, tk.Label)):
                            f = tkfont.Font(root=self, font=w.cget("font"))
                            o = ("tx", f.actual("family"), int(f.actual("size")), f.actual("weight"),
                                 int(float(w.cget("padx"))), int(float(w.cget("pady"))), hasattr(w, "_kind"))
                        else:
                            o = ("skip",)
                        self._cmp_orig[w] = o
                    if o[0] == "cb":
                        w.configure(width=max(8, int(round(o[1] * (1.0, 0.75, 0.6)[lvl]))))
                    elif o[0] == "tx":
                        _, fam, sz, wt, px, py, isbtn = o
                        kw = {"font": (fam, max(7, sz + dsize), wt)}
                        if isbtn:
                            kw["padx"] = max(3, int(round(px * pk)))
                            kw["pady"] = py if lvl == 0 else max(1, py - 1)
                        w.configure(**kw)
                except (tk.TclError, ValueError):
                    pass
        for fl in getattr(self, "_tl_flows", []):
            fl._sig = None
            fl._queue()

    def _exp_pick_dir(self):
        d = filedialog.askdirectory(parent=self.app, title="Export folder bachho",
                                    initialdir=self.exp_dir_var.get().strip() or self.app.proj or None)
        if d:
            self.exp_dir_var.set(d)

    # ───────── saved voice names (typed once -> remembered -> shown in dropdown) ─────────
    def _rec(self):
        r = getattr(self.app, "rec", None)
        return r if isinstance(r, dict) else None

    def _voice_names(self):
        r = self._rec()
        if r is None:
            r = load_recent()
        v = r.get("voice_names", [])
        return [str(x) for x in v if str(x).strip()] if isinstance(v, list) else []

    def _voice_save(self, names):
        r = self._rec()
        if r is None:
            r = load_recent()
        r["voice_names"] = names
        save_recent(r)
        try:
            self.voice_cb.configure(values=names)
        except Exception:
            pass

    def _voice_remember(self):
        name = self.voice_name_var.get().strip()
        if not name:
            return
        names = [n for n in self._voice_names() if n.lower() != name.lower()]
        names.insert(0, name)
        self._voice_save(names[:60])

    def _voice_delete(self):
        """Box e ja lekha/select kora ache sei voice name saved list theke muche dao."""
        name = self.voice_name_var.get().strip()
        if not name:
            self.app.note("Age dropdown theke ekta voice name select koro, tarpor ⌫ (Del name) chap", WARN)
            return
        names = self._voice_names()
        if not any(n.lower() == name.lower() for n in names):
            self.app.note("'%s' saved list e nai" % name, WARN)
            return
        self._voice_save([n for n in names if n.lower() != name.lower()])
        self.voice_name_var.set("")
        self.app.note("'%s' list theke delete hoyeche" % name, OK)

    def _voice_menu(self, e):
        name = self.voice_name_var.get().strip()
        m = tk.Menu(self, tearoff=0)
        m.add_command(label="Remove '%s' from list" % name if name else "Remove from list",
                      state="normal" if name else "disabled",
                      command=lambda: (self._voice_save([n for n in self._voice_names() if n.lower() != name.lower()]),
                                       self.voice_name_var.set("")))
        try:
            m.tk_popup(e.x_root, e.y_root)
        finally:
            m.grab_release()

    def fix_voice(self):
        if self._fix_busy:
            self._fix_stop.set()
            self.app.note("Fix voice stop hochhe…", WARN)
            return
        name = self.voice_name_var.get().strip()
        if not name:
            messagebox.showwarning("Fix voice", "Toolbar er 'Voice name' box e voice er naam likho (e.g. Walter).")
            return
        self._voice_remember()
        if not self.slots or not any(sl.get("path") for sl in self.slots):
            messagebox.showwarning("Fix voice", "Timeline e kono clip nei.")
            return
        add_ffmpeg_path()
        if not shutil.which("ffmpeg"):
            messagebox.showerror("Fix voice", "ffmpeg pawa jayni.")
            return
        proj = self.app.proj
        if not proj:
            messagebox.showwarning("Fix voice", "Age project select koro.")
            return
        self._pause()
        if self._analysis_pending():
            self.app.note("Audio analyse hochhe — ektu por abar 'Fix voice' chap.", WARN)
            return
        plan = []
        for sl in self.slots:
            p = sl.get("path")
            plan.append({"path": p, "dur": float(self._dur(sl)), "tin": self._trim(sl)[0],
                         "gain": self._norm_gain(p) if p else 1.0,
                         "img": bool(p and self._is_img(p))})
        self._fix_stop.clear()
        self._fix_ui(True)
        threading.Thread(target=self._fix_worker, args=(plan, name, proj), daemon=True).start()

    def _fix_ui(self, busy):
        self._fix_busy = busy
        if self._fix_btn is not None:
            try:
                self._fix_btn.config(text="Stop fix" if busy else "Fix voice", icon="■" if busy else "🔧")
            except Exception:
                pass

    def _fix_done(self, ok_path=None, err=None):
        self._fix_ui(False)
        if ok_path:
            self.set_voice(ok_path)
            self.app.note("Fix voice shesh — voice track timeline e boshano hoyeche ✓", OK)
        elif err:
            self.app.note("Fix voice: " + str(err), WARN)
            messagebox.showwarning("Fix voice", str(err))

    def _fix_worker(self, plan, name, proj):
        try:
            work = os.path.join(proj, "fixed_voice")
            os.makedirs(work, exist_ok=True)
            self.after(0, lambda: self.app.note("Fix voice: timeline audio merge hochhe…"))
            merged = os.path.join(work, "voice.mp3")
            ok, err = self._t2_build_merged_audio(plan, merged)
            if not ok:
                self.after(0, lambda: self._fix_done(err=err or "Audio merge fail"))
                return
            if self._fix_stop.is_set():
                self.after(0, lambda: self._fix_done(err="Stop kora hoyeche."))
                return
            chunks = self._t2_split_chunks(merged, work, 300.0)
            out = self._t2_speechify_swap(chunks, name, proj, work)
            self.after(0, lambda: self._fix_done(ok_path=out))
        except VoiceStopped:
            self.after(0, lambda: self._fix_done(err="Stop kora hoyeche."))
        except Exception as e:
            msg = str(e)
            self.after(0, lambda: self._fix_done(err=msg))

    # ───────── Fix voice: Speechify Voice Swap (Tab2SpeechifyRunner does the browser work) ─────────
