    def refresh_voice(self):
        _voice_ensure_dirs()
        if not self._voice_main_running and not self._voice_regens:
            try:
                _cfg_now = dict(self._voice_cfg)
                _cfg_now["output_dir"] = VOICE_OUTPUT
                voice_sweep_done(_cfg_now, self.voice_log_line)
                cur = self._voice_cur_script
                if cur and not os.path.exists(os.path.join(VOICE_SCRIPTS, cur)) \
                        and not os.path.exists(os.path.join(VOICE_LB, cur)):
                    self.voice_new_script()                  # editor e khola script ta done e chole geche
            except Exception:
                pass
        self.voice_refresh_scripts()
        self.voice_refresh_accounts()
        self.voice_refresh_results()

    def voice_log_line(self, msg):
        line = f"[{time.strftime('%H:%M:%S')}] {msg}"
        self._voice_q.put(line)
        try:
            with open(VOICE_LOG, "a", encoding="utf-8") as fh:
                fh.write(line + "\n")
        except Exception:
            pass

    def _voice_poll(self):
        try:
            while True:
                line = self._voice_q.get_nowait()
                low = line.lower()
                tag = "err" if ("fail" in low or "error" in low or "problem" in low) else (
                    "ok" if ("shesh" in low or "saved" in low) else (
                        "step" if "=====" in line else None))
                try:
                    _need = self._voice_track(line)
                except Exception:
                    _need = False
                if _need or "MP3 saved" in line or "SRT saved" in line or "SHESH" in line:
                    self.after(300, self.voice_refresh_results)     # show new files live
                self.voice_log.configure(state="normal")
                self.voice_log.insert("end", line + "\n", tag)
                self.voice_log.see("end")
                self.voice_log.configure(state="disabled")
                self.voice_status.configure(text=line[11:].strip()[:100],
                                            fg=BAD if tag == "err" else (OK if tag == "ok" else MUTED))
        except queue.Empty:
            pass
        try:
            self._voice_live_tick()
        except Exception:
            pass
        self.after(200, self._voice_poll)

    # ───────── live progress (Generated section e dekhabe ekhon ki kaj cholche) ─────────
    _VL_NAME = {"mp3": "MP3", "srt": "SRT", "gemini": "Gemini"}
    _VL_NUM = {"mp3": "\u2460", "srt": "\u2461", "gemini": "\u2462"}

    def _voice_cur_stage(self, d):
        gone = d["done"] | d["skipped"] | d["bad"]
        for s_ in d["stages"]:
            if s_ not in gone:
                return s_
        return None

    def _voice_track(self, line):
        """Log line pore bojhe: kon script e, kon dhape (MP3 / SRT / Gemini) kaj cholche.
        True dile Generated list notun kore ankte hobe."""
        msg = line[11:].strip()
        m = re.match(r"^\[(T\d+)\]\s*(.*)$", msg)
        tag, body = (m.group(1), m.group(2).strip()) if m else ("", msg)
        now = time.time()
        h = re.match(r"^=+\s*(.+?)\s*=+$", body)
        if h:
            inner = h.group(1)
            m2 = re.match(r"^(.*?)\s*\((mp3|srt|gemini)\)$", inner, re.I)
            name, what = (m2.group(1).strip(), m2.group(2).lower()) if m2 else (inner, "all")
            gem = bool(self._voice_cfg.get("gemini_enabled", True))
            if what == "gemini":
                stages = ["gemini"]
            elif what == "srt":
                stages = ["srt"] + (["gemini"] if gem else [])
            else:
                stages = ["mp3", "srt"] + (["gemini"] if gem else [])
            done = set()
            if what == "all":
                try:
                    mp = os.path.join(VOICE_OUTPUT, name, name + ".mp3")
                    if os.path.exists(mp) and os.path.getsize(mp) > 1000:
                        done.add("mp3")          # MP3 age thekei ache — Speechify skip hobe
                except OSError:
                    pass
            self._voice_live[name] = {"tag": tag, "stages": stages, "done": done, "skipped": set(),
                                      "bad": set(), "state": "run", "t0": now, "st0": now,
                                      "detail": "Shuru hochhe\u2026"}
            self._voice_tag_cur[tag] = name
            return True
        name = self._voice_tag_cur.get(tag)
        d = self._voice_live.get(name) if name else None
        if not d or d["state"] != "run" or not body or body.startswith("---"):
            return False
        low = body.lower()
        st = d["stages"]
        before = self._voice_cur_stage(d)
        if low.startswith(("mp3 saved", "mp3 notun kore")) and "mp3" in st:
            d["done"].add("mp3")
        elif low.startswith(("srt saved", "srt notun kore")) and "srt" in st:
            d["done"].add("srt")
        elif (low.startswith("corrected srt saved") or "corrected srt age thekei" in low) and "gemini" in st:
            d["done"].add("gemini")
        elif "gemini correction skip" in low and "gemini" in st:
            d["skipped"].add("gemini")
        elif low.startswith("gemini fail") and ("ager moto ache" in low or "hoyni" in low) and "gemini" in st:
            d["bad"].add("gemini")
        elif low.startswith("shesh:"):
            d["state"] = "done"
            d["tend"] = now
            for s_ in st:
                if s_ not in d["bad"] and s_ not in d["skipped"]:
                    d["done"].add(s_)
            d["detail"] = "Shesh"
            return True
        elif low.startswith("fail:") or low.startswith("error"):
            d["state"] = "fail"
            d["tend"] = now
            if before:
                d["bad"].add(before)
            d["detail"] = body[:140]
            return True
        d["detail"] = body[:110]
        if self._voice_cur_stage(d) != before:
            d["st0"] = now
        return False

    def _voice_live_finalize(self, only=None):
        """Kaj shesh/stop hole je gulo 'run' obosthay atke ache shegulor obostha thik kore."""
        changed = False
        for n, d in self._voice_live.items():
            if d["state"] != "run":
                continue
            if only is not None and n != only:
                continue
            if only is None and n in self._voice_regens:
                continue
            if d["bad"]:
                d["state"] = "fail"
                if not d.get("detail") or d["detail"] in ("Shuru hochhe\u2026", "Shesh"):
                    d["detail"] = "Kichu dhap fail hoyeche (upore \u2717 dekho)"
            else:
                d["state"] = "done" if self._voice_cur_stage(d) is None else "stopped"
            d["tend"] = time.time()
            changed = True
        if changed:
            try:
                self.voice_refresh_results()
            except tk.TclError:
                pass

    def _voice_live_row(self, card, name, d):
        fr = tk.Frame(card, bg=PANEL)
        fr.pack(fill="x", padx=10, pady=(4, 4))
        r1 = tk.Frame(fr, bg=PANEL)
        r1.pack(fill="x", padx=8, pady=(6, 0))
        chips = {}
        for s_ in d["stages"]:
            lb = mklabel(r1, "", 9, MUTED, True, bg=PANEL)
            lb.pack(side="left", padx=(0, 12))
            chips[s_] = lb
        tl = mklabel(r1, "", 9, MUTED, bg=PANEL)
        tl.pack(side="right")
        if d["state"] in ("fail", "stopped"):
            mkbtn(r1, "\u2715", lambda n=name: self._voice_live_dismiss(n), "flat",
                  pady=0, padx=6).pack(side="right", padx=(0, 8))
        dl = mklabel(fr, "", 9, FG, bg=PANEL, justify="left", anchor="w", wraplength=420)
        dl.pack(fill="x", padx=8, pady=(2, 7))
        fr.bind("<Configure>", lambda e, l=dl: l.configure(wraplength=max(140, e.width - 24)))
        self._voice_live_w[name] = {"frame": fr, "chips": chips, "time": tl, "detail": dl, "cache": {}}
        self._voice_live_update(self._voice_live_w[name], d)

    def _voice_live_dismiss(self, name):
        self._voice_live.pop(name, None)
        self.voice_refresh_results()

    def _voice_live_tick(self):
        if not self._voice_live_w:
            return
        self._voice_live_i += 1
        for name in list(self._voice_live_w):
            w = self._voice_live_w.get(name)
            d = self._voice_live.get(name)
            try:
                if not w or not d or not w["frame"].winfo_exists():
                    self._voice_live_w.pop(name, None)
                    continue
                self._voice_live_update(w, d)
            except tk.TclError:
                self._voice_live_w.pop(name, None)

    def _voice_live_update(self, w, d):
        i = self._voice_live_i
        now = time.time()
        dots = ("." * ((i // 2) % 4)).ljust(3)
        pulse = (math.sin(i * 0.9) + 1) / 2
        run = d["state"] == "run"
        cur = self._voice_cur_stage(d)
        cache = w["cache"]

        def put(key, widget, **kw):
            sig = tuple(sorted(kw.items()))
            if cache.get(key) != sig:
                cache[key] = sig
                widget.configure(**kw)

        for s_, lb in w["chips"].items():
            nm = f"{self._VL_NUM[s_]} {self._VL_NAME[s_]}"
            if s_ in d["done"]:
                put(s_, lb, text=nm + " \u2713", fg=OK)
            elif s_ in d["skipped"]:
                put(s_, lb, text=nm + " \u2013 skip", fg=MUTED)
            elif s_ in d["bad"]:
                put(s_, lb, text=nm + " \u2717", fg=BAD)
            elif s_ == cur and run:
                put(s_, lb, text=nm + " " + dots, fg=_mix(ACCENT, FG, pulse))
            elif s_ == cur:
                put(s_, lb, text=nm + " \u25a0", fg=WARN)
            else:
                put(s_, lb, text=nm, fg=MUTED)
        tot = (now if run else d.get("tend", now)) - d["t0"]
        ttxt = "\u23f1 " + fmt_dur(tot)
        if run and cur:
            ttxt += "   (dhap: " + fmt_dur(now - d["st0"]) + ")"
        put("time", w["time"], text=ttxt)
        det = d["detail"]
        if d["state"] == "fail":
            put("det", w["detail"], text="\u2717 " + det, fg=BAD)
        elif d["state"] == "stopped":
            put("det", w["detail"], text="\u25a0 Bondho hoye geche \u2014 " + det, fg=WARN)
        else:
            warn = re.search(r"fail|problem|retry|reload|abar", det.lower())
            put("det", w["detail"], text="\u25b8 " + det, fg=WARN if warn else FG)

    def voice_refresh_scripts(self):
        for w in self.voice_slist.inner.winfo_children():
            w.destroy()
        names = set()
        for base in (VOICE_SCRIPTS, VOICE_LB):
            try:
                names.update(f for f in os.listdir(base)
                             if f.lower().endswith(".txt") and os.path.isfile(os.path.join(base, f)))
            except Exception:
                pass
        files = sorted(names)
        for fn in files:
            sel = (self._voice_cur_script == fn)
            b = mkbtn(self.voice_slist.inner, os.path.splitext(fn)[0],
                      lambda n=fn: self.voice_load_script(n),
                      "primary" if sel else "flat", pady=3, padx=10)
            b.pack(fill="x", pady=1, padx=4)

    def _voice_alive(self):
        if self._voice_main_running or self._voice_regens:
            return True
        return self._voice_kind == "setup" and bool(self._voice_thread and self._voice_thread.is_alive())

    def _voice_running(self):
        return bool(self._voice_main_running or self._voice_regens)

    def _voice_ui_update(self):
        """Button state + animation sob ekhane theke thik hoy."""
        run = self._voice_running()
        busy = self._voice_alive()
        if not run:
            self._voice_stopping = False
        try:
            self.voice_start_btn.configure(state="disabled" if (self._voice_main_running or (busy and not run)) else "normal")
            self.voice_stop_btn.configure(state="normal" if run else "disabled")
            self.voice_clear_btn.configure(state="disabled" if busy else "normal")
            self.voice_atext.configure(state="disabled" if (busy or self._t2_fix_running()) else "normal")
            if not busy:
                self.voice_status.configure(text="Ready", fg=MUTED)
        except tk.TclError:
            return
        self.voice_act.set_active(run)
        if (run or self._voice_stopping) and self._voice_anim_job is None:
            self._voice_anim_tick()
        elif not run and not self._voice_stopping:
            self._voice_anim_reset()

    def _voice_anim_reset(self):
        if self._voice_anim_job:
            try:
                self.after_cancel(self._voice_anim_job)
            except Exception:
                pass
            self._voice_anim_job = None
        try:
            self.voice_start_btn.configure(text="▶  START")
            self.voice_stop_btn.configure(text="■  STOP", bg=DANGER, activebackground=DANGER)
            self.voice_active_lbl.configure(text="")
        except tk.TclError:
            pass

    def _voice_anim_tick(self):
        self._voice_anim_job = None
        run = self._voice_running()
        if not run and not self._voice_stopping:
            self._voice_anim_reset()
            return
        self._voice_anim_i += 1
        i = self._voice_anim_i
        k = (i // 6) % 4
        dots = "." * k + " " * (3 - k)
        try:
            if self._voice_main_running:
                self.voice_start_btn.configure(text="▶  Running" + dots)
            if self._voice_stopping:
                self.voice_stop_btn.configure(text="■  Stopping" + dots)
                col = _mix(WARN, DANGER, (math.sin(i * 0.3) + 1) / 2)
            else:
                self.voice_stop_btn.configure(text="■  STOP")
                col = _mix(DANGER, DANGER_HOV, (math.sin(i * 0.2) + 1) / 2)
            self.voice_stop_btn.configure(bg=col, activebackground=col)
            n = len(self._voice_slots.busy)
            self.voice_active_lbl.configure(text=f"● {n} Chrome kaj korche" if run else "")
        except tk.TclError:
            return
        self._voice_anim_job = self.after(50, self._voice_anim_tick)

    def _voice_sched(self, key, fn, ms):
        j = self._voice_jobs.get(key)
        if j:
            try:
                self.after_cancel(j)
            except Exception:
                pass
        self._voice_jobs[key] = self.after(ms, fn)

    def _voice_text_modified(self, e=None):
        changed = False
        for w in (self.voice_stext, self.voice_ltext):
            if w.edit_modified():
                w.edit_modified(False)
                changed = True
        if changed:
            self._voice_sched("script", self._voice_autosave_script, 600)

    def _voice_prompt_modified(self, e=None):
        if not self.voice_ptext.edit_modified():
            return
        self.voice_ptext.edit_modified(False)
        self._voice_sched("prompt", self._voice_save_prompt, 600)

    def _voice_save_prompt(self):
        _voice_ensure_dirs()
        atomic_write(VOICE_PROMPT, self.voice_ptext.get("1.0", "end-1c"))

    def voice_reset_prompt(self):
        if not messagebox.askyesno("Prompt", "Prompt ta default e ferot nibo? (ekhon ja lekha ache muchhe jabe)"):
            return
        self.voice_ptext.delete("1.0", "end")
        self.voice_ptext.insert("1.0", VOICE_DEFAULT_PROMPT)
        self.voice_ptext.edit_modified(False)
        self._voice_save_prompt()
