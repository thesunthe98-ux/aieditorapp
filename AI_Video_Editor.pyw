    def fix_voice(self):
        if self._fix_busy:
            self._fix_stop.set()
            self.app.note("Fix voice stop hochhe…", WARN)
            return
        name = self.voice_name_var.get().strip()
        if not name:
            messagebox.showwarning("Fix voice", "Toolbar er 'Voice name' box e voice er naam likho (e.g. Walter).")
            return
        self._voice_remember()
        if not self.slots or not any(sl.get("path") for sl in self.slots):
            messagebox.showwarning("Fix voice", "Timeline e kono clip nei.")
            return
        add_ffmpeg_path()
        if not shutil.which("ffmpeg"):
            messagebox.showerror("Fix voice", "ffmpeg pawa jayni.")
            return
        proj = self.app.proj
        if not proj:
            messagebox.showwarning("Fix voice", "Age project select koro.")
            return
        self._pause()
        if self._analysis_pending():
            self.app.note("Audio analyse hochhe — ektu por abar 'Fix voice' chap.", WARN)
            return
        plan = []
        for sl in self.slots:
            p = sl.get("path")
            plan.append({"path": p, "dur": float(self._dur(sl)), "tin": self._trim(sl)[0],
                         "gain": self._norm_gain(p) if p else 1.0,
                         "img": bool(p and self._is_img(p))})
        self._fix_stop.clear()
        self._fix_ui(True)
        threading.Thread(target=self._fix_worker, args=(plan, name, proj), daemon=True).start()

    def _fix_ui(self, busy):
        self._fix_busy = busy
        if self._fix_btn is not None:
            try:
                self._fix_btn.config(text="Stop fix" if busy else "Fix voice", icon="■" if busy else "🔧")
            except Exception:
                pass

    def _fix_done(self, ok_path=None, err=None):
        self._fix_ui(False)
        if ok_path:
            self.set_voice(ok_path)
            self.app.note("Fix voice shesh — voice track timeline e boshano hoyeche ✓", OK)
        elif err:
            self.app.note("Fix voice: " + str(err), WARN)
            messagebox.showwarning("Fix voice", str(err))

    def _fix_worker(self, plan, name, proj):
        try:
            work = os.path.join(proj, "fixed_voice")
            os.makedirs(work, exist_ok=True)
            self.after(0, lambda: self.app.note("Fix voice: timeline audio merge hochhe…"))
            merged = os.path.join(work, "voice.mp3")
            ok, err = self._t2_build_merged_audio(plan, merged)
            if not ok:
                self.after(0, lambda: self._fix_done(err=err or "Audio merge fail"))
                return
            if self._fix_stop.is_set():
                self.after(0, lambda: self._fix_done(err="Stop kora hoyeche."))
                return
            chunks = self._t2_split_chunks(merged, work, 300.0)
            out = self._t2_speechify_swap(chunks, name, proj, work)
            self.after(0, lambda: self._fix_done(ok_path=out))
        except VoiceStopped:
            self.after(0, lambda: self._fix_done(err="Stop kora hoyeche."))
        except Exception as e:
            msg = str(e)
            self.after(0, lambda: self._fix_done(err=msg))

