    def _compact_check(self, width):
        lvl = 0 if width >= 1480 else (1 if width >= 1150 else 2)
        if lvl != self._cmp_level:
            self._cmp_level = lvl
            self.after_idle(lambda: self._compact_apply(lvl))

    def _compact_apply(self, lvl):
        import tkinter.font as tkfont
        dsize = (0, -1, -2)[lvl]
        pk = (1.0, 0.65, 0.45)[lvl]
        for fl in getattr(self, "_tl_flows", []):
            for w, _px in fl._items:
                try:
                    o = self._cmp_orig.get(w)
                    if o is None:
                        if isinstance(w, ttk.Combobox):
                            o = ("cb", int(float(w.cget("width"))))
                        elif isinstance(w, (tk.Button, tk.Label)):
                            f = tkfont.Font(root=self, font=w.cget("font"))
                            o = ("tx", f.actual("family"), int(f.actual("size")), f.actual("weight"),
                                 int(float(w.cget("padx"))), int(float(w.cget("pady"))), hasattr(w, "_kind"))
                        else:
                            o = ("skip",)
                        self._cmp_orig[w] = o
                    if o[0] == "cb":
                        w.configure(width=max(8, int(round(o[1] * (1.0, 0.75, 0.6)[lvl]))))
                    elif o[0] == "tx":
                        _, fam, sz, wt, px, py, isbtn = o
                        kw = {"font": (fam, max(7, sz + dsize), wt)}
                        if isbtn:
                            kw["padx"] = max(3, int(round(px * pk)))
                            kw["pady"] = py if lvl == 0 else max(1, py - 1)
                        w.configure(**kw)
                except (tk.TclError, ValueError):
                    pass
        for fl in getattr(self, "_tl_flows", []):
            fl._sig = None
            fl._queue()

