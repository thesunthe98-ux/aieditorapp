    def zamzar_converting(self, page):
        """'Converting' spinner / 'Hang tight' message dekha jachche kina."""
        for rx in (r"^\s*Converting", r"Hang tight"):
            try:
                if page.get_by_text(re.compile(rx, re.I)).first.is_visible():
