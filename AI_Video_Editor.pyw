def sub_hl_indices(words, mode):
    """Which words of a subtitle get the highlight look (CapCut-style templates).
    MUST stay identical to _hl_indices() inside the embedded engine."""
    n = len(words)
    mode = (mode or "none").strip().lower()
    if n == 0 or mode in ("", "none"):
        return set()
    if n == 1:
        return {0}
    if mode in ("first", "follow"):
        return {0}
    if mode == "second":
        return {1}
    if mode == "last":
        return {n - 1}
    if mode == "longest":
        ln = [len(re.sub(r"[^\w]", "", x)) for x in words]
        return {ln.index(max(ln))}
    if mode == "alt":
        return {i for i in range(n) if i % 2 == 1}
    if mode == "half2":
        return set(range(n // 2, n))
    return set()


