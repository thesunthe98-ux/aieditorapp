    # ---- helpers ----

    def _ok_hex(self, v):
        return bool(re.fullmatch(r"#[0-9a-fA-F]{6}", (v or "").strip()))

    def _paint_swatch(self, key):
        sw = self._sub_swatches.get(key)
        v = self.subv[key].get().strip()
        if sw is not None and self._ok_hex(v):
            try:
                sw.configure(bg=v)
            except tk.TclError:
                pass

    def _pick_sub_color(self, key):
        cur = self.subv[key].get().strip()
        res = colorchooser.askcolor(color=cur if self._ok_hex(cur) else "#ffffff", parent=self, title="Color")
        if res and res[1]:
            self.subv[key].set(res[1].upper())

    def _apply_sub_preset(self, vals):
        for k in self.SUB_EXTRA_KEYS:                      # a plain preset clears glow / highlight / italic of a template
            self.subv[k].set(self.SUB_DEFAULTS[k])
        for k, v in vals.items():
            self.subv[k].set(v)
        self._pv_draw()

    def _set_sub_pos(self, x, y):
        self.subv["SUB_X"].set(x)
        self.subv["SUB_Y"].set(y)

    def _reset_subs(self):
        if messagebox.askyesno("Reset", "Subtitle settings default e ferot jabe. Thik ache?"):
            for k, v in self.SUB_DEFAULTS.items():
                self.subv[k].set(v)

    def load_sub_settings(self):
        c = cfg_read(self.proj)
        was = self._loading
        self._loading = True
        try:
            for k, v in self.subv.items():
                v.set(c.get(k, self.SUB_DEFAULTS[k]))
            if self.subv["SUB_HL_MODE"].get().strip().lower() not in ("", "none", "follow"):
                self.subv["SUB_HL_MODE"].set("follow")      # old modes (half2 / last / ...) now always follow
        finally:
            self._loading = was
        self._pv_samples = None
        self._pv_idx = 0
        if self.cur == "avatar":
            self.refresh_subs()

    def save_sub_settings(self, silent=True):
        cfg_write(self.proj, {k: v.get().strip() for k, v in self.subv.items()})
        return True

    def _fnum(self, key, default, lo=None, hi=None):
        try:
            x = float(self.subv[key].get())
        except Exception:
            x = float(default)
        if lo is not None:
            x = max(lo, x)
        if hi is not None:
            x = min(hi, x)
        return x

    def _fmt_num(self, x):
        return f"{x:.1f}".rstrip("0").rstrip(".")

    # ---- preview ----

    def _pv_out_dims(self):
        c = {k: v.get().strip() for k, v in self.sv.items()}
        m = re.fullmatch(r"(\d+)x(\d+)", c.get("OUTPUT_RESOLUTION", ""))
        if m and int(m.group(1)) > 0 and int(m.group(2)) > 0:
            return int(m.group(1)), int(m.group(2))
        return {"16:9": (1920, 1080), "9:16": (1080, 1920), "1:1": (1080, 1080),
                "4:3": (1440, 1080)}.get(c.get("OUTPUT_RATIO", "9:16"), (720, 1280))

    def _pv_collect_samples(self):
        srt_lines = []
        sp = self.srt_path()
        if sp:
            for blk in re.split(r"\n\s*\n", read_text(sp).replace("\r\n", "\n")):
                rows = [l for l in blk.strip().split("\n") if l.strip()]
                rows = [l for l in rows if "-->" not in l and not re.fullmatch(r"\d+", l.strip())]
                t = re.sub(r"\s+", " ", re.sub(r"<[^>]+>", "", " ".join(rows))).strip()
                if t:
                    srt_lines.append(t)
        script_lines = sentences_of(os.path.join(self.proj, "script.txt"))
        src = self.subv["SUB_SOURCE"].get().strip().lower()
        if src == "script":
            out = script_lines
        elif src == "srt":
            out = srt_lines
        else:
            out = srt_lines or script_lines
        out = out[:300]
        return out or ["Eta tomar subtitle er preview", "Drag kore position thik koro"]

    def refresh_subs(self):
        """Collect subtitle sample lines (preview itself is drawn by the shared avatar canvas)."""
        if not self.proj:
            return
        self._pv_samples = self._pv_collect_samples()
        self._pv_idx = min(self._pv_idx, len(self._pv_samples) - 1)
        self._pv_ready = True
        self._av_draw()

    def _pv_step(self, d):
        if not self._pv_samples:
            return
        self._pv_idx = (self._pv_idx + d) % len(self._pv_samples)
        self._pv_draw()

    def _pv_font(self, fam, weight, S_px, slant="roman", underline=False):
        import tkinter.font as tkfont
        lk = (fam, weight, slant)
        if lk not in self._pv_ls:
            self._pv_ls[lk] = max(1, tkfont.Font(family=fam, size=-100, weight=weight, slant=slant).metrics("linespace"))
        # libass: ASS font size == line height (ascent+descent). Pick the Tk pixel size with the same line height.
        E = max(5, int(round(S_px * 100.0 / self._pv_ls[lk])))
        fk = (fam, weight, E, slant, underline)
        if fk not in self._pv_fonts:
            if len(self._pv_fonts) > 80:
                self._pv_fonts.clear()
            self._pv_fonts[fk] = tkfont.Font(family=fam, size=-E, weight=weight, slant=slant, underline=underline)
        return self._pv_fonts[fk]

    def _pv_blend(self, hexcol, op, x0, y0, x1, y1):
        try:
            r1, g1, b1 = (int(hexcol[i:i + 2], 16) for i in (1, 3, 5))
        except Exception:
            return "#000000"
        br, bg_, bb = 0x2b, 0x30, 0x40
        if self._av_bg is not None:
            acc, n = [0, 0, 0], 0
            iw, ih = self._av_bg.width(), self._av_bg.height()
            for px, py in ((x0, y0), (x1, y0), (x0, y1), (x1, y1), ((x0 + x1) / 2, (y0 + y1) / 2)):
                try:
                    c = self._av_bg.get(int(max(0, min(iw - 1, px))), int(max(0, min(ih - 1, py))))
                    if isinstance(c, str):
                        c = c.split()
                    c = [int(v) for v in c[:3]]
                    acc = [a + b for a, b in zip(acc, c)]
                    n += 1
                except Exception:
                    pass
            if n:
                br, bg_, bb = (v // n for v in acc)
        a = op / 100.0
        return "#%02x%02x%02x" % (int(r1 * a + br * (1 - a)), int(g1 * a + bg_ * (1 - a)), int(bb * (1 - a) + b1 * a))

    def _pv_draw(self):
        self._av_draw()

    def _pv_overlay(self):
        """Draws the subtitle on the shared preview canvas (called from _av_draw_inner)."""
        if not self._pv_samples:
            return
        if self.subv["SUB_ENABLED"].get() != "1" and self._ctl_tab.get() != "subs":
            return
        cv = self.av_cv
        W, H = self._av_out
        cw, ch = self._av_size
        k = cw / float(W)
        text = self._pv_samples[self._pv_idx]
        n = int(self._fnum("SUB_WORDS", 0, 0, 50))
        words = text.split()
        if n > 0 and len(words) > n:
            text = " ".join(words[:n])
        if self.subv["SUB_UPPER"].get() == "1":
            text = text.upper()
        self.pv_info.configure(text=f"Sample {self._pv_idx + 1}/{len(self._pv_samples)}  \u2022  {W}\u00d7{H}")

        S = H * self._fnum("SUB_SIZE", 5, 1, 30) / 100.0               # ASS font size in output px
        px = cw * self._fnum("SUB_X", 50, 0, 100) / 100.0
        py = ch * self._fnum("SUB_Y", 82, 0, 100) / 100.0
        maxw = cw * self._fnum("SUB_WIDTH", 80, 10, 100) / 100.0
        maxw = min(maxw, 2 * min(px, cw - px))
        cfg = {key: var.get().strip() for key, var in self.subv.items()}
        self._sub_render(cv, text, cfg, S * k, px, py, maxw, self._pv_blend)
        if self._pv_drag:                                              # center guides while dragging
            sx, sy = self._pv_snap
            cv.create_line(cw / 2, 0, cw / 2, ch, fill=ACCENT if sx else "#ffffff", dash=(3, 4), width=1)
            cv.create_line(0, ch / 2, cw, ch / 2, fill=ACCENT if sy else "#ffffff", dash=(3, 4), width=1)

    def _sub_render(self, cv, text, cfg, S_px, cx, cy, maxw, blend, family=None):
        """Draws ONE subtitle (outline / box / glow / shadow / highlighted words) on a Tk canvas.
        Used by the live preview AND the template gallery. Mirrors write_ass() of the engine."""
        def nf(key, d, lo, hi):
            try:
                x = float(str(cfg.get(key, d)).strip())
            except Exception:
                x = float(d)
            return max(lo, min(hi, x))

        def hc(key, d):
            v = str(cfg.get(key, d)).strip()
            return v if self._ok_hex(v) else d

        fam = family or str(cfg.get("SUB_FONT", "")).strip() or "Arial"
        weight = "bold" if str(cfg.get("SUB_BOLD", "1")) == "1" else "normal"
        slant = "italic" if str(cfg.get("SUB_ITALIC", "0")) == "1" else "roman"
        font = self._pv_font(fam, weight, S_px, slant)
        pitch = font.metrics("linespace")
        hl_style = str(cfg.get("SUB_HL_STYLE", "text")).strip().lower()
        words_all = text.split()
        hi = sub_hl_indices(words_all, str(cfg.get("SUB_HL_MODE", "none")))
        ufont = self._pv_font(fam, weight, S_px, slant, True) if (hi and hl_style == "underline") else font
        lines, cur = [], []
        for w_ in words_all:                                           # greedy wrap (same as libass WrapStyle 1)
            if cur and font.measure(" ".join(cur + [w_])) > maxw:
                lines.append(cur)
                cur = [w_]
            else:
                cur.append(w_)
        if cur:
            lines.append(cur)
        if not lines:
            return
        col, hl_c, hlb_c = hc("SUB_COLOR", "#FFFFFF"), hc("SUB_HL_COLOR", "#FFE600"), hc("SUB_HL_BOX_COLOR", "#22C55E")
        box = str(cfg.get("SUB_BOX", "0")) == "1"
        glow, glow_c = nf("SUB_GLOW", 0, 0, 100), hc("SUB_GLOW_COLOR", "#FFFFFF")
        shadow = nf("SUB_SHADOW", 0, 0, 30) * S_px / 100.0
        r_out = S_px * nf("SUB_OUTLINE", 8, 0, 30) / 100.0
        top = cy - len(lines) * pitch / 2.0
        gi = 0
        for li, lw_ in enumerate(lines):
            ly = top + pitch * (li + 0.5)
            line_txt = " ".join(lw_)
            lw = font.measure(line_txt)
            x0 = cx - lw / 2.0
            runs = []                                                  # [text, highlighted?, x, width]
            for j, wd in enumerate(lw_):
                is_hl = (gi + j) in hi
                xs = x0 + (font.measure(" ".join(lw_[:j]) + " ") if j else 0)
                if runs and runs[-1][1] == is_hl:
                    runs[-1][0] += " " + wd
                else:
                    runs.append([wd, is_hl, xs, 0])
            gi += len(lw_)
            for rn in runs:
                rn[3] = (ufont if (rn[1] and hl_style == "underline") else font).measure(rn[0])
            bx0, bx1, by0, by1 = x0, x0 + lw, ly - pitch / 2.0, ly + pitch / 2.0
            if glow > 0:                                               # soft halo: 3 rings fading outwards
                gmax = S_px * (0.04 + 0.28 * glow / 100.0)
                ga = 0.45 + 0.55 * glow / 100.0
                for fr, al in ((1.0, 0.26), (0.7, 0.45), (0.4, 0.75)):
                    gc = blend(glow_c, min(100.0, al * ga * 100.0), bx0 - gmax, by0 - gmax, bx1 + gmax, by1 + gmax)
                    for a in range(0, 360, 45):
                        cv.create_text(cx + gmax * fr * math.cos(math.radians(a)),
                                       ly + gmax * fr * math.sin(math.radians(a)),
                                       text=line_txt, font=font, fill=gc, anchor="center")
            if box:
                bcol = hc("SUB_BOX_COLOR", "#000000")
                op = nf("SUB_BOX_OPACITY", 60, 0, 100)
                pad = 0.22 * S_px
                xa, xb, ya, yb = bx0 - pad, bx1 + pad, by0 - pad, by1 + pad
                cv.create_rectangle(xa, ya, xb, yb, outline="", fill=blend(bcol, op, xa, ya, xb, yb))
            if hi and hl_style == "box":
                for _t, is_hl, xs, rw in runs:
                    if is_hl:
                        cv.create_rectangle(xs - 0.18 * S_px, by0 - 0.05 * S_px, xs + rw + 0.18 * S_px,
                                            by1 + 0.05 * S_px, outline="", fill=hlb_c)
            if not box and shadow >= 0.6:
                scol = blend("#000000", 45, bx0, by0, bx1, by1)
                for t_, is_hl, xs, rw in runs:
                    if not (is_hl and hl_style == "box"):
                        cv.create_text(xs + shadow, ly + shadow, text=t_, font=font, fill=scol, anchor="w")
            if not box and r_out >= 0.6:
                ocol = hc("SUB_OUTLINE_COLOR", "#000000")
                for t_, is_hl, xs, rw in runs:
                    if is_hl and hl_style == "box":
                        continue
                    for a in range(0, 360, 30):
                        cv.create_text(xs + r_out * math.cos(math.radians(a)), ly + r_out * math.sin(math.radians(a)),
                                       text=t_, font=font, fill=ocol, anchor="w")
            for t_, is_hl, xs, rw in runs:
                cv.create_text(xs, ly, text=t_, font=(ufont if (is_hl and hl_style == "underline") else font),
                               fill=(hl_c if is_hl else col), anchor="w")

