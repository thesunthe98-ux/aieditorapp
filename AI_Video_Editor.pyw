    # ───────── right panel: Subtitles | Transitions | Settings | Export ─────────
    def _build_right(self, top):
        right = tk.Frame(top, bg=BG, width=self.RP_W)
        right.grid(row=0, column=2, sticky="ns", padx=(12, 0))
        right.grid_propagate(False)
        self._right = right
        Segmented(right, self.rp_tab, [("subs", "Aa  Subtitles"), ("trans", "⇄  Transitions"), ("set", "⚙  Settings"),
                                       ("export", "🎬  Export")],
                  idle=PANEL, padx=8, pady=6, size=9).pack(anchor="w", pady=(0, 8))
        holder = tk.Frame(right, bg=BG)
        holder.pack(fill="both", expand=True)
        self._rp = {k: ScrollFrame(holder) for k in ("subs", "trans", "set", "export")}
        self._build_sub_panel(self._rp["subs"].inner)
        self._build_tr_panel(self._rp["trans"].inner)
        self._build_set_panel(self._rp["set"].inner)
        self._build_exp_panel(self._rp["export"].inner)
        for k, v in self.subv2.items():
            v.trace_add("write", lambda *a, key=k: self._sub_changed(key))
        self.tspd.trace_add("write", lambda *a: (self._tr_update_lbl(), self._cfg_touch(), self._seek_refresh()))
        self.vol_pct.trace_add("write", lambda *a: self._cfg_touch())
        self.mute_var.trace_add("write", lambda *a: (self._cfg_touch(), self._pause() if self._playing else None))
        for _v in (self.cut_on, self.cut_val, self.cut_unit):
            _v.trace_add("write", lambda *a: self._cut_changed())
        self.norm_on.trace_add("write", lambda *a: self._norm_changed())
        self._cut_widgets()
        for v in (self.res_var, self.enc_var, self.preset_var, self.q_var, self.voice_name_var,
                  self.exp_dir_var, self.exp_name_var):
            v.trace_add("write", lambda *a: self._cfg_touch())
        self.aspect_var.trace_add("write", self._ratio2)
        self.rp_tab.trace_add("write", lambda *a: self._rp_changed())
        self._rp_changed()
        self._tr_update_lbl()

    def _toggle_right(self):
        if self._right_shown:
            self._right.grid_remove()
        else:
            self._right.grid()
        self._right_shown = not self._right_shown
        self.after(80, self._pv_configure)

    def _rp_changed(self):
        t = self.rp_tab.get()
        for k, pg in self._rp.items():
            pg.pack_forget()
        self._rp[t].pack(fill="both", expand=True)
        if t == "trans":
            self._tile_start()
        self._sub_ver += 1
        self._sub_key = None
        self._sub_sync()
        self._cfg_touch()

    def _cfg_touch(self):
        if self._loading:
            return
        self._cfg_dirty = True
        self._save_soon()

    # small layout helpers (narrow panel)
    def _lrow(self, body, r, label, widget, pady=3):
        mklabel(body, label, 10, MUTED, bg=PANEL, width=13, anchor="w").grid(row=r, column=0, sticky="w", pady=pady)
        widget.grid(row=r, column=1, sticky="w", pady=pady)
        return widget

    def _lslide(self, g, r, text, key, lo, hi, res):
        self._lrow(g, r, text, Slider(g, self.subv2[key], lo, hi, res, length=110, show_value=True, bg=PANEL), 1)

    def _lcolor(self, g, r, text, key):
        var = self.subv2[key]
        fr = tk.Frame(g, bg=PANEL)
        ring = tk.Frame(fr, bg=PANEL2, padx=2, pady=2)
        ring.pack(side="left")
        sw = tk.Label(ring, width=3, bg=var.get() if self.app._ok_hex(var.get()) else "#ffffff", cursor="hand2")
        sw._no_theme = True
        sw.pack()
        sw.bind("<Button-1>", lambda e: self._pick_color(key))
        self._swatches[key] = sw
        mkentry(fr, var, 8).pack(side="left", padx=6, ipady=2)
        mkbtn(fr, "Pick…", lambda: self._pick_color(key), "ghost", pady=2, padx=8).pack(side="left")
        var.trace_add("write", lambda *a: self._paint_sw(key))
        self._lrow(g, r, text, fr)

    def _paint_sw(self, key):
        sw, v = self._swatches.get(key), self.subv2[key].get().strip()
        if sw is not None and self.app._ok_hex(v):
            try:
                sw.configure(bg=v)
            except tk.TclError:
                pass

    def _pick_color(self, key):
        cur = self.subv2[key].get().strip()
        res = colorchooser.askcolor(color=cur if self.app._ok_hex(cur) else "#ffffff", parent=self.app, title="Color")
        if res and res[1]:
            self.subv2[key].set(res[1].upper())

