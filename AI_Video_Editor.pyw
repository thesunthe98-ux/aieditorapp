        kw.pop("relief", None)
        kw.pop("bd", None)
        self._cmd = command
        bg = kw.get("bg", "#262932")
        kw.setdefault("disabledforeground", DISABLED)
        super().__init__(parent, text=text, relief="flat", bd=0, anchor="center", **kw)
        self._base_bg = bg
        self.bind("<Button-1>", self._click)

    def _click(self, _e=None):
