    return fr


class Segmented(tk.Frame):
    """Pill-style single choice bound to a variable."""

    def __init__(self, parent, variable, options, bg=None, idle=None, padx=14, pady=6, size=10):
        super().__init__(parent, bg=bg or parent["bg"])
        self.var, self._idle_tok, self._items = variable, idle, []
        for val, text in options:
            lb = tk.Label(self, text=text, font=(FONT, size, "bold"), padx=padx, pady=pady, cursor="hand2")
            lb.pack(side="left", padx=(0, 5))
            lb.bind("<Button-1>", lambda e, v=val: self._pick(v))
            lb.bind("<Enter>", lambda e, w=lb: self._hover(w, True), add="+")
            lb.bind("<Leave>", lambda e, w=lb: self._hover(w, False), add="+")
            self._items.append((val, lb))
        self._trace = variable.trace_add("write", lambda *a: self._paint())
        self.bind("<Destroy>", self._destroyed, add="+")
        self._paint()

    def _destroyed(self, e):
        if e.widget is self:
            try:
                self.var.trace_remove("write", self._trace)
            except Exception:
                pass

    def _pick(self, v):
        self.var.set(int(v) if isinstance(self.var, tk.IntVar) else str(v))

    def _sel(self, val):
        try:
            return str(self.var.get()) == str(val)
        except Exception:
            return False

    def _colors(self, val):
        if self._sel(val):
            return ACCENT, ACCENT_FG
        return (self._idle_tok or PANEL2), MUTED

    def _hover(self, w, inside):
        val = next((v for v, lb in self._items if lb is w), None)
        if val is None or self._sel(val):
            return
        bg, fg = self._colors(val)
        try:
            fade_to(w, {"bg": GHOST_HOV if inside else bg, "fg": FG if inside else fg}, 120)
        except tk.TclError:
            pass

    def _paint(self):
        for val, lb in self._items:
            bg, fg = self._colors(val)
            try:
                tween_cancel(lb, "fade")
                lb.configure(bg=bg, fg=fg)
            except tk.TclError:
                pass

    def _retheme(self):
        self._idle_tok = None if self._idle_tok is None else PANEL
        self._paint()


