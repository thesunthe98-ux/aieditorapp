    @staticmethod
    def av_geometry(size_pct, px, py, W, H, vw, vh, even=True, free=False):
        """Same maths as the engine: avatar w/h and top-left corner inside a WxH frame.
        px/py = position inside the free space (100,100 = bottom-right corner).
        free=True lets the avatar go outside the frame (-100..200)."""
        size_pct = min(100.0, max(5.0, size_pct))
        aw = W * size_pct / 100.0
        ah = aw * vh / float(vw)
        if even:
            aw = max(2, int(round(aw / 2.0)) * 2)
            ah = max(2, int(round(aw * vh / float(vw) / 2.0)) * 2)
            if ah > H and not free:
                ah = max(2, (int(H) // 2) * 2)
                aw = max(2, int(round(ah * vw / float(vh) / 2.0)) * 2)
        elif ah > H and not free:
            ah = float(H)
            aw = ah * vw / float(vh)
        if free:
            px, py = min(200.0, max(-100.0, px)), min(200.0, max(-100.0, py))
            ux, uy = max(W - aw, 0.25 * W), max(H - ah, 0.25 * H)
        else:
            px, py = min(100.0, max(0.0, px)), min(100.0, max(0.0, py))
            ux, uy = W - aw, H - ah
        return aw, ah, int(round(ux * px / 100.0)), int(round(uy * py / 100.0))

