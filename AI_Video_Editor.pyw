                        self.voice_path = vp
                        self.voice_dur = media_duration(vp) or 0.0
                    tk_ = data.get("trans", "")
                    self.trans_key = tk_ if any(n == tk_ for n, _x, _m in T2_TRANSITIONS) else ""
                    try:
                        self.toff.set(max(-2.0, min(2.0, float(st.get("toff", 0.0)))))
                    except (TypeError, ValueError, tk.TclError):
                        self.toff.set(0.0)
                    if data.get("rp") in ("subs", "trans", "set"):
                        self.rp_tab.set(data["rp"])
                    for d in (data.get("ovs") or []):
                        nm, p = d.get("name", ""), d.get("p", "")
                        if not (p and os.path.isfile(p)):
