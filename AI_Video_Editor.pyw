ANIM_LIMIT_RE = re.compile(
    r"(reached (your|the|our) (usage |message |daily )?limit|usage limit|limit (will )?reset|"
    r"free usage returns|out of free messages|"
    r"you.?ve hit your|out of messages|too many messages)", re.I)
