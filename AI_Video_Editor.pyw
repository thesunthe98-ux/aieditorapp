# ───────── Light-leak overlay videos (black background) -> transition templates ─────────
# Put overlay clips (mp4/mov/webm/mkv, black background) in:  Documents/AI Video Editor/Light Leaks
# Each file becomes a template: hard cut (at the middle of the leak) underneath + the overlay `screen`-blended on top.
LEAK_DIR = os.path.join(WORKSPACE, "Light Leaks")
LEAK_BUILTIN_DIR = os.path.join(TOOLS, "light_leaks_builtin")
_LK_DUR = {}
_LK_TRIM = {}      # leak file path -> (start_sec, end_sec) of the part of the overlay that is used


def _lk_unpack_builtin():
    """Writes the built-in overlay clips to disk (once) so ffmpeg can read them."""
    try:
        os.makedirs(LEAK_BUILTIN_DIR, exist_ok=True)
    except OSError:
        return
    for fn, (size, b64) in _LK_BUILTIN.items():
        p = os.path.join(LEAK_BUILTIN_DIR, fn)
        try:
            if os.path.isfile(p) and os.path.getsize(p) == size:
                continue
            with open(p, "wb") as fh:
                fh.write(base64.b64decode("".join(b64.split())))
        except Exception:
            pass


def _lk_dirs():
    ds = [LEAK_BUILTIN_DIR, LEAK_DIR]
    try:
        if APP_PATH:
            ds.append(os.path.join(os.path.dirname(APP_PATH), "Light Leaks"))
    except Exception:
        pass
    return ds


def _lk_probe(path):
    try:
        r = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of",
                            "default=nw=1:nk=1", path], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           creationflags=NOWIN, timeout=20)
        v = float(r.stdout.decode("utf-8", "ignore").strip().split()[0])
        return v if v > 0.05 else 1.5
    except Exception:
        return 1.5


def _lk_list():
    """[(name, 'LK:<path>', duration multiplier)] for every overlay clip found in the Light Leaks folder(s)."""
    out = []
    try:
        os.makedirs(LEAK_DIR, exist_ok=True)
    except OSError:
        pass
    _lk_unpack_builtin()
    try:
        add_ffmpeg_path()
    except Exception:
        pass
    seen, names = set(), set()
    for d in _lk_dirs():
        try:
            files = sorted(os.listdir(d), key=lambda s: s.lower())
        except OSError:
            continue
        for fn in files:
            p = os.path.abspath(os.path.join(d, fn))
            if os.path.splitext(fn)[1].lower() not in VIDEO_EXTS or p in seen or not os.path.isfile(p):
                continue
            seen.add(p)
            stem = os.path.splitext(fn)[0].strip()
            nm = stem[:18] or "Leak"
            base, n = nm, 2
            while nm in names:
                nm, n = f"{base[:15]} {n}", n + 1
            names.add(nm)
            dur = _lk_probe(p)
            _LK_DUR[p] = dur
            out.append((nm, "LK:" + p, max(0.6, min(3.2, dur)) / 0.7))
    return out


def _lk_len(p):
    od = _LK_DUR.get(p)
    if not od:
        od = _lk_probe(p)
        _LK_DUR[p] = od
    return od


def _lk_trim_of(p):
    """(start, end, trimmed?) of the overlay clip `p` after the user's trim (whole clip when not trimmed)."""
    od = _lk_len(p)
    t = _LK_TRIM.get(p)
    if not t:
        return 0.0, od, False
    t0 = max(0.0, min(float(t[0]), od - 0.1))
    t1 = max(t0 + 0.1, min(float(t[1]), od))
    if t0 <= 0.01 and t1 >= od - 0.01:
        return 0.0, od, False
    return t0, t1, True


def t2_xf(x, D, off, W, H, F, cut_at=None):
    """Filter text that goes right after `[a][b]` — plain xfade, or (for 'LK:<file>') crossfade + overlay video screen-blended."""
    if not (isinstance(x, str) and x.startswith("LK:")):
        return f"xfade=transition={x}:duration={D:.3f}:offset={off:g}"
    p = x[3:]
    W, H = max(16, int(W)), max(16, int(H))
    t0, t1, trimmed = _lk_trim_of(p)
    od = (t1 - t0) if trimmed else _lk_len(p)
    cut = f",trim=start={t0:.3f}:end={t1:.3f},setpts=PTS-STARTPTS" if trimmed else ""
    pe = p.replace("\\", "/").replace(":", "\\:").replace("'", "\\'\\''")
    pad = f",tpad=start_duration={off:.3f}:color=black" if off > 0 else ""
    # light leak: A -> B switches exactly at the real cut (cut_at = seconds from window start); default = middle
    thr = 0.5 if cut_at is None else max(0.0, min(1.0, float(cut_at) / max(0.001, float(D))))
    return (f"xfade=transition=custom:expr='if(gt(P,{thr:.4f}),B,A)':duration={D:.3f}:offset={off:g}[xo];[xo]format=gbrp[xg];"
            f"movie='{pe}',setpts=PTS-STARTPTS{cut},setpts=PTS*{D / od:.5f},fps={F},"
            f"scale={W}:{H}:force_original_aspect_ratio=increase,crop={W}:{H}{pad},format=gbrp[lk];"
            f"[xg][lk]blend=all_mode=screen:eof_action=pass")


