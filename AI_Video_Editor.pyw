    def _exp_done(self, out=None, err=None):
        self._exp_ui(False)
        self._exp_dlg_close()
        if out:
            self.app.note("Export shesh \u2713  " + out, OK, 12)
            self._exp_done_dialog(out)
        elif err:
            self.app.note("Export: " + str(err), WARN, 12)
            if "stop kora" not in str(err):
                messagebox.showwarning("Export", str(err), parent=self.app)

    def _t2_sub_base(self, total):
        """Preview er moto-i subtitle source: SRT / script (timeline length e bhag kore). [(start, end, text)]."""
        proj = self.app.proj
        srt, script = [], []
        try:
            if proj and os.path.isdir(proj):
                sp = self.app.srt_path()
                if sp:
                    srt = t2_parse_srt(read_text(sp))
                script = sentences_of(os.path.join(proj, "script.txt"))
        except Exception:
            pass
        src = self.subv2["SUB_SOURCE"].get().strip().lower()
        use_srt = False if src == "script" else (True if src == "srt" else bool(srt))
        if use_srt:
            return list(srt)
        if script and total > 0.1:
            step = total / float(len(script))
            return [(i * step, (i + 1) * step, t) for i, t in enumerate(script)]
        return []

    def export_video(self):
        if self._exp_busy:
            self._exp_stop.set()
            self.app.note("Export stop hochhe\u2026", WARN)
            return
        if not self.slots or not any(sl.get("path") for sl in self.slots):
            messagebox.showwarning("Export", "Timeline e kono clip nei.", parent=self.app)
            return
        add_ffmpeg_path()
        if not shutil.which("ffmpeg"):
            messagebox.showerror("Export", "ffmpeg pawa jayni \u2014 Export tab e 'Install FFmpeg' chap.", parent=self.app)
            return
        if self._analysis_pending():
            self.app.note("Audio analyse hochhe (Cut clips / Auto volume) — ektu por abar Export chap.", WARN)
            return
        proj = self.app.proj or self._proj
        if not proj:
            messagebox.showwarning("Export", "Age project select koro.", parent=self.app)
            return
        self._pause()
        folder = self.exp_dir_var.get().strip().strip('"') or proj
        name = re.sub(r'[<>:"/\\|?*\x00-\x1f]', "_", self.exp_name_var.get().strip()).strip(" .") or "tab2_export"
        if name.lower().endswith(".mp4"):
            name = name[:-4]
        try:
            os.makedirs(folder, exist_ok=True)
        except OSError as e:
            messagebox.showerror("Export", "Folder toiri kora gelo na:\n%s\n\n%s" % (folder, e), parent=self.app)
            return
        out = os.path.join(folder, name + ".mp4")
        if os.path.exists(out) and not messagebox.askyesno(
                "Export", "Ei file ta already ache:\n%s\n\nReplace korbo?" % out, parent=self.app):
            return
        m = re.fullmatch(r"(\d+)x(\d+)", self.res_var.get().strip())
        W, H = (int(m.group(1)), int(m.group(2))) if m else (1920, 1080)
        W, H = max(16, W - W % 2), max(16, H - H % 2)
        items, cum = [], 0.0
        for i, s in enumerate(self.slots):                       # snapshot (Tk vars main thread e)
            d = self._dur(s)
            p = s.get("path")
            ok = bool(p and os.path.isfile(p))
            items.append({"path": p if ok else None, "img": bool(ok and self._is_img(p)), "dur": d, "t0": cum,
                          "tin": self._trim(s)[0] if ok else 0.0,
                          "gain": self._norm_gain(p) if ok else 1.0,
                          "tr": self._tr_for(i, 0.0) if ok else None})
            cum += d
        try:
            vol = max(0.1, min(4.0, float(self.vol_pct.get()) / 100.0))
        except (tk.TclError, ValueError):
            vol = 1.0
        cfg = {k: v.get().strip() for k, v in self.subv2.items()}
        cfg.update({"ENCODER": (self.enc_var.get() or "auto").strip(), "PRESET": self.preset_var.get().strip(),
                    "QUALITY": self.q_var.get().strip()})
        job = {"out": out, "W": W, "H": H, "items": items, "total": cum, "vol": vol, "cfg": cfg,
               "voice": self.voice_path if self._voice_active() else None,
               "mute": self.mute_var.get() == "1",
               "sub_base": self._t2_sub_base(cum) if cfg.get("SUB_ENABLED") == "1" else []}
        self._exp_stop.clear()
        self._exp_ui(True)
        self._exp_dlg_open(out)
        threading.Thread(target=self._exp_worker, args=(job,), daemon=True).start()

    def _exp_worker(self, job):
        tmp = tempfile.mkdtemp(prefix="ave_t2x_")
        try:
            ok, err = self._t2_export_run(job, tmp)
        except Exception as e:
            ok, err = False, str(e) or type(e).__name__
        shutil.rmtree(tmp, ignore_errors=True)
        self._pg_ctx = None
        if self._exp_stop.is_set():
            ok, err = False, "Export stop kora hoyeche."
            self._rm(job["out"])
        out = job["out"]
        self.after(0, lambda: self._exp_done(out if ok else None, err))

    def _t2_engine(self):
        """Embedded make_video.py engine ke module hishebe load (write_ass / subtitle events / encoder choice reuse)."""
        eng = getattr(self, "_t2_eng", None)
        if eng is not None:
            return eng
        import importlib.util
        path = os.path.join(tempfile.gettempdir(), "ave_t2_engine_%d.py" % os.getpid())
        with open(path, "wb") as fh:
            fh.write(_unpack(_ENGINE_B64))
        spec = importlib.util.spec_from_file_location("ave_t2_engine", path)
        eng = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(eng)
        eng.subprocess = _QuietSub(subprocess)          # ffmpeg console window flash hobe na
        self._t2_eng = eng
        return eng

    def _run_ff(self, cmd, cwd=None):
        """ffmpeg chalao; Stop (self._exp_stop) dile kill. Returns (returncode, stderr tail).
        Export cholar shomoy (self._pg_ctx = (base%, span%, seconds)) real progress % pathay."""
        ctx = getattr(self, "_pg_ctx", None)
        prog = bool(ctx and ctx[2] > 0 and cmd and str(cmd[0]).lower().startswith("ffmpeg"))
        if prog:
            cmd = [cmd[0], "-progress", "pipe:1", "-nostats"] + list(cmd[1:])
        errf = tempfile.TemporaryFile()
        try:
            p = subprocess.Popen(cmd, stdout=subprocess.PIPE if prog else subprocess.DEVNULL, stderr=errf,
                                 creationflags=NOWIN, cwd=cwd)
            if prog:
                def rd(pp=p, c=ctx):
                    try:
                        for ln in pp.stdout:
                            if ln.startswith(b"out_time_us=") or ln.startswith(b"out_time_ms="):
                                try:
                                    us = int(ln.split(b"=", 1)[1])
                                except ValueError:
                                    continue
                                if us >= 0:
                                    self._exp_prog(c[0] + c[1] * min(1.0, us / 1e6 / c[2]))
                    except Exception:
                        pass
                threading.Thread(target=rd, daemon=True).start()
            while p.poll() is None:
                if self._exp_stop.is_set():
                    p.kill()
                    p.wait()
                    return -1, "stopped"
                time.sleep(0.15)
            errf.seek(0)
            return p.returncode, errf.read().decode("utf-8", "replace")[-400:]
        finally:
            errf.close()

    def _t2_make_seg(self, it, nf, W, H, seg, venc):
        """Ekta slot er video segment (nf frame). Transition thakle slot er shuru te prev-clip er last frame theke xfade
        (preview er moto), clip chhoto hole last frame hold."""
        F = self.FPS
        hd = ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error"]
        tail = ["-an", "-r", str(F)] + venc + ["-pix_fmt", "yuv420p", "-frames:v", str(nf), seg]
        vf = self._vf(W, H)
        p, img, dur, tr = it["path"], it["img"], it["dur"], it.get("tr")
        tin = float(it.get("tin") or 0.0)
        ss = ["-ss", f"{tin:.3f}"] if (tin > 0 and not img) else []
        pad = f"tpad=stop_mode=clone:stop_duration={dur + 2:.3f}"
        cmds = []
        if p and tr:
            lp = self._last_frame(tr["prev"], tr["prev_img"], tr["prev_dur"])
            if lp:
                D = tr["D"]
                for x in ([tr["x"], "fade"] if tr["x"] != "fade" else ["fade"]):
                    b_in = (["-loop", "1", "-framerate", str(F)] if img else ss) + ["-i", p]
                    bchain = f"[1:v]fps={F},{vf}" + ("" if img else "," + pad) + ",format=yuv420p[b]"
                    fc = (f"[0:v]fps={F},{vf},format=yuv420p[a];{bchain};"
                          f"[a][b]xfade=transition={x}:duration={D:.3f}:offset=0[o]")
                    cmds.append(hd + ["-loop", "1", "-framerate", str(F), "-t", f"{D:.3f}", "-i", lp] + b_in
                                + ["-filter_complex", fc, "-map", "[o]"] + tail)
        if not p:
            cmds.append(hd + ["-f", "lavfi", "-i", f"color=c=black:s={W}x{H}:r={F}"] + tail)
        elif img:
            cmds.append(hd + ["-loop", "1", "-framerate", str(F), "-i", p, "-vf", vf] + tail)
        else:
            cmds.append(hd + ss + ["-i", p, "-vf", f"fps={F},{vf},{pad}"] + tail)
        err = ""
        for c in cmds:
            rc, err = self._run_ff(c)
            if self._exp_stop.is_set():
                return False, "stopped"
            if rc == 0 and os.path.isfile(seg) and os.path.getsize(seg) > 0:
                return True, ""
        return False, err

    def _t2_export_run(self, job, tmp):
        F = self.FPS
        W, H, out, items, total, cfg = job["W"], job["H"], job["out"], job["items"], job["total"], job["cfg"]
        eng, venc = None, ["-c:v", "libx264", "-preset", "veryfast", "-crf", "20", "-bf", "0"]
        try:
            eng = self._t2_engine()
            self._exp_say("Encoder check hochhe\u2026")
            eng.setup_encoder(cfg)
            venc = list(eng.VENC)
        except Exception:
            pass
        # 1) per-slot segments (frame count cumulative round kore \u2014 drift hoy na)
        segs, cum_f = [], 0
        tot = max(0.001, sum(i["dur"] for i in items))
        for k, it in enumerate(items):
            self._pg_ctx = (75.0 * it["t0"] / tot, 75.0 * it["dur"] / tot, max(0.05, it["dur"]))
            end_f = int(round((it["t0"] + it["dur"]) * F))
            nf = max(1, end_f - cum_f)
            cum_f = end_f
            seg = os.path.join(tmp, f"seg{k:04d}.mp4")
            self._exp_say(f"clip {k + 1}/{len(items)} render hochhe\u2026")
            ok, err = self._t2_make_seg(it, nf, W, H, seg, venc)
            if not ok:
                return False, ("Export stop kora hoyeche." if err == "stopped" else f"Clip {k + 1} render fail: {err}")
            segs.append(seg)
        # 2) join
        lst = os.path.join(tmp, "list.txt")
        with open(lst, "w", encoding="utf-8") as fh:
            for s in segs:
                fh.write("file '%s'\n" % s.replace("\\", "/").replace("'", "'\\''"))
        vid = os.path.join(tmp, "video.mp4")
        self._pg_ctx = None
        self._exp_prog(76)
        self._exp_say("clips join hochhe\u2026")
        rc, err = self._run_ff(["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", "-f", "concat", "-safe", "0",
                                "-i", lst, "-c", "copy", vid])
        if rc != 0 or not os.path.isfile(vid):
            return False, "Join fail: " + err
        # 3) audio: voice track thakle clips mute (shudhu voice, vol_pct); na thakle clips er original sound
        #    (mute_var=1 hole sob mute, na hole vol_pct clip volume). Video length e pad/trim.
        vol = job["vol"]
        vaf = f"volume={vol:.3f}" + (",alimiter=limit=0.98" if vol > 1.001 else "")
        pt = f"apad=whole_dur={total:.3f},atrim=0:{total:.3f}"
        a_in, af, aud_src = [], None, None
        voice = job["voice"]
        if voice and os.path.isfile(voice):
            a_in, af, aud_src = ["-i", voice], vaf + "," + pt, voice
        elif not job["mute"] and any(it["path"] and not it["img"] for it in items):
            self._exp_prog(80)
            self._exp_say("clips er sound merge hochhe\u2026")
            merged = os.path.join(tmp, "clips_audio.mp3")
            ok, err = self._t2_build_merged_audio(items, merged)
            if ok:
                a_in, af, aud_src = ["-i", merged], vaf + "," + pt, merged
        if not a_in:                                         # silent track
            a_in, af = ["-f", "lavfi", "-i", "anullsrc=r=44100:cl=stereo"], None
        # 4) subtitles (engine write_ass \u2014 Tab 2 er nijosso style)
        ass = None
        if job["sub_base"] and eng is not None:
            try:
                cfgd = dict(cfg)
                cfgd["SUB_SOURCE"] = "srt"
                try:
                    events = eng.build_subtitle_events(cfgd, [], [], job["sub_base"], aud_src)
                except Exception:
                    cfgd["SUB_TIMING"] = "simple"
                    events = eng.build_subtitle_events(cfgd, [], [], job["sub_base"], None)
                if events:
                    ass = os.path.join(tmp, "subs.ass")
                    eng.write_ass(ass, events, cfgd, W, H)
            except Exception:
                ass = None
        # 5) final mux
        base = ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", "-i", vid] + a_in + ["-map", "0:v:0", "-map", "1:a:0"]
        aenc = ["-c:a", "aac", "-b:a", "192k"] + (["-af", af] if af else []) + ["-t", f"{total:.3f}"]
        outp = os.path.abspath(out)
        self._rm(outp)
        self._exp_prog(85)
        self._pg_ctx = (85.0, 14.0, max(0.05, total))
        if ass:
            self._exp_say("subtitle burn + audio mux hochhe\u2026")
            rc, err = self._run_ff(base + ["-vf", "ass=subs.ass"] + venc + ["-pix_fmt", "yuv420p"] + aenc + [outp],
                                   cwd=tmp)
            if self._exp_stop.is_set():
                return False, "stopped"
            if rc != 0 or not os.path.isfile(outp):
                self._exp_say("Subtitle burn fail \u2014 subtitle chhara export korchhi")
                ass = None
        if not ass:
            self._exp_say("audio mux hochhe\u2026")
            rc, err = self._run_ff(base + ["-c:v", "copy"] + aenc + [outp])
            if rc != 0 or not os.path.isfile(outp):
                return False, "Mux fail: " + err
        self._pg_ctx = None
        self._exp_prog(100)
        return True, ""

    def _voice_start(self, t):
        if not self._voice_active():
            return
        gen = self._gen
        vol = self._vol
        path = self.voice_path

        def work():
            wav = self._wav_path(gen, "v")
            t0 = time.perf_counter()
            try:
                r = subprocess.run(["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", "-ss", f"{t:.3f}", "-i", path,
                                    "-vn", "-ac", "1", "-ar", "32000", "-af", f"volume={vol:.2f}", "-c:a", "pcm_s16le", wav],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, creationflags=NOWIN, timeout=180)
                ok = r.returncode == 0 and os.path.exists(wav) and os.path.getsize(wav) > 200
            except Exception:
                ok = False
            if gen != self._gen or not ok:
                self._rm(wav)
                return
            self._q.put(("voiceplay", gen, wav))
        threading.Thread(target=work, daemon=True).start()

    def _voice_play_now(self, gen, wav):
        if gen != self._gen or not self._playing:
            self._rm(wav)
            return
        old = self._cur_wav
        try:
            if os.name == "nt":
                import winsound
                winsound.PlaySound(wav, winsound.SND_FILENAME | winsound.SND_ASYNC)
            else:
                exe = shutil.which("afplay") or shutil.which("paplay") or shutil.which("aplay")
                if exe:
                    cmd = [exe, "-q", wav] if exe.endswith("aplay") else [exe, wav]
                    self._aproc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        self._cur_wav = wav
        if old and old != wav:
            self._rm(old)

    # audio
    def _audio_start(self, wav):
        if self._voice_active():          # voice track owns the speaker; clip audio is muted
            return
        old = self._cur_wav
        try:
            if os.name == "nt":
                import winsound
                if wav:
                    winsound.PlaySound(wav, winsound.SND_FILENAME | winsound.SND_ASYNC)
                else:
                    winsound.PlaySound(None, winsound.SND_PURGE)
            else:
                if self._aproc is not None and self._aproc.poll() is None:
                    self._aproc.terminate()
                self._aproc = None
                exe = shutil.which("afplay") or shutil.which("paplay") or shutil.which("aplay")
                if wav and exe:
                    cmd = [exe, "-q", wav] if exe.endswith("aplay") else [exe, wav]
                    self._aproc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass
        self._cur_wav = wav
        if old and old != wav:
            self._rm(old)

    def _audio_stop(self):
        try:
            if os.name == "nt":
                import winsound
                winsound.PlaySound(None, winsound.SND_PURGE)
            elif self._aproc is not None and self._aproc.poll() is None:
                self._aproc.terminate()
        except Exception:
            pass
        self._aproc = None
        self._rm(self._cur_wav)
        self._cur_wav = None

    # ───────── main-thread pump ─────────
    def _tick(self):
        try:
            self._step()
        except Exception:
            pass
        try:
            self.after(15 if self._playing else 60, self._tick)
        except tk.TclError:
            pass

    def _step(self):
        while True:
            try:
                m = self._q.get_nowait()
            except queue.Empty:
                break
            k = m[0]
            if k == "still":
                if m[1] == self._seek_id and not self._playing:
                    self._draw_frame(m[2])
            elif k == "dur":
                _, uid, path, dur = m
                s = self._slot_by_id(uid)
                if s and s["path"] == path:
                    if dur:
                        s["dur"] = round(float(dur), 3)
                    else:
                        s["dur"] = self.IMG_SEC
                        if not self._ff_warned:
                            self._ff_warned = True
                            self.app.note("Duration porte FFmpeg/ffprobe lagbe — Export tab e 'Install FFmpeg' chap.", WARN, 12)
                    self._changed(reseek=False)
            elif k == "thumb":
                _, uid, path, png = m
                s = self._slot_by_id(uid)
                if s and s["path"] == path:
                    s["thumbs"] = png if isinstance(png, dict) else {96: png}
                    s["thumb"] = s["thumbs"].get(96) or next(iter(s["thumbs"].values()))
                    self._draw_soon()
            elif k == "wave":
                if self._cut_margin() is not None:
                    self._cut_refresh_soon(250)
                else:
                    self._draw_soon()
            elif k == "tile":
                self._tile_ready(m[1], m[2])
            elif k == "voiceplay":
                self._voice_play_now(m[1], m[2])
            elif k == "noxf":
                if not getattr(self, "_xf_warned", False):
                    self._xf_warned = True
                    self.app.note("Transition preview e FFmpeg 4.3+ (xfade) lage — Export tab e 'Install FFmpeg' diye update koro.", WARN, 12)
            elif k == "noff":
                if not self._ff_warned:
                    self._ff_warned = True
                    self.app.note("Preview dekhate FFmpeg lagbe — Export tab e 'Install FFmpeg' chap.", WARN, 12)
        if self.app.proj and self.app.proj != self._proj and getattr(self.app, "active_tab", 1) == 2:
            self.load()
        if not self._playing:
            return
        now = time.perf_counter()
        dt, self._last = now - self._last, now
        with self._lock:
            has = bool(self._dq)
        if has or self._worker_done:
            self._tl += dt
        frame = None
        while True:
            with self._lock:
                if not self._dq:
                    break
                g, kind, t, a, b = self._dq[0]
                if g != self._gen:
                    self._dq.popleft()
                    continue
                if t > self._tl + 0.0005:
                    break
                self._dq.popleft()
            if kind == "seg":
                self._audio_start(b)
            else:
                frame = a
        if frame is not None:
            self._draw_frame(frame)
        self._set_time(self._tl)
        self._follow()
        with self._lock:
            empty = not self._dq
        if (self._worker_done and empty and self._tl >= self._total - 0.02) or self._tl > self._total + 3:
            self._finish()

    # ───────── background workers ─────────
    def _probe_worker(self):
        while True:
            uid, path = self._probe_q.get()
            dur = None
            try:
                info = probe_video_info(path)
                dur = info["dur"] if info else None
                if not dur:
                    dur = media_duration(path)
            except Exception:
                pass
            self._q.put(("dur", uid, path, dur))

    THUMB_W = (144, 96, 64, 40, 24)          # sizes; timeline picks the biggest that fits the block width

    def _thumb_worker(self):
        while True:
            uid, path = self._thumb_q.get()
            try:
                add_ffmpeg_path()
                st = os.stat(path)
                d = os.path.join(TOOLS, "_t2thumbs")
                os.makedirs(d, exist_ok=True)
                base = hashlib.md5(f"{path}{st.st_mtime}{st.st_size}".encode()).hexdigest()[:16]
                got = {}
                for w in self.THUMB_W:
                    out = os.path.join(d, "%s_w%d.png" % (base, w))
                    good = False
                    try:
                        with open(out, "rb") as fh:                  # cached file valid PNG?
                            good = fh.read(8) == b"\x89PNG\r\n\x1a\n" and os.path.getsize(out) > 60
                    except OSError:
                        good = False
                    if not good:
                        try:
                            os.remove(out)
                        except OSError:
                            pass
                        good = self._make_thumb(path, out, w)
                    if good:
                        got[w] = out
                if got:
                    self._q.put(("thumb", uid, path, got))
                else:
                    self._thumb_req.discard(path)                    # allow a later retry
            except Exception:
                self._thumb_req.discard(path)

    @staticmethod
    def _make_thumb(path, out, w=96):
        h = max(2, int(round(w * 54 / 96.0)))
        vf = ("scale=%d:%d:force_original_aspect_ratio=decrease,"
              "pad=%d:%d:(ow-iw)/2:(oh-ih)/2:color=0x0d0e12" % (w, h, w, h))
        vid = os.path.splitext(path)[1].lower() in VIDEO_EXTS
        for pre in ([["-ss", "0.5"]] if vid else []) + [[]]:
            cmd = ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", *pre, "-i", path,
                   "-an", "-sn", "-vf", vf, "-frames:v", "1", "-update", "1", out]
            try:
                subprocess.run(cmd, creationflags=NOWIN, timeout=30, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
            if os.path.exists(out) and os.path.getsize(out) > 0:
                return True
            try:
                os.remove(out)
            except OSError:
                pass
        return False

    # ───────── save / load (project/tab2.json) ─────────
    def _file(self):
        return os.path.join(self._proj, "tab2.json") if self._proj else None

    def _save_soon(self):
        if self._save_job:
            self.after_cancel(self._save_job)
        self._save_job = self.after(500, self.save)

    def save(self):
        self._save_job = None
        f = self._file()
        if not f or not os.path.isdir(self._proj):
            return
        if not self.slots and not os.path.exists(f) and not self._cfg_dirty:
            return
        try:
            data = {"v": 2, "aspect": self.aspect_var.get(), "pps": self.pps,
                    "slots": [{"path": s["path"], "label": s["label"], "dur": s["dur"]} for s in self.slots],
                    "sub": {k: v.get() for k, v in self.subv2.items()},
                    "set": {"res": self.res_var.get(), "vol": self._int(self.vol_pct, 100),
                            "tspd": self._int(self.tspd, 10), "enc": self.enc_var.get(),
                            "preset": self.preset_var.get(), "q": self.q_var.get()},
                    "trans": self.trans_key, "rp": self.rp_tab.get(),
                    "mute": self.mute_var.get(), "voice": self.voice_path or "",
                    "cut": {"on": self.cut_on.get(), "val": self.cut_val.get(), "unit": self.cut_unit.get()},
                    "norm": self.norm_on.get(),
                    "voice_name": self.voice_name_var.get().strip(),
                    "exp_dir": self.exp_dir_var.get().strip(),
                    "exp_name": self.exp_name_var.get().strip(),
                    "tab2_active_account": getattr(self, "_tab2_account", "")}
            atomic_write(f, json.dumps(data, ensure_ascii=False, indent=1))
        except Exception:
            pass

    @staticmethod
    def _int(var, d):
        try:
            return int(var.get())
        except (tk.TclError, ValueError):
            return d

    def load(self):
        """(Re)load the timeline of the current project."""
        self._pause()
        if self._proj and self._save_job:
            self.after_cancel(self._save_job)
            self.save()
        self._proj = self.app.proj
        self.slots, self.sel, self.cur_t = [], None, 0.0
        self._undo.clear()
        self._redo.clear()
        self._undo_refresh()
        self._loading = True
        try:
            for k, v in self.subv2.items():                     # defaults first (project may have nothing saved)
                v.set(self.app.SUB_DEFAULTS[k])
            self.aspect_var.set("16:9")
            self.res_var.set(self.RES_LIST["16:9"][1])
            self.vol_pct.set(100)
            self.tspd.set(10)
            self.enc_var.set("auto")
            self.preset_var.set("")
            self.q_var.set("")
            self.trans_key = ""
            self.mute_var.set("0")
            self.cut_on.set("0")
            self.cut_val.set("1")
            self.cut_unit.set("seconds")
            self.norm_on.set("0")
            self.voice_name_var.set("")
            self._tab2_account = ""
            self.voice_path, self.voice_dur = None, 0.0
            self._cfg_dirty = False
            f = self._file()
            try:
                if f and os.path.exists(f):
                    with open(f, encoding="utf-8") as fh:
                        data = json.load(fh)
                    if data.get("aspect") in self.ASPECTS:
                        self.aspect_var.set(data["aspect"])
                    self.pps = float(data.get("pps", self.pps))
                    for k, v in (data.get("sub") or {}).items():
                        if k in self.subv2:
                            self.subv2[k].set(str(v))
                    st = data.get("set") or {}
                    self.res_var.set(st.get("res") or self.RES_LIST.get(self.aspect_var.get(), ["", "1920x1080"])[1])
                    self.vol_pct.set(int(st.get("vol", 100)))
                    self.tspd.set(int(st.get("tspd", 10)))
                    self.enc_var.set(st.get("enc", "auto") or "auto")
                    self.preset_var.set(st.get("preset", ""))
                    self.q_var.set(st.get("q", ""))
                    self.mute_var.set("1" if data.get("mute") == "1" else "0")
                    ct = data.get("cut") or {}
                    self.cut_on.set("1" if ct.get("on") == "1" else "0")
                    self.cut_val.set(str(ct.get("val", "1")))
                    self.cut_unit.set("milliseconds" if str(ct.get("unit", "")).startswith("milli") else "seconds")
                    self.norm_on.set("1" if data.get("norm") == "1" else "0")
                    self.voice_name_var.set(data.get("voice_name", "") or "")
                    self.exp_dir_var.set(data.get("exp_dir", "") or "")
                    self.exp_name_var.set(data.get("exp_name", "") or "tab2_export")
                    self._tab2_account = data.get("tab2_active_account", "") or ""
                    vp = data.get("voice") or ""
                    if vp and os.path.isfile(vp):
                        self.voice_path = vp
                        self.voice_dur = media_duration(vp) or 0.0
                    tk_ = data.get("trans", "")
                    self.trans_key = tk_ if any(n == tk_ for n, _x, _m in T2_TRANSITIONS) else ""
                    if data.get("rp") in ("subs", "trans", "set"):
                        self.rp_tab.set(data["rp"])
                    for d in data.get("slots", []):
                        p = d.get("path")
                        if p and not os.path.isfile(p):
                            p = None
                        s = self._new_slot(p, d.get("label", ""), d.get("dur"))
                        self.slots.append(s)
                        if p:
                            if s["dur"]:
                                self._thumb_q.put((s["id"], p))
                            else:
                                self._queue_media(s)
            except Exception:
                pass
        finally:
            self._loading = False
        self._cut_widgets()
        try:
            self.res_cb2["values"] = self.RES_LIST.get(self.aspect_var.get(), [])
        except (AttributeError, tk.TclError):
            pass
        self._cues_ok = False
        self._sub_ver += 1
        self._sub_key = None
        self._tpl_mark()
        self._tr_mark()
        self._tr_update_lbl()
        self._changed()

    def activate(self):
        if self.app.proj != self._proj:
            self.load()
        self._cues_ok = False
        self.after(60, lambda: (self._draw(), self._pv_configure(), self._seek_still(self.cur_t), self._sub_redraw()))

    def deactivate(self):
        self._pause()
        self.save()

    def shutdown(self):
        self._pause()
        self.save()
        try:
            d = tempfile.gettempdir()
            for fn in os.listdir(d):
                if fn.startswith(f"ave_t2_{os.getpid()}_"):
                    self._rm(os.path.join(d, fn))
        except Exception:
            pass



