    # ---- avatar tab helpers ----

    def _av_fnum(self, key, default, lo=None, hi=None):
        try:
            x = float(self.avv[key].get())
        except Exception:
            x = float(default)
        if lo is not None:
            x = max(lo, x)
        if hi is not None:
            x = min(hi, x)
        return x

    def _av_free(self):
        return self.avv["AV_FREE"].get() == "1"

    def _av_pos_changed(self):
        """Keep X/Y inside 0..100 unless 'frame er bahire' is on, then redraw."""
        if not self._av_free():
            for k in ("AV_X", "AV_Y"):
                v = self._av_fnum(k, 100)
                if v < 0 or v > 100:
                    self.avv[k].set(self._fmt_num(max(0.0, min(100.0, v))))
                    return                       # the set() above triggers this again
        self._av_draw()

    def _av_avail(self):
        """Biggest preview that fits this window (controls keep ~380px on the right)."""
        try:
            fh = self.frames["avatar"].winfo_height()
        except Exception:
            fh = 1
        if fh < 200:
            return self.PV_MAX_W, self.PV_MAX_H
        return self.PV_MAX_W, max(180, min(self.PV_MAX_H, fh - 300))   # 100% base size; bigger = scale > 100

    def _av_scale_changed(self, *a):
        if self._av_scale_job:
            self.after_cancel(self._av_scale_job)
        self._av_scale_job = self.after(220, self._av_scale_apply)

    def _av_scale_apply(self):
        self._av_scale_job = None
        try:
            self.rec["av_preview"] = int(self._av_scale.get())
            save_recent(self.rec)
        except Exception:
            pass
        self._av_refresh()

    def _av_frame_resized(self, e=None):
        if self.cur != "avatar" or e is None or e.widget not in (self.frames["avatar"], self._av_left):
            return
        if self._av_resize_job:
            self.after_cancel(self._av_resize_job)
        self._av_resize_job = self.after(120, self._av_refresh)

    def _av_mode_note(self):
        try:
            m = int(self.mode.get())
            txt = {1: ("Normal — shudhu clips + voiceover, avatar export e jabe na.", MUTED),
                   2: ("Avatar windows — avatar full screen, bhage bhage (Pattern niche).", MUTED),
                   3: ("✓ Overlay — clips background e, avatar tar upor boshbe (bg remove).", OK)}[m]
            self.av_mode_note.configure(text=txt[0], fg=txt[1])
        except (tk.TclError, KeyError, ValueError):
            pass

    def _av_paint_swatch(self):
        v = self.avv["AV_KEY_COLOR"].get().strip()
        if self._av_swatch is not None and self._ok_hex(v):
            try:
                self._av_swatch.configure(bg=v)
            except tk.TclError:
                pass

    def _av_pick_dialog(self):
        cur = self.avv["AV_KEY_COLOR"].get().strip()
        res = colorchooser.askcolor(color=cur if self._ok_hex(cur) else "#ffffff", parent=self, title="Remove color")
        if res and res[1]:
            self.avv["AV_KEY_COLOR"].set(res[1].upper())

    def _av_set_pos(self, x, y):
        self.avv["AV_X"].set(x)
        self.avv["AV_Y"].set(y)

    def _av_reset_pos(self, e=None):
        self._av_set_pos(self.AV_DEFAULTS["AV_X"], self.AV_DEFAULTS["AV_Y"])

    def _av_toggle_pick(self):
        if not self._av_path:
            self.av_note.configure(text="Age avatar video import koro.")
            return
        self._av_pick = not self._av_pick
        self.av_eye.configure(text="✕ Cancel pick" if self._av_pick else "🎯 Eyedropper")
        self.av_cv.configure(cursor="crosshair" if self._av_pick else "fleur")
        self.av_note.configure(text="Avatar er background er upor click koro (original avatar dekhachhi)…"
                               if self._av_pick else "")
        self._av_draw()

    def _av_rect(self):
        """(img_w, img_h, x, y) of the avatar on the preview canvas."""
        cw, ch = self._av_size
        img = self._av_raw if self._av_pick else self._av_img
        vw, vh = self._av_dims or (16, 9)
        if img is not None:
            iw, ih = img.width(), img.height()
        else:
            iw, ih, _, _ = self.av_geometry(self._av_fnum("AV_SIZE", 35, 5, 100), 50, 50, cw, ch, vw, vh,
                                            even=False, free=self._av_free())
            iw, ih = int(iw), int(ih)
        ux, uy = self._av_units(iw, ih)
        x = int(round(ux * self._av_fnum("AV_X", 100, -100, 200) / 100.0))
        y = int(round(uy * self._av_fnum("AV_Y", 100, -100, 200) / 100.0))
        return iw, ih, x, y

    def _av_units(self, iw, ih):
        cw, ch = self._av_size
        if self._av_free():
            return max(cw - iw, 0.25 * cw), max(ch - ih, 0.25 * ch)
        return cw - iw, ch - ih

    def _av_refresh(self):
        """Called whenever the Avatar tab is opened (or the avatar / output ratio changed)."""
        if not hasattr(self, "av_cv"):
            return
        self._av_resize_job = None
        W, H = self._pv_out_dims()
        mw, mh = self._av_avail()
        sc = max(0.25, min(4.0, int(self._av_scale.get() or 100) / 100.0))
        k = min(mw * sc / float(W), mh * sc / float(H))
        cw, ch = max(120, int(W * k)), max(120, int(H * k))
        if (cw, ch) != self._av_size:
            self._av_key_sig = None
        self._av_out, self._av_size = (W, H), (cw, ch)
        self._pv_out, self._pv_size = (W, H), (cw, ch)
        self.av_cv.configure(width=cw, height=ch)
        self._av_make_room(cw)
        try:
            wl = max(200, min(520, self._av_left.winfo_width() - 36))
            for _w in (self.av_pos_lbl, self.cv_hint, self.pv_note, self.av_note):
                _w.configure(wraplength=wl)
        except (AttributeError, tk.TclError):
            pass
        self._av_ready = True
        p = self.avatar_path()
        if p != self._av_path:
            self._av_path = p
            self._av_dims, self._av_img, self._av_raw, self._av_key_sig = None, None, None, None
            self._av_pick = False
            self.av_eye.configure(text="🎯 Eyedropper")
        self._av_load_bg()
        self._av_draw()
        self._av_render_now()

    def _av_request(self, *a):
        if self._loading or not self._av_ready:
            return
        if self._av_job:
            self.after_cancel(self._av_job)
        self._av_job = self.after(100, self._av_render_now)

    def _av_render_now(self):
        """Make the preview picture of the avatar (raw + colour-removed) with the SAME ffmpeg filters
        the exporter uses, in a background thread."""
        self._av_job = None
        p = self._av_path
        if not p or not self._av_ready:
            return
        if self._av_busy:
            self._av_dirty = True
            return
        cw, ch = self._av_size
        size = self._av_fnum("AV_SIZE", 35, 5, 100)
        key_on = self.avv["AV_KEY_ON"].get() == "1"
        col = self.avv["AV_KEY_COLOR"].get().strip()
        col = col if self._ok_hex(col) else "#FFFFFF"
        sim = self._av_fnum("AV_KEY_SIM", 15, 1, 100) / 100.0
        bl = self._av_fnum("AV_KEY_BLEND", 5, 0, 100) / 100.0
        try:
            mt = os.path.getmtime(p)
        except OSError:
            return
        mirror = self.avv["AV_MIRROR"].get() == "1"
        ts = self._av_fnum("AV_TRIM_START", 0, 0, 100000)
        sig = (p, mt, cw, ch, size, key_on, col, round(sim, 3), round(bl, 3), mirror, round(ts, 2))
        if sig == self._av_key_sig and self._av_img is not None:
            return
        self._av_busy, self._av_dirty = True, False
        add_ffmpeg_path()
        known = self._av_dims

        def work():
            import tempfile
            try:
                vw, vh = known or (0, 0)
                if not vw:
                    out = subprocess.check_output(
                        ["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
                         "stream=width,height", "-of", "json", p],
                        stderr=subprocess.DEVNULL, creationflags=NOWIN, timeout=20)
                    st = json.loads(out)["streams"][0]
                    vw, vh = int(st["width"]), int(st["height"])
                aw, ah, _x, _y = self.av_geometry(size, 50, 50, cw, ch, vw, vh, even=True)
                tmp = tempfile.gettempdir()

                def good(fp):
                    return os.path.exists(fp) and os.path.getsize(fp) > 0

                # 1) decode ONE frame of the avatar video - only the first time (this was repeated on every slider move)
                src = os.path.join(tmp, "ave_avsrc_" + hashlib.md5(f"{p}|{mt}|{ts:.2f}".encode()).hexdigest()[:12] + ".png")
                if not good(src):
                    for ss in ([["-ss", f"{ts + 0.3:.2f}"]] + ([["-ss", f"{ts:.2f}"]] if ts > 0 else []) + [[]]):
                        subprocess.run(["ffmpeg", "-y", "-hide_banner", "-loglevel", "error"] + ss +
                                       ["-i", p, "-an", "-frames:v", "1", "-update", "1", src],
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                       creationflags=NOWIN, timeout=40)
                        if good(src):
                            break
                # 2) scale + colour-key that still picture: ONE ffmpeg run gives both the raw and the keyed image
                tag_key = hashlib.md5(repr(sig).encode()).hexdigest()[:12]
                raw = os.path.join(tmp, f"ave_av_{tag_key}_raw.png")
                key = os.path.join(tmp, f"ave_av_{tag_key}_key.png")
                ok = good(raw) and good(key)
                if not ok and good(src):
                    kf = "format=rgba" + (f",colorkey=0x{col[1:].upper()}:{sim:.3f}:{bl:.3f}" if key_on else "")
                    fc = (f"[0:v]scale={aw}:{ah}:flags=lanczos,setsar=1" + (",hflip" if mirror else "")
                          + f",split=2[r][k0];[k0]{kf}[k]")
                    subprocess.run(["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", "-i", src,
                                    "-filter_complex", fc,
                                    "-map", "[r]", "-frames:v", "1", "-update", "1", raw,
                                    "-map", "[k]", "-frames:v", "1", "-update", "1", key],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                   creationflags=NOWIN, timeout=40)
                    ok = good(raw) and good(key)
                self._av_q.put((sig, vw, vh, raw if ok else None, key if ok else None))
            except FileNotFoundError:
                self._av_q.put((sig, 0, 0, None, "noffmpeg"))
            except Exception:
                self._av_q.put((sig, 0, 0, None, None))
        threading.Thread(target=work, daemon=True).start()
        self.after(30, self._av_poll)

    def _av_poll(self):
        try:
            sig, vw, vh, raw, key = self._av_q.get_nowait()
        except queue.Empty:
            if self._av_busy:
                self.after(30, self._av_poll)
            return
        self._av_busy = False
        try:
            if raw and key and key != "noffmpeg":
                self._av_raw = tk.PhotoImage(file=raw)
                self._av_img = tk.PhotoImage(file=key)
                self._av_dims = (vw, vh)
                self._av_key_sig = sig
                self.av_note.configure(text="")
            else:
                self.av_note.configure(
                    text="Preview banano gelo na — FFmpeg lagbe (Export tab e 'Install FFmpeg')."
                    if key == "noffmpeg" else "Avatar video theke frame ana jayni.")
        except tk.TclError:
            pass
        self._av_draw()
        if self._av_dirty:
            self._av_dirty = False
            self._av_render_now()

    def _av_load_bg(self):
        """First clip's frame as the preview background (thread)."""
        cw, ch = self._av_size
        path = None
        try:
            cl = scan_clips(os.path.join(self.proj, "clips"))
            if cl:
                path = cl[sorted(cl)[0]][0][1]
        except Exception:
            path = None
        key = (path, cw, ch)
        if key == self._av_bg_key:
            return
        self._av_bg_key = key
        if self._av_bg_busy:
            return
        if not path:
            self._av_bg = None
            return
        self._av_bg_busy = True
        add_ffmpeg_path()

        def work():
            import tempfile
            try:
                tag = hashlib.md5(f"{path}|{cw}|{ch}|{os.path.getmtime(path)}".encode()).hexdigest()[:12]
                out = os.path.join(tempfile.gettempdir(), f"ave_avbg_{tag}.png")
                if not os.path.exists(out):
                    vf = f"scale={cw}:{ch}:force_original_aspect_ratio=increase,crop={cw}:{ch}"
                    is_img = os.path.splitext(path)[1].lower() in IMAGE_EXTS
                    for ss in ([] if is_img else [["-ss", "0.5"]]) + [[]]:
                        subprocess.run(["ffmpeg", "-y", "-hide_banner", "-loglevel", "error"] + ss +
                                       ["-i", path, "-frames:v", "1", "-vf", vf, out],
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                       creationflags=NOWIN, timeout=40)
                        if os.path.exists(out) and os.path.getsize(out) > 0:
                            break
                self._av_bgq.put((key, out if os.path.exists(out) else None))
            except Exception:
                self._av_bgq.put((key, None))
        threading.Thread(target=work, daemon=True).start()
        self.after(150, self._av_bg_poll)

    def _av_bg_poll(self):
        try:
            key, png = self._av_bgq.get_nowait()
        except queue.Empty:
            return self.after(200, self._av_bg_poll)
        self._av_bg_busy = False
        if key != self._av_bg_key:
            self._av_bg_key = None
            return self._av_load_bg()
        try:
            self._av_bg = tk.PhotoImage(file=png) if png else None
        except Exception:
            self._av_bg = None
        self._av_draw()

    def _av_draw(self):
        if not self._av_ready or self.cur != "avatar":
            return
        if getattr(self, "_av_draw_job", None):          # a redraw is already queued - it will use the newest values
            return
        self._av_draw_job = self.after_idle(self._av_draw_run)

    def _av_draw_run(self):
        self._av_draw_job = None
        if not self._av_ready or self.cur != "avatar":
            return
        try:
            self._av_draw_inner()
        except tk.TclError:
            pass

    def _av_draw_inner(self):
        cv = self.av_cv
        cw, ch = self._av_size
        W, H = self._av_out
        cv.delete("all")
        if self._av_bg is not None:
            cv.create_image(0, 0, image=self._av_bg, anchor="nw")
        else:
            cv.create_rectangle(0, 0, cw, ch, fill="#2b3040", outline="")
            cv.create_text(cw / 2, ch - 14, text="(clip dile ekhane clip er frame dekhabe)", fill="#8a90a0",
                           font=(FONT, 8))
        if not self._av_path:
            cv.create_text(cw / 2, ch * 0.4, text="Avatar video import koro (ba drag & drop)", fill="#ffffff",
                           font=(FONT, 10, "bold"), width=max(60, cw - 24), justify="center")
            self.av_pos_lbl.configure(text="")
            self._pv_overlay()
            self._draw_grip(cv, cw, ch)
            return
        iw, ih, x, y = self._av_rect()
        on_av = self._ctl_tab.get() == "avatar"
        img = self._av_raw if self._av_pick else self._av_img
        if img is not None:
            cv.create_image(x, y, image=img, anchor="nw")
        else:
            cv.create_rectangle(x, y, x + iw, y + ih, fill="#444a5a", outline="")
            cv.create_text(x + iw / 2, y + ih / 2, text="…", fill="#ffffff", font=(FONT, 14, "bold"))
        if on_av:
            cv.create_rectangle(x, y, x + iw, y + ih, outline=ACCENT, dash=(4, 3))
        self._pv_overlay()                                   # subtitle on top of the avatar, same canvas
        if self._av_drag and on_av:
            sx, sy = self._av_snap
            cv.create_line(cw / 2, 0, cw / 2, ch, fill=ACCENT if sx else "#ffffff", dash=(3, 4))
            cv.create_line(0, ch / 2, cw, ch / 2, fill=ACCENT if sy else "#ffffff", dash=(3, 4))
        self._draw_grip(cv, cw, ch)
        k = W / float(cw)
        self.av_pos_lbl.configure(
            text=f"Size {self._av_fnum('AV_SIZE', 35, 5, 100):g}%  •  avatar ≈ {int(iw * k)}×{int(ih * k)}px  "
                 f"•  X {self._av_fnum('AV_X', 100, -100, 200):g}  Y {self._av_fnum('AV_Y', 100, -100, 200):g}  "
                 f"•  video {W}×{H}")

    def _av_press(self, e):
        if self._av_pick:
            return self._av_pick_at(e)
        if not self._av_path:
            return
        iw, ih, x, y = self._av_rect()
        inside = x <= e.x <= x + iw and y <= e.y <= y + ih
        self._av_drag = (e.x - x, e.y - y) if inside else (iw / 2.0, ih / 2.0)
        self._av_move(e)

    def _av_move(self, e):
        if self._av_pick or not self._av_drag:
            return
        iw, ih, _x, _y = self._av_rect()
        cw, ch = self._av_size
        fx, fy = self._av_units(iw, ih)
        lo, hi = (-100.0, 200.0) if self._av_free() else (0.0, 100.0)
        nx, ny = e.x - self._av_drag[0], e.y - self._av_drag[1]
        xp = 50.0 if fx <= 0 else max(lo, min(hi, nx / float(fx) * 100))
        yp = 50.0 if fy <= 0 else max(lo, min(hi, ny / float(fy) * 100))
        sx = sy = False
        for tgt in (0.0, 50.0, 100.0):
            if abs(xp - tgt) < 2.5:
                xp, sx = tgt, True
            if abs(yp - tgt) < 2.5:
                yp, sy = tgt, True
        self._av_snap = (sx, sy)
        self.avv["AV_X"].set(self._fmt_num(xp))
        self.avv["AV_Y"].set(self._fmt_num(yp))

    def _av_release(self, e):
        self._av_drag = None
        self._av_draw()

    def _av_wheel(self, e):
        up = (getattr(e, "delta", 0) > 0) or getattr(e, "num", 0) == 4
        cur = self._av_fnum("AV_SIZE", 35, 5, 100)
        self.avv["AV_SIZE"].set(self._fmt_num(max(5.0, min(100.0, cur + (2.0 if up else -2.0)))))

    def _av_pick_at(self, e):
        iw, ih, x, y = self._av_rect()
        px, py = int(e.x - x), int(e.y - y)
        if not (0 <= px < iw and 0 <= py < ih) or self._av_raw is None:
            self.av_note.configure(text="Avatar er bhitore click koro (dashed box er moddhe).")
            return
        try:
            c = self._av_raw.get(px, py)
            if isinstance(c, str):
                c = c.split()
            r, g, b = (int(v) for v in c[:3])
        except Exception:
            return
        self.avv["AV_KEY_COLOR"].set("#%02X%02X%02X" % (r, g, b))
        self.avv["AV_KEY_ON"].set("1")
        self._av_pick = False
        self.av_eye.configure(text="🎯 Eyedropper")
        self.av_cv.configure(cursor="fleur")
        self.av_note.configure(text="")
        self._av_draw()

    # ───────── in-app avatar player + front/back trim ─────────

    def _avp_ok(self):
        return bool(self._avp_path) and self._avp_dur > 0 and self._avp_vw > 0

    # ---- player: resize ----
    def _avp_grip_hit(self, e):
        return e.x >= self._avp_cw - 24 and e.y >= self._avp_ch - 24

    def _avp_motion(self, e):
        if self._avp_rsz:
            return
        try:
            self.avp_cv.configure(cursor="bottom_right_corner" if self._avp_grip_hit(e) else "hand2")
        except tk.TclError:
            pass

    def _avp_press(self, e):
        if self._avp_grip_hit(e):
            self._avp_rsz = True
            self._avp_was_playing = self._avp_playing
            if self._avp_playing:
                self._avp_pause()
            return
        self._avp_toggle()

    def _avp_drag(self, e):
        if not self._avp_rsz:
            return
        a = self._avp_cw / float(max(1, self._avp_ch))
        w = max(200, min(900, int(round((e.x + e.y * a) / 2.0 / 10.0)) * 10))
        if w != int(self._avp_wvar.get()):
            self._avp_wset = True
            try:
                self._avp_wvar.set(w)
            finally:
                self._avp_wset = False
            self._avp_apply_size(final=False)

    def _avp_release(self, e):
        if not self._avp_rsz:
            return
        self._avp_rsz = False
        self._avp_apply_size(final=True)
        if self._avp_was_playing and self._avp_ok():
            self._avp_play()
        self._avp_was_playing = False

    def _avp_wvar_changed(self, *a):
        if self._avp_wset:
            return
        if self._avp_size_job:
            self.after_cancel(self._avp_size_job)
        self._avp_size_job = self.after(150, lambda: self._avp_apply_size(final=True))

    def _avp_apply_size(self, final=True):
        self._avp_size_job = None
        try:
            w = int(self._avp_wvar.get())
        except Exception:
            w = self.AVP_W
        w = max(200, min(900, w))
        h = w * self._avp_vh / float(self._avp_vw) if self._avp_vw > 0 and self._avp_vh > 0 else w * 0.6
        w, h = max(2, int(w) // 2 * 2), max(2, int(round(h)) // 2 * 2)
        if (w, h) != (self._avp_cw, self._avp_ch):
            self._avp_szdirty = True
        self._avp_cw, self._avp_ch, self._avp_wh = w, h, (w, h)
        try:
            self.avp_cv.configure(width=w, height=h)
            self.avp_cv.coords("msg", w // 2, h // 2)
            if self._avp_item is not None:
                self.avp_cv.coords(self._avp_item, w // 2, h // 2)
            self.avp_tl.resize(w)
            self._draw_grip(self.avp_cv, w, h)
        except tk.TclError:
            return
        self._avp_make_room(w)
        if final and self._avp_szdirty:
            self._avp_szdirty = False
            try:
                self.rec["avp_w"] = int(self._avp_wvar.get())
                save_recent(self.rec)
            except Exception:
                pass
            if self._avp_ok() and not self._avp_rsz:
                if self._avp_playing:
                    self._avp_pause()
                    self._avp_play()
                else:
                    self._avp_seek_frame(self.avp_tl.cur)

    def _avp_make_room(self, w):
        """Player wider than the controls pane -> move the divider left so it fits."""
        try:
            if self._av_ctl_hidden:
                return
            body = self._av_paned
            total = body.winfo_width()
            if total < 600:
                return
            need = w + 90
            right_w = total - body.sash_coord(0)[0] - 7
            if right_w < need:
                body.sash_place(0, max(300, total - need - 7), 1)
        except tk.TclError:
            pass

    # ---- player: live background removal ----
    def _avp_snapshot(self):
        col = self.avv["AV_KEY_COLOR"].get().strip()
        col = col if self._ok_hex(col) else "#FFFFFF"
        return {"mode": self._avp_view.get(), "col": col[1:].upper(),
                "sim": self._av_fnum("AV_KEY_SIM", 15, 1, 100) / 100.0,
                "bl": self._av_fnum("AV_KEY_BLEND", 5, 0, 100) / 100.0,
                "bg": self._avp_bgstyle.get()}

    @staticmethod
    def _avp_bg_inputs(style, w, h, fps):
        """ffmpeg input args for the backdrop shown behind the removed colour (runs in a worker thread)."""
        import tempfile
        if style == "checker":
            png = os.path.join(tempfile.gettempdir(), f"ave_avpchk_{w}x{h}.png")
            if not (os.path.exists(png) and os.path.getsize(png) > 0):
                try:
                    subprocess.run(
                        ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", "-f", "lavfi", "-i",
                         f"color=c=gray:s={w}x{h}", "-vf",
                         "geq=lum='if(mod(floor(X/10)+floor(Y/10),2),205,150)':cb=128:cr=128,format=rgb24",
                         "-frames:v", "1", png],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, creationflags=NOWIN, timeout=30)
                except Exception:
                    pass
            if os.path.exists(png) and os.path.getsize(png) > 0:
                return ["-loop", "1", "-framerate", str(fps), "-i", png]
            style = "dark"
        c = "0x1b1e27" if style == "dark" else "0xEDEDED"
        return ["-f", "lavfi", "-i", f"color=c={c}:s={w}x{h}:r={fps}"]

    def _avp_cmd(self, p, wh, snap, fps, start, dur=None, still=False):
        """Full ffmpeg command that writes raw rgb24 frames to stdout. snap['mode']=='key' -> colour removed live."""
        w, h = wh
        pre = ["ffmpeg", "-v", "error", "-ss", f"{start:.3f}"] + (["-t", f"{dur:.3f}"] if dur else []) + ["-i", p]
        tail = (["-frames:v", "1"] if still else []) + ["-f", "rawvideo", "-pix_fmt", "rgb24", "-"]
        if snap and snap.get("mode") == "key":
            graph = (f"[0:v]fps={fps},scale={w}:{h}:flags=fast_bilinear,format=rgba,"
                     f"colorkey=0x{snap['col']}:{snap['sim']:.3f}:{snap['bl']:.3f}[v];"
                     f"[1:v]scale={w}:{h},format=rgba[b];[b][v]overlay=shortest=1:format=auto,format=rgb24[o]")
            return pre + self._avp_bg_inputs(snap["bg"], w, h, fps) + ["-filter_complex", graph, "-map", "[o]",
                                                                         "-an"] + tail
        vf = f"scale={w}:{h}" if still else f"fps={fps},scale={w}:{h}:flags=fast_bilinear"
        return pre + ["-an", "-vf", vf] + tail

    def _avp_params_changed(self, *a):
        if self._loading or not hasattr(self, "avp_cv") or self._avp_view.get() != "key":
            return
        self._avp_view_changed()

    def _avp_keyon_changed(self, *a):
        if self._loading or not hasattr(self, "avp_cv"):
            return
        self._avp_view.set("key" if self.avv["AV_KEY_ON"].get() == "1" else "raw")

    def _avp_view_changed(self, *a):
        if self._loading or not hasattr(self, "avp_cv"):
            return
        if self._avp_params_job:
            self.after_cancel(self._avp_params_job)
        self._avp_params_job = self.after(250, self._avp_params_apply)

    def _avp_params_apply(self):
        self._avp_params_job = None
        if not self._avp_ok():
            return
        if self._avp_playing:                      # restart from the current position with the new settings
            self._avp_pause()
            self._avp_play()
        else:
            self._avp_seek_frame(self.avp_tl.cur)

    @staticmethod
    def _avp_can_sound():
        if os.name == "nt":
            return True                                  # winsound ships with Python on Windows
        return bool(shutil.which("afplay") or shutil.which("paplay") or shutil.which("aplay"))

    def _avp_msg(self, text):
        try:
            self.avp_cv.itemconfigure("msg", text=text, state="normal")
            self.avp_cv.tag_raise("msg")
        except tk.TclError:
            pass

    def _avp_update_time(self):
        try:
            self.avp_time.configure(text=f"{fmt_ts(self.avp_tl.cur)} / {fmt_ts(self._avp_dur)}")
        except tk.TclError:
            pass

    def _avp_sync_ui(self):
        """Refresh the entries / labels from the trim bar (and the trim line in the Avatar card)."""
        bar = self.avp_tl
        ok = self._avp_ok()
        if ok:
            self._avp_sv_s.set(f"{bar.t0:.2f}")
            self._avp_sv_e.set(f"{bar.t1:.2f}")
            trimmed = bar.t0 > 0.01 or bar.t1 < self._avp_dur - 0.05
            if trimmed:
                txt = (f"✂ Trim: {fmt_ts(bar.t0)} → {fmt_ts(bar.t1)}   (length {fmt_ts(bar.t1 - bar.t0)} "
                       f"of {fmt_ts(self._avp_dur)})")
                info = f"Duration: {fmt_dur(self._avp_dur)}  •  Trim: {fmt_ts(bar.t0)} – {fmt_ts(bar.t1)}"
            else:
                txt = "Trim nei — pura avatar video ta use hobe."
                info = f"Duration: {fmt_dur(self._avp_dur)}"
            try:
                self.avp_len.configure(text=txt, fg=ACCENT if trimmed else MUTED)
                self.av_info.configure(text=info)
            except tk.TclError:
                pass
        else:
            self._avp_sv_s.set("0.00")
            self._avp_sv_e.set("0.00")
            try:
                self.avp_len.configure(text="", fg=MUTED)
            except tk.TclError:
                pass
        self._avp_update_time()

    def _avp_vars_trim(self):
        dur = self._avp_dur
        s = self._av_fnum("AV_TRIM_START", 0, 0, dur)
        e = self._av_fnum("AV_TRIM_END", 0, 0, dur)
        if e <= 0.0 or e > dur - 0.02:
            e = dur
        if s > e - TrimBar.MIN_LEN:
            s = 0.0
        if e - s < TrimBar.MIN_LEN:
            s, e = 0.0, dur
        return s, e

    def _avp_store(self, s, e):
        """Write the trim into the project settings (AV_TRIM_END=0 means 'till the end')."""
        dur = self._avp_dur
        sv = "0" if s <= 0.005 else f"{s:.2f}"
        ev = "0" if e >= dur - 0.02 else f"{e:.2f}"
        if self.avv["AV_TRIM_START"].get() != sv:
            self.avv["AV_TRIM_START"].set(sv)
        if self.avv["AV_TRIM_END"].get() != ev:
            self.avv["AV_TRIM_END"].set(ev)
        self._avp_sync_ui()

    def _avp_refresh(self, p):
        """Called from refresh_avatar(): (re)load the in-app player when the avatar file changed."""
        sig = None
        if p:
            try:
                st = os.stat(p)
                sig = (p, st.st_mtime_ns, st.st_size)
            except OSError:
                p = None
        if sig is not None and sig == self._avp_sig:
            if self._avp_dur > 0 and not self._avp_playing:
                s, e = self._avp_vars_trim()
                self.avp_tl.set_state(t0=s, t1=e)
            self._avp_sync_ui()
            return
        self._avp_pause()
        self._avp_sig, self._avp_path = sig, p
        self._avp_dur, self._avp_vw, self._avp_vh = 0.0, 0, 0
        self._avp_img, self._avp_item = None, None
        try:
            self.avp_cv.delete("frame")
        except tk.TclError:
            pass
        self._avp_apply_size(final=False)
        self._avp_szdirty = False
        self.avp_tl.set_state(dur=0.0, t0=0.0, t1=0.0, cur=0.0)
        self._avp_sync_ui()
        if not p:
            self._avp_msg("Avatar video nei — Import koro")
            return
        self._avp_msg("Loading…")
        add_ffmpeg_path()

        def work():
            self._avp_q.put(("info", sig, probe_video_info(p)))
        threading.Thread(target=work, daemon=True).start()

    def _avp_got_info(self, sig, info):
        if sig != self._avp_sig:
            return
        if not info or not info.get("dur"):
            self._avp_dur = 0.0
            self._avp_msg("Ei video-r duration / size pawa gelo na,\nplayer & trim kaj korbe na.")
            self._avp_sync_ui()
            return
        self._avp_vw, self._avp_vh = info["w"], info["h"]
        self._avp_dur = float(info["dur"])
        self._avp_apply_size(final=False)
        self._avp_szdirty = False
        s, e = self._avp_vars_trim()
        self.avp_tl.set_state(dur=self._avp_dur, t0=s, t1=e, cur=s)
        self._avp_sync_ui()
        self._avp_seek_frame(s)

    # ---- frames ----
    def _avp_draw_frame(self, ppm):
        try:
            img = tk.PhotoImage(data=ppm, format="PPM")
            self._avp_img = img                           # keep a reference or Tk drops the picture
            if self._avp_item is None:
                self._avp_item = self.avp_cv.create_image(self._avp_cw // 2, self._avp_ch // 2, image=img, tags="frame")
                self.avp_cv.tag_lower("frame")
            else:
                self.avp_cv.itemconfigure(self._avp_item, image=img)
            self.avp_cv.itemconfigure("msg", state="hidden")
            self.avp_cv.tag_raise("grip")
        except tk.TclError:
            pass

    def _avp_seek_frame(self, t):
        """Show the frame at time t (latest request wins, runs in a background thread)."""
        if not self._avp_ok() or self._avp_playing:
            return
        t = min(max(0.0, t), max(0.0, self._avp_dur - 0.05))
        self._avp_snap_cur = self._avp_snapshot()
        with self._avp_lock:
            self._avp_seek_t = t
            if self._avp_seek_busy:
                return
            self._avp_seek_busy = True
        add_ffmpeg_path()
        threading.Thread(target=self._avp_seek_worker, args=(self._avp_sig, self._avp_path, self._avp_wh),
                         daemon=True).start()

    def _avp_seek_worker(self, sig, p, wh):
        while True:
            w, h = self._avp_wh                           # re-read: the player may have been resized meanwhile
            with self._avp_lock:
                t = self._avp_seek_t
                self._avp_seek_t = None
                if t is None:
                    self._avp_seek_busy = False
                    return
            try:
                r = subprocess.run(self._avp_cmd(p, (w, h), self._avp_snap_cur, 24, t, still=True),
                                   stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, creationflags=NOWIN,
                                   timeout=40)
                if len(r.stdout) == w * h * 3:
                    self._avp_q.put(("still", sig, b"P6 %d %d 255\n" % (w, h) + r.stdout))
            except Exception:
                pass

    # ---- playback ----
    def _avp_toggle(self):
        if self._avp_playing:
            self._avp_pause()
        else:
            self._avp_play()

    def _avp_play(self):
        if not self._avp_ok():
            self.note("Age avatar video import koro.", WARN)
            return
        s, e = self.avp_tl.t0, self.avp_tl.t1
        cur = self.avp_tl.cur
        if cur < s - 0.01 or cur >= e - 0.05:
            cur = s
        add_ffmpeg_path()
        self._avp_gen += 1
        gen = self._avp_gen
        self._avp_playing, self._avp_t0 = True, 0.0
        self._avp_base, self._avp_end, self._avp_n, self._avp_ended = cur, e, 0, False
        self._avp_drain()
        self.avp_btn.configure(text="⏸ Pause")
        snd = self._avp_snd.get() == "1" and self._avp_can_sound()
        threading.Thread(target=self._avp_worker,
                         args=(gen, self._avp_path, cur, e, self._avp_wh, self.AVP_FPS, snd, self._avp_snapshot()),
                         daemon=True).start()

    def _avp_worker(self, gen, p, start, end, wh, fps, want_sound, snap=None):
        import tempfile
        w, h = wh
        wav, proc = None, None
        try:
            if want_sound:
                wav = os.path.join(tempfile.gettempdir(), f"ave_avp_{os.getpid()}_{gen}.wav")
                r = subprocess.run(
                    ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", "-ss", f"{start:.3f}",
                     "-t", f"{end - start:.3f}", "-i", p, "-vn", "-ac", "1", "-ar", "32000",
                     "-c:a", "pcm_s16le", wav],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, creationflags=NOWIN, timeout=180)
                if r.returncode != 0 or not os.path.exists(wav) or os.path.getsize(wav) < 200:
                    self._avp_rm(wav)
                    wav = None
            if gen != self._avp_gen:
                self._avp_rm(wav)
                return
            proc = subprocess.Popen(self._avp_cmd(p, (w, h), snap, fps, start, dur=end - start),
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, creationflags=NOWIN)
            self._avp_q.put(("go", gen, proc, wav))
            size, hdr = w * h * 3, b"P6 %d %d 255\n" % (w, h)
            while gen == self._avp_gen:
                buf = proc.stdout.read(size)
                if len(buf) < size:
                    break
                item = (gen, hdr + buf)
                while gen == self._avp_gen:
                    try:
                        self._avp_fq.put(item, timeout=0.1)
                        break
                    except queue.Full:
                        continue
            self._avp_q.put(("end", gen))
        except Exception as ex:
            self._avp_q.put(("fail", gen, str(ex)))
        finally:
            try:
                if proc is not None:
                    if proc.poll() is None:
                        proc.kill()
                    proc.stdout.close()
            except Exception:
                pass

    def _avp_pause(self):
        if not hasattr(self, "avp_btn"):
            return
        if self._avp_playing and self._avp_t0:
            el = time.perf_counter() - self._avp_t0
            self.avp_tl.set_state(cur=min(self._avp_base + el, self._avp_end))
        self._avp_gen += 1
        self._avp_playing, self._avp_t0 = False, 0.0
        self._avp_kill_proc(self._avp_proc)
        self._avp_proc = None
        self._avp_audio_stop()
        self._avp_drain()
        try:
            self.avp_btn.configure(text="▶ Play")
        except tk.TclError:
            pass
        self._avp_update_time()

    def _avp_finish(self):
        """Reached the end of the trimmed part by itself."""
        self._avp_gen += 1
        self._avp_playing, self._avp_t0 = False, 0.0
        self._avp_kill_proc(self._avp_proc)
        self._avp_proc = None
        self._avp_drain()
        self.avp_tl.set_state(cur=self._avp_end)
        try:
            self.avp_btn.configure(text="▶ Play")
        except tk.TclError:
            pass
        self._avp_update_time()

    def _avp_drain(self):
        try:
            while True:
                self._avp_fq.get_nowait()
        except queue.Empty:
            pass

    @staticmethod
    def _avp_kill_proc(proc):
        try:
            if proc is not None and proc.poll() is None:
                proc.kill()
        except Exception:
            pass

    @staticmethod
    def _avp_rm(path):
        try:
            if path and os.path.exists(path):
                os.remove(path)
        except OSError:
            pass

    def _avp_audio_start(self, wav):
        self._avp_audio_stop()
        if not wav or self._avp_snd.get() != "1":
            return
        self._avp_wav = wav
        try:
            if os.name == "nt":
                import winsound
                winsound.PlaySound(wav, winsound.SND_FILENAME | winsound.SND_ASYNC)
            else:
                exe = shutil.which("afplay") or shutil.which("paplay") or shutil.which("aplay")
                if exe:
                    cmd = [exe, "-q", wav] if exe.endswith("aplay") else [exe, wav]
                    self._avp_aproc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

    def _avp_audio_stop(self):
        try:
            if os.name == "nt":
                import winsound
                winsound.PlaySound(None, winsound.SND_PURGE)
            elif self._avp_aproc is not None and self._avp_aproc.poll() is None:
                self._avp_aproc.terminate()
        except Exception:
            pass
        self._avp_aproc = None
        if self._avp_wav:
            self._avp_rm(self._avp_wav)
            self._avp_wav = None

    # ---- clock / queue pump (runs for the whole life of the app) ----
    def _avp_loop(self):
        try:
            self._avp_step()
        except Exception:
            pass
        try:
            self.after(16 if self._avp_playing else 50, self._avp_loop)
        except tk.TclError:
            pass

    def _avp_step(self):
        while True:
            try:
                m = self._avp_q.get_nowait()
            except queue.Empty:
                break
            k = m[0]
            if k == "info":
                self._avp_got_info(m[1], m[2])
            elif k == "still":
                if m[1] == self._avp_sig and not self._avp_playing:
                    self._avp_draw_frame(m[2])
            elif k == "go":
                _, gen, proc, wav = m
                if gen != self._avp_gen or not self._avp_playing:
                    self._avp_kill_proc(proc)
                    self._avp_rm(wav)
                    continue
                self._avp_proc = proc
                self._avp_audio_start(wav)
                self._avp_t0 = time.perf_counter()
                self._avp_n = 0
            elif k == "end":
                if m[1] == self._avp_gen:
                    self._avp_ended = True
            elif k == "fail":
                if m[1] == self._avp_gen:
                    self._avp_pause()
                    self.note("Video play korte somossa: " + str(m[2])[:120], BAD)
        if self._avp_playing and self._avp_t0:
            el = time.perf_counter() - self._avp_t0
            due = int(el * self.AVP_FPS)
            frame = None
            while self._avp_n <= due:
                try:
                    g, b = self._avp_fq.get_nowait()
                except queue.Empty:
                    break
                if g != self._avp_gen:
                    continue
                frame = b
                self._avp_n += 1
            if frame is not None:
                self._avp_draw_frame(frame)
            span = self._avp_end - self._avp_base
            self.avp_tl.set_state(cur=min(self._avp_base + el, self._avp_end))
            self._avp_update_time()
            if (self._avp_ended and self._avp_fq.empty() and el >= span - 0.05) or el > span + 1.5:
                self._avp_finish()

    # ---- user actions ----
    def _avp_on_seek(self, t):
        if self._avp_playing:
            self._avp_pause()
        self._avp_update_time()
        self._avp_seek_frame(t)

    def _avp_on_trim(self, t0, t1, final):
        if self._avp_playing:
            self._avp_pause()
        self._avp_store(t0, t1)
        if final:
            self._av_request()                      # the big preview uses the first frame of the trimmed part

    def _avp_nudge(self, d):
        if not self._avp_ok():
            return
        if self._avp_playing:
            self._avp_pause()
        t = min(max(0.0, self.avp_tl.cur + d), max(0.0, self._avp_dur - 0.05))
        self.avp_tl.set_state(cur=t)
        self._avp_update_time()
        self._avp_seek_frame(t)

    def _avp_set_here(self, which):
        if not self._avp_ok():
            return
        if self._avp_playing:
            self._avp_pause()
        bar, t = self.avp_tl, self.avp_tl.cur
        if which == "s":
            bar.set_state(t0=min(max(0.0, t), bar.t1 - TrimBar.MIN_LEN))
        else:
            bar.set_state(t1=max(min(self._avp_dur, t), bar.t0 + TrimBar.MIN_LEN))
        self._avp_store(bar.t0, bar.t1)
        self._av_request()

    def _avp_reset_trim(self):
        if not self._avp_ok():
            return
        if self._avp_playing:
            self._avp_pause()
        self.avp_tl.set_state(t0=0.0, t1=self._avp_dur, cur=0.0)
        self._avp_store(0.0, self._avp_dur)
        self._avp_seek_frame(0.0)
        self._av_request()

    def _avp_entry_commit(self, which):
        if not self._avp_ok():
            return
        bar = self.avp_tl
        v = parse_ts((self._avp_sv_s if which == "s" else self._avp_sv_e).get())
        if v is None or abs(v - (bar.t0 if which == "s" else bar.t1)) < 0.005:
            self._avp_sync_ui()
            return
        if which == "s":
            bar.set_state(t0=min(max(0.0, v), bar.t1 - TrimBar.MIN_LEN))
            bar.set_state(cur=bar.t0)
        else:
            bar.set_state(t1=max(min(self._avp_dur, v), bar.t0 + TrimBar.MIN_LEN))
            bar.set_state(cur=max(0.0, bar.t1 - 0.05))
        if self._avp_playing:
            self._avp_pause()
        self._avp_store(bar.t0, bar.t1)
        self._avp_seek_frame(bar.cur)
        self._av_request()

    def load_avatar_fields(self):
        c = cfg_read(self.proj)
        was = self._loading
        self._loading = True
        try:
            self.av_for.set(c.get("AVATAR_SHOW_FOR", "2"))
            self.av_every.set(c.get("AVATAR_SHOW_EVERY", "6"))
            for k, v in self.avv.items():
                v.set(c.get(k, self.AV_DEFAULTS[k]))
            self._avp_view.set("key" if self.avv["AV_KEY_ON"].get() == "1" else "raw")
        finally:
            self._loading = was
        self._av_path, self._av_key_sig, self._av_dims = False, None, None
        self._av_img = self._av_raw = None
        self._av_pick = False
        self._avp_pause()

    def save_avatar_fields(self, silent=False):
        upd = {k: v.get().strip() for k, v in self.avv.items()}
        if not self._ok_hex(upd["AV_KEY_COLOR"]):
            upd["AV_KEY_COLOR"] = "#FFFFFF"
        cfg_write(self.proj, upd)
        try:
            a, b = int(self.av_for.get()), int(self.av_every.get())
        except ValueError:
            if not silent:
                messagebox.showerror("Error", "Duto-i number hote hobe.")
            return False
        cfg_write(self.proj, {"AVATAR_SHOW_FOR": a, "AVATAR_SHOW_EVERY": b})
        if not silent:
            messagebox.showinfo("Saved", "Avatar settings saved.")
        return True

    def avatar_path(self):
        for fn in os.listdir(self.proj):
            if fn.lower().startswith("avatar") and os.path.splitext(fn)[1].lower() in VIDEO_EXTS:
                return os.path.join(self.proj, fn)
        return None

    def refresh_avatar(self):
        self.refresh_subs()
        p = self.avatar_path()
        if p:
            self.av_name.configure(text="🧑  " + os.path.basename(p))
            self.av_info.configure(text=f"Duration: {fmt_dur(media_duration(p))}")
        else:
            self.av_name.configure(text="No avatar video")
            self.av_info.configure(text="Overlay / Avatar mode e lagbe.")
        st = "normal" if p else "disabled"
        self.av_play.configure(state=st)
        self.av_rm.configure(state=st)
        self._avp_refresh(p)
        self._av_refresh()

    def import_avatar(self):
        p = filedialog.askopenfilename(filetypes=[("Video", "*.mp4 *.mov *.avi *.mkv *.webm")])
        if p:
            self.set_avatar(p)
            self.refresh_usage()

