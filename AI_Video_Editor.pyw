def fmt_ts(s):
    """m:ss.cc (used by the avatar player / trim bar)."""
    try:
        s = max(0.0, float(s or 0))
    except (TypeError, ValueError):
        s = 0.0
    m, r = divmod(s, 60)
    return f"{int(m)}:{r:05.2f}"


def parse_ts(txt):
    """'12.5' or '1:02.5' -> seconds (None when it is not a number)."""
    try:
        t = str(txt).strip().replace(",", ".")
        if ":" in t:
            m, s = t.rsplit(":", 1)
            return float(m or 0) * 60.0 + float(s or 0)
        return float(t)
    except (TypeError, ValueError):
        return None


def probe_video_info(path):
    """{'w','h','fps','dur'} of a video, or None when ffprobe can't read it."""
    try:
        out = subprocess.check_output(
            ["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
             "stream=width,height,avg_frame_rate,duration:format=duration", "-of", "json", path],
            stderr=subprocess.DEVNULL, creationflags=NOWIN, timeout=25)
        j = json.loads(out)
        st = (j.get("streams") or [{}])[0]
        w, h = int(st["width"]), int(st["height"])
        dur = None
        for v in ((j.get("format") or {}).get("duration"), st.get("duration")):
            try:
                d = float(v)
                if d > 0:
                    dur = d
                    break
            except (TypeError, ValueError):
                pass
        fps = 25.0
        try:
            a, b = str(st.get("avg_frame_rate", "0/1")).split("/")
            if float(a) > 0 and float(b) > 0:
                fps = float(a) / float(b)
        except Exception:
            pass
        return {"w": w, "h": h, "dur": dur, "fps": fps}
    except Exception:
        return None


def fmt_dur(s):
