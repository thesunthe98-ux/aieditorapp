        if messagebox.askyesno("Clear", "Sob clips remove korbe?\n(Tomar original file gulo thikই thakbe — project er copy muchbe.)"):
            for fn in os.listdir(self.clips_dir()):
                archive(os.path.join(self.clips_dir(), fn), self.proj)
            self.refresh_clips()
            self.refresh_usage()

