def _voice_ensure_dirs():
    for d in (VOICE_BASE, VOICE_SCRIPTS, VOICE_DONE, VOICE_OUTPUT, VOICE_DEBUG, VOICE_LB, VOICE_LB_DONE):
        os.makedirs(d, exist_ok=True)


def voice_prompt_read():
