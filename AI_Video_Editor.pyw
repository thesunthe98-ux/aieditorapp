def _srt_ts(x):
    m = re.fullmatch(r"(\d+):(\d+):(\d+)[,.](\d+)", (x or "").strip())
    if not m:
        return None
    h, mi, s, f = m.groups()
    return int(h) * 3600 + int(mi) * 60 + int(s) + int(f) / float(10 ** len(f))


def t2_parse_srt(txt):
    """[(start, end, text)] from SRT text."""
    out = []
    for blk in re.split(r"\n\s*\n", (txt or "").replace("\r\n", "\n").replace("\r", "\n")):
        rows = [l.strip() for l in blk.strip().split("\n") if l.strip()]
        ti = next((i for i, l in enumerate(rows) if "-->" in l), None)
        if ti is None:
            continue
        a, _, b = rows[ti].partition("-->")
        s = _srt_ts(a)
        e = _srt_ts(b.strip().split()[0] if b.strip() else "")
        text = re.sub(r"\s+", " ", re.sub(r"<[^>]+>", "", " ".join(rows[ti + 1:]))).strip()
        if s is not None and e is not None and text:
            out.append((s, max(e, s + 0.05), text))
    out.sort(key=lambda c: c[0])
    return out


